    "slugs": {
      "terminal": {
        "name": "Terminal",
        "description": "Enables the interactive terminal experience."
      },
      "video_walkthroughs": {
        "name": "Walkthrough videos",
        "description": "Record or drag a narrated screen recording into a chat; Gemini analyzes it and the chat agent works it toward an Epic. Requires a Gemini API key."
      },
      "coding_mode": {
        "name": "Coding Mode",
        "description": "Enables Coding Mode for Syrus Chat, allowing the agent to implement code changes directly in the session checkout instead of just planning."
      },
      "performance_logging": {
        "name": "Performance logging",
        "description": "Records structured slow request, SQL, and phase events to logs and a short-lived admin diagnostics buffer."
      },
      "operational_log_indexing": {
        "name": "Operational log indexing",
        "description": "Indexes recent structured application logs so admins and Syrus agents can search operational incidents."
      },
      "browser_error_auto_reports": {
        "name": "Browser error auto reports",
        "description": "Automatically files one bug-report job per browser-error fingerprint and app revision."
      },
      "local_mode": {
        "name": "Local Mode",
        "description": "Enables the Local chat mode and the `syrus local` daemon command. The agent connects to a daemon running on the user's local machine via a reverse WebSocket tunnel to read/write files and run commands locally."
      },
      "agent_insights": {
        "name": "Agent Insights",
        "description": "Enables agent insight analysis jobs that inspect recent workflow runs and surface improvement suggestions."
      },
      "chat_context_compaction": {
        "name": "Chat context compaction",
        "description": "Compacts older provider replay context for long-running chats while preserving the full durable chat transcript."
      },
      "landing_validation_prefetch": {
        "name": "Landing validation prefetch",
        "description": "Speculatively runs landing graders for the next eligible same-repository Job after the current Job's landing graders pass. Actual merge remains serialized."
      },
      "visual_review": {
        "name": "Visual review",
        "description": "Enables the visual_review step: an independent agent drives a headless browser against the worker's own in-step preview to catch visible defects and capture screenshot artifacts before graders run. A repository's .syrus.yml can override this instance-wide default per repo."
      },
      "epicless_job_bundling": {
        "name": "Epicless Job bundling",
        "description": "Enables landing multiple approved epicless Jobs together as one atomic bundle, the same way an Epic's children land together via the merge train. Experimental."
      },
      "persistent_mcp_sidecar": {
        "name": "Persistent MCP sidecar",
        "description": "Enables a worker-local persistent MCP sidecar daemon that boots once and exposes a local-only MCP transport and health check. Chat turns can route their MCP tool calls to it, with automatic fallback to stdio; workflow agent runs do not yet use it and always fall back to the per-run stdio sidecar. When disabled, all agents keep using the default per-run/per-session stdio sidecars."
      }
    }
  },
