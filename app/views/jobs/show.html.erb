<div class="space-y-6">
  <%# Title block on top, action row below — at every viewport.
      The actions had been side-by-side on the right of the title
      (`flex items-center justify-between`), which jammed on mobile
      (long titles wrap, buttons clip off-screen) and crowded the
      header on desktop too. Stacking is uniformly cleaner and
      lets the action row wrap naturally with `flex-wrap`. %>
  <div class="space-y-3">
    <div>
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="font-bold text-2xl">
          <span class="font-mono"><%= @job.repository.slug %></span>
          <span class="text-gray-400">·</span>
          <%= job_source_label_html(@job) %>
          <% if @job.issue_title.present? %>
            <span class="text-gray-400">·</span>
            <span class="font-normal"><%= @job.issue_title %></span>
          <% end %>
        </h1>
        <%= job_agent_pill(@job) %>
        <%= credential_mode_pill(@job) %>
      </div>
      <p class="mt-1 text-sm text-gray-500">
        Job #<%= @job.id %> ·
        <%= pluralize(@job.workflows.size, "workflow") %> ·
        <%= pluralize(@job.runs.size, "run") %> ·
        <span class="font-medium text-gray-700"><%= cost_caption(@job.total_cost_usd) %></span>
        <% if (prepare_label = prepare_skip_label(@job)) %>
          · <span class="font-medium text-amber-700"><%= prepare_label %></span>
        <% end %>
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <%= state_pill(job_summary_state(@job)) %>
      <% if @job.open? && @job.pr_number.present? %>
        <% feedback_agent_options = @job.alternate_configured_agent_providers.map do |provider|
             {
               label: "Check feedback with #{provider.titleize}",
               path: poll_feedback_job_path(@job, agent_provider: provider)
             }
           end %>
        <% if feedback_agent_options.any? %>
          <%= split_button(
                theme: "cyan",
                primary: { label: "Check for PR feedback", path: poll_feedback_job_path(@job) },
                options: feedback_agent_options) %>
        <% else %>
          <%= button_to "Check for PR feedback", poll_feedback_job_path(@job), method: :post,
                class: "rounded-md px-3 py-1.5 bg-cyan-600 hover:bg-cyan-500 text-white text-sm font-medium cursor-pointer",
                form: { class: "inline" } %>
        <% end %>
      <% end %>
      <%# "Rebase now" is always available when there's a PR and no
          rebase already in flight — sometimes the operator wants to
          pull in unrelated upstream changes (e.g. they pushed a bug
          fix on main and want this PR's agent to see it) regardless
          of whether GitHub thinks the branch is mergeable. The
          underlying controller bypasses the autonomous-poller's
          consecutive-failure cap, and the per-repo rebase cap (which
          only applies to autonomous polling) doesn't gate this path. %>
      <% if @job.pr_number.present? && !@job.workflows.active.where(trigger_kind: "rebase").exists? %>
        <% rebase_title = @job.pr_mergeable == false ? "Branch is unmergeable — auto-resolve" : "Force rebase onto base (e.g. to pull in upstream changes)" %>
        <% rebase_agent_options = @job.alternate_configured_agent_providers.map do |provider|
             {
               label: "Rebase with #{provider.titleize}",
               path: rebase_job_path(@job, agent_provider: provider)
             }
           end %>
        <% if rebase_agent_options.any? %>
          <%= split_button(
                theme: "teal",
                primary: { label: "Rebase now", path: rebase_job_path(@job), title: rebase_title },
                options: rebase_agent_options) %>
        <% else %>
          <%= button_to "Rebase now", rebase_job_path(@job), method: :post,
                class: "rounded-md px-3 py-1.5 bg-teal-600 hover:bg-teal-500 text-white text-sm font-medium cursor-pointer",
                form: { class: "inline" },
                title: rebase_title %>
        <% end %>
      <% end %>
      <%# Consolidated retry actions. Primary = Retry (soft replay
          on the existing branch). Dropdown holds variants: retry
          with another configured agent, retry from the failed step
          in-place when the latest workflow can do that, plus the
          always-available "start over with a new job" hard reset. %>
      <% latest_wf = @job.latest_workflow %>
      <% retry_options = @job.retry_with_agent_providers.map do |provider|
           {
             label: "Retry with #{provider.titleize}",
             path: run_again_job_path(@job, agent_provider: provider)
           }
         end %>
      <% if latest_wf&.retry_available? %>
        <% retry_options << {
             label: "Retry from failed step",
             path: retry_step_job_path(@job, workflow_id: latest_wf.id)
           } %>
      <% end %>
      <% retry_options << {
           label: "Start over with a new job",
           path: restart_job_path(@job),
           confirm: "This abandons the existing branch and PR (#{@job.pr_number ? "##{@job.pr_number}" : "none yet"}) and opens a new one. Continue?"
         } %>
      <%# Hidden entirely while a Run is in flight — retrying or
          starting over while the agent's still going would just
          stack work behind the per-Job concurrency lock. The
          Cancel & close button is the right tool when an active
          Run needs to make way. %>
      <% unless @job.any_active_run? %>
        <div data-controller="replay-context">
          <% replay_options = [
               { label: "Retry with context…", data_action: "replay-context#open" }
             ] + retry_options %>
          <%= split_button(
                theme: "blue",
                disabled: !@job.open?,
                primary: { label: "Retry", path: run_again_job_path(@job) },
                options: replay_options) %>
          <dialog data-replay-context-target="dialog"
                  class="rounded-lg shadow-xl p-0 w-full max-w-lg backdrop:bg-black/50">
            <%= form_with url: run_again_job_path(@job), method: :post, class: "p-6 space-y-4" do |f| %>
              <h2 class="text-base font-semibold text-gray-900">Retry with additional context</h2>
              <p class="text-sm text-gray-500">Tell the agent what went wrong or what to focus on. Leave blank to retry without context.</p>
              <%= f.text_area :replay_context, rows: 4,
                    class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500",
                    placeholder: "e.g. The tests in spec/models/user_spec.rb are failing — please fix them before committing." %>
              <div class="flex justify-end gap-2">
                <button type="button" data-action="replay-context#close"
                        class="px-3 py-1.5 text-sm text-gray-700 border border-gray-300 rounded-md hover:bg-gray-50 cursor-pointer">
                  Cancel
                </button>
                <%= f.submit "Retry",
                      class: "px-3 py-1.5 text-sm font-medium text-white bg-blue-600 hover:bg-blue-500 rounded-md cursor-pointer" %>
              </div>
            <% end %>
          </dialog>
        </div>
      <% end %>

      <% if @job.open? %>
        <%= button_to "Cancel & close", cancel_job_path(@job), method: :post,
              class: "rounded-md px-3 py-1.5 bg-amber-600 hover:bg-amber-500 text-white text-sm font-medium cursor-pointer",
              form: { class: "inline", data: { turbo_confirm: "Cancel any running work and close this thread?" } } %>
      <% end %>
      <% if @job.closed? %>
        <%= button_to "Reopen", reopen_job_path(@job), method: :post,
              class: "rounded-md px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium cursor-pointer",
              form: { class: "inline" } %>
      <% end %>
    </div>
  </div>

  <%# Two streams: refreshes (Job + Run state changes morph the page)
      + targeted log appends (live transcript). %>
  <%= turbo_stream_from @job %>
  <%= turbo_stream_from @job, "logs" %>

  <% runs = @job.runs.to_a %>
  <% workflows = @job.workflows.includes(steps: { runs: :job_logs }).to_a %>
  <% summary_run = runs.select { |r| r.agent_summary.present? }.last %>
  <% timeline_events = Jobs::Timeline.for(@job) %>
  <% unsatisfied_dependencies = @job.unsatisfied_dependencies %>

  <% content_for :head do %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/highlight.js@11.11.1/styles/github.min.css">
    <script src="https://cdn.jsdelivr.net/npm/highlight.js@11.11.1/highlight.min.js"></script>
  <% end %>

  <%# Tabs render unconditionally — Summary, Workflows, and Source
      are always-present panes. The Summary panel below handles the
      empty-state ("No summary yet") so the tabs don't disappear on a
      Job with no completed Runs yet. %>
  <div data-controller="tabs">
    <div class="flex border-b border-gray-200">
      <button type="button" data-tabs-target="tab" data-action="click->tabs#switch" data-tab-id="summary"
              class="px-4 py-2 text-sm font-medium text-blue-600 border-b-2 border-blue-600 -mb-px">
        Summary
      </button>
      <button type="button" data-tabs-target="tab" data-action="click->tabs#switch" data-tab-id="workflows"
              class="px-4 py-2 text-sm font-medium text-gray-500 hover:text-gray-700 -mb-px">
        Workflows (<%= workflows.size %>)
      </button>
      <button type="button" data-tabs-target="tab" data-action="click->tabs#switch" data-tab-id="source"
              class="px-4 py-2 text-sm font-medium text-gray-500 hover:text-gray-700 -mb-px">
        Source
      </button>
    </div>

    <%# Summary panel — always present; keeps overview, dependency controls,
        issue body, agent summary, and timeline behind the first tab. %>
    <div data-tabs-target="panel" class="space-y-4 pt-4">
      <% if unsatisfied_dependencies.any? %>
        <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <span class="font-medium">This Job is waiting on <%= pluralize(unsatisfied_dependencies.size, "dependency") %>.</span>
              <span>
                <%= safe_join(unsatisfied_dependencies.map { |dependency|
                      if dependency.pending?
                        content_tag(:span,
                          "#{dependency.unresolved_slug} (pending — no Syrus Job yet)",
                          class: "italic")
                      else
                        dep_job = dependency.depends_on_job
                        link_to("##{dep_job.issue_number || dep_job.id} #{dep_job.repository.slug} (#{job_summary_state(dep_job)})",
                                job_path(dep_job),
                                class: "underline hover:no-underline")
                      end
                    }, ", ".html_safe) %>
              </span>
            </div>
            <% if Current.user&.admin? %>
              <%= button_to "Override and force-run", override_dependencies_job_path(@job), method: :post,
                    class: "rounded-md px-3 py-1.5 bg-amber-700 hover:bg-amber-600 text-white text-sm font-medium cursor-pointer",
                    form: { class: "inline", data: { turbo_confirm: "Bypass dependency checks for this Job?" } } %>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="bg-white border border-gray-200 rounded-lg p-4 grid grid-cols-2 gap-4 text-sm">
        <div>
          <div class="text-xs uppercase text-gray-500">Priority</div>
          <div><%= priority_pill(@job.priority) %></div>
        </div>
        <div>
          <div class="text-xs uppercase text-gray-500">Branch</div>
          <div class="font-mono text-gray-700"><%= @job.branch_name || "—" %></div>
        </div>
        <div>
          <div class="text-xs uppercase text-gray-500">Pull request</div>
          <div class="space-y-1">
            <% if @job.pr_number %>
              <div class="flex items-center gap-2">
                <%= link_to "##{@job.pr_number}", job_pr_url(@job), target: "_blank", rel: "noopener", class: "text-blue-600 underline hover:no-underline" %>
                <span class="text-gray-500 text-xs">(Syrus)</span>
                <%= mergeable_pill(@job) %>
              </div>
            <% end %>
            <% if @job.external_pr_number %>
              <div class="flex items-center gap-2">
                <%= link_to "##{@job.external_pr_number}", external_pr_url(@job), target: "_blank", rel: "noopener", class: "text-violet-700 underline hover:no-underline" %>
                <span class="text-gray-500 text-xs">(external)</span>
                <% if @job.pr_number.nil? %><%= mergeable_pill(@job) %><% end %>
              </div>
            <% end %>
            <% if @job.pr_number.nil? && @job.external_pr_number.nil? %>
              <span class="text-gray-400">—</span>
            <% end %>
            <% if @job.pr_number || @job.external_pr_number %>
              <div class="text-xs text-gray-400 flex items-center gap-2">
                <% if @job.pr_mergeable_checked_at %>
                  <span>checked <%= relative_timestamp(@job.pr_mergeable_checked_at) %></span>
                  <span class="text-gray-300">·</span>
                <% end %>
                <%= button_to "Check now", check_mergeability_job_path(@job), method: :post,
                      class: "text-blue-500 underline hover:no-underline cursor-pointer",
                      form: { class: "inline" } %>
              </div>
            <% end %>
          </div>
        </div>
        <div>
          <div class="text-xs uppercase text-gray-500">Total cost</div>
          <div class="text-gray-900 font-medium"><%= cost_caption(@job.total_cost_usd) %></div>
          <div class="text-xs text-gray-500"><%= pluralize(@job.billed_runs_count, "billed run") %></div>
        </div>
        <div>
          <div class="text-xs uppercase text-gray-500">Started</div>
          <div class="text-gray-700"><%= relative_timestamp(@job.started_at) %></div>
        </div>
        <div>
          <div class="text-xs uppercase text-gray-500">Closed</div>
          <div class="text-gray-700">
            <% if @job.closed? %>
              <%= relative_timestamp(@job.finished_at) %>
              <span class="ml-1 text-gray-500 text-xs">(<%= @job.closure_reason || "unspecified" %>)</span>
            <% else %>
              <span class="text-gray-400">still open</span>
            <% end %>
          </div>
        </div>
      </div>

      <div class="grid gap-4 lg:grid-cols-2">
        <div class="bg-white border border-gray-200 rounded-lg p-4 space-y-3 text-sm">
          <div class="flex items-center justify-between gap-3">
            <h2 class="font-semibold text-gray-900">Dependencies</h2>
            <% if @job.dependencies_overridden_at.present? %>
              <span class="text-xs text-amber-700">overridden <%= relative_timestamp(@job.dependencies_overridden_at) %></span>
            <% end %>
          </div>
          <% if @job.dependencies.any? %>
            <ul class="divide-y divide-gray-100">
              <% @job.dependencies.each do |dependency| %>
                <li class="py-2 flex items-center justify-between gap-3">
                  <% if dependency.pending? %>
                    <div>
                      <span class="italic text-gray-600"><%= dependency.unresolved_slug %></span>
                      <span class="ml-2 text-xs text-amber-700">pending — no Syrus Job yet</span>
                      <span class="ml-2 text-xs text-gray-400"><%= dependency.source %></span>
                    </div>
                  <% else %>
                    <% dep_job = dependency.depends_on_job %>
                    <div>
                      <%= link_to "#{dep_job.repository.slug} #{job_source_label_html(dep_job)}", job_path(dep_job),
                            class: "text-blue-600 underline hover:no-underline" %>
                      <span class="ml-2"><%= state_pill(job_summary_state(dep_job)) %></span>
                      <span class="ml-2 text-xs text-gray-400"><%= dependency.source %></span>
                    </div>
                  <% end %>
                  <% if dependency.manual? %>
                    <%= button_to "Remove", dependency_job_path(@job, dependency), method: :delete,
                          class: "text-red-600 underline hover:no-underline cursor-pointer",
                          form: { class: "inline", data: { turbo_confirm: "Remove this dependency?" } } %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-gray-400">No dependencies.</p>
          <% end %>

          <%= form_with url: dependencies_job_path(@job), method: :post, class: "flex flex-wrap items-end gap-2 pt-2 border-t border-gray-100" do |f| %>
            <div class="min-w-0 flex-1">
              <%= f.label :dependency_target, "Dependency", class: "block text-xs uppercase text-gray-500" %>
              <%= f.select :dependency_target,
                    @dependency_target_options,
                    { prompt: "Select a Job or issue" },
                    required: true,
                    class: "w-full min-w-64 border border-gray-300 rounded px-2 py-1" %>
            </div>
            <%= f.submit "Add", class: "rounded-md px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium cursor-pointer" %>
          <% end %>
        </div>

        <div class="bg-white border border-gray-200 rounded-lg p-4 space-y-3 text-sm">
          <h2 class="font-semibold text-gray-900"><%= pluralize(@job.dependent_links.size, "other Job") %> depend on this one</h2>
          <% if @job.dependent_links.any? %>
            <ul class="divide-y divide-gray-100">
              <% @job.dependent_links.each do |dependency| %>
                <% dependent_job = dependency.job %>
                <li class="py-2">
                  <%= link_to "#{dependent_job.repository.slug} #{job_source_label_html(dependent_job)}", job_path(dependent_job),
                        class: "text-blue-600 underline hover:no-underline" %>
                  <span class="ml-2"><%= state_pill(job_summary_state(dependent_job)) %></span>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-gray-400">No dependent Jobs.</p>
          <% end %>
        </div>
      </div>

      <% if AppSetting.github_app_registered? && @job.repository.installation&.active? %>
        <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
          Bot-authored commits are unsigned and may show as unverified on GitHub. Repositories with required signed commits should exempt Syrus branches until GraphQL commit signing support lands.
        </div>
      <% end %>

      <% if @job.issue_body.present? %>
        <div>
          <div class="text-xs uppercase text-gray-500 mb-1">Issue</div>
          <pre class="text-sm text-gray-600 whitespace-pre-wrap break-words max-w-prose font-mono"><%= @job.issue_body %></pre>
        </div>
      <% end %>
      <% if summary_run %>
        <div>
          <div class="text-xs uppercase text-gray-500 mb-1">Agent summary</div>
          <p class="text-gray-800"><%= summary_run.agent_summary %></p>
        </div>
      <% elsif @job.issue_body.blank? %>
        <p class="text-sm text-gray-400">No summary yet.</p>
      <% end %>

      <%= render "timeline", events: timeline_events %>
    </div>

    <%# Workflows panel %>
    <div data-tabs-target="panel" class="hidden space-y-6 pt-4">
      <%= render "workflows", workflows: workflows, job: @job %>
    </div>

    <%# Source panel — lazy Turbo Frame; GitHub API is only called when this
        tab is first activated (IntersectionObserver fires when hidden→visible). %>
    <div data-tabs-target="panel" class="hidden pt-4">
      <turbo-frame id="source-browser-<%= @job.id %>"
                   src="<%= source_job_path(@job) %>"
                   loading="lazy">
        <div class="text-sm text-gray-400 py-8 text-center">Loading source browser…</div>
      </turbo-frame>
    </div>
  </div>

  <div class="text-sm">
    <%= link_to "← Back to dashboard", root_path, class: "text-gray-700 underline hover:no-underline" %>
  </div>
</div>
