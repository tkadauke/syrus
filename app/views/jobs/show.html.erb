<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="font-bold text-2xl">
        <span class="font-mono"><%= @job.repository.slug %></span>
        <span class="text-gray-400">·</span>
        <%= link_to "##{@job.issue_number}", job_issue_url(@job), target: "_blank", rel: "noopener", class: "text-blue-600 underline hover:no-underline" %>
      </h1>
      <p class="mt-1 text-sm text-gray-500">Job #<%= @job.id %> · <%= pluralize(@job.runs.size, "run") %></p>
    </div>
    <div class="flex items-center gap-3">
      <%= state_pill(job_summary_state(@job)) %>
      <% if @job.open? && @job.pr_number.present? %>
        <%= button_to "Check for PR feedback", poll_feedback_job_path(@job), method: :post,
              class: "rounded-md px-3 py-1.5 bg-cyan-600 hover:bg-cyan-500 text-white text-sm font-medium cursor-pointer",
              form: { class: "inline" } %>
      <% end %>
      <% if @job.pr_mergeable == false && !@job.runs.where(trigger_kind: "rebase").active.exists? %>
        <%= button_to "Rebase now", rebase_job_path(@job), method: :post,
              class: "rounded-md px-3 py-1.5 bg-teal-600 hover:bg-teal-500 text-white text-sm font-medium cursor-pointer",
              form: { class: "inline" } %>
      <% end %>
      <% if @job.open? && !@job.any_active_run? %>
        <%= button_to "Run again on this branch", run_again_job_path(@job), method: :post,
              class: "rounded-md px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium cursor-pointer",
              form: { class: "inline" } %>
      <% end %>
      <% if @job.open? %>
        <%= button_to "Cancel & close", cancel_job_path(@job), method: :post,
              class: "rounded-md px-3 py-1.5 bg-amber-600 hover:bg-amber-500 text-white text-sm font-medium cursor-pointer",
              form: { class: "inline", data: { turbo_confirm: "Cancel any running work and close this thread?" } } %>
      <% end %>
      <% if @job.closed? %>
        <%= button_to "Reopen", reopen_job_path(@job), method: :post,
              class: "rounded-md px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium cursor-pointer",
              form: { class: "inline" } %>
      <% end %>
      <%= button_to "Start over with a new branch", restart_job_path(@job), method: :post,
            class: "rounded-md px-3 py-1.5 bg-red-600 hover:bg-red-500 text-white text-sm font-medium cursor-pointer",
            form: { class: "inline", data: { turbo_confirm: "This abandons the existing branch and PR (#{@job.pr_number ? "##{@job.pr_number}" : "none yet"}) and opens a new one. Continue?" } } %>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg p-4 grid grid-cols-2 gap-4 text-sm">
    <div>
      <div class="text-xs uppercase text-gray-500">Branch</div>
      <div class="font-mono text-gray-700"><%= @job.branch_name || "—" %></div>
    </div>
    <div>
      <div class="text-xs uppercase text-gray-500">Pull request</div>
      <div class="space-y-1">
        <% if @job.pr_number %>
          <div class="flex items-center gap-2">
            <%= link_to "##{@job.pr_number}", job_pr_url(@job), target: "_blank", rel: "noopener", class: "text-blue-600 underline hover:no-underline" %>
            <span class="text-gray-500 text-xs">(Syrus)</span>
            <%= mergeable_pill(@job) %>
          </div>
        <% end %>
        <% if @job.external_pr_number %>
          <div class="flex items-center gap-2">
            <%= link_to "##{@job.external_pr_number}", external_pr_url(@job), target: "_blank", rel: "noopener", class: "text-violet-700 underline hover:no-underline" %>
            <span class="text-gray-500 text-xs">(external)</span>
            <% if @job.pr_number.nil? %><%= mergeable_pill(@job) %><% end %>
          </div>
        <% end %>
        <% if @job.pr_number.nil? && @job.external_pr_number.nil? %>
          <span class="text-gray-400">—</span>
        <% end %>
        <% if @job.pr_number || @job.external_pr_number %>
          <div class="text-xs text-gray-400 flex items-center gap-2">
            <% if @job.pr_mergeable_checked_at %>
              <span>checked <%= relative_timestamp(@job.pr_mergeable_checked_at) %></span>
              <span class="text-gray-300">·</span>
            <% end %>
            <%= button_to "Check now", check_mergeability_job_path(@job), method: :post,
                  class: "text-blue-500 underline hover:no-underline cursor-pointer",
                  form: { class: "inline" } %>
          </div>
        <% end %>
      </div>
    </div>
    <div>
      <div class="text-xs uppercase text-gray-500">Started</div>
      <div class="text-gray-700"><%= relative_timestamp(@job.started_at) %></div>
    </div>
    <div>
      <div class="text-xs uppercase text-gray-500">Closed</div>
      <div class="text-gray-700">
        <% if @job.closed? %>
          <%= relative_timestamp(@job.finished_at) %>
          <span class="ml-1 text-gray-500 text-xs">(<%= @job.closure_reason || "unspecified" %>)</span>
        <% else %>
          <span class="text-gray-400">still open</span>
        <% end %>
      </div>
    </div>
  </div>

  <%# Two streams: refreshes (Job + Run state changes morph the page)
      + targeted log appends (live transcript). %>
  <%= turbo_stream_from @job %>
  <%= turbo_stream_from @job, "logs" %>

  <% runs = @job.runs.to_a %>
  <% runs.reverse_each.with_index do |run, idx| %>
    <% run_number = runs.size - idx %>
    <% is_latest = idx == 0 %>
    <section class="border border-gray-200 rounded-lg overflow-hidden">
      <header class="bg-gray-50 px-4 py-3 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="font-medium text-gray-900">Run <%= run_number %></span>
          <%= trigger_pill(run.trigger_kind) %>
          <%= state_pill(run.state) %>
          <% if (run.failed? || run.cancelled?) && run.claude_session %>
            <%= button_to "Resume", resume_job_path(@job, source_run_id: run.id), method: :post,
                  class: "px-2 py-0.5 rounded text-xs font-medium bg-fuchsia-100 text-fuchsia-700 hover:bg-fuchsia-200 cursor-pointer",
                  form: { class: "inline" } %>
          <% end %>
        </div>
        <div class="text-xs text-gray-500">
          <% if run.running? && run.started_at %>
            <% avg = Run.average_duration_for(run.trigger_kind) %>
            <span data-controller="run-timer"
                  data-run-timer-started-at-value="<%= run.started_at.iso8601 %>"
                  data-run-timer-estimated-seconds-value="<%= avg || 0 %>">
              <span data-run-timer-target="elapsed">…</span>
              <% if avg %>
                · <span data-run-timer-target="remaining"></span>
              <% end %>
            </span>
          <% elsif run.started_at %>
            <%= relative_timestamp(run.started_at) %>
            <% if run.finished_at %>
              → <%= relative_timestamp(run.finished_at) %>
            <% end %>
          <% else %>
            not yet started
          <% end %>
          <% if run.agent_turns %>
            · turns=<%= run.agent_turns %>
          <% end %>
          <% if run.agent_outcome %>
            · <span class="font-mono"><%= run.agent_outcome %></span>
          <% end %>
        </div>
      </header>

      <div class="border-t border-gray-100 divide-y divide-gray-100">
        <details <%= is_latest ? "open" : "" %> class="group">
          <summary class="px-4 py-2 text-xs uppercase tracking-wide text-gray-500 cursor-pointer select-none hover:bg-gray-50 flex items-center gap-2 [&::marker]:hidden [&::-webkit-details-marker]:hidden">
            <span class="text-gray-400 group-open:rotate-90 transition-transform duration-150 inline-block">▶</span>
            Transcript
            <% unless run.job_logs.any? %>
              <span class="normal-case text-gray-400 font-normal">(empty)</span>
            <% end %>
          </summary>
          <%# data-turbo-permanent so streamed JobLog appends survive
              morph refreshes — without it a Job/Run state change can
              wipe in-flight transcript chunks. %>
          <div id="run_<%= run.id %>_logs" data-turbo-permanent class="bg-black text-gray-100 p-3 max-h-96 overflow-y-auto space-y-1">
            <% if run.job_logs.any? %>
              <%= render run.job_logs %>
            <% else %>
              <p class="font-mono text-xs text-gray-400">No transcript chunks yet.</p>
            <% end %>
          </div>
        </details>

        <% if run.agent_diff.present? %>
          <details class="group">
            <summary class="px-4 py-2 text-xs uppercase tracking-wide text-gray-500 cursor-pointer select-none hover:bg-gray-50 flex items-center gap-2 [&::marker]:hidden [&::-webkit-details-marker]:hidden">
              <span class="text-gray-400 group-open:rotate-90 transition-transform duration-150 inline-block">▶</span>
              Diff
            </summary>
            <pre class="bg-black text-gray-100 p-3 overflow-x-auto max-h-96 overflow-y-auto text-xs font-mono whitespace-pre"><%= run.agent_diff %></pre>
          </details>
        <% end %>
      </div>
    </section>
  <% end %>

  <div class="text-sm">
    <%= link_to "← Back to dashboard", root_path, class: "text-gray-700 underline hover:no-underline" %>
  </div>
</div>
