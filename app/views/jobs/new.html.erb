<div class="max-w-2xl space-y-6">
  <div>
    <h1 class="font-bold text-2xl">New ad hoc job</h1>
    <p class="mt-1 text-sm text-gray-500">
      Run the agent on a repository with a free-form prompt — no GitHub issue required.
    </p>
  </div>

  <%= form_with url: jobs_path, method: :post, class: "space-y-5" do |f| %>
    <% if flash[:alert] %>
      <div class="rounded-md bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-800">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <div>
      <label for="repository_id" class="block text-sm font-medium text-gray-700 mb-1">Repository</label>
      <% if @repositories.empty? %>
        <p class="text-sm text-gray-500">
          No active repositories.
          <%= link_to "Add one first.", new_repository_path, class: "text-blue-600 underline hover:no-underline" %>
        </p>
      <% else %>
        <select name="repository_id" id="repository_id" required
                class="w-full text-sm border border-gray-300 rounded-md px-3 py-2 bg-white text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
          <option value="">— select a repository —</option>
          <% @repositories.each do |repo| %>
            <option value="<%= repo.id %>" <%= "selected" if repo.id.to_s == @selected_repository_id.to_s %>>
              <%= repo.slug %>
            </option>
          <% end %>
        </select>
      <% end %>
    </div>

    <div data-controller="prompt-template"
         data-prompt-template-templates-value="<%= @prompt_templates.map { |t| { id: t.id, name: t.name, prompt: t.prompt } }.to_json %>">

      <% if @prompt_templates.any? %>
        <div class="space-y-2">
          <p class="text-sm font-medium text-gray-700">Templates</p>
          <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
            <% @prompt_templates.each do |template| %>
              <button type="button"
                      data-action="click->prompt-template#apply"
                      data-template-id="<%= template.id %>"
                      class="text-left rounded-md border border-gray-200 px-3 py-2.5 hover:border-blue-300 hover:bg-blue-50 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500">
                <div class="text-sm font-medium text-gray-900"><%= template.name %></div>
                <div class="mt-0.5 text-xs text-gray-500 leading-snug"><%= template.description %></div>
              </button>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="<%= @prompt_templates.any? ? 'mt-4' : '' %>">
        <label for="title" class="block text-sm font-medium text-gray-700 mb-1">
          Title <span class="text-gray-400 font-normal">(optional)</span>
        </label>
        <input type="text" name="title" id="title"
               data-prompt-template-target="title"
               placeholder="e.g. Bump Ruby version to 3.3"
               class="w-full text-sm border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
      </div>

      <div class="mt-4">
        <label for="prompt" class="block text-sm font-medium text-gray-700 mb-1">Prompt</label>
        <textarea name="prompt" id="prompt" rows="10" required
                  data-prompt-template-target="prompt"
                  placeholder="Describe what you want the agent to do…"
                  class="w-full text-sm font-mono border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea>
        <p class="mt-1 text-xs text-gray-500">The agent receives this prompt verbatim, plus the standard git-safety and submit-summary instructions.</p>
      </div>
    </div>

    <div>
      <label for="priority" class="block text-sm font-medium text-gray-700 mb-1">Priority</label>
      <select name="priority" id="priority"
              class="text-sm border border-gray-300 rounded-md px-3 py-2 bg-white text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
        <option value="high">High — runs before medium and low</option>
        <option value="medium" selected>Medium (default)</option>
        <option value="low">Low — yields to higher-priority jobs</option>
      </select>
    </div>

    <div class="flex items-center gap-3 pt-2">
      <%= f.submit "Create job",
            class: "rounded-md px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium cursor-pointer",
            disabled: @repositories.empty? %>
      <%= link_to "Cancel", root_path, class: "text-sm text-gray-600 underline hover:no-underline" %>
    </div>
  <% end %>
</div>
