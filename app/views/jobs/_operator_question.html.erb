<% context_json = question.context.present? ? JSON.pretty_generate(question.context) : nil %>
<section id="operator-question-<%= question.id %>" class="border-t border-fuchsia-100 bg-fuchsia-50/60 px-4 py-3">
  <div class="space-y-3">
    <div class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between">
      <div class="min-w-0">
        <div class="text-xs uppercase tracking-wide text-fuchsia-700">Operator question</div>
        <p class="mt-1 text-sm text-gray-900 whitespace-pre-wrap break-words"><%= question.text %></p>
      </div>
      <div class="text-xs text-gray-500 sm:text-right whitespace-nowrap">
        <%= relative_timestamp(question.asked_at) %>
      </div>
    </div>

    <% if context_json.present? %>
      <details class="group">
        <summary class="text-xs uppercase tracking-wide text-fuchsia-700 cursor-pointer select-none flex items-center gap-2 [&::marker]:hidden [&::-webkit-details-marker]:hidden">
          <span class="text-fuchsia-500 group-open:rotate-90 transition-transform duration-150 inline-block">▶</span>
          Context
        </summary>
        <pre class="mt-2 bg-white border border-fuchsia-100 rounded p-3 overflow-x-auto text-xs font-mono text-gray-700 whitespace-pre-wrap break-words"><%= context_json %></pre>
      </details>
    <% end %>

    <% if question.operator_responses.any? %>
      <ol class="space-y-2">
        <% question.operator_responses.each do |operator_response| %>
          <li class="rounded-md border border-gray-200 bg-white px-3 py-2">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between">
              <p class="text-sm text-gray-800 whitespace-pre-wrap break-words"><%= operator_response.text %></p>
              <span class="text-xs text-gray-500 whitespace-nowrap"><%= relative_timestamp(operator_response.responded_at) %></span>
            </div>
          </li>
        <% end %>
      </ol>
    <% end %>

    <% if run.awaiting_operator? %>
      <%= form_with url: operator_response_job_path(job), method: :post, class: "space-y-2" do |f| %>
        <%= f.hidden_field :operator_question_id, value: question.id %>
        <%= f.label :text, "Reply", class: "block text-xs uppercase tracking-wide text-fuchsia-700" %>
        <%= f.text_area :text,
              rows: 3,
              required: true,
              class: "w-full border border-fuchsia-200 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-fuchsia-500",
              placeholder: "Type your response for the agent." %>
        <%= f.submit "Send response",
              class: "rounded-md px-3 py-1.5 bg-fuchsia-600 hover:bg-fuchsia-500 text-white text-sm font-medium cursor-pointer" %>
      <% end %>
    <% end %>
  </div>
</section>
