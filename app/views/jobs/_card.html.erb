<%= link_to job_path(job),
      class: "block rounded-lg border border-gray-200 bg-white p-3 text-sm shadow-sm hover:border-blue-300 hover:shadow",
      data: { job_id: job.id } do %>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <div class="font-medium text-gray-900 break-words">
        <% if job.issue? %>
          <span class="text-blue-600">#<%= job.issue_number %></span>
        <% elsif job.cron? %>
          <span class="text-blue-600">scheduled</span>
        <% else %>
          <span class="text-gray-600">Direct</span>
        <% end %>
        <% if job.issue_title.present? %>
          <span class="ml-1"><%= job.issue_title %></span>
        <% end %>
      </div>
      <div class="mt-1 font-mono text-xs text-gray-500"><%= job.repository.slug %></div>
    </div>
    <%= job_attention_status_pill(job) %>
  </div>

  <div class="mt-3 flex flex-wrap items-center gap-1.5">
    <%= state_pill(job.latest_workflow_state) %>
    <% if job.latest_workflow_trigger_kind.present? %>
      <%= trigger_pill(job.latest_workflow_trigger_kind) %>
    <% else %>
      <span class="rounded bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600">pre-run</span>
    <% end %>
  </div>

  <div class="mt-2 text-xs text-gray-500">
    <% if job.latest_workflow_created_at.present? %>
      Latest workflow <%= relative_timestamp(job.latest_workflow_created_at) %>
    <% else %>
      No workflow yet
    <% end %>
  </div>
<% end %>
