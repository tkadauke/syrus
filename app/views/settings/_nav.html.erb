<nav class="flex gap-6 border-b border-gray-200 mb-6 pb-0 text-sm">
  <%= link_to "My credentials", edit_credentials_path,
        class: "pb-3 border-b-2 #{controller_name == 'credentials' ? 'border-blue-600 text-blue-600 font-medium' : 'border-transparent text-gray-600 hover:text-gray-900'}" %>
  <% if Current.user&.admin? %>
    <%= link_to "Invitations", invitations_path,
          class: "pb-3 border-b-2 #{controller_name == 'invitations' ? 'border-blue-600 text-blue-600 font-medium' : 'border-transparent text-gray-600 hover:text-gray-900'}" %>
    <%= link_to "App settings", edit_settings_path,
          class: "pb-3 border-b-2 #{controller_name == 'settings' ? 'border-blue-600 text-blue-600 font-medium' : 'border-transparent text-gray-600 hover:text-gray-900'}" %>
  <% end %>
</nav>
