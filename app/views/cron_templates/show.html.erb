<%= render "settings/nav" %>
<div class="space-y-6">
  <div class="flex items-start justify-between gap-4">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="font-bold text-2xl"><%= @template.name %></h1>
        <% if @template.enabled? %>
          <span class="inline-block px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-700">enabled</span>
        <% else %>
          <span class="inline-block px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-500">disabled</span>
        <% end %>
      </div>
      <% if @template.description.present? %>
        <p class="text-sm text-gray-600 mt-1"><%= @template.description %></p>
      <% end %>
    </div>

    <div class="flex items-center gap-2">
      <%= link_to "Edit", edit_cron_template_path(@template),
            class: "rounded-md px-3 py-1.5 text-sm border border-gray-300 hover:bg-gray-50" %>
      <%= button_to "Delete", cron_template_path(@template), method: :delete,
            data: { turbo_confirm: "Delete this template? Existing scheduled tasks created from it will remain." },
            class: "rounded-md px-3 py-1.5 text-sm border border-gray-300 hover:bg-red-50 text-red-700 cursor-pointer",
            form: { class: "inline" } %>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg p-4">
    <h2 class="font-semibold text-sm uppercase text-gray-500 mb-2">Schedule</h2>
    <dl class="grid grid-cols-2 gap-y-2 text-sm">
      <dt class="text-gray-500">Cron expression</dt>
      <dd class="font-mono"><%= @template.cron_expression %></dd>
      <dt class="text-gray-500">Semantics</dt>
      <dd>Minute ignored; fires by UTC hour window.</dd>
      <dt class="text-gray-500">PR pileup policy</dt>
      <dd><%= @template.pr_pileup_policy %></dd>
    </dl>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg p-4">
    <h2 class="font-semibold text-sm uppercase text-gray-500 mb-2">Prompt</h2>
    <pre class="text-xs whitespace-pre-wrap font-mono bg-gray-50 p-3 rounded border border-gray-200"><%= @template.prompt %></pre>
    <p class="text-xs text-gray-500 mt-2">
      Variables expanded at fire time:
      <code>{{repo_slug}}</code>, <code>{{repo_default_branch}}</code>, <code>{{date}}</code>,
      <code>{{last_fired_at}}</code>, <code>{{last_successful_fire_at}}</code>.
    </p>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg p-4">
    <div class="flex items-center justify-between mb-3">
      <h2 class="font-semibold text-sm uppercase text-gray-500">Applied to repositories</h2>
    </div>

    <% if @applied_tasks.any? %>
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="text-xs uppercase text-gray-500">
          <tr>
            <th class="px-2 py-2 text-left">Repository</th>
            <th class="px-2 py-2 text-left">Task</th>
            <th class="px-2 py-2 text-left">State</th>
            <th class="px-2 py-2 text-left">Last fired</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 text-sm">
          <% @applied_tasks.each do |task| %>
            <tr>
              <td class="px-2 py-2 font-mono text-xs">
                <%= link_to task.repository.slug, repository_path(task.repository), class: "text-blue-600 underline hover:no-underline" %>
              </td>
              <td class="px-2 py-2">
                <%= link_to task.name, scheduled_task_path(task), class: "text-blue-600 underline hover:no-underline" %>
              </td>
              <td class="px-2 py-2"><%= scheduled_task_state_pill(task) %></td>
              <td class="px-2 py-2 text-xs text-gray-500">
                <%= task.last_fired_at ? "#{time_ago_in_words(task.last_fired_at)} ago" : "never" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-sm text-gray-600">Not applied to any repositories yet.</p>
    <% end %>

    <% if @repositories.any? %>
      <div class="mt-4 pt-4 border-t border-gray-100">
        <p class="text-xs font-medium text-gray-500 mb-2">Apply to a repository:</p>
        <div class="flex flex-wrap gap-2">
          <% @repositories.each do |repo| %>
            <%= link_to repo.slug,
                  new_repository_scheduled_task_path(repo, from_template: @template.id),
                  class: "inline-block rounded border border-gray-300 px-2.5 py-1 text-xs font-mono hover:bg-blue-50 hover:border-blue-300 hover:text-blue-700" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
