<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Syrus" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Syrus">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# Turbo refresh broadcasts (broadcasts_refreshes / broadcasts_refreshes_to)
        morph the page in place instead of reloading. Preserves scroll
        position and any element marked data-turbo-permanent (the live
        transcript). %>
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-gray-900">
    <header class="bg-white border-b border-gray-200">
      <nav class="container mx-auto px-5 py-4 flex items-center justify-between">
        <div class="flex items-center gap-6">
          <%= link_to "Syrus", root_path, class: "font-bold text-xl text-gray-900 hover:text-blue-600" %>

          <% if Current.user %>
            <div class="flex items-center gap-4 text-sm">
              <%= link_to "Repositories", repositories_path, class: "text-gray-700 hover:text-blue-600" %>
              <%= link_to "Scheduled tasks", scheduled_tasks_path, class: "text-gray-700 hover:text-blue-600" %>
              <%= link_to "Templates", cron_templates_path, class: "text-gray-700 hover:text-blue-600" %>
              <%= link_to "Settings", settings_path, class: "text-gray-700 hover:text-blue-600" %>
              <% if Current.user.admin? %>
                <%# Admin diagnostics — see docs/plans/admin-diagnostics.md.
                    Lands on the system overview (F) which links into
                    the transcripts (A) and queue inspector (B). %>
                <%= link_to "Admin", admin_root_path, class: "text-blue-600 hover:text-blue-700 font-medium" %>
              <% end %>
            </div>
          <% end %>
        </div>

        <div class="flex items-center gap-4 text-sm">
          <% if Current.user %>
            <span class="text-gray-600">
              <%= Current.user.email_address %>
              <% if Current.user.admin? %>
                <span class="ml-1 px-1.5 py-0.5 rounded text-xs bg-blue-100 text-blue-700">admin</span>
              <% end %>
            </span>
            <%= button_to "Sign out", session_path, method: :delete, class: "text-gray-700 underline hover:no-underline cursor-pointer", form: { class: "inline" } %>
          <% else %>
            <%= link_to "Sign in", new_session_path, class: "text-gray-700 underline hover:no-underline" %>
          <% end %>
        </div>
      </nav>
    </header>

    <main class="container mx-auto mt-10 px-5 pb-16">
      <% if alert = flash[:alert] %>
        <p class="py-2 px-3 bg-red-50 mb-5 text-red-500 font-medium rounded-lg inline-block" id="alert" data-controller="flash"><%= alert %></p>
      <% end %>

      <% if notice = flash[:notice] %>
        <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice" data-controller="flash"><%= notice %></p>
      <% end %>

      <%= yield %>
    </main>

    <footer class="container mx-auto px-5 pb-6 text-xs text-gray-400 flex items-end justify-between gap-4">
      <%= link_to syrus_wikipedia_url, target: "_blank", rel: "noopener",
            class: "italic hover:text-gray-600 hover:no-underline" do %>
        &ldquo;<%= random_syrus_quote %>&rdquo; &mdash; Publilius Syrus
      <% end %>
      <% if app_revision_url %>
        <%= link_to app_revision, app_revision_url, target: "_blank", rel: "noopener",
              class: "font-mono underline hover:no-underline hover:text-gray-600 shrink-0" %>
      <% else %>
        <span class="font-mono shrink-0"><%= app_revision %></span>
      <% end %>
    </footer>
  </body>
</html>
