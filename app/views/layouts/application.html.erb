<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Syrus" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Syrus">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# Turbo refresh broadcasts (broadcasts_refreshes / broadcasts_refreshes_to)
        morph the page in place instead of reloading. Preserves scroll
        position and any element marked data-turbo-permanent (the live
        transcript). %>
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <% show_bug_report = Current.user.present? && controller_name != "bug_reports" %>
  <body class="bg-gray-50 text-gray-900"
        data-controller="form-validation checkbox-persistence"
        data-bug-context="<%= "#{controller_name.camelize}##{action_name}" if show_bug_report %>">
    <header class="bg-white border-b border-gray-200">
      <nav class="container mx-auto px-5 py-4 flex items-center justify-between">
        <div class="flex items-center gap-6">
          <%= link_to "Syrus", default_chat_path, class: "font-bold text-xl text-gray-900 hover:text-blue-600" %>

          <% if Current.user %>
            <div class="flex items-center gap-4 text-sm">
              <% top_nav_class = "text-gray-700 hover:text-blue-600" %>
              <% top_nav_active_class = "text-blue-600 font-medium" %>
              <%= link_to "Dashboard", dashboard_epics_path,
                    class: controller_name == "home" && action_name != "index" ? top_nav_active_class : top_nav_class %>
              <%= link_to repositories_path,
                    class: controller_name == "repositories" ? top_nav_active_class : top_nav_class do %>
                <span class="sm:hidden">Repos</span>
                <span class="hidden sm:inline">Repositories</span>
              <% end %>
            </div>
          <% end %>
        </div>

        <div class="flex items-center gap-4 text-sm">
          <% if Current.user %>
            <%# Admin pill is a clickable link to /admin in BOTH
                viewports. Sits outside the profile icon (mobile)
                and the dropdown trigger (desktop) — nested
                anchors/buttons are invalid markup, so the pill has
                to be its own element. %>
            <% if Current.user.admin? %>
              <%= link_to admin_root_path,
                    class: "px-1.5 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700 hover:bg-blue-200",
                    title: "Open admin overview" do %>
                admin
              <% end %>
            <% end %>

            <%# Mobile: a profile icon that goes straight to Settings.
                The dropdown menu costs too much horizontal real
                estate at narrow viewports, and Settings is the
                landing page operators are most likely to want
                anyway (Sign out, Admin are reachable via Settings's
                in-page nav and the admin pill above). %>
            <%= link_to settings_path, class: "sm:hidden flex items-center text-gray-700 hover:text-blue-600",
                  title: "Settings (signed in as #{Current.user.email_address})" do %>
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"/>
              </svg>
            <% end %>

            <%# Desktop: full email + dropdown. Hidden below sm
                breakpoint so the mobile profile icon above is the
                only user-menu surface there. %>
            <div class="relative hidden sm:block" data-controller="split-button">
              <button type="button" data-action="click->split-button#toggle"
                      class="flex items-center gap-2 text-gray-700 hover:text-blue-600 cursor-pointer">
                <span><%= Current.user.email_address %></span>
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
              </button>
              <div data-split-button-target="menu" class="hidden absolute right-0 mt-2 w-56 bg-white border border-gray-200 rounded-md shadow-lg py-1 z-10">
                <%# Per-user nav lives under Settings (Templates,
                    Credentials are sub-pages there). Admin links into
                    the diagnostic surface; App-Settings is an admin-
                    only sub-page rendered there, not here. %>
                <%= link_to "Settings",  settings_path,         class: "block px-4 py-2 text-gray-700 hover:bg-gray-50" %>
                <% if Current.user.admin? %>
                  <%= link_to "Admin",   admin_root_path,       class: "block px-4 py-2 text-blue-600 font-medium hover:bg-gray-50" %>
                <% end %>
                <div class="my-1 border-t border-gray-100"></div>
                <%= button_to "Sign out", session_path, method: :delete,
                      class: "block w-full text-left px-4 py-2 text-gray-700 hover:bg-gray-50 cursor-pointer",
                      form: { class: "block" } %>
              </div>
            </div>
          <% else %>
            <%= link_to "Sign in", new_session_path, class: "text-gray-700 underline hover:no-underline" %>
          <% end %>
        </div>
      </nav>
    </header>

    <main class="container mx-auto mt-10 px-5 pb-16">
      <%# Persistent system alerts (GH API blocked, polling paused, etc).
          Sourced from SystemAlerts.active_for; rendered via the
          reusable shared/_alert_banner partial so any future alert
          slots in without changing this layout. %>
      <% Array(@system_alerts).each do |alert| %>
        <div class="mb-5"><%= render "shared/alert_banner", alert: alert %></div>
      <% end %>

      <% if alert = flash[:alert] %>
        <p class="py-2 px-3 bg-red-50 mb-5 text-red-500 font-medium rounded-lg inline-block" id="alert" data-controller="flash"><%= alert %></p>
      <% end %>

      <% if notice = flash[:notice] %>
        <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice" data-controller="flash"><%= notice %></p>
      <% end %>

      <%= yield %>
    </main>

    <%# data-turbo-permanent stops Turbo morph from re-rolling the
        random quote on every broadcast refresh. The quote is purely
        decorative chrome and re-rolling it constantly when a Job is
        running is distracting flicker. The revision link is server
        state (changes on deploy) so it stays outside the permanent
        region. %>
    <footer class="container mx-auto px-5 pb-6 text-xs text-gray-400 flex items-end justify-between gap-4">
      <%= link_to syrus_wikipedia_url, target: "_blank", rel: "noopener",
            id: "syrus-footer-quote",
            data: { turbo_permanent: true },
            class: "italic hover:text-gray-600 hover:no-underline" do %>
        &ldquo;<%= random_syrus_quote %>&rdquo; &mdash; Publilius Syrus
      <% end %>
      <% if app_revision_url %>
        <%= link_to app_revision, app_revision_url, target: "_blank", rel: "noopener",
              class: "font-mono underline hover:no-underline hover:text-gray-600 shrink-0" %>
      <% else %>
        <span class="font-mono shrink-0"><%= app_revision %></span>
      <% end %>
    </footer>

    <% if show_bug_report %>
      <div data-controller="bug-report" data-bug-context="<%= "#{controller_name.camelize}##{action_name}" %>">
        <%= render "shared/bug_report_button" %>
      </div>
    <% end %>
  </body>
</html>
