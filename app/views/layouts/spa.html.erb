<!DOCTYPE html>
<%# data-theme carries the persisted preference (light/dark/system, defaulting to
    system for signed-out visitors) to the inline script below, which resolves
    "system" against prefers-color-scheme and sets the `dark` class before the
    stylesheet paints anything — the class= fallback covers no-JS environments for
    the two explicit themes (system can't be resolved server-side: the server has
    no reliable signal for the client's OS color-scheme preference). %>
<html class="<%= current_user&.theme == 'dark' ? 'dark' : '' %>" data-theme="<%= current_user&.theme || 'system' %>">
  <head>
    <title>Syrus</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Syrus">
    <meta name="mobile-web-app-capable" content="yes">
    <script>
      (function () {
        try {
          var theme = document.documentElement.dataset.theme;
          var prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
          var dark = theme === "dark" || (theme !== "light" && prefersDark);
          document.documentElement.classList.toggle("dark", dark);
        } catch {
          // matchMedia unavailable or blocked — leave the server-rendered class alone.
        }
      })();
    </script>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# ?v= matches BRAND_ICON_VERSION in app/frontend/lib/brandIcon.ts — public/
        files are served with a 1-year max-age, so rebranded icons need a new URL. %>
    <link rel="icon" href="/icon.png?v=2" type="image/png">
    <link rel="apple-touch-icon" href="/icon-192.png?v=2">
    <link rel="manifest" href="/manifest.json">

    <%= stylesheet_link_tag :app %>
    <% if Rails.env.test? %>
      <%= tag.script "", src: "/assets/spa-test.js", type: "module" %>
    <% elsif Rails.env.production? || Rails.application.assets.load_path.find("spa.js") %>
      <%= javascript_include_tag "spa", type: "module" %>
    <% end %>
  </head>

  <body class="bg-gray-50 text-gray-900 dark:bg-gray-900 dark:text-white">
    <%= yield %>
  </body>
</html>
