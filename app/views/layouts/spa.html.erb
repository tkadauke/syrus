<!DOCTYPE html>
<%# data-mode-pref carries the persisted mode preference (light/dark/system,
    defaulting to system for signed-out visitors) to the inline script below,
    which resolves "system" against prefers-color-scheme and sets the `dark`
    class before the stylesheet paints anything — the class= fallback covers
    no-JS environments for the two explicit modes (system can't be resolved
    server-side: the server has no reliable signal for the client's OS
    color-scheme preference).

    data-theme carries the user's built-in color theme slug (terracotta/
    ocean/forest/...), matching the compiled `[data-theme="slug"]` CSS blocks
    (app/assets/tailwind/generated/themes.generated.css) so a built-in theme
    never flashes. A non-built-in (custom) color theme isn't known at build
    time, so instead of data-theme its token values are embedded as JSON
    below and applied as inline custom properties by the same inline script,
    before hydration — the same anti-flash treatment the design-system lint ratchet established for
    mode. %>
<%
  mode_pref = current_user&.theme || "system"
  color_theme = current_user&.color_theme
  custom_color_theme = color_theme && !color_theme.built_in? ? color_theme : nil
%>
<html class="<%= mode_pref == 'dark' ? 'dark' : '' %>" data-mode-pref="<%= mode_pref %>"<% if color_theme&.built_in? %> data-theme="<%= color_theme.slug %>"<% end %>>
  <head>
    <title>Syrus</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Syrus">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="application-name" content="Syrus">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#c9704b">
    <meta name="syrus-app-revision" content="<%= SyrusVersion.current %>">
    <meta name="syrus-asset-revision" content="<%= spa_asset_version %>">
    <% if custom_color_theme %>
      <script id="syrus-custom-color-theme-data" type="application/json"><%= raw json_escape(custom_color_theme.tokens.to_json) %></script>
    <% end %>
    <script nonce="<%= content_security_policy_nonce %>">
      (function () {
        try {
          var modePref = document.documentElement.dataset.modePref;
          var prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
          var dark = modePref === "dark" || (modePref !== "light" && prefersDark);
          document.documentElement.classList.toggle("dark", dark);

          var customThemeDataEl = document.getElementById("syrus-custom-color-theme-data");
          if (customThemeDataEl) {
            var tokensByMode = JSON.parse(customThemeDataEl.textContent);
            var tokens = tokensByMode[dark ? "dark" : "light"] || {};
            var derivedTokens = {
              page: "var(--color-surface-raised)",
              "surface-subtle": "var(--color-surface-raised)",
              "surface-inset": "color-mix(in srgb, var(--color-surface) 70%, var(--color-border))",
              "border-strong": "color-mix(in srgb, var(--color-border) 70%, var(--color-text-primary))",
              text: "var(--color-text-primary)",
              "text-muted": "var(--color-text-secondary)",
              "text-subtle": "color-mix(in srgb, var(--color-text-secondary) 70%, var(--color-surface))",
              link: "var(--color-brand-emphasis)",
              "success-surface": "color-mix(in srgb, var(--color-surface) 94%, var(--color-success))",
              "success-border": "color-mix(in srgb, var(--color-surface) 70%, var(--color-success))",
              "success-text": "var(--color-success)",
              "warning-surface": "color-mix(in srgb, var(--color-surface) 94%, var(--color-warning))",
              "warning-border": "color-mix(in srgb, var(--color-surface) 70%, var(--color-warning))",
              "warning-text": "var(--color-warning)",
              "danger-surface": "color-mix(in srgb, var(--color-surface) 94%, var(--color-danger))",
              "danger-border": "color-mix(in srgb, var(--color-surface) 70%, var(--color-danger))",
              "danger-text": "var(--color-danger)",
              "info-surface": "color-mix(in srgb, var(--color-surface) 94%, var(--color-info))",
              "info-border": "color-mix(in srgb, var(--color-surface) 70%, var(--color-info))",
              "info-text": "var(--color-info)",
              "neutral-surface": "color-mix(in srgb, var(--color-surface) 94%, var(--color-neutral))",
              "neutral-border": "color-mix(in srgb, var(--color-surface) 70%, var(--color-neutral))",
              "neutral-text": "var(--color-neutral)"
            };
            Object.keys(tokens).forEach(function (key) {
              document.documentElement.style.setProperty("--color-" + key, tokens[key]);
            });
            Object.keys(derivedTokens).forEach(function (key) {
              document.documentElement.style.setProperty("--color-" + key, derivedTokens[key]);
            });
          }
        } catch {
          // matchMedia/JSON unavailable or blocked — leave the server-rendered attributes alone.
        }
      })();
    </script>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script id="syrus-startup-diagnostics" nonce="<%= content_security_policy_nonce %>">
      (function () {
        var WATCHDOG_TIMEOUT_MS = 8000;
        var startupAt = Date.now();
        var reportedKeys = {};
        var milestones = [];
        var pendingStartupState = null;

        function meta(name) {
          var el = document.querySelector('meta[name="' + name + '"]');
          return el ? el.getAttribute("content") : null;
        }

        function csrfToken() {
          return meta("csrf-token");
        }

        function shortText(value, limit) {
          return String(value == null ? "" : value).replace(/\s+/g, " ").slice(0, limit);
        }

        function sameOriginPath(value) {
          try {
            var url = new URL(value, window.location.href);
            return url.origin === window.location.origin ? url.pathname + url.search : "cross-origin";
          } catch (e) {
            return "unknown";
          }
        }

        function userAgentFamily() {
          var ua = navigator.userAgent || "";
          if (/CriOS/i.test(ua)) return "chrome_ios";
          if (/FxiOS/i.test(ua)) return "firefox_ios";
          if (/EdgiOS/i.test(ua)) return "edge_ios";
          if (/Safari/i.test(ua) && /Mobile|iPhone|iPad|iPod/i.test(ua)) return "mobile_safari";
          if (/Safari/i.test(ua)) return "safari";
          if (/Chrome|Chromium/i.test(ua)) return "chromium";
          if (/Firefox/i.test(ua)) return "firefox";
          return "unknown";
        }

        function standaloneContext() {
          var displayStandalone = false;
          try {
            displayStandalone = !!(window.matchMedia && window.matchMedia("(display-mode: standalone)").matches);
          } catch (e) {
            displayStandalone = false;
          }
          return {
            navigator_standalone: navigator.standalone === true,
            display_mode_standalone: displayStandalone
          };
        }

        function context(extra) {
          var standalone = standaloneContext();
          var base = {
            startup_elapsed_ms: Date.now() - startupAt,
            current_path: window.location.pathname + window.location.search,
            app_revision: meta("syrus-app-revision"),
            asset_revision: meta("syrus-asset-revision"),
            user_agent_family: userAgentFamily(),
            navigator_standalone: standalone.navigator_standalone,
            display_mode_standalone: standalone.display_mode_standalone,
            visibility_state: document.visibilityState || "unknown",
            milestones: milestones.slice(-20)
          };
          Object.keys(extra || {}).forEach(function (key) {
            base[key] = extra[key];
          });
          return base;
        }

        function shouldReportMilestone() {
          var standalone = standaloneContext();
          return standalone.navigator_standalone ||
            standalone.display_mode_standalone ||
            /(?:\?|&)startup_diagnostics=1(?:&|$)/.test(window.location.search);
        }

        function fingerprint(kind, detail) {
          return ["startup", kind, meta("syrus-app-revision") || "unknown", sameOriginPath(detail || window.location.href)].join(":").slice(0, 500);
        }

        function postJson(path, payload) {
          var token = csrfToken();
          var bodyPayload = { authenticity_token: token };
          var headers = {
            "Accept": "application/json",
            "Content-Type": "application/json"
          };
          Object.keys(payload || {}).forEach(function (key) {
            bodyPayload[key] = payload[key];
          });
          if (token) headers["X-CSRF-Token"] = token;
          fetch(path, {
            method: "POST",
            credentials: "same-origin",
            keepalive: true,
            headers: headers,
            body: JSON.stringify(bodyPayload)
          }).catch(function () {});
        }

        function startupStatus() {
          return document.getElementById("syrus-startup-status");
        }

        function applyStartupState(state) {
          var el = startupStatus();
          if (!el) return false;
          var title = el.querySelector("[data-syrus-startup-title]");
          var message = el.querySelector("[data-syrus-startup-message]");
          var spinner = el.querySelector("[data-syrus-startup-spinner]");
          var retry = el.querySelector("[data-syrus-startup-retry]");
          el.hidden = !!state.hidden;
          el.dataset.startupState = state.name || "";
          if (title && state.title) title.textContent = state.title;
          if (message && state.message) message.textContent = state.message;
          if (spinner) spinner.hidden = state.retry === true;
          if (retry) retry.hidden = state.retry !== true;
          return true;
        }

        function showStartupState(state) {
          pendingStartupState = state;
          if (!applyStartupState(state)) {
            document.addEventListener("DOMContentLoaded", function () {
              if (pendingStartupState) applyStartupState(pendingStartupState);
            }, { once: true });
          }
        }

        function hideStartupState() {
          showStartupState({ name: "ready", hidden: true });
        }

        function reportMilestone(milestone) {
          if (!shouldReportMilestone()) return;

          postJson("/api/v1/app/performance_events", {
            performance_event: {
              trace_id: "startup-" + startupAt + "-" + milestone,
              name: "startup." + milestone,
              path: window.location.pathname + window.location.search,
              duration_ms: Date.now() - startupAt,
              visibility_state: document.visibilityState || "unknown",
              metadata: context({ milestone: milestone })
            }
          });
        }

        function report(kind, message, extra) {
          var key = kind + ":" + (extra && extra.milestone ? extra.milestone : "") + ":" + (extra && extra.resource_url ? extra.resource_url : "");
          if (reportedKeys[key]) return;
          reportedKeys[key] = true;

          postJson("/api/v1/app/browser_errors", {
            browser_error: {
              occurred_at: new Date().toISOString(),
              app_revision: meta("syrus-app-revision"),
              fingerprint: fingerprint(kind, extra && extra.resource_url),
              name: kind,
              message: shortText(message, 500),
              url: window.location.href,
              path: window.location.pathname + window.location.search,
              user_agent: navigator.userAgent || "",
              viewport: {
                width: window.innerWidth,
                height: window.innerHeight,
                device_pixel_ratio: window.devicePixelRatio
              },
              feature_flags: {},
              recent_api_requests: [],
              recent_errors: [],
              metadata: context(extra || {})
            }
          });
        }

        function mark(milestone) {
          var entry = { name: milestone, at_ms: Date.now() - startupAt };
          milestones.push(entry);
          if (milestones.length > 20) milestones.shift();
          if (milestone === "react_first_render") {
            window.__syrusReactFirstRender = true;
            hideStartupState();
          }
          reportMilestone(milestone);
        }

        window.SyrusStartupDiagnostics = { mark: mark, report: report, context: context };
        mark("shell_loaded");

        window.addEventListener("error", function (event) {
          var target = event.target;
          var resourceUrl = target && (target.src || target.href);
          if (resourceUrl) {
            var tagName = target.tagName ? String(target.tagName).toLowerCase() : "resource";
            if (tagName === "script" || tagName === "link") {
              showStartupState({
                name: "resource_error",
                title: "The app could not load",
                message: "Check your connection, then retry.",
                retry: true
              });
              report("StartupResourceError", "SPA startup resource failed to load", {
                resource_tag: tagName,
                resource_url: sameOriginPath(resourceUrl)
              });
            }
            return;
          }

          report("StartupWindowError", event.message || "SPA startup window error", {
            source: sameOriginPath(event.filename || ""),
            line: event.lineno || null,
            column: event.colno || null,
            error_name: event.error && event.error.name ? shortText(event.error.name, 100) : null,
            stack: event.error && event.error.stack ? shortText(event.error.stack, 2000) : null
          });
        }, true);

        window.addEventListener("unhandledrejection", function (event) {
          var reason = event.reason;
          var isError = reason && typeof reason === "object" && ("message" in reason || "name" in reason);
          report("StartupUnhandledRejection", isError ? reason.message || "Unhandled startup rejection" : "Unhandled startup rejection", {
            error_name: isError && reason.name ? shortText(reason.name, 100) : typeof reason,
            stack: isError && reason.stack ? shortText(reason.stack, 2000) : null
          });
        });

        window.setTimeout(function () {
          if (window.__syrusReactFirstRender) return;
          var root = document.getElementById("syrus-spa-root");
          var rootBlank = !root || !root.textContent.trim();
          showStartupState({
            name: "watchdog",
            title: "Syrus is still loading",
            message: "This can happen on a slow connection. Retry if it does not finish soon.",
            retry: true
          });
          report("StartupWatchdog", rootBlank ? "SPA startup watchdog: root still blank" : "SPA startup watchdog: first render not marked", {
            root_present: !!root,
            root_blank: rootBlank
          });
        }, WATCHDOG_TIMEOUT_MS);
      })();
    </script>

    <%# ?v= matches BRAND_ICON_VERSION in app/frontend/lib/brandIcon.ts — public/
        files are served with a 1-year max-age, so rebranded icons need a new URL. %>
    <link rel="icon" href="/icon.png?v=2" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2">
    <link rel="manifest" href="/manifest.json">

    <style nonce="<%= content_security_policy_nonce %>">
      .syrus-startup-status {
        align-items: center;
        box-sizing: border-box;
        display: flex;
        min-height: 100vh;
        padding: 2rem;
      }

      .syrus-startup-status[hidden] {
        display: none;
      }

      .syrus-startup-status__panel {
        color: #1f2937;
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        margin: 0 auto;
        max-width: 28rem;
        text-align: center;
      }

      .syrus-startup-status__spinner {
        animation: syrus-startup-spin 0.9s linear infinite;
        border: 3px solid #e5e7eb;
        border-top-color: #b6492e;
        border-radius: 9999px;
        height: 2rem;
        margin: 0 auto 1rem;
        width: 2rem;
      }

      .syrus-startup-status__spinner[hidden] {
        display: none;
      }

      .syrus-startup-status__title {
        font-size: 1rem;
        font-weight: 700;
        margin: 0;
      }

      .syrus-startup-status__message {
        color: #4b5563;
        font-size: 0.875rem;
        line-height: 1.5;
        margin: 0.5rem 0 0;
      }

      .syrus-startup-status__retry {
        appearance: none;
        background: #b6492e;
        border: 0;
        border-radius: 0.375rem;
        color: white;
        cursor: pointer;
        font: inherit;
        font-size: 0.875rem;
        font-weight: 700;
        margin-top: 1rem;
        padding: 0.625rem 0.875rem;
      }

      .syrus-startup-status__retry[hidden] {
        display: none;
      }

      .syrus-startup-status__retry:focus-visible {
        outline: 3px solid rgba(182, 73, 46, 0.35);
        outline-offset: 2px;
      }

      @media (prefers-color-scheme: dark) {
        .syrus-startup-status__panel {
          color: #f9fafb;
        }

        .syrus-startup-status__message {
          color: #d1d5db;
        }

        .syrus-startup-status__spinner {
          border-color: #374151;
          border-top-color: #f0a078;
        }
      }

      @keyframes syrus-startup-spin {
        to {
          transform: rotate(360deg);
        }
      }
    </style>

    <%= spa_stylesheet_link_tags %>
    <% if Rails.env.test? %>
      <%= spa_asset_tag tag.script("", src: "/assets/spa-test.js", type: "module") %>
    <% elsif Rails.env.production? || Rails.application.assets.load_path.find("spa.js") %>
      <%= spa_javascript_include_tag "spa", type: "module" %>
    <% end %>
  </head>

  <body class="bg-gray-50 text-gray-900 dark:bg-gray-900 dark:text-white">
    <%= yield %>
  </body>
</html>
