<%= render "settings/nav" %>

<div class="max-w-xl">
  <h1 class="font-bold text-3xl">My credentials</h1>
  <p class="mt-2 text-sm text-gray-600">
    These are stored encrypted. Leaving a field blank keeps the existing value unchanged.
  </p>

  <%= form_with model: @user, url: credentials_path, scope: :user, method: :patch,
        class: "mt-6 space-y-5", data: { controller: "credentials-form" } do |form| %>
    <% claude_selected = @user.agent_provider == "claude" %>
    <% codex_selected = @user.agent_provider == "codex" %>
    <% codex_api_key_selected = codex_selected && @user.codex_auth_mode == "api_key" %>
    <% codex_auth_json_selected = codex_selected && @user.codex_auth_mode == "chatgpt_login" %>

    <div>
      <%= form.label :agent_provider, "Agent provider", class: "block text-sm font-medium text-gray-700" %>
      <p class="text-xs text-gray-500 mt-1">
        New jobs use this provider by default. Existing jobs keep their current provider until you pick another agent on that job.
      </p>
      <%= form.select :agent_provider,
            User::AGENT_PROVIDERS.map { |provider| [ provider.titleize, provider ] },
            { include_blank: "Select agent..." },
            class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full",
            data: {
              credentials_form_target: "agentProviderSelect",
              action: "credentials-form#agentProviderChanged"
            } %>
    </div>

    <div class="<%= "hidden" unless claude_selected %>" data-credentials-form-target="claudeSection">
      <%= form.label :claude_oauth_token, "Claude OAuth token", class: "block text-sm font-medium text-gray-700" %>
      <p class="text-xs text-gray-500 mt-1">
        From your Claude Pro/Max subscription. Run <code class="bg-gray-100 px-1 rounded">claude /login</code> locally,
        then copy the access token from <code class="bg-gray-100 px-1 rounded">~/.claude/.credentials.json</code>.
        Multiple auth methods (raw API key, etc.) are tracked in #13.
      </p>
      <% if @user.claude_oauth_token.present? %>
        <p class="text-xs text-gray-500 mt-1">Currently set. Submit a new value to replace.</p>
      <% else %>
        <p class="text-xs text-amber-600 mt-1">Not set.</p>
      <% end %>
      <%= form.password_field :claude_oauth_token, autocomplete: "off", placeholder: "oat-…",
            disabled: !claude_selected,
            class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="<%= "hidden" unless codex_selected %>" data-credentials-form-target="codexAuthModeSection">
      <%= form.label :codex_auth_mode, "Codex authentication", class: "block text-sm font-medium text-gray-700" %>
      <p class="text-xs text-gray-500 mt-1">
        API key uses API platform billing. ChatGPT login uses your Codex plan access by writing
        your Codex auth cache into Syrus's per-job Codex home.
      </p>
      <%= form.select :codex_auth_mode,
            [
              [ "API key", "api_key" ],
              [ "ChatGPT auth.json", "chatgpt_login" ]
            ],
            {},
            disabled: !codex_selected,
            class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full",
            data: {
              credentials_form_target: "codexAuthModeSelect",
              action: "credentials-form#codexAuthModeChanged"
            } %>
    </div>

    <div class="<%= "hidden" unless codex_api_key_selected %>" data-credentials-form-target="codexApiKeySection">
      <%= form.label :codex_api_key, "Codex API key", class: "block text-sm font-medium text-gray-700" %>
      <p class="text-xs text-gray-500 mt-1">
        Used as <code class="bg-gray-100 px-1 rounded">CODEX_API_KEY</code> for API-billed
        <code class="bg-gray-100 px-1 rounded">codex exec</code> runs.
      </p>
      <% if @user.codex_api_key.present? %>
        <p class="text-xs text-gray-500 mt-1">Currently set. Submit a new value to replace.</p>
      <% else %>
        <p class="text-xs text-amber-600 mt-1">Not set.</p>
      <% end %>
      <%= form.password_field :codex_api_key, autocomplete: "off", placeholder: "sk-…",
            disabled: !codex_api_key_selected,
            class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="<%= "hidden" unless codex_auth_json_selected %>" data-credentials-form-target="codexAuthJsonSection">
      <%= form.label :codex_auth_json, "Codex ChatGPT auth.json", class: "block text-sm font-medium text-gray-700" %>
      <p class="text-xs text-gray-500 mt-1">
        Used only when Codex authentication is set to ChatGPT auth.json. Paste the full contents of
        <code class="bg-gray-100 px-1 rounded">~/.codex/auth.json</code>; it contains refreshable
        ChatGPT credentials and is stored encrypted.
      </p>
      <% if @user.codex_auth_json.present? %>
        <p class="text-xs text-gray-500 mt-1">Currently set. Submit a new value to replace.</p>
      <% else %>
        <p class="text-xs text-amber-600 mt-1">Not set.</p>
      <% end %>
      <%= form.text_area :codex_auth_json, value: "", rows: 6, autocomplete: "off", spellcheck: false,
            disabled: !codex_auth_json_selected,
            placeholder: '{ "auth_mode": "chatgpt", "tokens": { ... } }',
            class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full font-mono text-xs" %>
    </div>

    <div>
      <%= form.label :github_token, "GitHub token", class: "block text-sm font-medium text-gray-700" %>
      <% if @user.github_token.present? %>
        <p class="text-xs text-gray-500 mt-1">Currently set. Submit a new value to replace.</p>
      <% else %>
        <p class="text-xs text-amber-600 mt-1">Not set.</p>
      <% end %>
      <% if @user.gh_rate_limit_observed_at %>
        <p class="text-xs text-gray-500 mt-1">
          GitHub API quota: <strong><%= number_with_delimiter(@user.gh_rate_limit_remaining) %></strong> /
          <%= number_with_delimiter(@user.gh_rate_limit_limit) %> remaining
          (<%= @user.gh_rate_limit_resource || "core" %> bucket) ·
          resets <%= relative_timestamp(@user.gh_rate_limit_reset_at) %> ·
          observed <%= relative_timestamp(@user.gh_rate_limit_observed_at) %>
        </p>
      <% else %>
        <p class="text-xs text-gray-400 mt-1">Quota not yet recorded — will appear after the first API call.</p>
      <% end %>
      <%= form.password_field :github_token, autocomplete: "off", placeholder: "ghp_…",
            class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="pt-4 border-t border-gray-200">
      <h2 class="font-medium text-gray-900">Agent preferences</h2>
      <p class="mt-1 text-xs text-gray-500">
        Tunes how Syrus invokes the selected agent on your runs.
      </p>
    </div>

    <div>
      <%= form.label :agent_max_turns, "Max turns", class: "block text-sm font-medium text-gray-700" %>
      <p class="text-xs text-gray-500 mt-1">
        Caps how many tool-use turns the agent gets before a run terminates with
        <code class="bg-gray-100 px-1 rounded">error_max_turns</code>. Non-trivial issues
        routinely take 100+ turns; the default 200 is a reasonable ceiling.
        <strong>Set to 0 to disable the cap entirely</strong> — the per-run timeout
        still bounds the agent, so a genuinely-stuck run can't run forever.
        Range <%= User::AGENT_MAX_TURNS_RANGE.first %>–<%= User::AGENT_MAX_TURNS_RANGE.last %>.
      </p>
      <%= form.number_field :agent_max_turns,
            min: User::AGENT_MAX_TURNS_RANGE.first, max: User::AGENT_MAX_TURNS_RANGE.last,
            class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div>
      <div class="flex items-start gap-3">
        <%= form.check_box :scheduling_paused, class: "mt-1 rounded border-gray-400" %>
        <div>
          <%= form.label :scheduling_paused, "Pause scheduling", class: "block text-sm font-medium text-gray-700" %>
          <p class="text-xs text-gray-500 mt-1">
            When enabled, none of your scheduled tasks will fire automatically.
            Existing tasks keep their state — uncheck to resume on the next minute tick.
          </p>
        </div>
      </div>
    </div>

    <%= form.submit "Save", class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
  <% end %>

  <% if @user.admin? %>
    <div class="mt-10 pt-6 border-t border-gray-200">
      <h2 class="font-medium text-gray-900">API token (admin)</h2>
      <p class="mt-1 text-xs text-gray-500">
        Authenticates calls to the <code class="bg-gray-100 px-1 rounded">/api/v1/admin/*</code>
        REST endpoints used by external scripts and the Claude debug skill.
        Pass as <code class="bg-gray-100 px-1 rounded">Authorization: Bearer &lt;token&gt;</code>.
        Stored encrypted; the plaintext is shown to you ONCE on rotation —
        copy it then or rotate again.
      </p>

      <% if @new_api_token %>
        <div class="mt-3 p-3 bg-emerald-50 border border-emerald-200 rounded">
          <div class="text-xs uppercase text-emerald-700 font-medium">New token (copy now)</div>
          <code class="mt-1 block font-mono text-sm break-all"><%= @new_api_token %></code>
        </div>
      <% elsif @user.api_token.present? %>
        <p class="mt-3 text-xs text-gray-500">A token is set. Rotate to issue a fresh one (the old one is invalidated immediately).</p>
      <% else %>
        <p class="mt-3 text-xs text-amber-600">No token issued yet.</p>
      <% end %>

      <div class="mt-3 flex gap-2">
        <%= button_to (@user.api_token.present? ? "Rotate token" : "Generate token"),
              rotate_api_token_credentials_path, method: :post,
              class: "rounded-md px-3 py-1.5 bg-gray-200 hover:bg-gray-300 text-gray-800 text-sm font-medium cursor-pointer",
              form: { data: { turbo_confirm: @user.api_token.present? ? "Rotate the API token? Existing scripts using the old token will stop working immediately." : nil } } %>
        <% if @user.api_token.present? %>
          <%= button_to "Revoke", revoke_api_token_credentials_path, method: :delete,
                class: "rounded-md px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-700 text-sm font-medium cursor-pointer",
                form: { data: { turbo_confirm: "Revoke the API token? All API calls using it will start returning 401." } } %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
