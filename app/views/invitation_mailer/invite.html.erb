<p>
  <%= @inviter.display_name %> invited you to join Syrus.
</p>

<p>
  Accept the invitation on
  <%= link_to "this signup page", new_user_url(token: @invitation.token) %>.
</p>

<% if @invitation.expires_at.present? %>
  <p>
    This invitation expires on <%= l(@invitation.expires_at, format: :long) %>.
  </p>
<% end %>
