<p>
  <%= t(".invited", inviter: @inviter.display_name) %>
</p>

<p>
  <%= t(".accept_intro") %>
  <%= link_to t(".accept_link"), new_user_url(token: @invitation.token) %>.
</p>

<% if @invitation.expires_at.present? %>
  <p>
    <%= t(".expires", date: l(@invitation.expires_at, format: :long)) %>
  </p>
<% end %>
