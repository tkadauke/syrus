<div class="space-y-6">
  <div class="flex items-start justify-between gap-3">
    <div>
      <h1 class="font-bold text-2xl">GitHub App registered</h1>
      <p class="text-sm text-gray-500 mt-1">
        Syrus stored the App credentials and queued an installation sync.
      </p>
    </div>
    <%= render "admin/nav" %>
  </div>

  <section class="bg-white border border-gray-200 rounded-lg p-4">
    <h2 class="font-medium text-gray-900">Next steps</h2>
    <ol class="list-decimal pl-5 mt-2 text-sm text-gray-700 space-y-1">
      <li>Install the App on your repositories via GitHub.</li>
      <li>Wait for the installation sync, or let the 5-minute recurring sync pick it up.</li>
      <li>Continue using personal access token behavior until Phase 2 routes GitHub calls through the App.</li>
    </ol>
  </section>

  <section class="bg-white border border-gray-200 rounded-lg p-4">
    <h2 class="font-medium text-gray-900">Stored registration</h2>
    <p class="text-sm text-gray-600 mt-2">
      <span class="font-mono"><%= @settings.github_app_slug.presence || "app-#{@settings.github_app_id}" %></span>
      registered <%= relative_timestamp(@settings.github_app_registered_at) if @settings.github_app_registered_at %>.
    </p>
  </section>
</div>
