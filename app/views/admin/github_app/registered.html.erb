<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title><%= t("github_app.registered.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <style>
      body { font-family: ui-sans-serif, system-ui, sans-serif; background: #f9fafb; color: #111827; margin: 0; display: flex; min-height: 100vh; align-items: center; justify-content: center; }
      .card { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 2rem 2.5rem; max-width: 22rem; text-align: center; box-shadow: 0 10px 25px rgba(0,0,0,.06); }
      .check { color: #047857; font-size: 2rem; }
      h1 { font-size: 1.05rem; margin: .25rem 0 .5rem; }
      p { font-size: .9rem; color: #4b5563; margin: 0; }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="check">✓</div>
      <h1><%= t("github_app.registered.heading") %></h1>
      <p><%= t("github_app.registered.body") %></p>
    </div>
    <script>
      // Best effort: this tab was opened by the setup flow, so try to close it.
      // Browsers may block closing tabs they didn't script-open; the message
      // above covers that case.
      setTimeout(function () { try { window.close(); } catch (e) {} }, 800);
    </script>
  </body>
</html>
