<%# Currently-claimed jobs (i.e. some worker thread is executing
    them right now). Empty list is the healthy steady state for
    short jobs; long entries with old claimed_at are the suspect. %>
<%= render "filters" %>

<% if @active.any? %>
  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50 text-xs uppercase text-gray-500">
        <tr>
          <th class="px-4 py-2 text-left">SQ id</th>
          <th class="px-4 py-2 text-left">Class</th>
          <th class="px-4 py-2 text-left">Queue</th>
          <th class="px-4 py-2 text-left">Args</th>
          <th class="px-4 py-2 text-left">Claimed</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @active.each do |sq| %>
          <tr>
            <td class="px-4 py-2 font-mono text-xs"><%= sq.id %></td>
            <td class="px-4 py-2 font-mono"><%= sq.class_name %></td>
            <td class="px-4 py-2"><%= sq.queue_name %></td>
            <td class="px-4 py-2 font-mono text-xs text-gray-600"><%= sq.arguments&.dig("arguments")&.inspect.to_s[0, 200] %></td>
            <td class="px-4 py-2 text-gray-500 text-xs">
              <%= relative_timestamp(sq.claimed_execution&.created_at) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="bg-white border border-gray-200 rounded-lg p-6 text-sm text-gray-500">
    No actively claimed jobs.
  </div>
<% end %>
