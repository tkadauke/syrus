<%# Recently failed executions, with the exception class + first
    line of message exposed inline. ProcessPrunedError entries are
    the post-deploy / post-OOM zombies that ReapStaleRunsJob keys
    off; surfacing them here means we can spot a crashed worker
    immediately. %>
<%= render "filters" %>

<% if @failed.any? %>
  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50 text-xs uppercase text-gray-500">
        <tr>
          <th class="px-4 py-2 text-left">When</th>
          <th class="px-4 py-2 text-left">Class</th>
          <th class="px-4 py-2 text-left">Exception</th>
          <th class="px-4 py-2 text-left">Message</th>
          <th class="px-4 py-2 text-left">Args</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @failed.each do |fe| %>
          <% err = fe.error || {} %>
          <tr>
            <td class="px-4 py-2 text-gray-500 text-xs whitespace-nowrap"><%= relative_timestamp(fe.created_at) %></td>
            <td class="px-4 py-2 font-mono text-xs"><%= fe.job&.class_name %></td>
            <td class="px-4 py-2 font-mono text-xs text-red-700"><%= err["exception_class"] %></td>
            <td class="px-4 py-2 text-xs text-gray-700"><%= err["message"].to_s[0, 200] %></td>
            <td class="px-4 py-2 font-mono text-xs text-gray-500"><%= fe.job&.arguments&.dig("arguments")&.inspect.to_s[0, 100] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="bg-white border border-gray-200 rounded-lg p-6 text-sm text-gray-500">
    No failures in window.
  </div>
<% end %>
