<%# Auto-refresh on a timer — see auto_refresh_controller.js.
    The morph-mode layout (turbo_refreshes_with method: :morph)
    keeps expanded details + scroll position across the visit. %>
<div class="space-y-6"
     data-controller="auto-refresh"
     data-auto-refresh-interval-value="<%= @poll_interval %>">

  <div class="flex items-center justify-between gap-3">
    <h1 class="font-bold text-2xl">Admin overview</h1>
    <div class="flex items-center gap-3">
      <%# Auto-refresh meta (desktop only — mobile leans on the
          rendered values themselves to communicate freshness). %>
      <div class="hidden sm:flex text-xs text-gray-500 items-center gap-2">
        <span>Auto-refresh every <%= @poll_interval %>s</span>
        <span class="text-gray-300">·</span>
        <a href="#" data-action="click->auto-refresh#refreshNow" class="text-blue-600 underline hover:no-underline">Refresh now</a>
      </div>
      <%= render "admin/nav" %>
    </div>
  </div>

  <% settings = AppSetting.current %>
  <% if settings.polling_paused || settings.runs_paused %>
    <div class="bg-amber-50 border border-amber-200 rounded-lg p-3 text-sm text-amber-800 flex items-center justify-between">
      <span>
        <strong>Pause active.</strong>
        <% paused_bits = [] %>
        <% paused_bits << "polling" if settings.polling_paused %>
        <% paused_bits << "RunJobs" if settings.runs_paused %>
        <%= paused_bits.to_sentence %> currently paused via the operator console.
      </span>
      <%= link_to "Manage →", admin_console_path, class: "text-amber-700 underline hover:no-underline" %>
    </div>
  <% end %>

  <%# Tile grid %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
    <%= render "tile",
          title: "Active runs",
          value: @active_runs_total,
          context: @active_runs_by_trigger.map { |k, v| "#{v} #{k}" }.join(" · ").presence || "all idle",
          status: @active_runs_total > 0 ? :info : :idle,
          link: admin_queue_path("active") %>

    <%= render "tile",
          title: "Queued runs",
          value: @queued_runs_total,
          context: @queued_runs_total > 0 ? "waiting for a worker thread" : "queue empty",
          status: @queued_runs_total > 10 ? :warn : (@queued_runs_total > 0 ? :info : :idle),
          link: admin_queue_path("pending") %>

    <% if @workers_unreachable %>
      <%= render "tile",
            title: "Workers",
            value: "?",
            context: "queue tables unreachable from web pod",
            status: :warn,
            link: admin_queue_path("workers") %>
    <% else %>
      <%= render "tile",
            title: "Workers",
            value: @workers_total,
            context: @workers_stale > 0 ? "#{@workers_stale} stale heartbeat(s)" : "all healthy",
            status: @workers_stale > 0 ? :alarm : (@workers_total.zero? ? :alarm : :ok),
            link: admin_queue_path("workers") %>
    <% end %>

    <%= render "tile",
          title: "Recurring jobs",
          value: @recurring_overdue.size,
          context: @recurring_overdue.any? ? "overdue: #{@recurring_overdue.map { |t| t[:key] }.join(', ')}" : "all firing on schedule",
          status: @recurring_overdue.any? ? :alarm : :ok,
          link: admin_queue_path("recurring") %>

    <%= render "tile",
          title: "Failed runs (24h)",
          value: @recent_failures_24h,
          context: @recent_failures_by_kind.map { |k, v| "#{v} #{k}" }.join(" · ").presence || "no failures",
          status: @recent_failures_24h > 5 ? :alarm : (@recent_failures_24h > 0 ? :warn : :ok),
          link: admin_queue_path("failed") %>

    <%= render "tile",
          title: "GitHub rate limits",
          value: @gh_low_users.size,
          context: @gh_low_users.any? ? "low: #{@gh_low_users.map(&:email_address).join(', ')}" : "all users healthy",
          status: @gh_low_users.any? ? :warn : :ok,
          link: admin_users_path(gh_rate: "low") %>

    <% if @capture_rate.nil? %>
      <%= render "tile",
            title: "Agent session capture",
            value: "—",
            context: "no agentic runs in last 24h",
            status: :idle %>
    <% else %>
      <%= render "tile",
            title: "Agent session capture",
            value: "#{(@capture_rate * 100).round}%",
            context: "#{@capture_with_session} of #{@capture_total} agentic runs (24h)",
            status: @capture_rate >= 0.95 ? :ok : (@capture_rate >= 0.80 ? :warn : :alarm) %>
    <% end %>

    <% any_alarm = @stuck.any? { |s| s.severity == :alarm } %>
    <%= render "tile",
          title: "Stuck things",
          value: @stuck.size,
          context: @stuck.any? ? (any_alarm ? "includes alarm-level" : "concerning, not yet dead") : "nothing flagged",
          status: any_alarm ? :alarm : (@stuck.any? ? :warn : :ok),
          link: admin_stuck_path %>
  </div>

  <% if @stuck.any? %>
    <% border_class = any_alarm ? "border-red-200" : "border-amber-200" %>
    <% header_bg    = any_alarm ? "bg-red-50 text-red-700" : "bg-amber-50 text-amber-700" %>
    <div class="bg-white border <%= border_class %> rounded-lg overflow-hidden">
      <div class="px-4 py-2 <%= header_bg %> text-xs uppercase font-medium flex items-center justify-between">
        <span>Stuck things</span>
        <%= link_to "Open full list →", admin_stuck_path, class: "text-blue-600 hover:underline normal-case text-xs" %>
      </div>
      <ul class="divide-y divide-gray-100">
        <% @stuck.each do |item| %>
          <% sev_class = item.severity == :alarm ? "bg-red-100 text-red-700" : "bg-amber-100 text-amber-700" %>
          <li class="px-4 py-2 text-sm flex items-center justify-between gap-3">
            <span class="flex items-center gap-2">
              <span class="<%= sev_class %> font-mono text-xs px-1.5 py-0.5 rounded"><%= item.kind %></span>
              <span class="text-gray-700"><%= item.detail %></span>
            </span>
            <% if item.job %>
              <%= link_to "View job", job_path(item.job), class: "text-blue-600 underline hover:no-underline text-xs flex-shrink-0" %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>
