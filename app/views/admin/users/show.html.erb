<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="font-bold text-2xl"><%= @user.display_name %></h1>
      <div class="text-xs text-gray-500 mt-1">
        <%= @user.email_address %> ·
        Created <%= @user.created_at.strftime("%Y-%m-%d") %>
        <% if @user.admin? %>
          <span class="ml-2 px-2 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-700">admin</span>
        <% end %>
      </div>
    </div>
    <%= render "admin/nav" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <%# Identity & access %>
    <div class="bg-white border border-gray-200 rounded-lg p-4">
      <h2 class="font-semibold text-sm uppercase text-gray-500 mb-3">Identity & access</h2>
      <dl class="text-sm space-y-2">
        <div class="flex justify-between gap-4">
          <dt class="text-gray-600">Display name</dt>
          <dd class="text-right"><%= @user.name.presence || "—" %></dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-gray-600">Email</dt>
          <dd class="text-right"><%= @user.email_address %></dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-gray-600">GitHub handle</dt>
          <dd class="text-right"><%= @user.github_handle.present? ? "@#{@user.github_handle}" : "—" %></dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-gray-600">Admin</dt>
          <dd class="text-right"><%= @user.admin? ? "yes" : "no" %></dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-gray-600">GitHub API blocked</dt>
          <dd class="text-right"><%= @user.gh_api_blocked? ? "yes" : "no" %></dd>
        </div>
        <% if @user.gh_api_blocked? %>
          <div class="flex justify-between gap-4">
            <dt class="text-gray-600">Blocked at</dt>
            <dd class="text-right"><%= @user.gh_api_blocked_at.strftime("%Y-%m-%d %H:%M %Z") %></dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-gray-600">Blocked reason</dt>
            <dd class="text-right"><%= @user.gh_api_blocked_reason.presence || "—" %></dd>
          </div>
        <% end %>
        <div class="flex justify-between gap-4">
          <dt class="text-gray-600">Created</dt>
          <dd class="text-right"><%= @user.created_at.strftime("%Y-%m-%d %H:%M %Z") %></dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-gray-600">Updated</dt>
          <dd class="text-right"><%= @user.updated_at.strftime("%Y-%m-%d %H:%M %Z") %></dd>
        </div>
      </dl>
    </div>

    <%# Tokens & settings %>
    <div class="bg-white border border-gray-200 rounded-lg p-4">
      <h2 class="font-semibold text-sm uppercase text-gray-500 mb-3">Tokens & settings</h2>
      <dl class="text-sm space-y-2">
        <div class="flex justify-between">
          <dt class="text-gray-600">GitHub token</dt>
          <dd><%= @user.github_token.present? ? "✓ set" : "—" %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-gray-600">Claude OAuth token</dt>
          <dd><%= @user.claude_oauth_token.present? ? "✓ set" : "—" %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-gray-600">Codex API key</dt>
          <dd><%= @user.codex_api_key.present? ? "✓ set" : "—" %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-gray-600">Codex auth.json</dt>
          <dd><%= @user.codex_auth_json.present? ? "✓ set" : "—" %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-gray-600">Codex auth mode</dt>
          <dd><%= @user.codex_auth_mode %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-gray-600">API token</dt>
          <dd><%= @user.api_token.present? ? "✓ set" : "—" %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-gray-600">Agent provider</dt>
          <dd><%= @user.agent_provider %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-gray-600">Agent max turns</dt>
          <dd><%= @user.agent_max_turns %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-gray-600">Scheduling paused</dt>
          <dd><%= @user.scheduling_paused? ? "yes" : "no" %></dd>
        </div>
      </dl>
    </div>

    <%# GitHub rate limits %>
    <div class="bg-white border border-gray-200 rounded-lg p-4">
      <h2 class="font-semibold text-sm uppercase text-gray-500 mb-3">GitHub rate limit</h2>
      <% if @user.gh_rate_limit_remaining.nil? %>
        <div class="text-sm text-gray-500">No GH rate-limit data observed yet.</div>
      <% else %>
        <% pct = @user.gh_rate_limit_limit.to_i > 0 ? @user.gh_rate_limit_remaining.to_f / @user.gh_rate_limit_limit : nil %>
        <dl class="text-sm space-y-2">
          <div class="flex justify-between">
            <dt class="text-gray-600">Remaining</dt>
            <dd class="<%= pct && pct < 0.10 ? 'text-red-600 font-semibold' : '' %>">
              <%= @user.gh_rate_limit_remaining %> / <%= @user.gh_rate_limit_limit %>
              <% if pct %>(<%= (pct * 100).round %>%)<% end %>
            </dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-gray-600">Resource</dt>
            <dd><%= @user.gh_rate_limit_resource || "—" %></dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-gray-600">Resets at</dt>
            <dd><%= @user.gh_rate_limit_reset_at&.strftime("%Y-%m-%d %H:%M %Z") || "—" %></dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-gray-600">Observed at</dt>
            <dd><%= @user.gh_rate_limit_observed_at&.strftime("%Y-%m-%d %H:%M %Z") || "—" %></dd>
          </div>
        </dl>
      <% end %>
    </div>
  </div>

  <%# Scheduling control %>
  <div class="bg-white border border-gray-200 rounded-lg p-4">
    <h2 class="font-semibold text-sm uppercase text-gray-500 mb-3">Scheduling</h2>
    <div class="flex items-center gap-4">
      <span class="text-sm text-gray-600">
        Status: <strong><%= @user.scheduling_paused? ? "paused" : "active" %></strong>
      </span>
      <% if @user.scheduling_paused? %>
        <%= button_to "Resume scheduling", unpause_scheduling_admin_user_path(@user),
              class: "px-3 py-1.5 rounded-md bg-green-600 hover:bg-green-500 text-white text-sm font-medium" %>
      <% else %>
        <%= button_to "Pause scheduling", pause_scheduling_admin_user_path(@user),
              class: "px-3 py-1.5 rounded-md bg-amber-600 hover:bg-amber-500 text-white text-sm font-medium" %>
      <% end %>
    </div>
  </div>

  <%# Recent jobs %>
  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <div class="px-4 py-2 border-b border-gray-200 text-sm font-semibold text-gray-700">Recent jobs (10)</div>
    <% if @recent_jobs.empty? %>
      <div class="px-4 py-6 text-center text-gray-500 text-sm">No jobs yet.</div>
    <% else %>
      <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-gray-50 text-xs uppercase text-gray-500">
          <tr>
            <th class="px-4 py-2 text-left">Job</th>
            <th class="px-4 py-2 text-left">State</th>
            <th class="px-4 py-2 text-left">Kind</th>
            <th class="px-4 py-2 text-left">Created</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @recent_jobs.each do |job| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-2"><%= link_to "##{job.id}", job_path(job), class: "text-blue-600 hover:underline" %></td>
              <td class="px-4 py-2"><%= job.state %></td>
              <td class="px-4 py-2"><%= job.kind %></td>
              <td class="px-4 py-2 text-gray-500"><%= job.created_at.strftime("%Y-%m-%d %H:%M") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>

  <%# Recent runs %>
  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <div class="px-4 py-2 border-b border-gray-200 text-sm font-semibold text-gray-700">Recent runs (10)</div>
    <% if @recent_runs.empty? %>
      <div class="px-4 py-6 text-center text-gray-500 text-sm">No runs yet.</div>
    <% else %>
      <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-gray-50 text-xs uppercase text-gray-500">
          <tr>
            <th class="px-4 py-2 text-left">Run</th>
            <th class="px-4 py-2 text-left">State</th>
            <th class="px-4 py-2 text-left">Trigger</th>
            <th class="px-4 py-2 text-left">Started</th>
            <th class="px-4 py-2 text-left">Finished</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @recent_runs.each do |run| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-2">
                <%= link_to "##{run.id}", job_path(run.job_id, anchor: "run-#{run.id}"), class: "text-blue-600 hover:underline" %>
              </td>
              <td class="px-4 py-2"><%= run.state %></td>
              <td class="px-4 py-2"><%= run.trigger_kind %></td>
              <td class="px-4 py-2 text-gray-500"><%= run.started_at&.strftime("%H:%M:%S") || "—" %></td>
              <td class="px-4 py-2 text-gray-500"><%= run.finished_at&.strftime("%H:%M:%S") || "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>

  <%# Admin actions authored — only meaningful for admins, but
      shown unconditionally; non-admins will just have an empty list. %>
  <% if @recent_admin_actions.any? %>
    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
      <div class="px-4 py-2 border-b border-gray-200 text-sm font-semibold text-gray-700">Recent admin actions (10)</div>
      <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-gray-50 text-xs uppercase text-gray-500">
          <tr>
            <th class="px-4 py-2 text-left">Action</th>
            <th class="px-4 py-2 text-left">When</th>
            <th class="px-4 py-2 text-left">Params</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @recent_admin_actions.each do |action| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-2 font-mono text-xs"><%= action.action %></td>
              <td class="px-4 py-2 text-gray-500"><%= action.performed_at.strftime("%Y-%m-%d %H:%M") %></td>
              <td class="px-4 py-2 text-gray-500 font-mono text-xs"><%= action.params.presence || "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
