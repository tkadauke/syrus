<div class="space-y-8">
  <div class="flex items-start justify-between gap-3">
    <div>
      <h1 class="font-bold text-2xl">Operator console</h1>
      <p class="text-sm text-gray-500 mt-1">
        Runtime kill switches. Each action is logged to
        <span class="font-mono">admin_actions</span> with the operator's id, the
        action, and any params.
      </p>
    </div>
    <%= render "admin/nav" %>
  </div>

  <%# Polling pause %>
  <section class="bg-white border border-gray-200 rounded-lg p-4">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 class="font-medium text-gray-900">Polling</h2>
        <p class="text-xs text-gray-600 mt-1 max-w-prose">
          Stops the recurring fan-out jobs (PollAllRepositories,
          PollAllPullRequests, PollAllMergeStates, PollScheduledTasks)
          from enqueueing per-Job pollers. The recurring scheduler
          still ticks; the body just no-ops. Per-Job manual
          "Poll now" buttons still work.
        </p>
        <p class="text-xs mt-2">
          State:
          <% if @settings.polling_paused %>
            <span class="bg-amber-100 text-amber-700 px-2 py-0.5 rounded font-mono uppercase">paused</span>
          <% else %>
            <span class="bg-emerald-100 text-emerald-700 px-2 py-0.5 rounded font-mono uppercase">running</span>
          <% end %>
        </p>
      </div>
      <div>
        <% if @settings.polling_paused %>
          <%= button_to "Resume polling", admin_unpause_polling_path, method: :post,
                class: "rounded-md px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium cursor-pointer",
                form: { class: "inline" } %>
        <% else %>
          <%= button_to "Pause polling", admin_pause_polling_path, method: :post,
                class: "rounded-md px-3 py-1.5 bg-amber-600 hover:bg-amber-500 text-white text-sm font-medium cursor-pointer",
                form: { class: "inline", data: { turbo_confirm: "Stop ingesting new issues / PR feedback / rebase checks / scheduled tasks until resumed?" } } %>
        <% end %>
      </div>
    </div>
  </section>

  <%# Runs pause %>
  <section class="bg-white border border-gray-200 rounded-lg p-4">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 class="font-medium text-gray-900">RunJobs</h2>
        <p class="text-xs text-gray-600 mt-1 max-w-prose">
          Pre-flight check on RunJob#perform: when paused, attempts
          re-enqueue themselves with a 30-second delay instead of
          starting work. Already-running Runs continue to completion
          (or worker death). New Runs created by polling /
          chain-advancement / Resume / Retry queue normally; they
          just defer at perform time.
        </p>
        <p class="text-xs mt-2">
          State:
          <% if @settings.runs_paused %>
            <span class="bg-amber-100 text-amber-700 px-2 py-0.5 rounded font-mono uppercase">paused</span>
          <% else %>
            <span class="bg-emerald-100 text-emerald-700 px-2 py-0.5 rounded font-mono uppercase">running</span>
          <% end %>
        </p>
      </div>
      <div>
        <% if @settings.runs_paused %>
          <%= button_to "Resume runs", admin_unpause_runs_path, method: :post,
                class: "rounded-md px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium cursor-pointer",
                form: { class: "inline" } %>
        <% else %>
          <%= button_to "Pause runs", admin_pause_runs_path, method: :post,
                class: "rounded-md px-3 py-1.5 bg-amber-600 hover:bg-amber-500 text-white text-sm font-medium cursor-pointer",
                form: { class: "inline", data: { turbo_confirm: "Block new agent invocations system-wide until resumed?" } } %>
        <% end %>
      </div>
    </div>
  </section>

  <%# Reap stale runs (lives in queue inspector but mirrored here) %>
  <section class="bg-white border border-gray-200 rounded-lg p-4">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 class="font-medium text-gray-900">Reap stale Runs now</h2>
        <p class="text-xs text-gray-600 mt-1 max-w-prose">
          Inline-runs ReapStaleRunsJob — same code path the recurring
          reaper takes every minute. Use when the reaper itself is
          starved (queue saturation, dead worker pod) and you need to
          mark zombie Runs failed immediately so retries can proceed.
        </p>
      </div>
      <div>
        <%= button_to "Reap now", admin_reap_stale_runs_path, method: :post,
              class: "rounded-md px-3 py-1.5 bg-red-600 hover:bg-red-500 text-white text-sm font-medium cursor-pointer",
              form: { class: "inline" } %>
      </div>
    </div>
  </section>

  <%# GH cache clear %>
  <section class="bg-white border border-gray-200 rounded-lg p-4">
    <div>
      <h2 class="font-medium text-gray-900">GitHub HTTP cache</h2>
      <p class="text-xs text-gray-600 mt-1 max-w-prose">
        Drops the per-user faraday-http-cache entries used by GithubClient.
        Use when conditional-GET 304s are serving stale data despite ETag
        invalidation (e.g. mergeability stuck on a previous value;
        symptoms similar to the canonical "Check now" workaround).
      </p>
    </div>
    <div class="mt-3">
      <%# Stack the select + submit on mobile so the button doesn't
          clip off the right edge on narrow viewports; back to a
          row at the `sm` breakpoint where there's space. %>
      <%= form_with url: admin_clear_github_cache_path, method: :post, local: true,
                    class: "flex flex-col sm:flex-row sm:items-center gap-2" do |f| %>
        <%= f.select :user_id,
              [ [ "All users", "" ] ] + @users.map { |u| [ u.email_address, u.id ] },
              {},
              class: "text-sm border border-gray-300 rounded-md px-2 py-1.5 bg-white text-gray-700 w-full sm:w-auto" %>
        <%= f.submit "Clear cache",
              class: "rounded-md px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium cursor-pointer w-full sm:w-auto",
              data: { turbo_confirm: "Drop the GitHub HTTP cache for the selected scope?" } %>
      <% end %>
    </div>
  </section>

  <%# Audit log %>
  <section class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <div class="px-4 py-2 bg-gray-50 text-xs uppercase text-gray-500 font-medium">Recent admin actions</div>
    <% if @recent_actions.any? %>
      <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-gray-50 text-xs uppercase text-gray-500">
          <tr>
            <th class="px-4 py-2 text-left">When</th>
            <th class="px-4 py-2 text-left">Operator</th>
            <th class="px-4 py-2 text-left">Action</th>
            <th class="px-4 py-2 text-left">Params</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @recent_actions.each do |action| %>
            <tr>
              <td class="px-4 py-2 text-xs text-gray-600 whitespace-nowrap"><%= relative_timestamp(action.performed_at) %></td>
              <td class="px-4 py-2 text-xs text-gray-700"><%= action.user&.email_address || "—" %></td>
              <td class="px-4 py-2 font-mono text-xs"><%= action.action %></td>
              <td class="px-4 py-2 font-mono text-xs text-gray-500"><%= action.params.to_json[0, 200] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="px-4 py-3 text-sm text-gray-500">No admin actions logged yet.</p>
    <% end %>
  </section>
</div>
