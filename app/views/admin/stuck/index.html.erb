<div class="space-y-6"
     data-controller="auto-refresh"
     data-auto-refresh-interval-value="<%= @poll_interval %>">

  <div class="flex items-start justify-between gap-3">
    <div>
      <h1 class="font-bold text-2xl">Stuck things</h1>
      <p class="text-sm text-gray-500 mt-1">
        Runs whose heartbeat has gone silent past the admin warn threshold (5 min)
        and workflows whose disk workspace is about to be pruned. Source:
        <span class="font-mono">Admin::StuckItems</span>.
      </p>
    </div>
    <div class="flex items-center gap-3">
      <div class="hidden sm:flex text-xs text-gray-500 items-center gap-2">
        <span>Auto-refresh every <%= @poll_interval %>s</span>
        <span class="text-gray-300">·</span>
        <a href="#" data-action="click->auto-refresh#refreshNow" class="text-blue-600 underline hover:no-underline">Refresh now</a>
      </div>
      <%= render "admin/nav" %>
    </div>
  </div>

  <% if @items.empty? %>
    <div class="bg-emerald-50 border border-emerald-200 rounded-lg p-6 text-emerald-800">
      Nothing stuck. Reaper, pruner, and worker pool are all
      keeping up.
    </div>
  <% else %>
    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-gray-50 text-xs uppercase text-gray-500">
          <tr>
            <th class="px-4 py-2 text-left">Severity</th>
            <th class="px-4 py-2 text-left">Kind</th>
            <th class="px-4 py-2 text-left">Detail</th>
            <th class="px-4 py-2 text-left">Run / Step / Workflow</th>
            <th class="px-4 py-2 text-left">Age</th>
            <th class="px-4 py-2 text-left"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @items.each do |item| %>
            <% sev_class = item.severity == :alarm ? "bg-red-100 text-red-700" : "bg-amber-100 text-amber-700" %>
            <tr>
              <td class="px-4 py-2"><span class="<%= sev_class %> font-mono text-xs px-1.5 py-0.5 rounded uppercase"><%= item.severity %></span></td>
              <td class="px-4 py-2 font-mono text-xs"><%= item.kind %></td>
              <td class="px-4 py-2 text-gray-700"><%= item.detail %></td>
              <td class="px-4 py-2 text-xs text-gray-600">
                <% if item.run %>
                  Run #<%= item.run.id %>
                <% end %>
                <% if item.workflow %>
                  · <span class="font-mono"><%= item.workflow.trigger_kind %></span>
                  <% if item.workflow.current_step %>
                    · step <span class="font-mono"><%= step_kind_label(item.workflow.current_step.kind) %></span>
                  <% end %>
                <% end %>
              </td>
              <td class="px-4 py-2 text-xs text-gray-500"><%= item.age_label %></td>
              <td class="px-4 py-2 text-xs text-right space-x-3">
                <% if item.job %>
                  <%= link_to "Job", job_path(item.job), class: "text-blue-600 underline hover:no-underline" %>
                <% end %>
                <% if item.run&.claude_session %>
                  <%= link_to "Transcript", admin_run_transcript_path(item.run.id), class: "text-indigo-600 underline hover:no-underline" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
