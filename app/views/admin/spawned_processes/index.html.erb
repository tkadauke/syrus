<div class="space-y-6">
  <div class="flex items-start justify-between gap-3">
    <div>
      <h1 class="font-bold text-2xl">Spawned processes</h1>
      <p class="text-sm text-gray-500 mt-1">
        Every subprocess Syrus spawns (claude/codex/grader/git/prepare). Heartbeats every chunk;
        stale = no chunk in 5 min. Kill button stamps <span class="font-mono">kill_requested_at</span> —
        the owning worker pod polls and terminates the local pid.
      </p>
    </div>
    <%= render "admin/nav" %>
  </div>

  <details class="group rounded-lg border border-gray-200 bg-white lg:hidden">
    <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm font-medium text-gray-700">
      <span>Folders and filters</span>
      <span class="text-gray-400 group-open:hidden">Show</span>
      <span class="hidden text-gray-400 group-open:inline">Hide</span>
    </summary>
    <div class="space-y-4 border-t border-gray-200 p-3">
      <%= render "home/smart_folders", subject: :spawned_process, folder_heading: "Processes" %>
      <%= render "home/chip_bar", subject: :spawned_process, filter: @filter, schema: @schema, action_url: admin_processes_path, class_name: "relative flex flex-col gap-3" %>
    </div>
  </details>

  <div class="grid gap-5 lg:grid-cols-[16rem_1fr]">
    <aside class="hidden space-y-4 lg:block">
      <%= render "home/smart_folders", subject: :spawned_process, folder_heading: "Processes" %>
    </aside>

    <div class="space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-gray-200 bg-gray-50 px-3 py-2">
        <%= render "home/chip_bar", subject: :spawned_process, filter: @filter, schema: @schema, action_url: admin_processes_path, class_name: "relative" %>
        <div class="text-xs text-gray-500">
          <strong><%= @running_count %></strong> running ·
          <strong><%= @processes.size %></strong> shown
        </div>
      </div>

      <% if @processes.empty? %>
        <div class="bg-emerald-50 border border-emerald-200 rounded-lg p-6 text-emerald-800">
          No processes match this filter.
        </div>
      <% else %>
        <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
          <table class="min-w-full divide-y divide-gray-200 text-sm">
            <thead class="bg-gray-50 text-xs uppercase text-gray-500">
              <tr>
                <th class="px-3 py-2 text-left">Kind</th>
                <th class="px-3 py-2 text-left">Command</th>
                <th class="px-3 py-2 text-left">Host / pid</th>
                <th class="px-3 py-2 text-left">Started</th>
                <th class="px-3 py-2 text-left">Last chunk</th>
                <th class="px-3 py-2 text-left">Duration</th>
                <th class="px-3 py-2 text-left">Outcome</th>
                <th class="px-3 py-2"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% @processes.each do |sp| %>
                <tr class="<%= 'bg-amber-50' if sp.stale? %>">
                  <td class="px-3 py-2 align-top">
                    <span class="rounded px-2 py-0.5 text-xs font-medium <%= kind_pill_class(sp.kind) %>"><%= sp.kind %></span>
                  </td>
                  <td class="px-3 py-2 align-top font-mono text-xs text-gray-700 max-w-md truncate" title="<%= sp.command %>">
                    <%= sp.command %>
                    <% if sp.run_id %>
                      <div class="text-gray-500 mt-0.5">
                        Run <%= link_to "##{sp.run_id}", admin_run_transcript_path(sp.run_id), class: "text-blue-600 hover:underline" %>
                      </div>
                    <% end %>
                  </td>
                  <td class="px-3 py-2 align-top text-xs text-gray-600 font-mono">
                    <%= sp.hostname %>
                    <% if sp.pid %>
                      <div class="text-gray-500">pid <%= sp.pid %></div>
                    <% end %>
                  </td>
                  <td class="px-3 py-2 align-top text-xs text-gray-700 whitespace-nowrap">
                    <%= relative_timestamp(sp.started_at) %>
                  </td>
                  <td class="px-3 py-2 align-top text-xs whitespace-nowrap">
                    <% if sp.last_chunk_at %>
                      <%= relative_timestamp(sp.last_chunk_at) %>
                    <% else %>
                      <span class="text-gray-400">no output yet</span>
                    <% end %>
                    <% if sp.stale? %>
                      <span class="ml-1 rounded bg-amber-200 px-1 text-amber-900 text-[0.65rem] uppercase font-semibold">stale</span>
                    <% end %>
                  </td>
                  <td class="px-3 py-2 align-top text-xs text-gray-700">
                    <%= duration_label(sp.duration_s) %>
                    <% if sp.wall_timeout_s %>
                      <div class="text-gray-400">of <%= duration_label(sp.wall_timeout_s) %></div>
                    <% end %>
                  </td>
                  <td class="px-3 py-2 align-top text-xs">
                    <% if sp.finished? %>
                      <span class="rounded px-2 py-0.5 font-medium <%= outcome_pill_class(sp.outcome) %>"><%= sp.outcome %></span>
                      <% if sp.exit_status %>
                        <div class="text-gray-400">exit <%= sp.exit_status %></div>
                      <% end %>
                    <% elsif sp.kill_requested? %>
                      <span class="rounded bg-amber-100 text-amber-800 px-2 py-0.5 font-medium">kill requested</span>
                    <% else %>
                      <span class="rounded bg-blue-100 text-blue-800 px-2 py-0.5 font-medium">running</span>
                    <% end %>
                  </td>
                  <td class="px-3 py-2 align-top whitespace-nowrap">
                    <%= link_to "Detail", admin_process_path(sp), class: "text-blue-600 hover:underline text-xs" %>
                    <% if sp.running? && !sp.kill_requested? %>
                      <%= button_to "Kill", kill_admin_process_path(sp), method: :post,
                            data: { turbo_confirm: "Send SIGTERM (then SIGKILL after 5s) to #{sp.kind} ##{sp.id}?" },
                            class: "ml-2 inline-flex items-center rounded bg-red-600 px-2 py-0.5 text-xs font-medium text-white hover:bg-red-700 cursor-pointer" %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>
</div>
