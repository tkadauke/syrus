<h1><%= @alert.fetch(:title) %></h1>

<p><strong><%= t(".severity") %></strong> <%= @alert.fetch(:severity) %></p>
<p><strong><%= t(".dismissal_key") %></strong> <code><%= @alert.fetch(:dismissal_key) %></code></p>

<p><%= @alert.fetch(:message) %></p>

<% if @alert[:action_steps].present? %>
  <h2><%= t(".action_steps") %></h2>
  <ul>
    <% @alert[:action_steps].each do |step| %>
      <li><%= step %></li>
    <% end %>
  </ul>
<% end %>

<% if @alert[:cta].present? %>
  <p><%= link_to @alert[:cta].fetch(:text), @alert[:cta].fetch(:url) %></p>
<% end %>

<% if @alert[:app_url].present? %>
  <p><%= link_to t(".open_syrus"), @alert[:app_url] %></p>
<% end %>
