<div class="space-y-6">
  <%# Subscribe to the per-user "jobs" stream so any Job/Run change
      (new Job, state pill move, workflow count tick, mergeability flip)
      morphs the dashboard live without a reload. %>
  <%= turbo_stream_from Current.user, "jobs" %>

  <% rl_user = Current.user %>
  <% if rl_user.gh_rate_limit_remaining&.zero? %>
    <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-800">
      <strong>GitHub quota exhausted.</strong>
      Polls and runs are paused until the quota resets
      <% if rl_user.gh_rate_limit_reset_at %>
        (<%= relative_timestamp(rl_user.gh_rate_limit_reset_at) %>).
      <% else %>
        at the next reset window.
      <% end %>
    </div>
  <% elsif rl_user.gh_rate_limit_remaining && rl_user.gh_rate_limit_remaining < 200 %>
    <div class="rounded-lg bg-amber-50 border border-amber-200 px-4 py-3 text-sm text-amber-800">
      GitHub quota low:
      <strong><%= number_with_delimiter(rl_user.gh_rate_limit_remaining) %></strong> /
      <%= number_with_delimiter(rl_user.gh_rate_limit_limit) %> remaining
      (<%= rl_user.gh_rate_limit_resource || "core" %> bucket).
      Resets <%= relative_timestamp(rl_user.gh_rate_limit_reset_at) %>.
    </div>
  <% end %>

  <div class="flex items-center justify-between">
    <h1 class="font-bold text-3xl">Dashboard</h1>
    <%= link_to "New job", new_job_path,
          class: "rounded-md px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium" %>
  </div>

  <div class="border-b border-gray-200">
    <nav class="-mb-px flex gap-6">
      <%= link_to "Epics", dashboard_epics_path,
            class: "pb-3 text-sm font-medium border-b-2 #{@active_tab == 'epics' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'}" %>
      <%= link_to "Jobs", dashboard_jobs_path,
            class: "pb-3 text-sm font-medium border-b-2 #{@active_tab == 'jobs' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'}" %>
      <%= link_to "Workflows", dashboard_workflows_path,
            class: "pb-3 text-sm font-medium border-b-2 #{@active_tab == 'workflows' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'}" %>
    </nav>
  </div>

  <% if @active_tab == "epics" %>
    <div class="space-y-4">
      <%= form_with url: dashboard_epics_path, method: :get, class: "flex flex-wrap items-center gap-3 rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm" do %>
        <label class="flex items-center gap-2 text-gray-700">
          <span>Repo</span>
          <%= select_tag :repository_id,
                options_for_select([ [ "All repositories", "" ] ] + @epic_repositories.map { |repository| [ repository.slug, repository.id ] }, @epic_filter_params["repository_id"]),
                class: "rounded-md border border-gray-300 bg-white px-2 py-1.5 text-sm text-gray-700" %>
        </label>
        <label class="flex items-center gap-2 text-gray-700">
          <span>Sort</span>
          <%= select_tag :sort,
                options_for_select([ [ "Recently updated", "updated_desc" ], [ "Oldest updated", "updated_asc" ] ], @epic_filter_params["sort"].presence || "updated_desc"),
                class: "rounded-md border border-gray-300 bg-white px-2 py-1.5 text-sm text-gray-700" %>
        </label>
        <label class="inline-flex items-center gap-2 rounded-full border border-gray-300 px-3 py-1.5 text-gray-700">
          <%= check_box_tag :done, "1", @show_done_epics, class: "rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
          <span>Show Done</span>
        </label>
        <label class="inline-flex items-center gap-2 rounded-full border border-amber-300 bg-amber-50 px-3 py-1.5 text-amber-900">
          <%= check_box_tag :blocked, "1", @epic_filter_params["blocked"] == "1", class: "rounded border-amber-300 text-amber-600 focus:ring-amber-500" %>
          <span>Blocked</span>
        </label>
        <%= submit_tag "Apply",
              class: "rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-blue-500 cursor-pointer" %>
        <% if @epic_filter_params.any? %>
          <%= link_to "Clear", dashboard_epics_path, class: "text-sm text-gray-600 underline hover:no-underline" %>
        <% end %>
      <% end %>

      <div class="grid gap-4 xl:grid-cols-4 lg:grid-cols-2"
           data-controller="epic-kanban">
        <% Epic::STATES.each do |state| %>
          <% lane_epics = @epic_lanes.fetch(state, []) %>
          <section class="min-w-0 rounded-lg border border-gray-200 bg-gray-50"
                   data-epic-kanban-target="lane"
                   data-epic-state="<%= state %>"
                   data-action="dragover->epic-kanban#dragOver drop->epic-kanban#drop">
            <div class="flex items-center justify-between border-b border-gray-200 px-3 py-2">
              <h2 class="text-sm font-semibold text-gray-900"><%= epic_lane_title(state) %></h2>
              <span class="rounded-full bg-white px-2 py-0.5 text-xs font-medium text-gray-600"><%= lane_epics.size %></span>
            </div>
            <div class="space-y-3 p-3">
              <% if state == "done" && !@show_done_epics %>
                <div class="rounded-md border border-dashed border-gray-300 bg-white px-3 py-4 text-center text-sm text-gray-500">
                  Done epics hidden.
                </div>
              <% elsif lane_epics.any? %>
                <% lane_epics.each do |epic| %>
                  <div class="rounded-lg border border-gray-200 bg-white p-3 text-sm shadow-sm hover:border-blue-300 hover:shadow"
                       draggable="<%= epic.ready? %>"
                       data-action="dragstart->epic-kanban#dragStart"
                       data-epic-id="<%= epic.id %>"
                       data-epic-state="<%= epic.state %>"
                       data-epic-state-url="<%= state_epic_path(epic) %>">
                    <div class="flex items-start justify-between gap-3">
                      <div class="min-w-0">
                        <%= link_to epic_path(epic), class: "block font-medium text-gray-900 break-words hover:text-blue-700" do %>
                          <span class="font-mono text-xs font-semibold text-gray-500"><%= epic.display_number %></span>
                          <span class="text-gray-400">·</span>
                          <span><%= epic.title %></span>
                        <% end %>
                      </div>
                      <div class="flex shrink-0 items-start gap-1">
                        <% if epic_blocked?(epic) %>
                          <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-amber-100 text-amber-700"
                                title="Blocked"
                                aria-label="Blocked">
                            <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                              <path d="M3 2.25A.75.75 0 0 1 3.75 1h7.5a.75.75 0 0 1 .53 1.28L9.56 4.5l2.22 2.22a.75.75 0 0 1-.53 1.28h-6.5v6.25a.75.75 0 0 1-1.5 0v-12Z" />
                            </svg>
                          </span>
                        <% end %>
                        <details class="relative">
                          <summary class="flex h-6 w-6 cursor-pointer list-none items-center justify-center rounded-full text-gray-400 hover:bg-gray-100 hover:text-gray-700"
                                   aria-label="Epic actions">
                            &hellip;
                          </summary>
                          <div class="absolute right-0 z-10 mt-1 w-48 rounded-md border border-gray-200 bg-white p-2 shadow-lg">
                            <div class="mb-1 text-xs font-medium text-gray-500">Override state</div>
                            <% (Epic::STATES - [ epic.state ]).each do |target_state| %>
                              <%= button_to epic_lane_title(target_state),
                                    state_epic_path(epic),
                                    method: :patch,
                                    params: { target_state: target_state, override: "1" },
                                    class: "block w-full rounded px-2 py-1 text-left text-sm text-gray-700 hover:bg-gray-50" %>
                            <% end %>
                          </div>
                        </details>
                      </div>
                    </div>
                    <div class="mt-3 flex flex-wrap items-center gap-1.5">
                      <span class="rounded bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-700">
                        <%= epic_done_jobs_count(epic) %>/<%= epic_total_jobs_count(epic) %> done
                      </span>
                      <% epic_child_repositories(epic).each do |repository| %>
                        <span class="rounded bg-blue-50 px-2 py-0.5 font-mono text-xs text-blue-700"><%= repository.slug %></span>
                      <% end %>
                      <span class="rounded bg-violet-50 px-2 py-0.5 text-xs font-medium text-violet-700">
                        <%= pluralize(epic_dependency_edge_count(epic), "dep") %>
                      </span>
                    </div>
                    <div class="mt-2 text-xs text-gray-500">
                      Updated <%= relative_timestamp(epic.updated_at) %>
                    </div>
                  </div>
                <% end %>
              <% else %>
                <div class="rounded-md border border-dashed border-gray-300 bg-white px-3 py-4 text-center text-sm text-gray-500">
                  No epics.
                </div>
              <% end %>
            </div>
          </section>
        <% end %>
      </div>
    </div>
  <% elsif @active_tab == "jobs" %>
    <details class="group rounded-lg border border-gray-200 bg-white lg:hidden">
      <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm font-medium text-gray-700">
        <span>Folders and filters</span>
        <span class="text-gray-400 group-open:hidden">Show</span>
        <span class="hidden text-gray-400 group-open:inline">Hide</span>
      </summary>
      <div class="space-y-4 border-t border-gray-200 p-3">
        <%= render "smart_folders" %>
        <%= render "job_filters", class_name: "flex flex-col gap-3" %>
        <%= render "save_smart_folder_form", class_name: "flex flex-col gap-2 rounded-md border border-gray-200 bg-gray-50 px-3 py-2 text-sm" %>
        <% if @active_smart_folder %>
          <div class="rounded-md border border-blue-100 bg-blue-50 px-3 py-2 text-sm text-blue-800">
            Showing smart folder: <strong><%= @active_smart_folder.name %></strong>
          </div>
        <% end %>
      </div>
    </details>

    <div class="grid gap-5 lg:grid-cols-[16rem_1fr]">
      <aside class="hidden space-y-4 lg:block">
        <%= render "smart_folders" %>
      </aside>

      <div class="space-y-4">
        <%= render "job_filters", class_name: "hidden flex-wrap items-center gap-3 lg:flex" %>
        <%= render "save_smart_folder_form", class_name: "hidden flex-wrap items-center gap-2 rounded-md border border-gray-200 bg-gray-50 px-3 py-2 text-sm lg:flex" %>

        <% if @active_smart_folder %>
          <div class="hidden rounded-md border border-blue-100 bg-blue-50 px-3 py-2 text-sm text-blue-800 lg:block">
            Showing smart folder: <strong><%= @active_smart_folder.name %></strong>
          </div>
        <% end %>
    <% if @epics&.any? %>
      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
        <div class="px-4 py-3 border-b border-gray-200">
          <h2 class="font-semibold text-lg">Epics awaiting your move</h2>
        </div>
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50 text-xs uppercase text-gray-500">
            <tr>
              <th class="px-4 py-2 text-left">State</th>
              <th class="px-4 py-2 text-left">Epic</th>
              <th class="hidden sm:table-cell px-4 py-2 text-left">Repository</th>
              <th class="hidden sm:table-cell px-4 py-2 text-left">Updated</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 text-sm">
            <% @epics.each do |epic| %>
              <tr>
                <td class="px-4 py-3 align-top"><%= state_pill(epic.state) %></td>
                <td class="px-4 py-3">
                  <div class="font-medium text-gray-900">
                    <%= link_to epic.title, epic_path(epic), class: "hover:underline" %>
                  </div>
                  <%= form_with url: dashboard_epic_auto_approval_path(epic), method: :patch,
                        scope: :epic, class: "mt-2 flex flex-wrap items-center gap-2 text-xs" do |form| %>
                    <%= form.label :auto_approve_mode, "Auto-approval", class: "font-medium text-gray-700" %>
                    <%= form.select :auto_approve_mode, auto_approve_mode_options, {},
                          class: "rounded border border-gray-300 bg-white px-2 py-1 text-xs" %>
                    <%= form.submit "Update", class: "text-blue-600 underline hover:no-underline cursor-pointer" %>
                    <span class="text-gray-500"><%= auto_approve_preview(epic) %></span>
                  <% end %>
                  <div class="sm:hidden text-xs font-mono text-gray-500 mt-0.5">
                    <%= link_to epic.repository.slug, repository_path(epic.repository), class: "hover:underline" %>
                  </div>
                </td>
                <td class="hidden sm:table-cell px-4 py-3 font-mono">
                  <%= link_to epic.repository.slug, repository_path(epic.repository), class: "text-gray-700 hover:underline" %>
                </td>
                <td class="hidden sm:table-cell px-4 py-3 text-gray-500"><%= relative_timestamp(epic.updated_at) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <% if @jobs.any? || @page > 1 %>
      <% jobs_total_pages = (@jobs_total.to_f / HomeController::PER_PAGE).ceil %>
      <%= form_with url: bulk_dashboard_jobs_path, method: :post,
            data: { controller: "bulk-jobs" },
            class: "space-y-3" do %>
        <div data-bulk-jobs-target="actions"
             class="hidden flex flex-wrap items-center gap-2 rounded-md border border-gray-200 bg-gray-50 px-3 py-2 text-sm">
          <span class="text-gray-600">Bulk actions for <span data-bulk-jobs-target="count">0</span></span>
          <%= button_tag "Retry", name: :bulk_action, value: "retry",
                class: "rounded-md px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
          <% if @configured_agent_providers.size > 1 %>
            <% @configured_agent_providers.each do |provider| %>
              <%= button_tag "Retry with #{provider.titleize}", name: :bulk_action, value: "retry:#{provider}",
                    class: "rounded-md px-3 py-1.5 border border-blue-200 bg-white text-blue-700 hover:bg-blue-50 font-medium cursor-pointer" %>
            <% end %>
          <% end %>
          <%= button_tag "Close", name: :bulk_action, value: "close",
                class: "rounded-md px-3 py-1.5 bg-amber-600 hover:bg-amber-500 text-white font-medium cursor-pointer",
                data: { turbo_confirm: "Cancel active runs and close the selected jobs?" } %>
          <%= button_tag name: :bulk_action, value: "approve",
                class: "rounded-md px-3 py-1.5 bg-green-600 hover:bg-green-500 text-white font-medium cursor-pointer",
                data: { turbo_confirm: "Approve the selected implemented jobs?" } do %>
            Approve <span data-bulk-jobs-target="count">0</span>
          <% end %>
          <%= button_tag name: :bulk_action, value: "review_approve",
                class: "rounded-md px-3 py-1.5 border border-green-200 bg-white text-green-700 hover:bg-green-50 font-medium cursor-pointer" do %>
            Review and approve <span data-bulk-jobs-target="count">0</span>
          <% end %>
          <div class="flex flex-wrap items-center gap-2 border-l border-gray-200 pl-2">
            <%= select_tag :tag_id,
                  options_for_select([["Choose tag", ""]] + @tags.map { |tag| [tag.name, tag.id] }),
                  class: "text-sm border border-gray-300 rounded-md px-2 py-1.5 bg-white text-gray-700" %>
            <%= text_field_tag :tag_name, nil,
                  placeholder: "or new tag",
                  list: "bulk-tag-options",
                  class: "text-sm border border-gray-300 rounded-md px-2 py-1.5 bg-white text-gray-700 w-36" %>
            <datalist id="bulk-tag-options">
              <% @tags.each do |tag| %>
                <option value="<%= tag.name %>"></option>
              <% end %>
            </datalist>
            <%= button_tag "Apply tag", name: :bulk_action, value: "apply_tag",
                  class: "rounded-md px-3 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-white font-medium cursor-pointer" %>
          </div>
        </div>

        <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50 text-xs uppercase text-gray-500">
              <tr>
                <th class="px-4 py-2 text-left w-10">
                  <input type="checkbox"
                         data-bulk-jobs-target="selectAll"
                         data-action="bulk-jobs#toggleAll"
                         aria-label="Select all jobs"
                         class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                </th>
                <th class="hidden sm:table-cell px-4 py-2 text-left">State</th>
                <th class="hidden sm:table-cell px-4 py-2 text-left">Repository</th>
                <th class="px-4 py-2 text-left">Issue</th>
                <th class="hidden sm:table-cell px-4 py-2 text-left">Latest</th>
                <th class="hidden sm:table-cell px-4 py-2 text-left">Workflows</th>
                <th class="hidden sm:table-cell px-4 py-2 text-left">Started</th>
                <th class="hidden sm:table-cell px-4 py-2"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 text-sm">
              <% @jobs.each do |job| %>
                <% latest_workflow = job.latest_workflow %>
                <tr>
                  <td class="px-4 py-3 align-top">
                    <%= check_box_tag "job_ids[]", job.id, false,
                          id: "bulk_job_#{job.id}",
                          data: { bulk_jobs_target: "checkbox", action: "bulk-jobs#sync" },
                          aria: { label: "Select job #{job.id}" },
                          class: "rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
                  </td>
                  <td class="hidden sm:table-cell px-4 py-3 align-top">
                    <%= state_pill(job_summary_state(job)) %>
                    <% if job.priority != "medium" %>
                      <%= priority_pill(job.priority) %>
                    <% end %>
                    <div class="mt-1 text-xs text-gray-500"><%= cost_caption(job.total_cost_usd) %></div>
                  </td>
                  <td class="hidden sm:table-cell px-4 py-3 font-mono align-top">
                    <%= link_to job.repository.slug, repository_path(job.repository), class: "text-gray-700 hover:underline" %>
                  </td>
                  <td class="px-4 py-3">
                    <div class="sm:hidden mb-1 flex flex-wrap items-center gap-1.5">
                      <%= state_pill(job_summary_state(job)) %>
                      <% if job.priority != "medium" %>
                        <%= priority_pill(job.priority) %>
                      <% end %>
                      <span class="text-xs text-gray-500"><%= cost_caption(job.total_cost_usd) %></span>
                    </div>
                    <div class="sm:hidden text-xs font-mono text-gray-500 mb-0.5">
                      <%= link_to job.repository.slug, repository_path(job.repository), class: "hover:underline" %>
                    </div>
                    <div class="flex items-start gap-2">
                      <%= job_pin_button(job, pinned: @pinned_job_ids.include?(job.id)) %>
                      <div class="min-w-0">
                        <%= job_source_label_html(job) %>
                        <% if job.issue_title.present? %>
                          <%= link_to job.issue_title, job_path(job), class: "ml-1 text-gray-700 hover:underline" %>
                        <% end %>
                      </div>
                    </div>
                    <% if job.pr_number %>
                      <span class="ml-1 text-xs text-indigo-700">
                        →
                        <%= link_to "PR ##{job.pr_number}", job_pr_url(job), target: "_blank", rel: "noopener", class: "underline hover:no-underline" %>
                      </span>
                    <% end %>
                    <% if job.external_pr_number %>
                      <span class="ml-1 text-xs text-violet-700">
                        ↪
                        <%= link_to "PR ##{job.external_pr_number}", external_pr_url(job), target: "_blank", rel: "noopener", class: "underline hover:no-underline" %>
                      </span>
                    <% end %>
                    <% caption = current_step_caption(job) %>
                    <% if caption %>
                      <div class="text-xs text-gray-500 italic mt-0.5"><%= caption %></div>
                    <% end %>
                    <% if job.approved_at.present? || job.state == "implemented" %>
                      <div class="text-xs text-gray-500 mt-0.5"><%= approval_caption(job) %></div>
                    <% end %>
                    <% if job.tags.any? %>
                      <div class="mt-1 flex flex-wrap items-center gap-1">
                        <%= tag_chip_list(job.tags.to_a, limit: 3) %>
                      </div>
                    <% end %>
                    <% if job.validity_duplicate? || job.validity_already_implemented? %>
                      <div class="mt-2 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-900">
                        <div class="flex flex-wrap items-center justify-between gap-2">
                          <div>
                            <span class="font-medium"><%= job.validity.humanize %></span>
                            <% if job.invalidation_reason.present? %>
                              <span class="ml-1"><%= job.invalidation_reason %></span>
                            <% end %>
                          </div>
                          <%= button_tag "Override (mark valid)",
                                type: "submit",
                                formaction: mark_valid_job_path(job),
                                formmethod: "post",
                                class: "rounded-md bg-amber-700 px-2 py-1 text-white hover:bg-amber-600 cursor-pointer" %>
                        </div>
                        <% if job.invalidation_evidence.present? %>
                          <div class="mt-1 flex flex-wrap gap-x-2 gap-y-1">
                            <% job.invalidation_evidence.each do |url| %>
                              <%= link_to url, url, target: "_blank", rel: "noopener", class: "text-amber-800 underline hover:no-underline break-all" %>
                            <% end %>
                          </div>
                        <% end %>
                      </div>
                    <% end %>
                    <div class="sm:hidden text-xs text-gray-400 mt-1 flex items-center gap-1.5">
                      <span><%= pluralize(job.workflows.size, "workflow") %></span>
                      <span>·</span>
                      <span><%= relative_timestamp(job.started_at) %></span>
                    </div>
                  </td>
                  <td class="hidden sm:table-cell px-4 py-3 align-top">
                    <% if latest_workflow %>
                      <div class="flex flex-wrap items-center gap-1">
                        <%= trigger_pill(latest_workflow.trigger_kind) %>
                        <%= state_pill(latest_workflow.state) %>
                      </div>
                    <% else %>
                      <span class="text-gray-400">—</span>
                    <% end %>
                  </td>
                  <td class="hidden sm:table-cell px-4 py-3 text-gray-600"><%= job.workflows.size %></td>
                  <td class="hidden sm:table-cell px-4 py-3 text-gray-500"><%= relative_timestamp(job.started_at) %></td>
                  <td class="hidden sm:table-cell px-4 py-3 text-right">
                    <%= link_to "View", job_path(job), class: "text-blue-600 underline hover:no-underline" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
      <% if @bulk_review_jobs&.any? %>
        <%= form_with url: bulk_dashboard_jobs_path, method: :post,
              data: { controller: "approval-review" },
              class: "fixed inset-y-0 right-0 z-40 flex w-full max-w-3xl flex-col border-l border-gray-200 bg-white shadow-xl" do %>
          <%= hidden_field_tag :bulk_action, "commit_review_approval" %>
          <% @bulk_review_jobs.each do |job| %>
            <%= hidden_field_tag "job_ids[]", job.id %>
          <% end %>
          <div class="flex items-center justify-between border-b border-gray-200 px-4 py-3">
            <div>
              <h2 class="text-base font-semibold text-gray-900">Review and approve</h2>
              <p class="text-sm text-gray-500">
                <span data-approval-review-target="position">1</span> of <%= @bulk_review_jobs.size %>
              </p>
            </div>
            <%= link_to "Close", dashboard_jobs_path(request.query_parameters.except("page")),
                  class: "rounded-md border border-gray-300 px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-50" %>
          </div>

          <div class="min-h-0 flex-1 overflow-y-auto">
            <% @bulk_review_jobs.each_with_index do |job, index| %>
              <section data-approval-review-target="item"
                       class="<%= index.zero? ? '' : 'hidden' %> space-y-3 p-4">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div>
                    <div class="font-mono text-sm text-gray-500"><%= job.repository.slug %></div>
                    <h3 class="text-lg font-semibold text-gray-900">
                      <%= job_source_label_html(job) %>
                      <% if job.issue_title.present? %>
                        <span class="font-normal"><%= job.issue_title %></span>
                      <% end %>
                    </h3>
                  </div>
                  <%= state_pill(job_summary_state(job)) %>
                </div>

                <% diff = latest_agent_diff(job) %>
                <% if diff.present? %>
                  <pre class="max-h-[65vh] overflow-auto rounded-md bg-black p-3 font-mono text-xs text-gray-100 whitespace-pre"><%= diff %></pre>
                <% else %>
                  <div class="rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900">
                    No stored diff is available for this Job.
                  </div>
                <% end %>

                <%= hidden_field_tag "approval_choices[#{job.id}]", "skip", data: { approval_review_target: "choice" } %>
              </section>
            <% end %>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-2 border-t border-gray-200 px-4 py-3">
            <button type="button"
                    data-action="approval-review#skip"
                    class="rounded-md border border-gray-300 px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-50 cursor-pointer">
              Skip
            </button>
            <div class="flex items-center gap-2">
              <button type="button"
                      data-approval-review-target="previous"
                      data-action="approval-review#previous"
                      class="rounded-md border border-gray-300 px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-50 cursor-pointer">
                Previous
              </button>
              <button type="button"
                      data-action="approval-review#approve"
                      class="rounded-md bg-green-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-green-500 cursor-pointer">
                Approve
              </button>
              <%= submit_tag "Commit approved batch",
                    data: { approval_review_target: "submit" },
                    class: "hidden rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-blue-500 cursor-pointer" %>
            </div>
          </div>
        <% end %>
      <% end %>
      <% if jobs_total_pages > 1 %>
        <% first_item = (@page - 1) * HomeController::PER_PAGE + 1 %>
        <% last_item = [@page * HomeController::PER_PAGE, @jobs_total].min %>
        <div class="flex items-center justify-between text-sm text-gray-600">
          <span>Showing <%= first_item %>–<%= last_item %> of <%= @jobs_total %></span>
          <div class="flex gap-2">
            <% if @page > 1 %>
              <%= link_to "← Previous", dashboard_jobs_path(request.query_parameters.merge("page" => @page - 1)),
                    class: "px-3 py-1 border border-gray-300 rounded hover:bg-gray-50" %>
            <% else %>
              <span class="px-3 py-1 border border-gray-200 rounded text-gray-300">← Previous</span>
            <% end %>
            <% if @page < jobs_total_pages %>
              <%= link_to "Next →", dashboard_jobs_path(request.query_parameters.merge("page" => @page + 1)),
                    class: "px-3 py-1 border border-gray-300 rounded hover:bg-gray-50" %>
            <% else %>
              <span class="px-3 py-1 border border-gray-200 rounded text-gray-300">Next →</span>
            <% end %>
          </div>
        </div>
      <% end %>
    <% elsif !@epics&.any? %>
      <div class="bg-white border border-gray-200 rounded-lg p-6 text-sm text-gray-600">
        <% if @job_filter.active? %>
          No jobs match the current filters.
        <% else %>
          No jobs yet. Add a repository, enable polling, label an issue
          <code class="bg-gray-100 px-1 rounded">syrus</code>, and one will show up here.
        <% end %>
      </div>
    <% end %>
      </div>
    </div>
  <% else %>
    <% if @workflows.any? || @page > 1 %>
      <% workflows_total_pages = (@workflows_total.to_f / HomeController::PER_PAGE).ceil %>
      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50 text-xs uppercase text-gray-500">
            <tr>
              <th class="hidden sm:table-cell px-4 py-2 text-left">State</th>
              <th class="hidden sm:table-cell px-4 py-2 text-left">Trigger</th>
              <th class="hidden sm:table-cell px-4 py-2 text-left">Repository</th>
              <th class="px-4 py-2 text-left">Issue</th>
              <th class="hidden sm:table-cell px-4 py-2 text-left">Step</th>
              <th class="hidden sm:table-cell px-4 py-2 text-left">Started</th>
              <th class="hidden sm:table-cell px-4 py-2"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 text-sm">
            <% @workflows.each do |wf| %>
              <tr>
                <td class="hidden sm:table-cell px-4 py-3 align-top"><%= state_pill(wf.state) %></td>
                <td class="hidden sm:table-cell px-4 py-3 align-top"><%= trigger_pill(wf.trigger_kind) %></td>
                <td class="hidden sm:table-cell px-4 py-3 font-mono align-top">
                  <%= link_to wf.job.repository.slug, repository_path(wf.job.repository), class: "text-gray-700 hover:underline" %>
                </td>
                <td class="px-4 py-3">
                  <div class="sm:hidden flex flex-wrap items-center gap-1.5 mb-0.5">
                    <%= state_pill(wf.state) %>
                    <%= trigger_pill(wf.trigger_kind) %>
                    <span class="text-xs font-mono text-gray-500">
                      <%= link_to wf.job.repository.slug, repository_path(wf.job.repository), class: "hover:underline" %>
                    </span>
                  </div>
                  <%= job_source_label_html(wf.job) %>
                  <% if wf.job.issue_title.present? %>
                    <%= link_to wf.job.issue_title, job_path(wf.job), class: "ml-1 text-gray-700 hover:underline" %>
                  <% end %>
                  <% if wf.job.pr_number %>
                    <span class="ml-1 text-xs text-indigo-700">
                      →
                      <%= link_to "PR ##{wf.job.pr_number}", job_pr_url(wf.job), target: "_blank", rel: "noopener", class: "underline hover:no-underline" %>
                    </span>
                  <% end %>
                  <% if wf.job.external_pr_number %>
                    <span class="ml-1 text-xs text-violet-700">
                      ↪
                      <%= link_to "PR ##{wf.job.external_pr_number}", external_pr_url(wf.job), target: "_blank", rel: "noopener", class: "underline hover:no-underline" %>
                    </span>
                  <% end %>
                  <div class="sm:hidden text-xs text-gray-400 mt-1 flex items-center gap-1.5">
                    <span><%= workflow_step_caption(wf) %></span>
                    <span>·</span>
                    <span><%= relative_timestamp(wf.started_at || wf.created_at) %></span>
                  </div>
                </td>
                <td class="hidden sm:table-cell px-4 py-3 text-gray-600"><%= workflow_step_caption(wf) %></td>
                <td class="hidden sm:table-cell px-4 py-3 text-gray-500"><%= relative_timestamp(wf.started_at || wf.created_at) %></td>
                <td class="hidden sm:table-cell px-4 py-3 text-right">
                  <%= link_to "View", job_path(wf.job), class: "text-blue-600 underline hover:no-underline" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if workflows_total_pages > 1 %>
        <% first_item = (@page - 1) * HomeController::PER_PAGE + 1 %>
        <% last_item = [@page * HomeController::PER_PAGE, @workflows_total].min %>
        <div class="flex items-center justify-between text-sm text-gray-600">
          <span>Showing <%= first_item %>–<%= last_item %> of <%= @workflows_total %></span>
          <div class="flex gap-2">
            <% if @page > 1 %>
              <%= link_to "← Previous", dashboard_workflows_path(request.query_parameters.merge("page" => @page - 1)),
                    class: "px-3 py-1 border border-gray-300 rounded hover:bg-gray-50" %>
            <% else %>
              <span class="px-3 py-1 border border-gray-200 rounded text-gray-300">← Previous</span>
            <% end %>
            <% if @page < workflows_total_pages %>
              <%= link_to "Next →", dashboard_workflows_path(request.query_parameters.merge("page" => @page + 1)),
                    class: "px-3 py-1 border border-gray-300 rounded hover:bg-gray-50" %>
            <% else %>
              <span class="px-3 py-1 border border-gray-200 rounded text-gray-300">Next →</span>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="bg-white border border-gray-200 rounded-lg p-6 text-sm text-gray-600">
        No workflows yet.
      </div>
    <% end %>
  <% end %>
</div>
