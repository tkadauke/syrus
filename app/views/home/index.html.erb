      <%= safe_turbo_frame "epic_graph_drawer_body", data: { epic_graph_drawer_target: "frame" } do %>
        <p class="text-sm text-gray-500">Choose an Epic graph from a card menu.</p>
      <% end %>
    </div>
  </aside>
</div>
