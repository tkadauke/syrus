      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="hidden bg-gray-50 text-xs uppercase text-gray-500 sm:table-header-group">
            <tr>
              <%= sort_header(subject: :workflow, column: :title, current_sort: @workflow_sort, th_class: "px-4 py-2 text-left") %>
              <th class="px-4 py-2 text-left">Job</th>
              <% if dashboard_column_visible?("workflows", "trigger") %>
                <th class="hidden sm:table-cell px-4 py-2 text-left">Trigger</th>
              <% end %>
              <% if dashboard_column_visible?("workflows", "state") %>
                <%= sort_header(subject: :workflow, column: :state, current_sort: @workflow_sort, th_class: "hidden sm:table-cell px-4 py-2 text-left") %>
              <% end %>
              <% if dashboard_column_visible?("workflows", "started") %>
                <%= sort_header(subject: :workflow, column: :started_at, current_sort: @workflow_sort, th_class: "hidden md:table-cell px-4 py-2 text-left") %>
              <% end %>
              <% if dashboard_column_visible?("workflows", "finished") %>
                <%= sort_header(subject: :workflow, column: :finished_at, current_sort: @workflow_sort, th_class: "hidden md:table-cell px-4 py-2 text-left") %>
              <% end %>
              <% if dashboard_column_visible?("workflows", "agent") %>
                <th class="hidden sm:table-cell px-4 py-2 text-left">Agent</th>
              <% end %>
              <% dashboard_timestamp_columns("workflows").each do |column| %>
                <% if dashboard_column_visible?("workflows", column) %>
                  <th class="hidden sm:table-cell px-4 py-2 text-left"><%= dashboard_column_label("workflows", column) %></th>
                <% end %>
              <% end %>
              <th class="hidden sm:table-cell px-4 py-2 text-right w-10">
                <%= render "home/column_picker", subject: "workflows" %>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 text-sm">
            <%= render partial: "workflows/row", collection: @workflows, as: :workflow %>
          </tbody>
        </table>
      </div>
      <% if workflows_total_pages > 1 %>
        <% first_item = (@page - 1) * HomeController::PER_PAGE + 1 %>
        <% last_item = [@page * HomeController::PER_PAGE, @workflows_total].min %>
        <div class="flex items-center justify-between text-sm text-gray-600">
          <span>Showing <%= first_item %>–<%= last_item %> of <%= @workflows_total %></span>
          <div class="flex gap-2">
            <% if @page > 1 %>
              <%= link_to "← Previous", root_path(request.query_parameters.merge("subject" => "workflow", "view" => current_view, "page" => @page - 1)),
                    class: "px-3 py-1 border border-gray-300 rounded hover:bg-gray-50" %>
            <% else %>
              <span class="px-3 py-1 border border-gray-200 rounded text-gray-300">← Previous</span>
            <% end %>
            <% if @page < workflows_total_pages %>
              <%= link_to "Next →", root_path(request.query_parameters.merge("subject" => "workflow", "view" => current_view, "page" => @page + 1)),
                    class: "px-3 py-1 border border-gray-300 rounded hover:bg-gray-50" %>
            <% else %>
              <span class="px-3 py-1 border border-gray-200 rounded text-gray-300">Next →</span>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="bg-white border border-gray-200 rounded-lg p-6 text-sm text-gray-600">
        <% if @workflows_unfiltered_count.to_i.positive? && @workflow_filter.active? %>
          No workflows match the current filters.
        <% else %>
          No workflows yet.
        <% end %>
      </div>
    <% end %>
      </div>
    </div>
  <% end %>
  <% end %>

  <div data-epic-graph-drawer-target="overlay"
       class="hidden fixed inset-0 z-40 bg-gray-900/30"
       data-action="click->epic-graph-drawer#close">
  </div>
  <aside data-epic-graph-drawer-target="panel"
         class="fixed inset-y-0 right-0 z-50 flex w-full max-w-3xl translate-x-full flex-col border-l border-gray-200 bg-white shadow-xl transition-transform duration-200"
         aria-label="Epic dependency graph drawer">
    <div class="flex items-center justify-between border-b border-gray-200 px-4 py-3">
      <h2 class="font-semibold text-gray-900">Dependency graph</h2>
      <div class="flex items-center gap-2">
        <button type="button"
                class="rounded-md border border-gray-300 px-2 py-1 text-xs font-medium text-gray-700 hover:bg-gray-50"
