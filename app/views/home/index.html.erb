        <%= render "save_workflow_smart_folder_form", class_name: "flex flex-col gap-2 rounded-md border border-gray-200 bg-gray-50 px-3 py-2 text-sm" %>
      </div>
    </details>

    <div class="grid gap-5 lg:grid-cols-[16rem_1fr]">
