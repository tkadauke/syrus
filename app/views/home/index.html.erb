<div class="space-y-6">
  <%# Subscribe to the per-user "jobs" stream so any Job/Run change
      (new Job, state pill move, run count tick, mergeability flip)
      morphs the dashboard live without a reload. %>
  <%= turbo_stream_from Current.user, "jobs" %>

  <% rl_user = Current.user %>
  <% if rl_user.gh_rate_limit_remaining&.zero? %>
    <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-800">
      <strong>GitHub quota exhausted.</strong>
      Polls and runs are paused until the quota resets
      <% if rl_user.gh_rate_limit_reset_at %>
        (<%= relative_timestamp(rl_user.gh_rate_limit_reset_at) %>).
      <% else %>
        at the next reset window.
      <% end %>
    </div>
  <% elsif rl_user.gh_rate_limit_remaining && rl_user.gh_rate_limit_remaining < 200 %>
    <div class="rounded-lg bg-amber-50 border border-amber-200 px-4 py-3 text-sm text-amber-800">
      GitHub quota low:
      <strong><%= number_with_delimiter(rl_user.gh_rate_limit_remaining) %></strong> /
      <%= number_with_delimiter(rl_user.gh_rate_limit_limit) %> remaining
      (<%= rl_user.gh_rate_limit_resource || "core" %> bucket).
      Resets <%= relative_timestamp(rl_user.gh_rate_limit_reset_at) %>.
    </div>
  <% end %>

  <h1 class="font-bold text-3xl">Dashboard</h1>

  <div class="border-b border-gray-200">
    <nav class="-mb-px flex gap-6">
      <%= link_to "Jobs", root_path,
            class: "pb-3 text-sm font-medium border-b-2 #{@active_tab == 'jobs' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'}" %>
      <%= link_to "Runs", root_path(tab: "runs"),
            class: "pb-3 text-sm font-medium border-b-2 #{@active_tab == 'runs' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'}" %>
    </nav>
  </div>

  <% if @active_tab == "jobs" %>
    <%= form_with url: root_path, method: :get,
          data: { controller: "auto-submit" },
          class: "flex flex-wrap items-center gap-3" do |f| %>
      <% select_classes = "text-sm border border-gray-300 rounded-md px-2 py-1.5 bg-white text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>

      <%= f.select :state,
            options_for_select([["All states", ""], ["Open", "open"], ["Closed", "closed"]], params[:state]),
            {},
            class: select_classes, data: { action: "change->auto-submit#submit" } %>

      <%= f.select :repository_id,
            options_for_select([["All repos", ""]] + @repositories.map { |r| [r.slug, r.id] }, params[:repository_id]),
            {},
            class: select_classes, data: { action: "change->auto-submit#submit" } %>

      <%= f.select :pr,
            options_for_select([["Any PR status", ""], ["Has PR", "has_pr"], ["No PR", "no_pr"]], params[:pr]),
            {},
            class: select_classes, data: { action: "change->auto-submit#submit" } %>

      <%= f.select :age,
            options_for_select([["All time", ""], ["Last 24h", "1d"], ["Last 7 days", "7d"], ["Last 30 days", "30d"]], params[:age]),
            {},
            class: select_classes, data: { action: "change->auto-submit#submit" } %>

      <% if params[:state].present? || params[:repository_id].present? || params[:pr].present? || params[:age].present? %>
        <%= link_to "Clear", root_path, class: "text-sm text-gray-500 hover:text-gray-700 underline" %>
      <% end %>
    <% end %>

    <% if @jobs.any? || @page > 1 %>
      <% jobs_total_pages = (@jobs_total.to_f / HomeController::PER_PAGE).ceil %>
      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50 text-xs uppercase text-gray-500">
            <tr>
              <th class="px-4 py-2 text-left">State</th>
              <th class="px-4 py-2 text-left">Repository</th>
              <th class="px-4 py-2 text-left">Issue</th>
              <th class="px-4 py-2 text-left">Runs</th>
              <th class="px-4 py-2 text-left">Started</th>
              <th class="px-4 py-2"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 text-sm">
            <% @jobs.each do |job| %>
              <tr>
                <td class="px-4 py-3"><%= state_pill(job_summary_state(job)) %></td>
                <td class="px-4 py-3 font-mono"><%= job.repository.slug %></td>
                <td class="px-4 py-3">
                  <%= job_source_label_html(job) %>
                  <% if job.pr_number %>
                    <span class="ml-1 text-xs text-indigo-700">
                      →
                      <%= link_to "PR ##{job.pr_number}", job_pr_url(job), target: "_blank", rel: "noopener", class: "underline hover:no-underline" %>
                    </span>
                  <% end %>
                  <% if job.external_pr_number %>
                    <span class="ml-1 text-xs text-violet-700">
                      ↪
                      <%= link_to "PR ##{job.external_pr_number}", external_pr_url(job), target: "_blank", rel: "noopener", class: "underline hover:no-underline" %>
                    </span>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-gray-600"><%= job.runs.size %></td>
                <td class="px-4 py-3 text-gray-500"><%= relative_timestamp(job.started_at) %></td>
                <td class="px-4 py-3 text-right">
                  <%= link_to "View", job_path(job), class: "text-blue-600 underline hover:no-underline" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if jobs_total_pages > 1 %>
        <% first_item = (@page - 1) * HomeController::PER_PAGE + 1 %>
        <% last_item = [@page * HomeController::PER_PAGE, @jobs_total].min %>
        <div class="flex items-center justify-between text-sm text-gray-600">
          <span>Showing <%= first_item %>–<%= last_item %> of <%= @jobs_total %></span>
          <div class="flex gap-2">
            <% if @page > 1 %>
              <%= link_to "← Previous", root_path(request.query_parameters.merge("page" => @page - 1)),
                    class: "px-3 py-1 border border-gray-300 rounded hover:bg-gray-50" %>
            <% else %>
              <span class="px-3 py-1 border border-gray-200 rounded text-gray-300">← Previous</span>
            <% end %>
            <% if @page < jobs_total_pages %>
              <%= link_to "Next →", root_path(request.query_parameters.merge("page" => @page + 1)),
                    class: "px-3 py-1 border border-gray-300 rounded hover:bg-gray-50" %>
            <% else %>
              <span class="px-3 py-1 border border-gray-200 rounded text-gray-300">Next →</span>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="bg-white border border-gray-200 rounded-lg p-6 text-sm text-gray-600">
        <% if params[:state].present? || params[:repository_id].present? || params[:pr].present? || params[:age].present? %>
          No jobs match the current filters.
        <% else %>
          No jobs yet. Add a repository, enable polling, label an issue
          <code class="bg-gray-100 px-1 rounded">syrus</code>, and one will show up here.
        <% end %>
      </div>
    <% end %>
  <% else %>
    <% if @runs.any? || @page > 1 %>
      <% runs_total_pages = (@runs_total.to_f / HomeController::PER_PAGE).ceil %>
      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50 text-xs uppercase text-gray-500">
            <tr>
              <th class="px-4 py-2 text-left">State</th>
              <th class="px-4 py-2 text-left">Trigger</th>
              <th class="px-4 py-2 text-left">Repository</th>
              <th class="px-4 py-2 text-left">Issue</th>
              <th class="px-4 py-2 text-left">Started</th>
              <th class="px-4 py-2"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 text-sm">
            <% @runs.each do |run| %>
              <tr>
                <td class="px-4 py-3"><%= state_pill(run.state) %></td>
                <td class="px-4 py-3"><%= trigger_pill(run.trigger_kind) %></td>
                <td class="px-4 py-3 font-mono"><%= run.job.repository.slug %></td>
                <td class="px-4 py-3">
                  <%= job_source_label_html(run.job) %>
                  <% if run.job.pr_number %>
                    <span class="ml-1 text-xs text-indigo-700">
                      →
                      <%= link_to "PR ##{run.job.pr_number}", job_pr_url(run.job), target: "_blank", rel: "noopener", class: "underline hover:no-underline" %>
                    </span>
                  <% end %>
                  <% if run.job.external_pr_number %>
                    <span class="ml-1 text-xs text-violet-700">
                      ↪
                      <%= link_to "PR ##{run.job.external_pr_number}", external_pr_url(run.job), target: "_blank", rel: "noopener", class: "underline hover:no-underline" %>
                    </span>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-gray-500"><%= relative_timestamp(run.started_at) %></td>
                <td class="px-4 py-3 text-right">
                  <%= link_to "View", job_path(run.job), class: "text-blue-600 underline hover:no-underline" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if runs_total_pages > 1 %>
        <% first_item = (@page - 1) * HomeController::PER_PAGE + 1 %>
        <% last_item = [@page * HomeController::PER_PAGE, @runs_total].min %>
        <div class="flex items-center justify-between text-sm text-gray-600">
          <span>Showing <%= first_item %>–<%= last_item %> of <%= @runs_total %></span>
          <div class="flex gap-2">
            <% if @page > 1 %>
              <%= link_to "← Previous", root_path(request.query_parameters.merge("page" => @page - 1)),
                    class: "px-3 py-1 border border-gray-300 rounded hover:bg-gray-50" %>
            <% else %>
              <span class="px-3 py-1 border border-gray-200 rounded text-gray-300">← Previous</span>
            <% end %>
            <% if @page < runs_total_pages %>
              <%= link_to "Next →", root_path(request.query_parameters.merge("page" => @page + 1)),
                    class: "px-3 py-1 border border-gray-300 rounded hover:bg-gray-50" %>
            <% else %>
              <span class="px-3 py-1 border border-gray-200 rounded text-gray-300">Next →</span>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="bg-white border border-gray-200 rounded-lg p-6 text-sm text-gray-600">
        No runs yet.
      </div>
    <% end %>
  <% end %>
</div>
