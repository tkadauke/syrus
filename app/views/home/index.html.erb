<div class="space-y-6">
  <%# Subscribe to the per-user "jobs" stream so any Job/Run change
      (new Job, state pill move, workflow count tick, mergeability flip)
      morphs the dashboard live without a reload. %>
  <%= turbo_stream_from Current.user, "jobs" %>

  <% rl_user = Current.user %>
  <% if rl_user.gh_rate_limit_remaining&.zero? %>
    <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-800">
      <strong>GitHub quota exhausted.</strong>
      Polls and runs are paused until the quota resets
      <% if rl_user.gh_rate_limit_reset_at %>
        (<%= relative_timestamp(rl_user.gh_rate_limit_reset_at) %>).
      <% else %>
        at the next reset window.
      <% end %>
    </div>
  <% elsif rl_user.gh_rate_limit_remaining && rl_user.gh_rate_limit_remaining < 200 %>
    <div class="rounded-lg bg-amber-50 border border-amber-200 px-4 py-3 text-sm text-amber-800">
      GitHub quota low:
      <strong><%= number_with_delimiter(rl_user.gh_rate_limit_remaining) %></strong> /
      <%= number_with_delimiter(rl_user.gh_rate_limit_limit) %> remaining
      (<%= rl_user.gh_rate_limit_resource || "core" %> bucket).
      Resets <%= relative_timestamp(rl_user.gh_rate_limit_reset_at) %>.
    </div>
  <% end %>

  <div class="flex items-center justify-between">
    <h1 class="font-bold text-3xl">Dashboard</h1>
    <%= link_to "New job", new_job_path,
          class: "rounded-md px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium" %>
  </div>

  <div class="border-b border-gray-200">
    <nav class="-mb-px flex gap-6">
      <%= link_to "Jobs", root_path,
            class: "pb-3 text-sm font-medium border-b-2 #{@active_tab == 'jobs' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'}" %>
      <%= link_to "Workflows", root_path(tab: "workflows"),
            class: "pb-3 text-sm font-medium border-b-2 #{@active_tab == 'workflows' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'}" %>
    </nav>
  </div>

  <% if @active_tab == "jobs" %>
    <%= form_with url: root_path, method: :get,
          data: { controller: "auto-submit filter-memory" },
          class: "flex flex-wrap items-center gap-3" do |f| %>
      <% select_classes = "text-sm border border-gray-300 rounded-md px-2 py-1.5 bg-white text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>

      <%= f.select :state,
            options_for_select([["All states", ""], ["Open", "open"], ["Closed", "closed"]], params[:state]),
            {},
            class: select_classes, data: { action: "change->auto-submit#submit" } %>

      <%= f.select :repository_id,
            options_for_select([["All repos", ""]] + @repositories.map { |r| [r.slug, r.id] }, params[:repository_id]),
            {},
            class: select_classes, data: { action: "change->auto-submit#submit" } %>

      <%= f.select :pr,
            options_for_select([["Any PR status", ""], ["Has PR", "has_pr"], ["No PR", "no_pr"]], params[:pr]),
            {},
            class: select_classes, data: { action: "change->auto-submit#submit" } %>

      <%= f.select :age,
            options_for_select([["All time", ""], ["Last 24h", "1d"], ["Last 7 days", "7d"], ["Last 30 days", "30d"]], params[:age]),
            {},
            class: select_classes, data: { action: "change->auto-submit#submit" } %>

      <% if params[:state].present? || params[:repository_id].present? || params[:pr].present? || params[:age].present? %>
        <%= link_to "Clear", root_path, class: "text-sm text-gray-500 hover:text-gray-700 underline",
              data: { action: "click->filter-memory#clear" } %>
      <% end %>
    <% end %>

    <% if @jobs.any? || @page > 1 %>
      <% jobs_total_pages = (@jobs_total.to_f / HomeController::PER_PAGE).ceil %>
      <%= form_with url: bulk_dashboard_jobs_path, method: :post,
            data: { controller: "bulk-jobs" },
            class: "space-y-3" do %>
        <div data-bulk-jobs-target="actions"
             class="hidden flex flex-wrap items-center gap-2 rounded-md border border-gray-200 bg-gray-50 px-3 py-2 text-sm">
          <span class="text-gray-600">Bulk actions</span>
          <%= button_tag "Retry", name: :bulk_action, value: "retry",
                class: "rounded-md px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
          <% if @configured_agent_providers.size > 1 %>
            <% @configured_agent_providers.each do |provider| %>
              <%= button_tag "Retry with #{provider.titleize}", name: :bulk_action, value: "retry:#{provider}",
                    class: "rounded-md px-3 py-1.5 border border-blue-200 bg-white text-blue-700 hover:bg-blue-50 font-medium cursor-pointer" %>
            <% end %>
          <% end %>
          <%= button_tag "Close", name: :bulk_action, value: "close",
                class: "rounded-md px-3 py-1.5 bg-amber-600 hover:bg-amber-500 text-white font-medium cursor-pointer",
                data: { turbo_confirm: "Cancel active runs and close the selected jobs?" } %>
        </div>

        <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50 text-xs uppercase text-gray-500">
              <tr>
                <th class="px-4 py-2 text-left w-10">
                  <input type="checkbox"
                         data-bulk-jobs-target="selectAll"
                         data-action="bulk-jobs#toggleAll"
                         aria-label="Select all jobs"
                         class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                </th>
                <th class="px-4 py-2 text-left">State</th>
                <th class="hidden sm:table-cell px-4 py-2 text-left">Repository</th>
                <th class="px-4 py-2 text-left">Issue</th>
                <th class="hidden sm:table-cell px-4 py-2 text-left">Latest</th>
                <th class="hidden sm:table-cell px-4 py-2 text-left">Workflows</th>
                <th class="hidden sm:table-cell px-4 py-2 text-left">Started</th>
                <th class="hidden sm:table-cell px-4 py-2"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 text-sm">
              <% @jobs.each do |job| %>
                <% latest_workflow = job.latest_workflow %>
                <tr>
                  <td class="px-4 py-3 align-top">
                    <%= check_box_tag "job_ids[]", job.id, false,
                          id: "bulk_job_#{job.id}",
                          data: { bulk_jobs_target: "checkbox", action: "bulk-jobs#sync" },
                          aria: { label: "Select job #{job.id}" },
                          class: "rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
                  </td>
                  <td class="px-4 py-3 align-top">
                    <%= state_pill(job_summary_state(job)) %>
                    <% if job.priority != "medium" %>
                      <%= priority_pill(job.priority) %>
                    <% end %>
                    <div class="mt-1 text-xs text-gray-500"><%= cost_caption(job.total_cost_usd) %></div>
                  </td>
                  <td class="hidden sm:table-cell px-4 py-3 font-mono align-top">
                    <%= link_to job.repository.slug, repository_path(job.repository), class: "text-gray-700 hover:underline" %>
                  </td>
                  <td class="px-4 py-3">
                    <div class="sm:hidden text-xs font-mono text-gray-500 mb-0.5">
                      <%= link_to job.repository.slug, repository_path(job.repository), class: "hover:underline" %>
                    </div>
                    <%= job_source_label_html(job) %>
                    <% if job.issue_title.present? %>
                      <%= link_to job.issue_title, job_path(job), class: "ml-1 text-gray-700 hover:underline" %>
                    <% end %>
                    <% if job.pr_number %>
                      <span class="ml-1 text-xs text-indigo-700">
                        →
                        <%= link_to "PR ##{job.pr_number}", job_pr_url(job), target: "_blank", rel: "noopener", class: "underline hover:no-underline" %>
                      </span>
                    <% end %>
                    <% if job.external_pr_number %>
                      <span class="ml-1 text-xs text-violet-700">
                        ↪
                        <%= link_to "PR ##{job.external_pr_number}", external_pr_url(job), target: "_blank", rel: "noopener", class: "underline hover:no-underline" %>
                      </span>
                    <% end %>
                    <% caption = current_step_caption(job) %>
                    <% if caption %>
                      <div class="text-xs text-gray-500 italic mt-0.5"><%= caption %></div>
                    <% end %>
                    <div class="sm:hidden text-xs text-gray-400 mt-1 flex items-center gap-1.5">
                      <span><%= pluralize(job.workflows.size, "workflow") %></span>
                      <span>·</span>
                      <span><%= relative_timestamp(job.started_at) %></span>
                    </div>
                  </td>
                  <td class="hidden sm:table-cell px-4 py-3 align-top">
                    <% if latest_workflow %>
                      <div class="flex flex-wrap items-center gap-1">
                        <%= trigger_pill(latest_workflow.trigger_kind) %>
                        <%= state_pill(latest_workflow.state) %>
                      </div>
                    <% else %>
                      <span class="text-gray-400">—</span>
                    <% end %>
                  </td>
                  <td class="hidden sm:table-cell px-4 py-3 text-gray-600"><%= job.workflows.size %></td>
                  <td class="hidden sm:table-cell px-4 py-3 text-gray-500"><%= relative_timestamp(job.started_at) %></td>
                  <td class="hidden sm:table-cell px-4 py-3 text-right">
                    <%= link_to "View", job_path(job), class: "text-blue-600 underline hover:no-underline" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
      <% if jobs_total_pages > 1 %>
        <% first_item = (@page - 1) * HomeController::PER_PAGE + 1 %>
        <% last_item = [@page * HomeController::PER_PAGE, @jobs_total].min %>
        <div class="flex items-center justify-between text-sm text-gray-600">
          <span>Showing <%= first_item %>–<%= last_item %> of <%= @jobs_total %></span>
          <div class="flex gap-2">
            <% if @page > 1 %>
              <%= link_to "← Previous", root_path(request.query_parameters.merge("page" => @page - 1)),
                    class: "px-3 py-1 border border-gray-300 rounded hover:bg-gray-50" %>
            <% else %>
              <span class="px-3 py-1 border border-gray-200 rounded text-gray-300">← Previous</span>
            <% end %>
            <% if @page < jobs_total_pages %>
              <%= link_to "Next →", root_path(request.query_parameters.merge("page" => @page + 1)),
                    class: "px-3 py-1 border border-gray-300 rounded hover:bg-gray-50" %>
            <% else %>
              <span class="px-3 py-1 border border-gray-200 rounded text-gray-300">Next →</span>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="bg-white border border-gray-200 rounded-lg p-6 text-sm text-gray-600">
        <% if params[:state].present? || params[:repository_id].present? || params[:pr].present? || params[:age].present? %>
          No jobs match the current filters.
        <% else %>
          No jobs yet. Add a repository, enable polling, label an issue
          <code class="bg-gray-100 px-1 rounded">syrus</code>, and one will show up here.
        <% end %>
      </div>
    <% end %>
  <% else %>
    <% if @workflows.any? || @page > 1 %>
      <% workflows_total_pages = (@workflows_total.to_f / HomeController::PER_PAGE).ceil %>
      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50 text-xs uppercase text-gray-500">
            <tr>
              <th class="px-4 py-2 text-left">State</th>
              <th class="hidden sm:table-cell px-4 py-2 text-left">Trigger</th>
              <th class="hidden sm:table-cell px-4 py-2 text-left">Repository</th>
              <th class="px-4 py-2 text-left">Issue</th>
              <th class="hidden sm:table-cell px-4 py-2 text-left">Step</th>
              <th class="hidden sm:table-cell px-4 py-2 text-left">Started</th>
              <th class="hidden sm:table-cell px-4 py-2"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 text-sm">
            <% @workflows.each do |wf| %>
              <tr>
                <td class="px-4 py-3 align-top"><%= state_pill(wf.state) %></td>
                <td class="hidden sm:table-cell px-4 py-3 align-top"><%= trigger_pill(wf.trigger_kind) %></td>
                <td class="hidden sm:table-cell px-4 py-3 font-mono align-top">
                  <%= link_to wf.job.repository.slug, repository_path(wf.job.repository), class: "text-gray-700 hover:underline" %>
                </td>
                <td class="px-4 py-3">
                  <div class="sm:hidden flex items-center gap-1.5 mb-0.5">
                    <%= trigger_pill(wf.trigger_kind) %>
                    <span class="text-xs font-mono text-gray-500">
                      <%= link_to wf.job.repository.slug, repository_path(wf.job.repository), class: "hover:underline" %>
                    </span>
                  </div>
                  <%= job_source_label_html(wf.job) %>
                  <% if wf.job.issue_title.present? %>
                    <%= link_to wf.job.issue_title, job_path(wf.job), class: "ml-1 text-gray-700 hover:underline" %>
                  <% end %>
                  <% if wf.job.pr_number %>
                    <span class="ml-1 text-xs text-indigo-700">
                      →
                      <%= link_to "PR ##{wf.job.pr_number}", job_pr_url(wf.job), target: "_blank", rel: "noopener", class: "underline hover:no-underline" %>
                    </span>
                  <% end %>
                  <% if wf.job.external_pr_number %>
                    <span class="ml-1 text-xs text-violet-700">
                      ↪
                      <%= link_to "PR ##{wf.job.external_pr_number}", external_pr_url(wf.job), target: "_blank", rel: "noopener", class: "underline hover:no-underline" %>
                    </span>
                  <% end %>
                  <div class="sm:hidden text-xs text-gray-400 mt-1 flex items-center gap-1.5">
                    <span><%= workflow_step_caption(wf) %></span>
                    <span>·</span>
                    <span><%= relative_timestamp(wf.started_at || wf.created_at) %></span>
                  </div>
                </td>
                <td class="hidden sm:table-cell px-4 py-3 text-gray-600"><%= workflow_step_caption(wf) %></td>
                <td class="hidden sm:table-cell px-4 py-3 text-gray-500"><%= relative_timestamp(wf.started_at || wf.created_at) %></td>
                <td class="hidden sm:table-cell px-4 py-3 text-right">
                  <%= link_to "View", job_path(wf.job), class: "text-blue-600 underline hover:no-underline" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if workflows_total_pages > 1 %>
        <% first_item = (@page - 1) * HomeController::PER_PAGE + 1 %>
        <% last_item = [@page * HomeController::PER_PAGE, @workflows_total].min %>
        <div class="flex items-center justify-between text-sm text-gray-600">
          <span>Showing <%= first_item %>–<%= last_item %> of <%= @workflows_total %></span>
          <div class="flex gap-2">
            <% if @page > 1 %>
              <%= link_to "← Previous", root_path(request.query_parameters.merge("page" => @page - 1)),
                    class: "px-3 py-1 border border-gray-300 rounded hover:bg-gray-50" %>
            <% else %>
              <span class="px-3 py-1 border border-gray-200 rounded text-gray-300">← Previous</span>
            <% end %>
            <% if @page < workflows_total_pages %>
              <%= link_to "Next →", root_path(request.query_parameters.merge("page" => @page + 1)),
                    class: "px-3 py-1 border border-gray-300 rounded hover:bg-gray-50" %>
            <% else %>
              <span class="px-3 py-1 border border-gray-200 rounded text-gray-300">Next →</span>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="bg-white border border-gray-200 rounded-lg p-6 text-sm text-gray-600">
        No workflows yet.
      </div>
    <% end %>
  <% end %>
</div>
