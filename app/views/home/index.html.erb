<div class="space-y-6" data-controller="epic-graph-drawer">
  <%# Subscribe to the per-user "jobs" stream so any Job/Run change
      (new Job, state pill move, workflow count tick, mergeability flip)
      morphs the dashboard live without a reload. %>
  <%= turbo_stream_from Current.user, "jobs" %>

  <% rl_user = Current.user %>
  <% if rl_user.gh_rate_limit_remaining&.zero? %>
    <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-800">
      <strong>GitHub quota exhausted.</strong>
      Polls and runs are paused until the quota resets
      <% if rl_user.gh_rate_limit_reset_at %>
        (<%= relative_timestamp(rl_user.gh_rate_limit_reset_at) %>).
      <% else %>
        at the next reset window.
      <% end %>
    </div>
  <% elsif rl_user.gh_rate_limit_remaining && rl_user.gh_rate_limit_remaining < 200 %>
    <div class="rounded-lg bg-amber-50 border border-amber-200 px-4 py-3 text-sm text-amber-800">
      GitHub quota low:
      <strong><%= number_with_delimiter(rl_user.gh_rate_limit_remaining) %></strong> /
      <%= number_with_delimiter(rl_user.gh_rate_limit_limit) %> remaining
      (<%= rl_user.gh_rate_limit_resource || "core" %> bucket).
      Resets <%= relative_timestamp(rl_user.gh_rate_limit_reset_at) %>.
    </div>
  <% end %>

  <div class="flex items-center justify-between">
    <h1 class="font-bold text-3xl">Dashboard</h1>
    <div class="flex items-center gap-2">
      <%= link_to "New Epic", new_epic_path,
            class: "rounded-md px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium" %>
      <%= link_to "New job", new_job_path,
            class: "rounded-md px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium" %>
    </div>
  </div>

  <%# target: "_top" makes top-level navigation the default for every
      link inside this frame. The only in-frame navigations are the
      List/Kanban view toggle below (explicitly marked with
      data-turbo-frame="dashboard_content"). Without target="_top",
      links to /jobs/:id and /epics/:id inherit the frame target,
      fetch the show page, find no matching frame in the response,
      and render "Content missing." %>
  <%= safe_turbo_frame "dashboard_content" do %>
    <% current_view = @dashboard_view.presence || "list" %>
    <% subject_link_classes = ->(active) { "inline-flex items-center gap-2 px-3 py-1.5 text-sm font-medium #{active ? 'bg-blue-600 text-white' : 'text-gray-700 hover:bg-gray-50'}" } %>
    <% view_link_classes = ->(active) { "inline-flex items-center px-2.5 py-1 text-xs font-medium #{active ? 'bg-gray-800 text-white' : 'text-gray-600 hover:bg-gray-50'}" } %>
    <% count_title = ->(count, noun) { "#{pluralize(count, noun)} #{count == 1 ? 'matches' : 'match'} the current filter" } %>

    <nav class="sr-only" aria-label="Legacy dashboard sections">
      <%= link_to "Epics", dashboard_epics_path %>
      <%= link_to "Jobs", dashboard_jobs_path %>
      <%= link_to "Workflows", dashboard_workflows_path %>
    </nav>

    <%# Combined controls row: subject toggle (left, sized to the
        sidebar width on lg so the chip bar aligns with the table's
        left edge), chip bar (middle, grows; hidden on mobile because
        the mobile <details> carries its own copy), view toggle
        (right). gap-5 matches the grid's gap-5 below so the column
        boundaries line up vertically. pb-2 gives a touch more
        breathing room between this row and what follows. %>
    <div class="flex flex-wrap items-center gap-3 lg:gap-5 pb-2">
      <div class="lg:w-64 lg:shrink-0">
      <%# Subject toggle. Counts removed from the badges to make room
          for the chip bar + view toggle on narrower-but-still-lg
          screens — they pushed the chip bar off the right edge and
          clipped "Workflows." The hover tooltip (`title`) still
          carries the count for operators who want it. %>
      <nav class="inline-flex overflow-hidden rounded-md border border-gray-300 bg-white" aria-label="Dashboard subject">
        <%= link_to "Epics", root_path(subject: "epic", view: current_view),
              class: subject_link_classes.call(@active_tab == "epics"),
              title: count_title.call(@epics_matching_count.to_i, "epic"),
              data: { turbo_frame: "_top" } %>
        <%= link_to "Jobs", root_path(subject: "job", view: current_view),
              class: subject_link_classes.call(@active_tab == "jobs"),
              title: count_title.call(@jobs_matching_count.to_i, "job"),
              data: { turbo_frame: "_top" } %>
        <%= link_to "Workflows", root_path(subject: "workflow", view: current_view),
              class: subject_link_classes.call(@active_tab == "workflows"),
              title: count_title.call(@workflows_matching_count.to_i, "workflow"),
              data: { turbo_frame: "_top" } %>
      </nav>
      </div>

      <% if current_view == "kanban" %>
        <div class="flex items-center gap-2" data-kanban-limit-selector>
          <span class="text-xs font-medium uppercase tracking-wide text-gray-500">Limit</span>
          <details class="relative">
            <summary class="flex h-9 cursor-pointer list-none items-center gap-2 rounded-md border border-gray-300 bg-white px-3 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 [&::-webkit-details-marker]:hidden">
              <span><%= @kanban_limit || HomeController::KANBAN_PER_PAGE %></span>
              <span class="text-gray-400">cards</span>
            </summary>
            <div class="absolute left-0 z-20 mt-2 w-32 rounded-md border border-gray-200 bg-white py-1 text-sm shadow-lg">
              <% HomeController::KANBAN_LIMIT_OPTIONS.each do |limit| %>
                <% limit_params = request.query_parameters.except("page").merge("subject" => @dashboard_subject, "view" => "kanban", "kanban_limit" => limit) %>
                <%= link_to root_path(limit_params),
                      class: "flex items-center justify-between px-3 py-2 text-gray-700 hover:bg-gray-50 #{limit == @kanban_limit ? 'font-semibold' : ''}",
                      data: { turbo_frame: "dashboard_content", turbo_action: "advance" } do %>
                  <span><%= limit %></span>
                  <% if limit == @kanban_limit %>
                    <span class="text-xs text-blue-600">Current</span>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          </details>
        </div>
      <% end %>

      <%# flex-1 lets the chip bar swell to fill the gap; min-w-0
          keeps the chip bar's wrap behavior correct inside a flex
          parent. Per-tab branch picks the right filter ivar. %>
      <div class="hidden lg:block flex-1 min-w-0">
        <% if @active_tab == "epics" %>
          <%= render "home/chip_bar",
                subject: :epic,
                filter: @filter,
                schema: @schema,
                action_url: root_path(subject: "epic", view: current_view),
                class_name: "relative" %>
        <% elsif @active_tab == "jobs" %>
          <%= render "chip_bar", class_name: "relative" %>
        <% elsif @active_tab == "workflows" %>
          <%= render "home/chip_bar",
                subject: :workflow,
                filter: @workflow_filter,
                schema: @schema,
                action_url: root_path(subject: "workflow", view: current_view),
                class_name: "relative" %>
        <% end %>
      </div>

      <nav class="inline-flex overflow-hidden rounded-md border border-gray-300 bg-white" aria-label="Dashboard view">
        <% view_params = request.query_parameters.except("page").merge("subject" => @dashboard_subject, "view" => "list") %>
        <%= link_to "List", root_path(view_params),
              class: view_link_classes.call(current_view == "list"),
              data: { turbo_frame: "dashboard_content", turbo_action: "advance" } %>
        <% view_params = request.query_parameters.except("page").merge("subject" => @dashboard_subject, "view" => "kanban") %>
        <%= link_to "Kanban", root_path(view_params),
              class: view_link_classes.call(current_view == "kanban"),
              data: { turbo_frame: "dashboard_content", turbo_action: "advance" } %>
      </nav>
    </div>

  <% if @active_tab == "epics" %>
    <% if current_view == "list" %>
      <% folder_link_classes = ->(active) { "flex items-center justify-between rounded-md px-2 py-1.5 text-sm #{active ? 'bg-blue-50 text-blue-700 font-medium' : 'text-gray-700 hover:bg-gray-50'}" } %>
      <% epics_total_pages = (@epics_total.to_f / HomeController::PER_PAGE).ceil %>

      <details class="group rounded-lg border border-gray-200 bg-white lg:hidden">
        <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm font-medium text-gray-700">
          <span>Folders and filters</span>
          <span class="text-gray-400 group-open:hidden">Show</span>
          <span class="hidden text-gray-400 group-open:inline">Hide</span>
        </summary>
        <div class="space-y-4 border-t border-gray-200 p-3">
          <%= render "epics/epic_smart_folders", folder_link_classes: folder_link_classes %>
          <%= render "home/chip_bar",
                subject: :epic,
                filter: @filter,
                schema: @schema,
                action_url: root_path(subject: "epic", view: current_view),
                class_name: "relative flex flex-col gap-3" %>
          <%= render "epics/save_smart_folder_form", class_name: "flex flex-col gap-2 rounded-md border border-gray-200 bg-gray-50 px-3 py-2 text-sm" %>
        </div>
      </details>

      <div class="grid gap-5 lg:grid-cols-[16rem_1fr]">
        <aside class="hidden space-y-4 lg:block">
          <%= render "epics/epic_smart_folders", folder_link_classes: folder_link_classes %>
        </aside>

        <div class="space-y-4">
          <%= render "epics/save_smart_folder_form", class_name: "hidden flex-wrap items-center gap-2 rounded-md border border-gray-200 bg-gray-50 px-3 py-2 text-sm lg:flex" %>
          <%= mobile_sort_select(subject: :epic, current_sort: @epic_sort) %>
          <div class="overflow-hidden rounded-lg border border-gray-200 bg-white">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="hidden bg-gray-50 text-xs uppercase text-gray-500 sm:table-header-group">
                <tr>
                  <% if dashboard_column_visible?("epics", "state") %>
                    <%= sort_header(subject: :epic, column: :state, current_sort: @epic_sort, th_class: "px-4 py-2 text-left") %>
                  <% end %>
                  <%= sort_header(subject: :epic, column: :title, current_sort: @epic_sort, th_class: "px-4 py-2 text-left") %>
                  <% if dashboard_column_visible?("epics", "repository") %>
                    <%= sort_header(subject: :epic, column: :repository, current_sort: @epic_sort, th_class: "hidden sm:table-cell px-4 py-2 text-left") %>
                  <% end %>
                  <% if dashboard_column_visible?("epics", "updated") %>
                    <%= sort_header(subject: :epic, column: :updated_at, current_sort: @epic_sort, th_class: "hidden sm:table-cell px-4 py-2 text-left") %>
                  <% end %>
                  <% dashboard_timestamp_columns("epics").each do |column| %>
                    <% if dashboard_column_visible?("epics", column) %>
                      <th class="hidden sm:table-cell px-4 py-2 text-left"><%= dashboard_column_label("epics", column) %></th>
                    <% end %>
                  <% end %>
                  <th class="px-4 py-2 text-right">
                    <%= render "home/column_picker", subject: "epics" %>
                  </th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100 text-sm">
                <% @epics.each do |epic| %>
                  <tr>
                    <% if dashboard_column_visible?("epics", "state") %>
                      <td class="px-4 py-3 align-top"><%= state_pill(epic.state) %></td>
                    <% end %>
                    <td class="px-4 py-3">
                      <div class="font-medium text-gray-900">
                        <span class="font-mono text-xs text-gray-500"><%= epic.display_number %></span>
                        <%= link_to epic.title, epic_path(epic), class: "ml-1 hover:underline" %>
                      </div>
                      <% if epic.description.present? %>
                        <div class="mt-1 line-clamp-2 text-sm text-gray-500"><%= epic.description %></div>
                      <% end %>
                      <div class="mt-1 sm:hidden text-xs font-mono text-gray-500">
                        <%= link_to epic.repository.slug, repository_path(epic.repository), class: "hover:underline" %>
                      </div>
                    </td>
                    <% if dashboard_column_visible?("epics", "repository") %>
                      <td class="hidden sm:table-cell px-4 py-3 font-mono">
                        <%= link_to epic.repository.slug, repository_path(epic.repository), class: "text-gray-700 hover:underline" %>
                      </td>
                    <% end %>
                    <% if dashboard_column_visible?("epics", "updated") %>
                      <td class="hidden sm:table-cell px-4 py-3 text-gray-500"><%= relative_timestamp(epic.updated_at) %></td>
                    <% end %>
                    <% dashboard_timestamp_columns("epics").each do |column| %>
                      <% if dashboard_column_visible?("epics", column) %>
                        <td class="hidden sm:table-cell px-4 py-3 text-gray-500"><%= relative_timestamp(epic.public_send(column)) %></td>
                      <% end %>
                    <% end %>
                    <td class="px-4 py-3 text-right">
                      <%= link_to "View", epic_path(epic), class: "text-blue-600 underline hover:no-underline" %>
                    </td>
                  </tr>
                <% end %>
                <% if @epics.empty? %>
                  <tr>
                    <td colspan="<%= Current.user.dashboard_visible_columns("epics").size + 1 %>" class="px-4 py-8 text-center text-sm text-gray-500">No epics match these filters.</td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <% if epics_total_pages > 1 %>
            <% first_item = (@page - 1) * HomeController::PER_PAGE + 1 %>
            <% last_item = [@page * HomeController::PER_PAGE, @epics_total].min %>
            <div class="flex items-center justify-between text-sm text-gray-600">
              <span>Showing <%= first_item %>–<%= last_item %> of <%= @epics_total %></span>
              <div class="flex gap-2">
                <% if @page > 1 %>
                  <%= link_to "← Previous", root_path(request.query_parameters.merge("subject" => "epic", "view" => current_view, "page" => @page - 1)),
                        class: "px-3 py-1 border border-gray-300 rounded hover:bg-gray-50" %>
                <% else %>
                  <span class="px-3 py-1 border border-gray-200 rounded text-gray-300">← Previous</span>
                <% end %>
                <% if @page < epics_total_pages %>
                  <%= link_to "Next →", root_path(request.query_parameters.merge("subject" => "epic", "view" => current_view, "page" => @page + 1)),
                        class: "px-3 py-1 border border-gray-300 rounded hover:bg-gray-50" %>
                <% else %>
                  <span class="px-3 py-1 border border-gray-200 rounded text-gray-300">Next →</span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <% folder_link_classes = ->(active) { "flex items-center justify-between rounded-md px-2 py-1.5 text-sm #{active ? 'bg-blue-50 text-blue-700 font-medium' : 'text-gray-700 hover:bg-gray-50'}" } %>

      <details class="group rounded-lg border border-gray-200 bg-white lg:hidden">
        <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm font-medium text-gray-700">
          <span>Folders and filters</span>
          <span class="text-gray-400 group-open:hidden">Show</span>
          <span class="hidden text-gray-400 group-open:inline">Hide</span>
        </summary>
        <div class="space-y-4 border-t border-gray-200 p-3">
          <%= render "epics/epic_smart_folders", folder_link_classes: folder_link_classes %>
          <%= render "home/chip_bar",
                subject: :epic,
                filter: @filter,
                schema: @schema,
                action_url: root_path(subject: "epic", view: current_view),
                class_name: "relative flex flex-col gap-3" %>
          <%= render "epics/save_smart_folder_form", class_name: "flex flex-col gap-2 rounded-md border border-gray-200 bg-gray-50 px-3 py-2 text-sm" %>
        </div>
      </details>

      <div class="grid gap-5 lg:grid-cols-[16rem_1fr]">
        <aside class="hidden space-y-4 lg:block">
          <%= render "epics/epic_smart_folders", folder_link_classes: folder_link_classes %>
        </aside>

        <div class="space-y-4">
          <%= render "epics/save_smart_folder_form", class_name: "hidden flex-wrap items-center gap-2 rounded-md border border-gray-200 bg-gray-50 px-3 py-2 text-sm lg:flex" %>
          <%= render "shared/kanban_board",
                subject: :epic,
                records: @epic_records,
                column_attribute: :state,
                columns: Epic::BOARD_STATES,
                card_partial: "epics/card",
                drag_enabled: true,
                drop_endpoint: ->(epic) { state_epic_path(epic) },
                empty_column_messages: {} %>
        </div>
      </div>
    <% end %>
  <% elsif @active_tab == "jobs" %>
    <details class="group rounded-lg border border-gray-200 bg-white lg:hidden">
      <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm font-medium text-gray-700">
        <span>Folders and filters</span>
        <span class="text-gray-400 group-open:hidden">Show</span>
        <span class="hidden text-gray-400 group-open:inline">Hide</span>
      </summary>
      <div class="space-y-4 border-t border-gray-200 p-3">
        <%= render "smart_folders" %>
        <%= render "chip_bar", class_name: "relative flex flex-col gap-3" %>
        <%= render "save_smart_folder_form", class_name: "flex flex-col gap-2 rounded-md border border-gray-200 bg-gray-50 px-3 py-2 text-sm" %>
      </div>
    </details>

    <div class="grid gap-5 lg:grid-cols-[16rem_1fr]">
      <aside class="hidden space-y-4 lg:block">
        <%= render "smart_folders" %>
      </aside>

      <div class="space-y-4">
        <%= render "save_smart_folder_form", class_name: "hidden flex-wrap items-center gap-2 rounded-md border border-gray-200 bg-gray-50 px-3 py-2 text-sm lg:flex" %>

        <%# The List/Kanban toggle and Kanban limit selector live in the
            top-level dashboard controls. %>
    <% if @epics&.any? %>
      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
        <div class="px-4 py-3 border-b border-gray-200">
          <h2 class="font-semibold text-lg">Epics awaiting your move</h2>
        </div>
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50 text-xs uppercase text-gray-500">
            <tr>
              <th class="px-4 py-2 text-left">State</th>
              <th class="px-4 py-2 text-left">Epic</th>
              <th class="hidden sm:table-cell px-4 py-2 text-left">Repository</th>
              <th class="hidden sm:table-cell px-4 py-2 text-left">Updated</th>
              <th class="px-4 py-2"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 text-sm">
            <% @epics.each do |epic| %>
              <tr>
                <td class="px-4 py-3 align-top"><%= state_pill(epic.state) %></td>
                <td class="px-4 py-3">
                  <div class="font-medium text-gray-900">
                    <%= link_to epic.title, epic_path(epic), class: "hover:underline" %>
                  </div>
                  <%= form_with url: dashboard_epic_auto_approval_path(epic), method: :patch,
                        scope: :epic, class: "mt-2 flex flex-wrap items-center gap-2 text-xs" do |form| %>
                    <%= form.label :auto_approve_mode, "Auto-approval", class: "font-medium text-gray-700" %>
                    <%= form.select :auto_approve_mode, auto_approve_mode_options, {},
                          class: "rounded border border-gray-300 bg-white px-2 py-1 text-xs" %>
                    <%= form.submit "Update", class: "text-blue-600 underline hover:no-underline cursor-pointer" %>
                    <span class="text-gray-500"><%= auto_approve_preview(epic) %></span>
                  <% end %>
                  <div class="sm:hidden text-xs font-mono text-gray-500 mt-0.5">
                    <%= link_to epic.repository.slug, repository_path(epic.repository), class: "hover:underline" %>
                  </div>
                </td>
                <td class="hidden sm:table-cell px-4 py-3 font-mono">
                  <%= link_to epic.repository.slug, repository_path(epic.repository), class: "text-gray-700 hover:underline" %>
                </td>
                <td class="hidden sm:table-cell px-4 py-3 text-gray-500"><%= relative_timestamp(epic.updated_at) %></td>
                <td class="px-4 py-3 text-right">
                  <details class="relative inline-block text-left">
                    <summary class="cursor-pointer list-none rounded-md border border-gray-300 px-2 py-1 text-xs font-medium text-gray-700 hover:bg-gray-50">
                      Menu
                    </summary>
                    <div class="absolute right-0 z-10 mt-2 w-56 rounded-md border border-gray-200 bg-white py-1 text-sm shadow-lg">
                      <%= link_to "Show dependency graph",
                            graph_epic_path(epic, drawer: 1),
                            class: "block px-3 py-2 text-left text-gray-700 hover:bg-gray-50",
                            data: {
                              turbo_frame: "epic_graph_drawer_body",
                              action: "epic-graph-drawer#open"
                            } %>
                    </div>
                  </details>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <% if @dashboard_view == "kanban" %>
      <% if @job_kanban_lanes.values.flatten.any? %>
        <%= render "kanban_board",
              lanes: HomeController::JOB_KANBAN_LANES,
              items_by_lane: @job_kanban_lanes,
              card_partial: "jobs/card",
              item_name: :job,
              empty_label: "No jobs." %>
      <% elsif !@epics&.any? %>
        <div class="bg-white border border-gray-200 rounded-lg p-6 text-sm text-gray-600">
          <% if @job_filter.active? %>
            No jobs match the current filters.
          <% else %>
            No jobs yet. Add a repository, enable polling, label an issue
            <code class="bg-gray-100 px-1 rounded">syrus</code>, and one will show up here.
          <% end %>
        </div>
      <% end %>
    <% elsif @jobs.any? || @page > 1 %>
      <% jobs_total_pages = (@jobs_total.to_f / HomeController::PER_PAGE).ceil %>
      <% unless @custom_job_ordering %>
        <%= mobile_sort_select(subject: :job, current_sort: @job_sort) %>
      <% end %>
      <%= form_with url: bulk_dashboard_jobs_path, method: :post,
            data: { controller: "bulk-jobs" },
            class: "space-y-3" do %>
        <div data-bulk-jobs-target="actions"
             class="hidden flex flex-wrap items-center gap-2 rounded-md border border-gray-200 bg-gray-50 px-3 py-2 text-sm">
          <span class="text-gray-600">Bulk actions for <span data-bulk-jobs-target="count">0</span></span>
          <%= button_tag "Retry", name: :bulk_action, value: "retry",
                class: "rounded-md px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
          <% if @configured_agent_providers.size > 1 %>
            <% @configured_agent_providers.each do |provider| %>
              <%= button_tag "Retry with #{provider.titleize}", name: :bulk_action, value: "retry:#{provider}",
                    class: "rounded-md px-3 py-1.5 border border-blue-200 bg-white text-blue-700 hover:bg-blue-50 font-medium cursor-pointer" %>
            <% end %>
          <% end %>
          <%= button_tag "Close", name: :bulk_action, value: "close",
                class: "rounded-md px-3 py-1.5 bg-amber-600 hover:bg-amber-500 text-white font-medium cursor-pointer",
                data: { turbo_confirm: "Cancel active runs and close the selected jobs?" } %>
          <%= button_tag name: :bulk_action, value: "approve",
                class: "rounded-md px-3 py-1.5 bg-green-600 hover:bg-green-500 text-white font-medium cursor-pointer",
                data: { turbo_confirm: "Approve the selected implemented jobs?" } do %>
            Approve <span data-bulk-jobs-target="count">0</span>
          <% end %>
          <%= button_tag name: :bulk_action, value: "review_approve",
