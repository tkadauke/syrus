<div class="grid gap-4 xl:grid-cols-4 lg:grid-cols-2">
  <% lanes.each do |lane| %>
    <% lane_items = items_by_lane.fetch(lane.fetch(:key), []) %>
    <section class="min-w-0 rounded-lg border border-gray-200 bg-gray-50"
             data-kanban-lane="<%= lane.fetch(:key) %>">
      <div class="flex items-center justify-between border-b border-gray-200 px-3 py-2">
        <h2 class="text-sm font-semibold text-gray-900"><%= lane.fetch(:title) %></h2>
        <span class="rounded-full bg-white px-2 py-0.5 text-xs font-medium text-gray-600"><%= lane_items.size %></span>
      </div>
      <div class="space-y-3 p-3">
        <% if lane_items.any? %>
          <% lane_items.each do |item| %>
            <%= render card_partial, item_name => item %>
          <% end %>
        <% else %>
          <div class="rounded-md border border-dashed border-gray-300 bg-white px-3 py-4 text-center text-sm text-gray-500">
            <%= local_assigns.fetch(:empty_label, "No items.") %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
