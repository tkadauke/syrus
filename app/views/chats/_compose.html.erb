<% action_path = chat_session ? chat_message_path(chat_session) : chats_path %>
<% stop_requested = chat_session&.stop_requested_at.present? %>
<% controls_id = chat_session ? "chat_session_#{chat_session.id}_controls" : "new_chat_controls" %>

<div id="<%= controls_id %>" class="bg-white border border-gray-200 rounded-lg p-3">
  <div class="flex flex-wrap items-end gap-3">
    <%= form_with url: action_path,
          method: :post,
          class: "flex flex-1 items-end gap-3",
          data: { chat_target: "composeForm" } do |form| %>
      <%# rows: 1 + autoGrow JS makes the textarea start single-line and
          expand up to ~3 lines while typing; after that the inner
          overflow scrolls. max-h-[4.75rem] is 3 × leading-5 + py-2. %>
      <%= text_area_tag "chat_message[text]",
            nil,
            rows: 1,
            required: true,
            placeholder: chat_session&.repository ? "Ask about this repository..." : "Attach a repository to start chatting...",
            class: "min-h-9 max-h-[4.75rem] flex-1 resize-none overflow-y-auto rounded-md border border-gray-300 px-3 py-2 text-sm leading-5 focus:border-blue-500 focus:ring-blue-500",
            data: { chat_target: "textarea", action: "input->chat#autoGrow keydown->chat#submitOnEnter" },
            disabled: turn_in_flight %>
      <%= submit_tag "Send",
            class: "rounded-md px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium cursor-pointer disabled:cursor-not-allowed disabled:bg-gray-300",
            data: { chat_target: "sendButton" },
            disabled: turn_in_flight %>
    <% end %>
    <% if chat_session && turn_in_flight %>
      <%= button_to(stop_requested ? "Stopping…" : "Stop",
            chat_stop_path(chat_session),
            method: :post,
            class: "rounded-md px-4 py-2 border border-red-200 bg-white text-sm font-medium text-red-700 hover:bg-red-50 disabled:cursor-not-allowed disabled:border-gray-200 disabled:text-gray-400",
            disabled: stop_requested,
            form: { data: { action: "submit->chat#stop" } },
            data: { chat_target: "stopButton" }) %>
    <% end %>
  </div>
</div>
