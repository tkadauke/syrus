<% content_hash = message.content.is_a?(Hash) ? message.content : {} %>
<% tool_name = message.tool_name.presence || content_hash["name"].presence || "tool_result" %>
<% proposal_tool = tool_name.to_s.include?("proposal") || tool_name.to_s.include?("propose_issue") %>
<% payload = content_hash.presence || { "content" => message.content } %>

<%# Structured/canvas tool_result card. Same treatment as
    tool_use_card: a compact line by default, the emerald body only
    materializes when expanded so the chat surface stays quiet. %>
<details <%= "open" if proposal_tool %> class="chat-message group/tool text-xs open:rounded-md open:border open:border-emerald-200 open:bg-emerald-50">
  <summary class="flex cursor-pointer items-baseline gap-2 py-0.5 select-none text-sm text-gray-700 hover:text-gray-900 group-open/tool:px-3 group-open/tool:py-2">
    <span class="text-gray-400 group-open/tool:rotate-90 transition-transform">▸</span>
    <span class="font-mono font-medium text-gray-900"><%= tool_name %></span>
    <% if message.proposal %>
      <span class="text-gray-500">→</span>
      <%# The model state is "proposed" but operators read it as
          "pending" — surface the friendlier label here. Other states
          (confirmed / rejected / withdrawn) read fine literally. %>
      <% state_label = message.proposal.state == "proposed" ? "pending" : message.proposal.state %>
      <span class="text-gray-600">Proposal #<%= message.proposal.id %> created (<%= state_label %>)</span>
    <% end %>
  </summary>
  <% if message.proposal&.job&.epic %>
    <div class="px-3 pb-3">
      <%= render "epics/dependency_graph", epic: message.proposal.job.epic, initially_open: false, compact: true %>
    </div>
  <% end %>
  <pre class="overflow-x-auto px-3 pb-3 font-mono text-gray-700 whitespace-pre-wrap break-words"><%= JSON.pretty_generate(payload) %></pre>
</details>
