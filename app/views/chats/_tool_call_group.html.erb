<%# A run of consecutive same-named tool calls collapsed into a single
    line. Summary shows the tool name and the comma-joined details
    ("Read foo.py, bar.py, baz.py"). Expanding reveals each call's
    full args plus the result the agent received. No surrounding box
    — these calls are agent-overhead, not first-class chat content.

    Locals:
      group: { tool:, calls: [{ message:, detail:, result: }, ...] }
      repository: the Repository

    For live-broadcast appends the same partial is rendered from
    _message.html.erb with a one-call group, so the on-screen shape
    stays uniform between initial render and append.
%>
<% tool = group[:tool] %>
<% calls = group[:calls] %>
<% details = calls.map { |c| c[:detail].to_s }.reject(&:blank?) %>
<details class="chat-message group/tool"
         data-chat-target="message"
         data-tool-call="true"
         data-tool-name="<%= tool %>">
  <summary class="flex min-w-0 cursor-pointer items-baseline gap-2 py-0.5 text-sm text-gray-700 select-none hover:text-gray-900">
    <span class="text-gray-400 group-open/tool:rotate-90 transition-transform">▸</span>
    <span class="font-mono font-medium text-gray-900" data-tool-name><%= tool %></span>
    <span class="min-w-0 flex-1 truncate font-mono text-gray-600" data-tool-detail><%= details.join(", ") %></span>
    <span class="ml-auto rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-500 <%= 'hidden' if calls.size < 2 %>"
          data-tool-call-count><%= calls.size %></span>
  </summary>
  <div class="mt-1 ml-5 space-y-2 border-l border-gray-200 pl-3 text-xs" data-tool-call-body>
    <% calls.each do |call| %>
      <div>
        <div class="break-words font-mono text-gray-700">
          <%= tool %><% if call[:detail].present? %>(<%= call[:detail] %>)<% end %>
        </div>
        <% if call[:result] %>
          <% rc = call[:result].content %>
          <% result_body = rc.is_a?(Hash) ? AgentEventAbbreviator.full_result_body(rc["result"]) : rc.to_s %>
          <pre class="mt-1 whitespace-pre-wrap break-words font-mono text-gray-600 <%= 'text-red-600' if rc.is_a?(Hash) && rc['is_error'] %>"><%= result_body %></pre>
        <% end %>
      </div>
    <% end %>
  </div>
</details>
