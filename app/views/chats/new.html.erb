<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="font-bold text-3xl">New chat</h1>
    <%= link_to "Repositories", repositories_path, class: "text-sm text-blue-600 underline hover:no-underline" %>
  </div>

  <section class="max-w-3xl rounded-lg border border-gray-200 bg-white p-4">
    <%= form_with url: chats_path, method: :post, class: "space-y-4" do %>
      <div>
        <label for="repository_id" class="block text-sm font-medium text-gray-700">Repository</label>
        <%= select_tag :repository_id,
              options_from_collection_for_select(Current.user.repositories.active.order(:owner, :name), :id, :slug),
              include_blank: "Attach later",
              class: "mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
      </div>
      <div>
        <label for="chat_message_text" class="block text-sm font-medium text-gray-700">First message</label>
        <%= text_area_tag "chat_message[text]",
              nil,
              id: "chat_message_text",
              rows: 4,
              placeholder: "Optional",
              class: "mt-1 w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
      </div>
      <%= submit_tag "Create chat",
            class: "rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-500" %>
    <% end %>
  </section>
</div>
