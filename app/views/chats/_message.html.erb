<% text = message.content.is_a?(Hash) ? message.content["text"].to_s : message.content.to_s %>
<% dom_id = "chat_message_#{message.id}" %>
<% bookmarkable = message.bookmarkable? %>

<div id="<%= dom_id %>"
     class="chat-message group/message relative"
     <% if bookmarkable %>data-controller="bookmark-modal"<% end %>
     data-chat-target="message"
     data-message-id="<%= message.id %>">
  <span id="message-<%= message.id %>" class="absolute -top-4"></span>
  <% if bookmarkable %>
    <button type="button"
            class="absolute right-0 top-0 z-10 hidden rounded-md border border-gray-200 bg-white px-2 py-1 text-xs font-medium text-gray-600 shadow-sm hover:bg-gray-50 group-hover/message:block"
            data-action="bookmark-modal#open">
      Bookmark this
    </button>
    <dialog id="bookmark-modal-message-<%= message.id %>"
            data-turbo-permanent
            class="w-full max-w-sm rounded-lg border border-gray-200 bg-white p-0 shadow-xl backdrop:bg-gray-900/30"
            data-bookmark-modal-target="dialog">
      <%= form_with url: chat_bookmarks_path(message.chat_session), method: :post, class: "space-y-4 p-4" do %>
        <%= hidden_field_tag :message_id, message.id %>
        <div>
          <h2 class="text-sm font-semibold text-gray-900">Bookmark message</h2>
          <p class="mt-1 text-xs text-gray-500">Add this message to the chat table of contents.</p>
        </div>
        <div>
          <label for="chat_bookmark_label_<%= message.id %>" class="block text-xs font-medium text-gray-600">Label</label>
          <%= text_field_tag "chat_bookmark[label]",
                nil,
                id: "chat_bookmark_label_#{message.id}",
                required: true,
                maxlength: 120,
                class: "mt-1 w-full rounded-md border border-gray-300 px-2 py-1.5 text-sm",
                data: { bookmark_modal_target: "label" } %>
        </div>
        <div class="flex justify-end gap-2">
          <button type="button"
                  class="rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50"
                  data-action="bookmark-modal#close">
            Cancel
          </button>
          <%= submit_tag "Save",
                class: "rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-blue-500" %>
        </div>
      <% end %>
    </dialog>
  <% end %>
  <% case message.role
     when "user" %>
    <div class="flex justify-end">
      <div class="chat-prose chat-prose-invert max-w-[min(42rem,85%)] rounded-lg bg-blue-600 px-4 py-2 text-white"><%= render_markdown(text) %></div>
    </div>
  <% when "assistant" %>
    <% if message.proposal_card? %>
      <%= render "chats/proposal_card", proposal: message.proposal, repository: repository, chat_session: message.chat_session %>
    <% else %>
      <div class="max-w-3xl rounded-lg border border-gray-200 bg-white px-4 py-3">
        <div class="chat-prose text-gray-800">
          <%= render_markdown(text) %>
        </div>
      </div>
    <% end %>
  <% when "tool_use" %>
    <% if ChatMessageGrouper.groupable_tool_use?(message) %>
      <%# Live broadcast path. Renders one collapsed tool-call line. The
          chat controller's mutation observer merges adjacent same-tool
          appends and pulls the matching tool_result into the body. %>
      <%= render "chats/tool_call_group",
            group: ChatMessageGrouper.single_call_group(message, repository: repository),
            repository: repository %>
    <% else %>
      <%= render "chats/tool_use_card", message: message, repository: repository %>
    <% end %>
  <% when "tool_result" %>
    <% if ChatMessageGrouper.groupable_tool_result?(message) %>
      <%# Hidden in the default view; JS pairs into the preceding call. %>
      <%= render "chats/tool_call_live_result", message: message, repository: repository %>
    <% else %>
      <%= render "chats/tool_result_card", message: message, repository: repository %>
    <% end %>
  <% when "system" %>
    <%= render_chat_system_message(text) %>
  <% end %>
</div>
