<%# Split button: a primary action with a trailing chevron that
    toggles a dropdown of related options. Use to consolidate
    related actions where one is the common case and the others
    are variants (e.g. Job#show's Retry / Retry-from-failed-step
    / Start-over cluster).

    Locals:
      primary  — { label:, path:, method: :post, confirm: nil }
      options  — [{ label:, path:, method: :post, confirm: nil }, …]
      theme    — color theme name; see SPLIT_BUTTON_THEMES (default "blue")
      disabled — true to render the primary as a no-op (chevron + dropdown
                 still work). Use when the primary action isn't applicable
                 in the current context but the alternatives are.
%>
<% theme_classes = split_button_theme(local_assigns.fetch(:theme, "blue")) %>
<% disabled = local_assigns.fetch(:disabled, false) %>
<% primary_method = primary[:method] || :post %>
<% primary_title = primary[:title] %>
<% primary_form = { class: "inline" } %>
<% primary_form[:data] = { turbo_confirm: primary[:confirm] } if primary[:confirm] %>

<div class="relative inline-flex" data-controller="split-button">
  <% if disabled %>
    <button type="button" disabled
            title="<%= primary_title %>"
            class="<%= theme_classes %> rounded-l-md px-3 py-1.5 text-sm font-medium opacity-60 cursor-not-allowed">
      <%= primary[:label] %>
    </button>
  <% else %>
    <%= button_to primary[:label], primary[:path], method: primary_method,
          class: "#{theme_classes} rounded-l-md px-3 py-1.5 text-sm font-medium cursor-pointer",
          title: primary_title,
          form: primary_form %>
  <% end %>

  <button type="button"
          data-action="split-button#toggle"
          class="<%= theme_classes %> rounded-r-md px-2 py-1.5 border-l border-white/30 cursor-pointer flex items-center"
          aria-label="More actions">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 011.08 1.04l-4.25 4.39a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
    </svg>
  </button>

  <div data-split-button-target="menu"
       class="hidden absolute right-0 top-full mt-1 z-10 min-w-max bg-white border border-gray-200 rounded-md shadow-lg overflow-hidden">
    <% options.each do |opt| %>
      <% if opt[:data_action] %>
        <button type="button"
                data-action="<%= opt[:data_action] %>"
                class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 cursor-pointer whitespace-nowrap">
          <%= opt[:label] %>
        </button>
      <% else %>
        <% opt_form = { class: "block" } %>
        <% opt_form[:data] = { turbo_confirm: opt[:confirm] } if opt[:confirm] %>
        <%= button_to opt[:label], opt[:path], method: (opt[:method] || :post),
              class: "block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 cursor-pointer whitespace-nowrap",
              form: opt_form %>
      <% end %>
    <% end %>
  </div>
</div>
