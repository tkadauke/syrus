<%= form_with model: task, url: form_url, scope: :scheduled_task, class: "space-y-5",
              data: { controller: "scheduled-task-form" } do |form| %>
  <% if task.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-800 rounded-md p-3 text-sm">
      <ul class="list-disc list-inside">
        <% task.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Name", class: "block text-sm font-medium text-gray-700" %>
    <p class="text-xs text-gray-500 mt-1">Short label shown in the dashboard.</p>
    <%= form.text_field :name,
          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>

  <div>
    <%= form.label :kind, "Kind", class: "block text-sm font-medium text-gray-700" %>
    <%= form.select :kind, ScheduledTask::KINDS.map { |k| [ k, k ] },
          {},
          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full",
          data: { scheduled_task_form_target: "kindSelect", action: "change->scheduled-task-form#kindChanged" } %>
    <p class="text-xs text-gray-500 mt-1">
      <strong>cron</strong> recurs on a schedule (min 1-hour interval). <strong>one_shot</strong> fires once at a specific time.
    </p>
  </div>

  <div data-scheduled-task-form-target="cronSection" class="<%= 'hidden' if task.one_shot? %>">
    <%= form.label :cron_expression, "Cron expression", class: "block text-sm font-medium text-gray-700" %>
    <p class="text-xs text-gray-500 mt-1">
      Standard 5-field cron: <code>min hour day-of-month month day-of-week</code>.
      Must fire at most once per hour. The minute slot will be auto-replaced with this task's
      stored offset (<%= task.minute_offset %>) at fire time, so two tasks with the same nominal
      schedule don't collide.
    </p>
    <p class="text-xs text-gray-500 mt-1">
      Examples — <code>0 * * * *</code> (top of every hour),
      <code>0 9 * * *</code> (9am daily UTC),
      <code>0 9 * * 1</code> (Monday 9am UTC),
      <code>0 0 1 * *</code> (1st of each month).
    </p>
    <%= form.text_field :cron_expression, placeholder: "0 9 * * 1",
          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full font-mono" %>
  </div>

  <div data-scheduled-task-form-target="oneShotSection" class="<%= 'hidden' unless task.one_shot? %>">
    <%= form.label :fire_at, "Fire at", class: "block text-sm font-medium text-gray-700" %>
    <p class="text-xs text-gray-500 mt-1">UTC. Must be in the future.</p>
    <%= form.datetime_local_field :fire_at,
          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>

  <div>
    <%= form.label :pr_pileup_policy, "PR pileup policy", class: "block text-sm font-medium text-gray-700" %>
    <%= form.select :pr_pileup_policy, ScheduledTask::PR_PILEUP_POLICIES.map { |p| [ p, p ] }, {},
          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    <p class="text-xs text-gray-500 mt-1">
      What to do if the previous fire's PR is still open when the next tick comes:
      <strong>skip</strong> (recommended) — don't fire until the previous PR closes;
      <strong>pile</strong> — open another PR (they accumulate);
      <strong>replace</strong> — close the previous PR, open a fresh one.
    </p>
  </div>

  <div>
    <%= form.label :prompt, "Prompt", class: "block text-sm font-medium text-gray-700" %>
    <p class="text-xs text-gray-500 mt-1">
      The standing instruction for the agent. A Syrus preamble gets prepended at fire time
      that explains this is a scheduled task and tells the agent NOT to invent work.
      Variables: <code>{{repo_slug}}</code>, <code>{{repo_default_branch}}</code>,
      <code>{{date}}</code>, <code>{{last_fired_at}}</code>, <code>{{last_successful_fire_at}}</code>.
    </p>
    <%= form.text_area :prompt, rows: 8,
          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full font-mono" %>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit submit_label,
          class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
    <%= link_to "Cancel", cancel_url, class: "text-sm text-gray-600 hover:text-gray-900" %>
  </div>
<% end %>
