<div class="space-y-6">
  <div class="flex items-start justify-between gap-4">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="font-bold text-2xl"><%= @task.name %></h1>
        <%= scheduled_task_state_pill(@task) %>
      </div>
      <p class="text-sm text-gray-600 mt-1">
        <%= link_to @task.repository.slug, repository_path(@task.repository), class: "font-mono text-blue-600 underline hover:no-underline" %>
        — <%= @task.kind %>
      </p>
    </div>

    <div class="flex items-center gap-2">
      <% if @task.state == "scheduled" %>
        <%= button_to "Pause", pause_scheduled_task_path(@task), method: :post,
              class: "rounded-md px-3 py-1.5 text-sm bg-gray-100 hover:bg-gray-200 cursor-pointer",
              form: { class: "inline" } %>
      <% elsif @task.paused? || @task.auto_paused? %>
        <%= button_to "Resume", resume_scheduled_task_path(@task), method: :post,
              class: "rounded-md px-3 py-1.5 text-sm bg-green-600 hover:bg-green-500 text-white cursor-pointer",
              form: { class: "inline" } %>
      <% end %>
      <% if @task.cron? && !@task.archived? %>
        <%= button_to "Fire now", fire_now_scheduled_task_path(@task), method: :post,
              class: "rounded-md px-3 py-1.5 text-sm bg-blue-600 hover:bg-blue-500 text-white cursor-pointer",
              form: { class: "inline" } %>
      <% end %>
      <%= link_to "Edit", edit_scheduled_task_path(@task),
            class: "rounded-md px-3 py-1.5 text-sm border border-gray-300 hover:bg-gray-50" %>
      <%= button_to "Archive", scheduled_task_path(@task), method: :delete,
            data: { turbo_confirm: "Archive this scheduled task?" },
            class: "rounded-md px-3 py-1.5 text-sm border border-gray-300 hover:bg-red-50 text-red-700 cursor-pointer",
            form: { class: "inline" } %>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg p-4">
    <h2 class="font-semibold text-sm uppercase text-gray-500 mb-2">Schedule</h2>
    <dl class="grid grid-cols-2 gap-y-2 text-sm">
      <% if @task.cron? %>
        <dt class="text-gray-500">Cron expression (entered)</dt>
        <dd class="font-mono"><%= @task.cron_expression %></dd>
        <dt class="text-gray-500">Hourly schedule used</dt>
        <dd class="font-mono"><%= @task.hourly_cron_expression %></dd>
        <dt class="text-gray-500">Next fire window</dt>
        <dd><%= @task.next_fire_at&.utc&.iso8601 || '—' %></dd>
      <% else %>
        <dt class="text-gray-500">Fire at</dt>
        <dd><%= @task.fire_at&.utc&.iso8601 %></dd>
      <% end %>
      <dt class="text-gray-500">PR pileup policy</dt>
      <dd><%= @task.pr_pileup_policy %></dd>
      <dt class="text-gray-500">Auto-approval</dt>
      <dd>
        <span class="font-mono"><%= @task.auto_approve_mode %></span>
        <span class="ml-2 text-xs text-gray-500"><%= auto_approve_preview(@task) %></span>
      </dd>
      <dt class="text-gray-500">Last fired</dt>
      <dd><%= @task.last_fired_at&.utc&.iso8601 || '—' %></dd>
      <dt class="text-gray-500">Last successful fire</dt>
      <dd><%= @task.last_successful_fire_at&.utc&.iso8601 || '—' %></dd>
      <dt class="text-gray-500">Consecutive failures</dt>
      <dd>
        <%= @task.consecutive_failure_count %>
        <% if @task.auto_paused? %>
          <span class="ml-2 text-xs text-red-600">(auto-paused at the cap — resume to clear and reactivate)</span>
        <% end %>
      </dd>
    </dl>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg p-4">
    <h2 class="font-semibold text-sm uppercase text-gray-500 mb-2">Prompt</h2>
    <pre class="text-xs whitespace-pre-wrap font-mono bg-gray-50 p-3 rounded border border-gray-200"><%= @task.prompt %></pre>
    <p class="text-xs text-gray-500 mt-2">
      Variables get expanded at fire time. Available:
      <code>{{repo_slug}}</code>, <code>{{repo_default_branch}}</code>, <code>{{date}}</code>,
      <code>{{last_fired_at}}</code>, <code>{{last_successful_fire_at}}</code>.
    </p>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg p-4">
    <h2 class="font-semibold text-sm uppercase text-gray-500 mb-2">Recent fires</h2>
    <% if @recent_jobs.any? %>
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="text-xs uppercase text-gray-500">
          <tr>
            <th class="px-2 py-2 text-left">Job</th>
            <th class="px-2 py-2 text-left">Created</th>
            <th class="px-2 py-2 text-left">State</th>
            <th class="px-2 py-2 text-left">Reason</th>
            <th class="px-2 py-2 text-left">PR</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 text-sm">
          <% @recent_jobs.each do |job| %>
            <tr>
              <td class="px-2 py-2"><%= link_to "##{job.id}", job_path(job), class: "text-blue-600 underline hover:no-underline" %></td>
              <td class="px-2 py-2 text-xs text-gray-500"><%= job.created_at.utc.iso8601 %></td>
              <td class="px-2 py-2"><%= job.state %></td>
              <td class="px-2 py-2 text-xs"><%= job.closure_reason || "—" %></td>
              <td class="px-2 py-2 text-xs">
                <%= job.pr_number ? "##{job.pr_number}" : "—" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-sm text-gray-600">No fires yet.</p>
    <% end %>
  </div>
</div>
