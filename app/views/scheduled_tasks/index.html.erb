<div class="space-y-8">
  <div class="flex items-center justify-between">
    <h1 class="font-bold text-3xl">Scheduled tasks</h1>
    <p class="text-sm text-gray-600">
      Recurring or one-shot agent runs. Create one from any
      <%= link_to "repository's page", repositories_path, class: "text-blue-600 underline hover:no-underline" %>.
    </p>
  </div>

  <% if @active_tasks.any? %>
    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50 text-xs uppercase text-gray-500">
          <tr>
            <th class="px-4 py-2 text-left">Name</th>
            <th class="px-4 py-2 text-left">Repository</th>
            <th class="px-4 py-2 text-left">Kind</th>
            <th class="px-4 py-2 text-left">Schedule</th>
            <th class="px-4 py-2 text-left">State</th>
            <th class="px-4 py-2 text-left">Last fired</th>
            <th class="px-4 py-2 text-left">Failures</th>
            <th class="px-4 py-2"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 text-sm">
          <% @active_tasks.each do |task| %>
            <tr>
              <td class="px-4 py-3 font-medium">
                <%= link_to task.name, scheduled_task_path(task), class: "text-blue-600 underline hover:no-underline" %>
              </td>
              <td class="px-4 py-3 font-mono text-xs"><%= task.repository.slug %></td>
              <td class="px-4 py-3"><%= task.kind %></td>
              <td class="px-4 py-3 font-mono text-xs">
                <% if task.cron? %>
                  <%= task.hourly_cron_expression %>
                <% else %>
                  <%= task.fire_at&.utc&.strftime("%Y-%m-%d %H:%M UTC") || "—" %>
                <% end %>
              </td>
              <td class="px-4 py-3">
                <%= scheduled_task_state_pill(task) %>
              </td>
              <td class="px-4 py-3 text-xs text-gray-600">
                <%= task.last_fired_at ? "#{time_ago_in_words(task.last_fired_at)} ago" : "never" %>
              </td>
              <td class="px-4 py-3 text-xs">
                <% if task.consecutive_failure_count > 0 %>
                  <span class="text-red-700"><%= task.consecutive_failure_count %></span>
                <% else %>
                  <span class="text-gray-400">0</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-right">
                <%= link_to "Open", scheduled_task_path(task), class: "text-blue-600 underline hover:no-underline" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-sm text-gray-600">
      No scheduled tasks yet. Open a repository and click "New scheduled task" to create one.
    </p>
  <% end %>

  <% if @fired_one_shots.any? %>
    <div>
      <h2 class="font-semibold text-lg mb-2">Recently fired one-shots</h2>
      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50 text-xs uppercase text-gray-500">
            <tr>
              <th class="px-4 py-2 text-left">Name</th>
              <th class="px-4 py-2 text-left">Repository</th>
              <th class="px-4 py-2 text-left">Fired at</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 text-sm">
            <% @fired_one_shots.each do |task| %>
              <tr>
                <td class="px-4 py-3"><%= link_to task.name, scheduled_task_path(task), class: "text-blue-600 underline hover:no-underline" %></td>
                <td class="px-4 py-3 font-mono text-xs"><%= task.repository.slug %></td>
                <td class="px-4 py-3 text-xs text-gray-600"><%= task.last_fired_at&.utc&.iso8601 %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <% if @archived_tasks.any? %>
    <details class="bg-white border border-gray-200 rounded-lg p-4">
      <summary class="cursor-pointer text-sm text-gray-600">Archived tasks (<%= @archived_tasks.size %>)</summary>
      <ul class="mt-3 space-y-1 text-sm">
        <% @archived_tasks.each do |task| %>
          <li>
            <%= link_to task.name, scheduled_task_path(task), class: "text-blue-600 underline hover:no-underline" %>
            <span class="text-xs text-gray-500">— <%= task.repository.slug %>, archived <%= time_ago_in_words(task.archived_at) %> ago</span>
          </li>
        <% end %>
      </ul>
    </details>
  <% end %>
</div>
