<div class="space-y-4">
  <%= link_to "Back to Epics", dashboard_epics_path, class: "text-sm text-blue-600 underline hover:no-underline" %>

  <div class="rounded-lg border border-gray-200 bg-white p-6">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <div class="font-mono text-sm font-semibold text-gray-500"><%= @epic.display_number %></div>
        <h1 class="mt-1 text-2xl font-bold text-gray-900"><%= @epic.title %></h1>
      </div>
      <%= state_pill(@epic.state) %>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-2 text-sm">
      <%= link_to @epic.repository.slug, repository_path(@epic.repository), class: "font-mono text-blue-700 underline hover:no-underline" %>
      <span class="rounded bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-700">
        <%= epic_done_jobs_count(@epic) %>/<%= epic_total_jobs_count(@epic) %> done
      </span>
      <span class="rounded bg-violet-50 px-2 py-0.5 text-xs font-medium text-violet-700">
        <%= pluralize(epic_dependency_edge_count(@epic), "dep") %>
      </span>
      <% if epic_blocked?(@epic) %>
        <span class="rounded bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-800">Blocked</span>
      <% end %>
    </div>

    <% if @epic.description.present? %>
      <div class="mt-4 whitespace-pre-wrap text-sm text-gray-700"><%= @epic.description %></div>
    <% else %>
      <div class="mt-4 text-sm text-gray-500">Epic detail page placeholder.</div>
    <% end %>
  </div>
</div>
