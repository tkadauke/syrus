<div class="max-w-2xl">
  <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
    <h1 class="font-bold text-2xl">Edit Epic</h1>
    <%= link_to "Back to Epic", epic_path(@epic), class: "text-sm text-blue-600 underline hover:no-underline" %>
  </div>

  <div class="mt-6">
    <%= render "form",
          epic: @epic,
          submit_label: "Save Epic",
          cancel_url: epic_path(@epic) %>
  </div>
</div>
