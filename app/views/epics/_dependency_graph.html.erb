<% result ||= EpicDependencyGraphRenderer.new(epic).render %>
<% initially_open = local_assigns.fetch(:initially_open, result.node_count <= 10) %>
<% compact = local_assigns.fetch(:compact, false) %>

<% if result.empty? %>
  <p class="<%= compact ? "text-xs" : "text-sm" %> text-gray-500">No external dependencies</p>
<% else %>
  <details <%= "open" if initially_open %>
           class="group rounded-md border border-gray-200 bg-white <%= compact ? "text-xs" : "text-sm" %>">
    <summary class="flex cursor-pointer flex-wrap items-center justify-between gap-2 px-3 py-2 select-none text-gray-700 hover:bg-gray-50 [&::marker]:hidden [&::-webkit-details-marker]:hidden">
      <span class="flex items-center gap-2">
        <span class="text-gray-400 transition-transform group-open:rotate-90">▶</span>
        <span class="font-medium">Dependency graph</span>
        <span class="text-gray-500">
          (<%= pluralize(result.epic_dependency_count, "epic dep") %>, <%= pluralize(result.job_blocker_count, "job blocker") %>)
        </span>
      </span>
    </summary>
    <div class="border-t border-gray-100 p-3">
      <div data-controller="mermaid-graph"
           class="overflow-x-auto rounded bg-gray-50 p-3">
        <pre data-mermaid-graph-target="source" class="hidden"><%= result.definition %></pre>
        <div data-mermaid-graph-target="output"
             class="min-w-[28rem] text-center text-gray-700"></div>
      </div>
    </div>
  </details>
<% end %>
