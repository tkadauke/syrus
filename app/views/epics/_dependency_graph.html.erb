<% result ||= EpicDependencyGraphRenderer.new(epic, depth: params[:graph_depth]).render %>
<% initially_open = local_assigns.fetch(:initially_open, result.node_count <= 10) %>
<% compact = local_assigns.fetch(:compact, false) %>
<% drawer = local_assigns.fetch(:drawer, false) %>
<% current_depth = result.depth || :adjacent %>
<% next_depth = current_depth.to_s == "transitive" ? :adjacent : :transitive %>
<% toggle_label = current_depth.to_s == "transitive" ? "Show local dependencies" : "Show all transitive dependencies" %>
<% toggle_url = drawer ? graph_epic_path(epic, graph_depth: next_depth, drawer: 1) : url_for(request.query_parameters.merge(graph_depth: next_depth)) %>

<details <%= "open" if initially_open %>
         class="group rounded-md border border-gray-200 bg-white <%= compact ? "text-xs" : "text-sm" %>">
  <summary class="flex cursor-pointer flex-wrap items-center justify-between gap-2 px-3 py-2 select-none text-gray-700 hover:bg-gray-50 [&::marker]:hidden [&::-webkit-details-marker]:hidden">
    <span class="flex items-center gap-2">
      <span class="text-gray-400 transition-transform group-open:rotate-90">▶</span>
      <span class="font-medium">Dependency graph</span>
      <span class="text-gray-500">
        (<%= pluralize(result.node_count, "node") %><%= ", summarized from #{result.raw_node_count}" if result.summarized %>)
      </span>
    </span>
    <%= link_to toggle_label,
          toggle_url,
          class: "rounded-md border border-gray-300 bg-white px-2 py-1 text-xs font-medium text-gray-700 hover:bg-gray-50",
          role: "button",
          data: (drawer ? { turbo_frame: "epic_graph_drawer_body" } : {}) %>
  </summary>
  <div class="border-t border-gray-100 p-3">
    <% if result.summarized %>
      <p class="mb-3 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-900">
        Full transitive closure has <%= pluralize(result.raw_node_count, "node") %>, so this view collapses Job chains into Epic-level nodes.
      </p>
    <% end %>
    <div data-controller="mermaid-graph"
         class="overflow-x-auto rounded bg-gray-50 p-3">
      <pre data-mermaid-graph-target="source" class="hidden"><%= result.definition %></pre>
      <div data-mermaid-graph-target="output"
           class="min-w-[28rem] text-center text-gray-700"></div>
    </div>
  </div>
</details>
