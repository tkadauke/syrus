<div class="rounded-lg border border-gray-200 bg-white p-3">
  <div class="mb-2 text-xs font-semibold uppercase text-gray-500">Attention</div>
  <nav class="space-y-1">
    <% @primary_builtin_smart_folders.each do |folder| %>
      <% active = @smart_folder == folder %>
      <%= link_to epics_path(smart_folder_id: folder.id), class: folder_link_classes.call(active) do %>
        <span><%= folder.name %></span>
        <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600"><%= @smart_folder_counts[folder.id] %></span>
      <% end %>
    <% end %>
  </nav>

  <% if @more_builtin_smart_folders.any? %>
    <% more_open = @more_builtin_smart_folders.include?(@smart_folder) %>
    <details class="group/more mt-1"
             data-details-persistence-key="smart-folders-more-epic-list"
             <%= "open" if more_open %>>
      <summary class="flex cursor-pointer items-center gap-1 rounded-md px-2 py-1.5 text-xs font-medium text-gray-500 select-none hover:bg-gray-50 hover:text-gray-700">
        <span class="text-gray-400 transition-transform group-open/more:rotate-90">▸</span>
        <span>More</span>
      </summary>
      <nav class="mt-1 space-y-1">
        <% @more_builtin_smart_folders.each do |folder| %>
          <% active = @smart_folder == folder %>
          <%= link_to epics_path(smart_folder_id: folder.id), class: folder_link_classes.call(active) do %>
            <span><%= folder.name %></span>
            <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600"><%= @smart_folder_counts[folder.id] %></span>
          <% end %>
        <% end %>
      </nav>
    </details>
  <% end %>

  <div class="my-3 border-t border-gray-200"></div>

  <div class="mb-2 flex items-center justify-between">
    <span class="text-xs font-semibold uppercase text-gray-500">Saved</span>
    <%= link_to "Manage", smart_folders_path(subject_type: :epic), class: "text-xs text-blue-600 underline hover:no-underline" %>
  </div>
  <nav class="space-y-1">
    <% @smart_folders.each do |folder| %>
      <% active = @smart_folder == folder %>
      <%= link_to epics_path(smart_folder_id: folder.id), class: folder_link_classes.call(active) do %>
        <span class="truncate"><%= folder.name %></span>
        <span class="ml-2 rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600"><%= @smart_folder_counts[folder.id] %></span>
      <% end %>
    <% end %>
    <% if @smart_folders.empty? %>
      <div class="px-2 py-1.5 text-sm text-gray-400">No saved folders</div>
    <% end %>
  </nav>
</div>
