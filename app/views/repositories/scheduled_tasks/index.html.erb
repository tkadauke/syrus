<div class="space-y-6">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h1 class="font-bold text-3xl">
        <%= link_to @repository.slug, repository_path(@repository), class: "font-mono hover:underline" %>
      </h1>
    </div>
  </div>

  <%= render "repositories/tabs", repository: @repository, active: :scheduled_tasks do %>
    <%= link_to "New scheduled task",
          new_repository_scheduled_task_path(@repository),
          class: "rounded-md px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium" %>
  <% end %>

  <% if @scheduled_tasks.any? %>
    <div class="overflow-hidden rounded-lg border border-gray-200 bg-white">
      <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-gray-50 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
          <tr>
            <th class="px-4 py-3">Name</th>
            <th class="px-4 py-3">Hourly schedule</th>
            <th class="px-4 py-3">Next Window</th>
            <th class="px-4 py-3">State</th>
            <th class="px-4 py-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @scheduled_tasks.each do |task| %>
            <% active = task.active? %>
            <% next_fire = task.next_fire_at %>
            <tr>
              <td class="px-4 py-3">
                <div class="font-medium text-gray-900"><%= task.name %></div>
                <div class="mt-1 max-w-xl truncate text-xs text-gray-500"><%= task.prompt %></div>
              </td>
              <td class="px-4 py-3 font-mono text-xs text-gray-700"><%= task.hourly_cron_expression %></td>
              <td class="px-4 py-3 text-gray-700">
                <%= next_fire ? l(next_fire, format: :short) : "—" %>
              </td>
              <td class="px-4 py-3">
                <%
                  state_class = case task.state
                                when "scheduled"   then "bg-green-100 text-green-700"
                                when "paused"      then "bg-gray-100 text-gray-600"
                                when "auto_paused" then "bg-amber-100 text-amber-700"
                                when "fired"       then "bg-blue-100 text-blue-700"
                                else "bg-gray-100 text-gray-600"
                                end
                %>
                <span class="rounded px-2 py-0.5 text-xs font-medium <%= state_class %>">
                  <%= task.state.humanize %>
                </span>
              </td>
              <td class="px-4 py-3">
                <div class="flex justify-end gap-2">
                  <%= button_to(active ? "Disable" : "Enable",
                        repository_scheduled_task_path(@repository, task),
                        method: :patch,
                        params: { enabled: (!active).to_s },
                        class: "rounded border border-gray-300 px-3 py-1 text-sm text-gray-700 hover:bg-gray-50") %>
                  <%= button_to "Delete",
                        repository_scheduled_task_path(@repository, task),
                        method: :delete,
                        class: "rounded border border-red-200 px-3 py-1 text-sm text-red-700 hover:bg-red-50",
                        form: { data: { turbo_confirm: "Delete this scheduled task?" } } %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="rounded-lg border border-dashed border-gray-300 bg-white p-8 text-center text-sm text-gray-500">
      No scheduled tasks for this repository.
    </div>
  <% end %>
</div>
