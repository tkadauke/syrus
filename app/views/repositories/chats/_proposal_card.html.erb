<% dependencies = proposal.dependencies.order(:slug) %>
<% resolved = proposal.resolved? %>
<% materialized = proposal.materialized_record %>

<% if proposal.confirmed? && materialized %>
  <div class="flex items-center gap-2">
    <span class="text-sm text-gray-500">Confirmed proposal</span>
    <% if materialized.is_a?(Job) %>
      <%= link_to proposal.materialized_label,
            job_path(materialized),
            class: "inline-flex items-center rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-sm font-medium text-blue-700 hover:bg-blue-100" %>
    <% elsif materialized.is_a?(Epic) %>
      <%= link_to proposal.materialized_label,
            dashboard_epics_path,
            class: "inline-flex items-center rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-sm font-medium text-blue-700 hover:bg-blue-100" %>
    <% end %>
  </div>
<% else %>
  <article class="max-w-3xl rounded-lg border bg-white px-4 py-3 <%= resolved ? "border-gray-200 opacity-70 grayscale" : "border-blue-200" %>">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <h3 class="text-base font-semibold text-gray-900"><%= proposal.title %></h3>
          <span class="rounded bg-indigo-50 px-2 py-0.5 text-xs font-medium text-indigo-700"><%= proposal.kind.humanize %></span>
          <span class="rounded px-2 py-0.5 text-xs font-medium <%= proposal.proposed? ? "bg-blue-50 text-blue-700" : "bg-gray-100 text-gray-600" %>"><%= proposal.state.humanize %></span>
          <% if proposal.edited_at.present? && proposal.proposed? %>
            <span class="rounded bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700">Edited</span>
          <% end %>
        </div>
        <p class="mt-1 font-mono text-xs text-gray-500"><%= proposal.slug %></p>
      </div>
    </div>

    <div class="mt-3 chat-prose text-sm text-gray-800">
      <%= render_markdown(proposal.body) %>
    </div>

    <dl class="mt-3 grid gap-2 text-xs text-gray-600 sm:grid-cols-2">
      <div>
        <dt class="font-medium text-gray-500">Attached scope</dt>
        <dd><%= repository&.slug || "No repository attached" %></dd>
      </div>
      <div>
        <dt class="font-medium text-gray-500">Dependencies</dt>
        <dd>
          <% if dependencies.any? %>
            <div class="flex flex-wrap gap-1">
              <% dependencies.each do |dependency| %>
                <span class="rounded bg-gray-100 px-2 py-0.5 font-mono"><%= dependency.slug %></span>
              <% end %>
            </div>
          <% else %>
            None
          <% end %>
        </dd>
      </div>
    </dl>

    <% if proposal.proposed? %>
      <div class="mt-4 flex flex-wrap gap-2">
        <%= button_to "Confirm",
              chat_proposal_confirm_path(chat_session, proposal),
              method: :post,
              class: "rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-blue-700" %>
        <% if repository %>
          <%= link_to "Edit",
                repository_proposals_path(repository, edit_id: proposal.id),
                class: "rounded-md border border-gray-300 px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50" %>
        <% end %>
        <%= button_to "Reject",
              chat_proposal_reject_path(chat_session, proposal),
              method: :post,
              class: "rounded-md border border-red-200 px-3 py-1.5 text-sm font-medium text-red-700 hover:bg-red-50" %>
      </div>
    <% end %>
  </article>
<% end %>
