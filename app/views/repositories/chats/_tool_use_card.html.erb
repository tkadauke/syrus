<% content_hash = message.content.is_a?(Hash) ? message.content : {} %>
<% tool_name = message.tool_name.presence || content_hash["name"].presence || "tool_use" %>
<% payload = content_hash.presence || { "content" => message.content } %>

<%# Structured/canvas tool_use card. Collapsed state is a single
    compact line (matching the abbreviated-tool style); the amber
    treatment only appears once expanded, so the chat surface stays
    quiet by default. %>
<details <%= "open" if message.proposal_tool_use? %> class="chat-message group/tool text-xs open:rounded-md open:border open:border-amber-200 open:bg-amber-50">
  <summary class="flex cursor-pointer items-baseline gap-2 py-0.5 select-none text-sm text-gray-700 hover:text-gray-900 group-open/tool:px-3 group-open/tool:py-2">
    <span class="text-gray-400 group-open/tool:rotate-90 transition-transform">▸</span>
    <span class="font-mono font-medium text-gray-900"><%= tool_name %></span>
    <% if message.proposal %>
      <span class="text-gray-500">→</span>
      <%= link_to "Proposal ##{message.proposal.id}",
            repository_proposals_path(repository),
            class: "text-blue-700 underline hover:no-underline" %>
    <% end %>
  </summary>
  <% if message.proposal&.job&.epic %>
    <div class="px-3 pb-3">
      <%= render "epics/dependency_graph", epic: message.proposal.job.epic, initially_open: false, compact: true %>
    </div>
  <% end %>
  <pre class="overflow-x-auto px-3 pb-3 font-mono text-gray-700 whitespace-pre-wrap break-words"><%= JSON.pretty_generate(payload) %></pre>
</details>
