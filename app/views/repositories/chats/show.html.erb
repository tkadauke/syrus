<div class="space-y-6"
     <%# Stimulus connects controllers in the order they appear. chat-layout
         reparents the chat pane (via appendChild) into its slot during
         connect, which resets the stream's scrollTop. Listing chat-layout
         first lets that reparent happen before chat-controller calls
         scrollToBottom, so the initial scroll sticks. %>
     data-controller="<%= @chat_available ? "chat-layout chat chat-side-panel" : "chat" %>"
     data-chat-layout-storage-key-value="syrus.user.<%= Current.user.id %>.repository.<%= @repository.id %>.chat_split"
     <% if @chat_session %>
       data-chat-layout-canvas-storage-key-value="syrus.chat.canvas.<%= @chat_session.id %>"
     <% end %>
     data-chat-layout-whiteboard-enabled-value="<%= @chat_session.present? %>"
     data-chat-side-panel-repository-id-value="<%= @repository.id %>"
     data-chat-side-panel-documentation-url-value="/repositories/<%= @repository.to_param %>/documents?frame=1"
     data-chat-turn-in-flight-value="<%= @turn_in_flight %>"
     <% if @chat_session %>
       data-chat-older-messages-url-value="<%= repository_chat_messages_path(@repository, @chat_session) %>"
       data-chat-has-more-older-value="<%= @has_more_older %>"
     <% end %>>
  <div class="space-y-3">
    <%= render "header", repository: @repository, chat_session: @chat_session, chat_available: @chat_available %>
  </div>

  <%# Chat-pane workspace + window controls collapsed onto the right
      side of the tab nav (desktop only). Hidden on mobile — the
      tab-strip layout doesn't have room and these are operator power
      actions, not first-touch flows. %>
  <%= render "repositories/tabs", repository: @repository, active: :chats do %>
    <div class="hidden sm:flex flex-wrap items-center gap-2 pb-2">
      <% if @chat_session %>
        <%= button_to "Refresh repo",
              repository_chat_refresh_path(@repository, @chat_session),
              method: :post,
              class: "rounded-md px-3 py-1.5 border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50" %>
        <%= button_to "Reset workspace",
              repository_chat_reset_path(@repository, @chat_session),
              method: :post,
              class: "rounded-md px-3 py-1.5 border border-red-200 bg-white text-sm font-medium text-red-700 hover:bg-red-50",
              form: { data: { turbo_confirm: "Reset this repository chat workspace? Any in-progress workspace state will be destroyed." } } %>
      <% end %>
      <% if @chat_available %>
        <button type="button"
                class="rounded-md px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium cursor-pointer"
                data-chat-layout-target="canvasToggle"
                data-action="chat-layout#toggleCanvas">
          <span data-chat-layout-target="canvasToggleLabel">Hide canvas</span>
        </button>
        <%= button_to "New chat",
              repository_chats_path(@repository),
              method: :post,
              class: "rounded-md px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium cursor-pointer",
              form: { data: { chat_target: "newChatForm" } } %>
      <% end %>
    </div>
  <% end %>

  <% if @pending_actions.any? %>
    <section class="space-y-3 rounded-lg border border-amber-200 bg-amber-50 p-4">
      <h2 class="text-sm font-semibold text-amber-900">Pending actions</h2>
      <% @pending_actions.each do |action| %>
        <% payload = action.payload || {} %>
        <div class="flex flex-wrap items-center justify-between gap-3 rounded-md border border-amber-200 bg-white px-3 py-2 text-sm">
          <div>
            <div class="font-medium text-gray-900">
              <% if action.action == "add_repo_note" %>
                Pin repository note
              <% elsif action.action == "remove_repo_note" %>
                Remove repository note #<%= payload["id"] %>
              <% elsif action.action == "cancel_job" %>
                Cancel Job #<%= payload["job_id"] %>
              <% elsif action.action == "retry_job" %>
                Retry Job #<%= payload["job_id"] %>
              <% elsif action.action == "rebase_job" %>
                Rebase Job #<%= payload["job_id"] %>
              <% else %>
                <%= payload["label"] || action.action_type.to_s.humanize %>
              <% end %>
            </div>
            <div class="mt-1 text-xs text-gray-600">
              <% if action.action == "add_repo_note" %>
                <span class="text-gray-900"><%= payload["body"].to_s.truncate(160) %></span>
              <% elsif action.action_type == "schedule_recurring" %>
                <span class="font-mono"><%= payload["cron_expression"] %></span>
              <% end %>
              <% if payload["next_fire_at"].present? %>
                · next <%= l(Time.zone.parse(payload["next_fire_at"]), format: :short) %>
              <% end %>
            </div>
          </div>
          <div class="flex gap-2">
            <%= button_to "Confirm",
                  repository_chat_pending_action_confirm_path(@repository, action),
                  method: :post,
                  class: "rounded bg-blue-600 px-3 py-1 text-sm font-medium text-white hover:bg-blue-700" %>
            <%= button_to "Cancel",
                  repository_chat_pending_action_path(@repository, action),
                  method: :delete,
                  class: "rounded border border-gray-300 px-3 py-1 text-sm text-gray-700 hover:bg-gray-50" %>
          </div>
        </div>
      <% end %>
    </section>
  <% end %>

  <% if @chat_session %>
    <%= turbo_stream_from "chat_session_#{@chat_session.id}_messages" %>
    <%= turbo_stream_from "chat_session_#{@chat_session.id}_controls" %>
    <%= turbo_stream_from "chat_session_#{@chat_session.id}_header" %>
    <%= turbo_stream_from "chat_session_#{@chat_session.id}_whiteboard" %>
  <% end %>

  <% unless @chat_available %>
    <div class="bg-white border border-amber-200 rounded-lg p-6 text-sm text-amber-900">
      <div class="font-semibold">Claude credentials are required.</div>
      <p class="mt-1">
        Per-repo chat uses Claude regardless of your default agent
        provider for Jobs. Add a Claude OAuth token in
        <%= link_to "Credentials", edit_credentials_path, class: "text-amber-900 underline hover:no-underline" %>
        to enable per-repo chat.
      </p>
    </div>
  <% else %>
    <div class="sm:hidden border-b border-gray-200"
         role="tablist"
         aria-label="Chat panes">
      <button type="button"
              class="px-4 py-2 text-sm font-medium border-b-2 -mb-px"
              role="tab"
              data-chat-layout-target="chatTab"
              data-action="chat-layout#showChat">
        Chat
      </button>
      <button type="button"
              class="px-4 py-2 text-sm font-medium border-b-2 -mb-px"
              role="tab"
              data-chat-layout-target="sidePanelTab"
              data-chat-side-panel-target="whiteboardTab"
              data-action="chat-layout#showCanvas chat-side-panel#showWhiteboard">
        Whiteboard
      </button>
      <button type="button"
              class="px-4 py-2 text-sm font-medium border-b-2 -mb-px"
              role="tab"
              data-chat-layout-target="sidePanelTab"
              data-chat-side-panel-target="documentationTab"
              data-action="chat-layout#showCanvas chat-side-panel#showDocumentation">
        Documentation
      </button>
    </div>

    <%# Pin the desktop chat grid to the viewport: fill what's
        available between the page chrome (header, repo h1, tab nav,
        pending-actions section, tokens subtitle, page footer) and
        keep the existing 34rem floor so short viewports don't
        squeeze the messages list below readable. Mobile stays on
        its existing tab-strip layout with inner fixed heights. %>
    <div class="sm:grid sm:grid-rows-1 sm:h-[calc(100dvh-20rem)] sm:min-h-[34rem] sm:items-stretch"
         data-chat-layout-target="grid"
         data-action="touchstart->chat-layout#swipeStart touchend->chat-layout#swipeEnd">
      <div class="hidden min-w-0 sm:block" data-chat-layout-target="desktopChatSlot"></div>
      <div class="hidden sm:flex cursor-col-resize items-stretch justify-center"
           role="separator"
           aria-orientation="vertical"
           aria-label="Resize chat side panel"
           tabindex="0"
           data-chat-layout-target="divider"
           data-action="pointerdown->chat-layout#startDrag">
        <div class="w-px bg-gray-200"></div>
      </div>
      <div class="hidden min-w-0 sm:block" data-chat-layout-target="desktopCanvasSlot"></div>
      <div class="sm:hidden" data-chat-layout-target="mobileSlot"></div>
    </div>

    <section class="flex h-[32rem] min-h-[24rem] flex-col overflow-hidden rounded-lg border border-gray-200 bg-white sm:h-full"
             <% if @chat_session %>
               data-whiteboard-url-value="<%= repository_chat_whiteboard_path(@repository, @chat_session) %>"
             <% end %>
             data-chat-layout-target="canvasPane">
      <div class="hidden border-b border-gray-200 sm:flex"
           role="tablist"
           aria-label="Chat side panel">
        <button type="button"
                class="px-4 py-2 text-sm font-medium border-b-2 -mb-px"
                role="tab"
                data-chat-side-panel-target="whiteboardTab"
                data-action="chat-side-panel#showWhiteboard">
          Whiteboard
        </button>
        <button type="button"
                class="px-4 py-2 text-sm font-medium border-b-2 -mb-px"
                role="tab"
                data-chat-side-panel-target="documentationTab"
                data-action="chat-side-panel#showDocumentation">
          Documentation
        </button>
      </div>

      <div class="min-h-0 flex-1"
           data-chat-side-panel-target="whiteboardPanel">
        <div class="h-full w-full"
             data-whiteboard-target="mount"></div>
        <% if @chat_session %>
          <%= render "repositories/chats/whiteboard_broadcast",
                chat_session: @chat_session,
                whiteboard: @chat_session.whiteboard %>
        <% end %>
      </div>

      <div class="hidden min-h-0 flex-1"
           data-chat-side-panel-target="documentationPanel">
        <turbo-frame id="repository_<%= @repository.id %>_documents"
                     class="block h-full"
                     data-chat-side-panel-target="documentationFrame">
          <div class="h-full"></div>
        </turbo-frame>
      </div>
    </section>

    <% input_tokens  = @chat_session&.cumulative_input_tokens.to_i %>
    <% output_tokens = @chat_session&.cumulative_output_tokens.to_i %>
    <% input_label   = number_with_precision(input_tokens / 1000.0, precision: 1, strip_insignificant_zeros: true) %>
    <% output_label  = number_with_precision(output_tokens / 1000.0, precision: 1, strip_insignificant_zeros: true) %>
    <% cost          = @chat_session&.cumulative_cost || 0 %>
    <section class="flex min-h-[32rem] min-w-0 flex-col gap-3 sm:h-full"
             data-chat-layout-target="chatPane">
      <%# Messages box owns both the scrolling list and a slim tokens
          readout. The readout overlays the TOP of the message area
          only while the operator hovers the chat — keeps the chat
          surface clean by default and gives the messages full
          vertical space, with the cost ticker one mouse-over away.
          The bottom of the chat is reserved for the (frequently
          present) "New messages" pill and the user's natural reading
          position; the top is where their eye lands when entering
          the pane, so it's the right place for an at-a-glance ticker.
          pointer-events-none so it doesn't block clicks underneath.
          TODO: live-update wiring needs ChatSession#broadcast_header
          to also broadcast this overlay (currently only re-renders
          on full page load). %>
      <div class="group relative min-h-0 flex-1 bg-white border border-gray-200 rounded-lg flex flex-col overflow-hidden">
        <div id="<%= @chat_session ? "chat_session_#{@chat_session.id}_messages" : "new_chat_messages" %>"
             class="flex-1 min-h-0 overflow-y-auto p-4 space-y-4"
             data-chat-target="stream"
             data-action="scroll->chat#scroll">
          <% if @messages.any? %>
            <%= render "repositories/chats/message_stream",
                  items: ChatMessageGrouper.group(@messages),
                  repository: @repository %>
          <% else %>
            <div class="h-full flex items-center justify-center text-sm text-gray-500">
              Start a chat with this repository.
            </div>
          <% end %>
        </div>
        <p class="pointer-events-none absolute top-0 left-0 right-0 border-b border-gray-100 bg-white/95 backdrop-blur-sm px-4 py-1.5 text-xs text-gray-500 opacity-0 transition-opacity duration-150 group-hover:opacity-100">
          Tokens:
          <%= input_label %>k in /
          <%= output_label %>k out · <%= number_to_currency(cost, precision: 4) %>
        </p>
        <button type="button"
                class="hidden absolute bottom-4 left-1/2 -translate-x-1/2 rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-sm font-medium text-blue-700 shadow-sm hover:bg-blue-100"
                data-chat-target="newMessagesPill"
                data-action="chat#scrollToBottom">
          New messages ↓
        </button>
      </div>

      <%= render "compose", repository: @repository, chat_session: @chat_session, turn_in_flight: @turn_in_flight %>
    </section>
  <% end %>
</div>
