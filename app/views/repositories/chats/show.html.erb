<% chat_available = Current.user.agent_provider != "codex" && Current.user.claude_oauth_token.present? %>

<div class="space-y-6"
     data-controller="<%= chat_available ? "chat chat-layout" : "chat" %>"
     data-chat-layout-storage-key-value="syrus.user.<%= Current.user.id %>.repository.<%= @repository.id %>.chat_split"
     <% if @chat_session %>
       data-chat-layout-canvas-storage-key-value="syrus.chat.canvas.<%= @chat_session.id %>"
     <% end %>
     data-chat-layout-whiteboard-enabled-value="<%= @chat_session.present? %>"
     data-chat-turn-in-flight-value="<%= @turn_in_flight %>">
  <div class="space-y-3">
    <%= render "header", repository: @repository, chat_session: @chat_session, chat_available: chat_available %>
  </div>

  <div class="flex border-b border-gray-200">
    <%= link_to "Overview",
          repository_path(@repository),
          class: "px-4 py-2 text-sm font-medium border-b-2 -mb-px border-transparent text-gray-600 hover:text-gray-900 hover:border-gray-300" %>
    <%= link_to "GitHub Issues",
          repository_path(@repository, tab: "github_issues"),
          class: "px-4 py-2 text-sm font-medium border-b-2 -mb-px border-transparent text-gray-600 hover:text-gray-900 hover:border-gray-300" %>
    <%= link_to "Chats",
          repository_chats_path(@repository),
          class: "px-4 py-2 text-sm font-medium border-b-2 -mb-px border-blue-600 text-blue-600" %>
    <%= link_to "Proposals",
          repository_proposals_path(@repository),
          class: "px-4 py-2 text-sm font-medium border-b-2 -mb-px border-transparent text-gray-600 hover:text-gray-900 hover:border-gray-300" %>
    <%= link_to "Recurring Tasks",
          repository_recurring_tasks_path(@repository),
          class: "px-4 py-2 text-sm font-medium border-b-2 -mb-px border-transparent text-gray-600 hover:text-gray-900 hover:border-gray-300" %>
  </div>

  <% if @pending_actions.any? %>
    <section class="space-y-3 rounded-lg border border-amber-200 bg-amber-50 p-4">
      <h2 class="text-sm font-semibold text-amber-900">Pending confirmations</h2>
      <% @pending_actions.each do |action| %>
        <% payload = action.payload || {} %>
        <div class="flex flex-wrap items-center justify-between gap-3 rounded-md border border-amber-200 bg-white px-3 py-2 text-sm">
          <div>
            <div class="font-medium text-gray-900">
              <% if action.action == "add_repo_note" %>
                Pin repository note
              <% elsif action.action == "remove_repo_note" %>
                Remove repository note #<%= payload["id"] %>
              <% elsif action.action == "cancel_job" %>
                Cancel Job #<%= payload["job_id"] %>
              <% elsif action.action == "retry_job" %>
                Retry Job #<%= payload["job_id"] %>
              <% elsif action.action == "rebase_job" %>
                Rebase Job #<%= payload["job_id"] %>
              <% else %>
                <%= payload["label"] || action.action_type.to_s.humanize %>
              <% end %>
            </div>
            <div class="mt-1 text-xs text-gray-600">
              <% if action.action == "add_repo_note" %>
                <span class="text-gray-900"><%= payload["body"].to_s.truncate(160) %></span>
              <% elsif action.action_type == "schedule_recurring" %>
                <span class="font-mono"><%= payload["cron_expression"] %></span>
              <% end %>
              <% if payload["next_fire_at"].present? %>
                · next <%= l(Time.zone.parse(payload["next_fire_at"]), format: :short) %>
              <% end %>
            </div>
          </div>
          <div class="flex gap-2">
            <%= button_to "Confirm",
                  repository_chat_pending_action_confirm_path(@repository, action),
                  method: :post,
                  class: "rounded bg-blue-600 px-3 py-1 text-sm font-medium text-white hover:bg-blue-700" %>
            <%= button_to "Cancel",
                  repository_chat_pending_action_path(@repository, action),
                  method: :delete,
                  class: "rounded border border-gray-300 px-3 py-1 text-sm text-gray-700 hover:bg-gray-50" %>
          </div>
        </div>
      <% end %>
    </section>
  <% end %>

  <% if @chat_session %>
    <%= turbo_stream_from "chat_session_#{@chat_session.id}_messages" %>
    <%= turbo_stream_from "chat_session_#{@chat_session.id}_controls" %>
    <%= turbo_stream_from "chat_session_#{@chat_session.id}_header" %>
    <%= turbo_stream_from "chat_session_#{@chat_session.id}_whiteboard" %>
  <% end %>

  <% if Current.user.agent_provider == "codex" %>
    <div class="bg-white border border-amber-200 rounded-lg p-6 text-sm text-amber-900">
      <div class="font-semibold">Chat requires Claude.</div>
      <p class="mt-1">
        v1 is Claude-only — see the per-repo chat plan for context.
        Switch your agent provider to Claude in
        <%= link_to "Credentials", edit_credentials_path, class: "text-amber-900 underline hover:no-underline" %>
        to enable per-repo chat.
      </p>
    </div>
  <% elsif Current.user.claude_oauth_token.blank? %>
    <div class="bg-white border border-amber-200 rounded-lg p-6 text-sm text-amber-900">
      <div class="font-semibold">Claude credentials are required.</div>
      <p class="mt-1">
        Per-repo chat uses Claude in v1. Add a Claude OAuth token in
        <%= link_to "Credentials", edit_credentials_path, class: "text-amber-900 underline hover:no-underline" %>
        to enable per-repo chat.
      </p>
    </div>
  <% else %>
    <div class="sm:hidden border-b border-gray-200"
         role="tablist"
         aria-label="Chat panes">
      <button type="button"
              class="px-4 py-2 text-sm font-medium border-b-2 -mb-px"
              role="tab"
              data-chat-layout-target="chatTab"
              data-action="chat-layout#showChat">
        Chat
      </button>
      <button type="button"
              class="px-4 py-2 text-sm font-medium border-b-2 -mb-px"
              role="tab"
              data-chat-layout-target="canvasTab"
              data-action="chat-layout#showCanvas">
        Canvas
      </button>
    </div>

    <div class="sm:grid sm:min-h-[34rem] sm:items-stretch"
         data-chat-layout-target="grid"
         data-action="touchstart->chat-layout#swipeStart touchend->chat-layout#swipeEnd">
      <div class="hidden min-w-0 sm:block" data-chat-layout-target="desktopCanvasSlot"></div>
      <div class="hidden sm:flex cursor-col-resize items-stretch justify-center"
           role="separator"
           aria-orientation="vertical"
           aria-label="Resize chat canvas"
           tabindex="0"
           data-chat-layout-target="divider"
           data-action="pointerdown->chat-layout#startDrag">
        <div class="w-px bg-gray-200"></div>
      </div>
      <div class="hidden min-w-0 sm:block" data-chat-layout-target="desktopChatSlot"></div>
      <div class="sm:hidden" data-chat-layout-target="mobileSlot"></div>
    </div>

    <section class="h-[32rem] min-h-[24rem] overflow-hidden rounded-lg border border-gray-200 bg-white sm:h-full"
             <% if @chat_session %>
               data-whiteboard-url-value="<%= repository_chat_whiteboard_path(@repository, @chat_session) %>"
             <% end %>
             data-chat-layout-target="canvasPane">
      <div class="h-full w-full"
           data-whiteboard-target="mount"></div>
      <% if @chat_session&.whiteboard %>
        <div id="chat_session_<%= @chat_session.id %>_whiteboard_broadcast"
             data-whiteboard-target="broadcast"
             data-version="<%= @chat_session.whiteboard.version %>"
             data-elements-json="<%= json_escape(@chat_session.whiteboard.elements.to_json) %>"></div>
      <% end %>
    </section>

    <section class="flex min-h-[32rem] min-w-0 flex-col gap-3 sm:h-full"
             data-chat-layout-target="chatPane">
      <div class="relative min-h-0 flex-1 bg-white border border-gray-200 rounded-lg">
        <div id="<%= @chat_session ? "chat_session_#{@chat_session.id}_messages" : "new_chat_messages" %>"
             class="h-[24rem] overflow-y-auto p-4 space-y-4 sm:h-full"
             data-chat-target="stream"
             data-action="scroll->chat#scroll">
          <% if @messages.any? %>
            <%= render partial: "repositories/chats/message",
                  collection: @messages,
                  as: :message,
                  locals: { repository: @repository } %>
          <% else %>
            <div class="h-full flex items-center justify-center text-sm text-gray-500">
              Start a chat with this repository.
            </div>
          <% end %>
        </div>
        <button type="button"
                class="hidden absolute bottom-4 left-1/2 -translate-x-1/2 rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-sm font-medium text-blue-700 shadow-sm hover:bg-blue-100"
                data-chat-target="newMessagesPill"
                data-action="chat#scrollToBottom">
          New messages ↓
        </button>
      </div>

      <%= render "compose", repository: @repository, chat_session: @chat_session, turn_in_flight: @turn_in_flight %>
    </section>
  <% end %>
</div>
