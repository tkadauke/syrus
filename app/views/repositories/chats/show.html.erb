<div class="space-y-6"
     data-controller="chat"
     data-chat-turn-in-flight-value="<%= @turn_in_flight %>">
  <% chat_available = Current.user.agent_provider != "codex" && Current.user.claude_oauth_token.present? %>
  <div class="space-y-3">
    <%= render "header", repository: @repository, chat_session: @chat_session, chat_available: chat_available %>
  </div>

  <div class="flex border-b border-gray-200">
    <%= link_to "Overview",
          repository_path(@repository),
          class: "px-4 py-2 text-sm font-medium border-b-2 -mb-px border-transparent text-gray-600 hover:text-gray-900 hover:border-gray-300" %>
    <%= link_to "GitHub Issues",
          repository_path(@repository, tab: "github_issues"),
          class: "px-4 py-2 text-sm font-medium border-b-2 -mb-px border-transparent text-gray-600 hover:text-gray-900 hover:border-gray-300" %>
    <%= link_to "Chats",
          repository_chats_path(@repository),
          class: "px-4 py-2 text-sm font-medium border-b-2 -mb-px border-blue-600 text-blue-600" %>
    <%= link_to "Proposals",
          repository_proposals_path(@repository),
          class: "px-4 py-2 text-sm font-medium border-b-2 -mb-px border-transparent text-gray-600 hover:text-gray-900 hover:border-gray-300" %>
  </div>

  <% if @chat_session %>
    <%= turbo_stream_from "chat_session_#{@chat_session.id}_messages" %>
    <%= turbo_stream_from "chat_session_#{@chat_session.id}_controls" %>
    <%= turbo_stream_from "chat_session_#{@chat_session.id}_header" %>
  <% end %>

  <% if Current.user.agent_provider == "codex" %>
    <div class="bg-white border border-amber-200 rounded-lg p-6 text-sm text-amber-900">
      <div class="font-semibold">Chat requires Claude.</div>
      <p class="mt-1">
        v1 is Claude-only — see the per-repo chat plan for context.
        Switch your agent provider to Claude in
        <%= link_to "Credentials", edit_credentials_path, class: "text-amber-900 underline hover:no-underline" %>
        to enable per-repo chat.
      </p>
    </div>
  <% elsif Current.user.claude_oauth_token.blank? %>
    <div class="bg-white border border-amber-200 rounded-lg p-6 text-sm text-amber-900">
      <div class="font-semibold">Claude credentials are required.</div>
      <p class="mt-1">
        Per-repo chat uses Claude in v1. Add a Claude OAuth token in
        <%= link_to "Credentials", edit_credentials_path, class: "text-amber-900 underline hover:no-underline" %>
        to enable per-repo chat.
      </p>
    </div>
  <% else %>
    <% if @pending_actions&.any? %>
      <div class="bg-white border border-amber-200 rounded-lg overflow-hidden mb-3">
        <div class="px-4 py-2 border-b border-amber-100 bg-amber-50 text-sm font-semibold text-amber-900">
          Pending actions
        </div>
        <div class="divide-y divide-amber-100">
          <% @pending_actions.each do |pending_action| %>
            <%= render "pending_action_card",
                  repository: @repository,
                  chat_session: @chat_session,
                  pending_action: pending_action %>
          <% end %>
        </div>
      </div>
    <% end %>
    <section class="relative bg-white border border-gray-200 rounded-lg">
      <div id="<%= @chat_session ? "chat_session_#{@chat_session.id}_messages" : "new_chat_messages" %>"
           class="h-[28rem] overflow-y-auto p-4 space-y-4"
           data-chat-target="stream"
           data-action="scroll->chat#scroll">
        <% if @messages.any? %>
          <%= render partial: "repositories/chats/message",
                collection: @messages,
                as: :message,
                locals: { repository: @repository } %>
        <% else %>
          <div class="h-full flex items-center justify-center text-sm text-gray-500">
            Start a chat with this repository.
          </div>
        <% end %>
      </div>
      <button type="button"
              class="hidden absolute bottom-4 left-1/2 -translate-x-1/2 rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-sm font-medium text-blue-700 shadow-sm hover:bg-blue-100"
              data-chat-target="newMessagesPill"
              data-action="chat#scrollToBottom">
        New messages ↓
      </button>
    </section>

    <%= render "compose", repository: @repository, chat_session: @chat_session, turn_in_flight: @turn_in_flight %>
  <% end %>
</div>
