<% text = message.content.is_a?(Hash) ? message.content["text"].to_s : message.content.to_s %>
<% dom_id = "chat_message_#{message.id}" %>

<div id="<%= dom_id %>" class="chat-message" data-chat-target="message" data-message-id="<%= message.id %>">
  <% case message.role
     when "user" %>
    <div class="flex justify-end">
      <div class="chat-prose chat-prose-invert max-w-[min(42rem,85%)] rounded-lg bg-blue-600 px-4 py-2 text-white"><%= render_markdown(text) %></div>
    </div>
  <% when "assistant" %>
    <% if message.proposal_card? %>
      <%= render "repositories/chats/proposal_card", proposal: message.proposal, repository: repository, chat_session: message.chat_session %>
    <% else %>
      <div class="max-w-3xl rounded-lg border border-gray-200 bg-white px-4 py-3">
        <div class="chat-prose text-gray-800">
          <%= render_markdown(text) %>
        </div>
      </div>
    <% end %>
  <% when "tool_use" %>
    <% if ChatMessageGrouper.groupable_tool_use?(message) %>
      <%# Live broadcast path. Renders one collapsed tool-call line. The
          chat controller's mutation observer merges adjacent same-tool
          appends and pulls the matching tool_result into the body. %>
      <%= render "repositories/chats/tool_call_group",
            group: ChatMessageGrouper.single_call_group(message),
            repository: repository %>
    <% else %>
      <%= render "repositories/chats/tool_use_card", message: message, repository: repository %>
    <% end %>
  <% when "tool_result" %>
    <% if ChatMessageGrouper.groupable_tool_result?(message) %>
      <%# Hidden in the default view; JS pairs into the preceding call. %>
      <%= render "repositories/chats/tool_call_live_result", message: message, repository: repository %>
    <% else %>
      <%= render "repositories/chats/tool_result_card", message: message, repository: repository %>
    <% end %>
  <% when "system" %>
    <p class="text-center text-sm italic text-gray-500"><%= text %></p>
  <% end %>
</div>
