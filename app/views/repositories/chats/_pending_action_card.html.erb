<% payload = pending_action.payload || {} %>

<div class="flex flex-wrap items-center justify-between gap-3 rounded-md border border-amber-200 bg-white px-3 py-2 text-sm">
  <div>
    <div class="font-medium text-gray-900">
      <% case pending_action.action %>
      <% when "add_repo_note" %>
        Pin repository note
      <% when "remove_repo_note" %>
        Remove repository note #<%= payload["id"] %>
      <% when "cancel_job" %>
        Cancel Job #<%= payload["job_id"] %>
      <% when "retry_job" %>
        Retry Job #<%= payload["job_id"] %>
      <% when "rebase_job" %>
        Rebase Job #<%= payload["job_id"] %>
      <% else %>
        <%= payload["label"] || pending_action.action_type.to_s.humanize %>
      <% end %>
    </div>
    <div class="mt-1 text-xs text-gray-600">
      <% if pending_action.action == "add_repo_note" %>
        <span class="text-gray-900"><%= payload["body"].to_s.truncate(160) %></span>
      <% elsif pending_action.action_type == "schedule_recurring" %>
        <span class="font-mono"><%= payload["cron_expression"] %></span>
      <% end %>
      <% if payload["next_fire_at"].present? %>
        · next <%= l(Time.zone.parse(payload["next_fire_at"]), format: :short) %>
      <% end %>
    </div>
  </div>
  <div class="flex gap-2">
    <%= button_to "Confirm",
          repository_chat_pending_action_confirm_path(repository, pending_action),
          method: :post,
          class: "rounded bg-blue-600 px-3 py-1 text-sm font-medium text-white hover:bg-blue-700" %>
    <%= button_to "Cancel",
          repository_chat_pending_action_path(repository, pending_action),
          method: :delete,
          class: "rounded border border-gray-300 px-3 py-1 text-sm text-gray-700 hover:bg-gray-50" %>
  </div>
</div>
