<% action_path = chat_session ? repository_chat_message_path(repository, chat_session) : repository_chats_path(repository) %>
<% stop_requested = chat_session&.stop_requested_at.present? %>
<% controls_id = chat_session ? "chat_session_#{chat_session.id}_controls" : "new_chat_controls" %>

<div id="<%= controls_id %>" class="bg-white border border-gray-200 rounded-lg p-3">
  <div class="flex items-end gap-3">
    <%= form_with url: action_path,
          method: :post,
          class: "flex flex-1 items-end gap-3",
          data: { chat_target: "composeForm" } do |form| %>
      <%= text_area_tag "chat_message[text]",
            nil,
            rows: 3,
            required: true,
            placeholder: "Ask about this repository…",
            class: "min-h-24 flex-1 resize-y rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-blue-500",
            data: { chat_target: "textarea" },
            disabled: turn_in_flight %>
      <%= submit_tag "Send",
            class: "rounded-md px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium cursor-pointer disabled:cursor-not-allowed disabled:bg-gray-300",
            data: { chat_target: "sendButton" },
            disabled: turn_in_flight %>
    <% end %>
    <% if chat_session && turn_in_flight %>
      <%= button_to(stop_requested ? "Stopping…" : "Stop",
            repository_chat_stop_path(repository, chat_session),
            method: :post,
            class: "rounded-md px-4 py-2 border border-red-200 bg-white text-sm font-medium text-red-700 hover:bg-red-50 disabled:cursor-not-allowed disabled:border-gray-200 disabled:text-gray-400",
            disabled: stop_requested,
            form: { data: { action: "submit->chat#stop" } },
            data: { chat_target: "stopButton" }) %>
    <% end %>
  </div>

  <% if chat_session %>
    <div class="mt-3 flex flex-wrap items-center justify-between gap-2 border-t border-gray-100 pt-3">
      <p class="text-xs text-gray-500">Workspace operations run on the repository chat workspace.</p>
      <div class="flex items-center gap-2">
        <%= button_to "Refresh repo",
              repository_chat_refresh_path(repository, chat_session),
              method: :post,
              class: "rounded-md px-3 py-1.5 border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50" %>
        <%= button_to "Reset workspace",
              repository_chat_reset_path(repository, chat_session),
              method: :post,
              class: "rounded-md px-3 py-1.5 border border-red-200 bg-white text-sm font-medium text-red-700 hover:bg-red-50",
              form: { data: { turbo_confirm: "Reset this repository chat workspace? Any in-progress workspace state will be destroyed." } } %>
      </div>
    </div>
  <% end %>
</div>
