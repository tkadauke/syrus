<%= form_with model: repository, data: { controller: "repository-form" }, class: "space-y-5" do |form| %>
  <% if repository.errors.any? %>
    <ul class="text-sm text-red-600 list-disc pl-5">
      <% repository.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  <% end %>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= form.label :owner, class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :owner, required: true, autocomplete: "off",
            data: { repository_form_target: "ownerText", action: "input->repository-form#ownerTextChanged" },
            class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full font-mono" %>
      <select name="repository[owner]" disabled
              data-repository-form-target="ownerSelect"
              data-action="change->repository-form#ownerSelected"
              class="hidden block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full font-mono bg-white">
      </select>
      <a href="#" data-repository-form-target="ownerManualLink"
         data-action="click->repository-form#enterOwnerManually"
         class="hidden text-xs text-gray-500 underline mt-1 inline-block">Enter manually</a>
    </div>
    <div>
      <%= form.label :name, class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :name, required: true, autocomplete: "off",
            data: { repository_form_target: "nameText", action: "input->repository-form#nameTextChanged" },
            class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full font-mono" %>
      <select name="repository[name]" disabled
              data-repository-form-target="nameSelect"
              data-action="change->repository-form#nameSelected"
              class="hidden block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full font-mono bg-white">
      </select>
      <a href="#" data-repository-form-target="nameManualLink"
         data-action="click->repository-form#enterNameManually"
         class="hidden text-xs text-gray-500 underline mt-1 inline-block">Enter manually</a>
      <p data-repository-form-target="repoError"
         class="hidden text-sm text-red-600 mt-1"></p>
    </div>
  </div>

  <div>
    <%= form.label :default_branch, class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :default_branch, required: true,
          data: { repository_form_target: "branchText" },
          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full font-mono" %>
    <select name="repository[default_branch]" disabled
            data-repository-form-target="branchSelect"
            class="hidden block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full font-mono bg-white">
    </select>
  </div>

  <div>
    <%= form.label :trigger_label, class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :trigger_label, required: true,
          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full font-mono" %>
    <p class="text-xs text-gray-500 mt-1">Issues with this label are picked up by the poller.</p>
  </div>

  <div>
    <%= form.label :agent_provider, "Default agent", class: "block text-sm font-medium text-gray-700" %>
    <%= form.select :agent_provider,
          User::AGENT_PROVIDERS.map { |provider| [ provider.titleize, provider ] },
          { include_blank: "Use my default (#{Current.user.agent_provider.titleize})" },
          class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full bg-white" %>
    <p class="text-xs text-gray-500 mt-1">New jobs for this repository use this agent unless a job already has its own agent.</p>
  </div>

  <div class="flex items-center gap-2">
    <%= form.check_box :polling_enabled, class: "rounded border-gray-400" %>
    <%= form.label :polling_enabled, "Polling enabled", class: "text-sm text-gray-700" %>
  </div>

  <div class="flex items-center gap-2">
    <%= form.check_box :prepare_enabled, class: "rounded border-gray-400" %>
    <%= form.label :prepare_enabled, "Run prepare step on this repository's Workflows", class: "text-sm text-gray-700" %>
  </div>

  <div class="flex items-center gap-2">
    <%= form.check_box :pr_cost_footer_enabled, class: "rounded border-gray-400" %>
    <%= form.label :pr_cost_footer_enabled, "Add Syrus cost footer to PR descriptions", class: "text-sm text-gray-700" %>
  </div>

  <div class="flex items-center gap-2">
    <%= form.check_box :auto_merge_enabled, class: "rounded border-gray-400" %>
    <%= form.label :auto_merge_enabled, "Auto-merge approved Syrus PRs", class: "text-sm text-gray-700" %>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
    <%= link_to "Cancel", repositories_path, class: "text-gray-700 underline hover:no-underline" %>
  </div>
<% end %>
