<dialog open class="w-full max-w-xl rounded-lg border border-gray-200 p-0 shadow-xl backdrop:bg-gray-900/30">
  <div class="border-b border-gray-200 px-5 py-4">
    <h2 class="font-semibold text-lg">Withdraw proposal</h2>
    <p class="mt-1 text-sm text-gray-600"><span class="font-mono"><%= proposal.slug %></span> &middot; <%= proposal.title %></p>
  </div>

  <div class="space-y-4 px-5 py-4 text-sm text-gray-700">
    <% if downstream.any? %>
      <div class="rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-amber-900">
        This proposal has downstream dependents. Withdrawing only this proposal removes it from their dependency lists.
      </div>
      <div>
        <div class="font-medium text-gray-900">Downstream dependents</div>
        <ul class="mt-2 list-disc pl-5">
          <% downstream.each do |dependent| %>
            <li><span class="font-mono"><%= dependent.slug %></span> &mdash; <%= dependent.title %></li>
          <% end %>
        </ul>
      </div>
    <% else %>
      <p>This proposal has no downstream dependents.</p>
    <% end %>
  </div>

  <div class="flex flex-wrap items-center justify-end gap-2 border-t border-gray-100 px-5 py-4">
    <%= link_to "Cancel",
          repository_proposals_path(repository, include_resolved: ("1" if include_resolved)),
          class: "rounded-md px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium" %>
    <%= button_to "Withdraw only this",
          repository_proposal_path(repository, proposal),
          method: :delete,
          params: { discard_mode: "single" },
          class: "rounded-md px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-700 text-sm font-medium cursor-pointer",
          form: { class: "inline" } %>
    <% if downstream.any? %>
      <%= button_to "Withdraw cascade",
            repository_proposal_path(repository, proposal),
            method: :delete,
            params: { discard_mode: "cascade" },
            class: "rounded-md px-3 py-1.5 bg-red-600 hover:bg-red-500 text-white text-sm font-medium cursor-pointer",
            form: { class: "inline" } %>
    <% end %>
  </div>
</dialog>
