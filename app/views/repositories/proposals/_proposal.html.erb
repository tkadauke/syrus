<article class="bg-white border border-gray-200 rounded-lg p-4 space-y-3">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="flex min-w-0 items-start gap-3">
      <% if proposal.proposed? %>
        <%= check_box_tag "proposal_ids[]",
              proposal.id,
              false,
              id: "proposal_#{proposal.id}_selected",
              class: "mt-1 h-4 w-4 rounded border-gray-300 text-blue-600",
              data: { proposal_selection_target: "checkbox", action: "proposal-selection#sync" },
              aria: { label: "Select #{proposal.title}" } %>
      <% end %>
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <h4 class="font-semibold text-gray-900"><%= proposal.title %></h4>
          <span class="inline-block px-2 py-0.5 rounded text-xs bg-indigo-50 text-indigo-700"><%= proposal.kind.humanize %></span>
          <% unless proposal.proposed? %>
            <span class="inline-block px-2 py-0.5 rounded text-xs bg-gray-100 text-gray-600"><%= proposal.state %></span>
          <% end %>
        </div>
        <div class="mt-1 text-xs text-gray-500">
          <span class="font-mono"><%= proposal.slug %></span>
          <% if proposal.labels.present? %>
            &middot; labels: <span class="font-mono"><%= proposal.labels %></span>
          <% end %>
          <% if proposal.job %>
            &middot; <%= link_to "Confirmed as Job ##{proposal.job.id}", job_path(proposal.job), class: "text-blue-600 underline hover:no-underline" %>
          <% elsif proposal.epic %>
            &middot; Confirmed as <%= proposal.epic.display_number %>
          <% elsif proposal.github_issue_number.present? %>
            &middot; Filed as GitHub issue #<%= proposal.github_issue_number %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <% if proposal.proposed? %>
        <%= link_to "Confirm",
              file_repository_proposal_path(repository, proposal),
              class: "rounded-md px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium" %>
        <%= link_to "Edit",
              repository_proposals_path(repository, edit_id: proposal.id, include_resolved: ("1" if include_resolved)),
              class: "rounded-md px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium" %>
        <%= link_to "Withdraw",
              repository_proposals_path(repository, discard_id: proposal.id, include_resolved: ("1" if include_resolved)),
              class: "rounded-md px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-700 text-sm font-medium" %>
      <% end %>
    </div>
  </div>

  <details class="text-sm text-gray-700">
    <summary class="cursor-pointer text-gray-600">Body excerpt</summary>
    <div class="mt-2 whitespace-pre-wrap"><%= truncate(proposal.body, length: 600, separator: " ") %></div>
  </details>

  <% if proposal.dependencies.any? %>
    <div class="flex flex-wrap items-center gap-2 text-xs text-gray-600">
      <span>Depends on</span>
      <% proposal.dependencies.each do |dependency| %>
        <span class="inline-block px-2 py-0.5 rounded bg-gray-100 font-mono"><%= dependency.slug %></span>
      <% end %>
    </div>
  <% end %>
</article>
