<div class="space-y-6">
  <div class="space-y-3">
    <div>
      <h1 class="font-bold text-3xl">
        <%= link_to @repository.slug,
              repository_path(@repository),
              class: "font-mono hover:underline" %>
      </h1>
      <p class="mt-2 text-sm text-gray-600">Review draft proposals from repository chats.</p>
    </div>
  </div>

  <div class="flex border-b border-gray-200">
    <%= link_to "Overview",
          repository_path(@repository),
          class: "px-4 py-2 text-sm font-medium border-b-2 -mb-px border-transparent text-gray-600 hover:text-gray-900 hover:border-gray-300" %>
    <%= link_to "GitHub Issues",
          repository_path(@repository, tab: "github_issues"),
          class: "px-4 py-2 text-sm font-medium border-b-2 -mb-px border-transparent text-gray-600 hover:text-gray-900 hover:border-gray-300" %>
    <%= link_to "Proposals",
          repository_proposals_path(@repository),
          class: "px-4 py-2 text-sm font-medium border-b-2 -mb-px border-blue-600 text-blue-600" %>
  </div>

  <div class="flex items-center justify-between gap-3">
    <h2 class="font-semibold text-lg">Proposals</h2>
    <% if @include_resolved %>
      <%= link_to "Pending only",
            repository_proposals_path(@repository),
            class: "rounded-md px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium" %>
    <% else %>
      <%= link_to "Show recently filed/discarded",
            repository_proposals_path(@repository, include_resolved: "1"),
            class: "rounded-md px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium" %>
    <% end %>
  </div>

  <% if @proposal_layers.values.flatten.any? %>
    <div class="space-y-4">
      <% @proposal_layers.each do |layer, proposals| %>
        <section class="space-y-3" style="margin-left: <%= layer * 1.5 %>rem">
          <h3 class="text-xs uppercase tracking-wide text-gray-500">Layer <%= layer + 1 %></h3>
          <% proposals.each do |proposal| %>
            <%= render "proposal", proposal: proposal, repository: @repository, include_resolved: @include_resolved %>
          <% end %>
        </section>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white border border-gray-200 rounded-lg p-6 text-sm text-gray-600">
      No pending proposals. Open a chat to draft some.
      <%= link_to "Chats tab", repository_path(@repository, tab: "chats"), class: "text-blue-600 underline hover:no-underline" %>
    </div>
  <% end %>

  <%= render "form", repository: @repository, proposal: @edit_proposal, include_resolved: @include_resolved if @edit_proposal %>
  <%= render "discard_modal",
        repository: @repository,
        proposal: @discard_proposal,
        downstream: @discard_downstream,
        include_resolved: @include_resolved if @discard_proposal %>
</div>
