<div class="space-y-6">
  <div class="space-y-3">
    <div>
      <h1 class="font-bold text-3xl">
        <%= link_to @repository.slug,
              repository_path(@repository),
              class: "font-mono hover:underline" %>
      </h1>
    </div>
  </div>

  <%= render "repositories/tabs", repository: @repository, active: :proposals %>

  <div class="flex items-center justify-between gap-3">
    <h2 class="font-semibold text-lg">Proposals</h2>
    <div class="flex flex-wrap items-center justify-end gap-2">
      <% if @proposal_layers.values.flatten.any? && !@include_resolved %>
        <%= link_to "Confirm all",
              file_bulk_repository_proposals_path(@repository, all: "1"),
              class: "rounded-md px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium" %>
      <% end %>
      <% if @include_resolved %>
        <%= link_to "Proposed only",
              repository_proposals_path(@repository),
              class: "rounded-md px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium" %>
      <% else %>
        <%= link_to "Show recently resolved",
              repository_proposals_path(@repository, include_resolved: "1"),
              class: "rounded-md px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium" %>
      <% end %>
    </div>
  </div>

  <% if @proposal_layers.values.flatten.any? %>
    <%= form_with url: file_bulk_repository_proposals_path(@repository),
          method: :get,
          data: { controller: "proposal-selection" },
          class: "space-y-4 pb-20" do %>
      <% @proposal_layers.each do |layer, proposals| %>
        <section class="space-y-3" style="margin-left: <%= layer * 1.5 %>rem">
          <h3 class="text-xs uppercase tracking-wide text-gray-500">Layer <%= layer + 1 %></h3>
          <% proposals.each do |proposal| %>
            <%= render "proposal", proposal: proposal, repository: @repository, include_resolved: @include_resolved %>
          <% end %>
        </section>
      <% end %>
      <div data-proposal-selection-target="actions" class="hidden fixed inset-x-0 bottom-0 z-30 border-t border-gray-200 bg-white/95 px-5 py-3 shadow-lg backdrop-blur">
        <div class="container mx-auto flex flex-wrap items-center justify-between gap-3">
          <div class="text-sm font-medium text-gray-700">
            <span data-proposal-selection-target="count">0</span> selected
          </div>
          <%= submit_tag "File selected (0)",
                data: { proposal_selection_target: "submit" },
                class: "rounded-md px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium cursor-pointer" %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="bg-white border border-gray-200 rounded-lg p-6 text-sm text-gray-600">
      No proposed cards. Open a chat to draft some.
      <%= link_to "Chats tab", repository_chats_path(@repository), class: "text-blue-600 underline hover:no-underline" %>
    </div>
  <% end %>

  <%= render "form", repository: @repository, proposal: @edit_proposal, include_resolved: @include_resolved if @edit_proposal %>
  <%= render "discard_modal",
        repository: @repository,
        proposal: @discard_proposal,
        downstream: @discard_downstream,
        include_resolved: @include_resolved if @discard_proposal %>
  <%= render "file_modal",
        repository: @repository,
        proposals: @file_proposals,
        warnings: @file_warnings,
        selected_ids: @file_selected_ids,
        file_all: @file_all if @file_proposals.present? %>
</div>
