<div class="space-y-6">
  <%# Subscribe to two streams: the repository itself (so config
      changes morph the header) and its per-repo "jobs" stream (so
      newly-polled Jobs appear in the table and existing rows update
      their state pills without a full reload). %>
  <%= turbo_stream_from @repository %>
  <%= turbo_stream_from @repository, "jobs" %>

  <%# Header %>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="font-bold text-3xl">
        <%= link_to @repository.slug,
              "https://github.com/#{@repository.slug}",
              target: "_blank", rel: "noopener",
              class: "font-mono hover:underline" %>
      </h1>
      <div class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-sm text-gray-600">
        <span>Branch: <span class="font-mono"><%= @repository.default_branch %></span></span>
        <span>
          <% if @repository.polling_enabled? %>
            <span class="inline-block px-2 py-0.5 rounded text-xs bg-green-100 text-green-700">polling enabled</span>
          <% else %>
            <span class="inline-block px-2 py-0.5 rounded text-xs bg-gray-100 text-gray-600">polling paused</span>
          <% end %>
          · label: <code class="bg-gray-100 px-1 rounded"><%= @repository.trigger_label %></code>
        </span>
        <span>
          Owner: <%= @repository.user.email_address %>
          <% if @repository.user.admin? %>
            <span class="inline-block px-1.5 py-0.5 rounded text-xs bg-purple-100 text-purple-700">admin</span>
          <% end %>
        </span>
        <% repo_user = @repository.user %>
        <% if repo_user.gh_rate_limit_observed_at %>
          <span>
            GitHub quota:
            <strong><%= number_with_delimiter(repo_user.gh_rate_limit_remaining) %></strong> /
            <%= number_with_delimiter(repo_user.gh_rate_limit_limit) %>
            (<%= repo_user.gh_rate_limit_resource || "core" %>)
          </span>
        <% end %>
        <span>Added: <%= @repository.created_at.to_fs(:long) %></span>
      </div>
    </div>
    <div class="flex items-center gap-2 flex-shrink-0">
      <%= button_to "Poll now", poll_repository_path(@repository), method: :post,
            class: "rounded-md px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium cursor-pointer",
            form: { class: "inline" } %>
      <% retryable = @repository.jobs.where(state: "open").select { |j| !j.any_active_run? && j.current_run&.failed? } %>
      <% if retryable.any? %>
        <%= button_to "Retry #{retryable.size} failed", retry_failed_jobs_repository_path(@repository), method: :post,
              class: "rounded-md px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium cursor-pointer",
              form: { class: "inline", data: { turbo_confirm: "Replay #{retryable.size} failed job(s)?" } } %>
      <% end %>
      <%= link_to "Edit", edit_repository_path(@repository),
            class: "rounded-md px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium" %>
      <%= button_to "Remove", repository_path(@repository), method: :delete,
            class: "rounded-md px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-700 text-sm font-medium cursor-pointer",
            form: { class: "inline", data: { turbo_confirm: "Remove #{@repository.slug} and all its jobs?" } } %>
    </div>
  </div>

  <%# Quick counts %>
  <div class="grid grid-cols-3 gap-4">
    <div class="bg-white border border-gray-200 rounded-lg p-4 text-center">
      <div class="text-2xl font-bold text-blue-600"><%= @running_count %></div>
      <div class="text-xs uppercase text-gray-500 mt-1">Running</div>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg p-4 text-center">
      <div class="text-2xl font-bold text-gray-600"><%= @queued_count %></div>
      <div class="text-xs uppercase text-gray-500 mt-1">Queued</div>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg p-4 text-center">
      <div class="text-2xl font-bold text-red-600"><%= @failed_7d_count %></div>
      <div class="text-xs uppercase text-gray-500 mt-1">Failed (7d)</div>
    </div>
  </div>

  <%# Scheduled tasks %>
  <div>
    <div class="flex items-center justify-between mb-3">
      <h2 class="font-semibold text-lg">Scheduled tasks</h2>
      <%= link_to "New scheduled task",
            new_repository_scheduled_task_path(@repository),
            class: "rounded-md px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium" %>
    </div>
    <% repo_tasks = @repository.scheduled_tasks.where(archived_at: nil).order(:created_at) %>
    <% if repo_tasks.any? %>
      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50 text-xs uppercase text-gray-500">
            <tr>
              <th class="px-4 py-2 text-left">Name</th>
              <th class="px-4 py-2 text-left">Kind</th>
              <th class="px-4 py-2 text-left">Schedule</th>
              <th class="px-4 py-2 text-left">State</th>
              <th class="px-4 py-2 text-left">Last fired</th>
              <th class="px-4 py-2"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 text-sm">
            <% repo_tasks.each do |task| %>
              <tr>
                <td class="px-4 py-3"><%= link_to task.name, scheduled_task_path(task), class: "text-blue-600 underline hover:no-underline" %></td>
                <td class="px-4 py-3"><%= task.kind %></td>
                <td class="px-4 py-3 font-mono text-xs">
                  <% if task.cron? %>
                    <%= task.smeared_cron_expression %>
                  <% else %>
                    <%= task.fire_at&.utc&.strftime("%Y-%m-%d %H:%M UTC") || "—" %>
                  <% end %>
                </td>
                <td class="px-4 py-3"><%= scheduled_task_state_pill(task) %></td>
                <td class="px-4 py-3 text-xs text-gray-600">
                  <%= task.last_fired_at ? "#{time_ago_in_words(task.last_fired_at)} ago" : "never" %>
                </td>
                <td class="px-4 py-3 text-right">
                  <%= link_to "Open", scheduled_task_path(task), class: "text-blue-600 underline hover:no-underline" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-sm text-gray-600">No scheduled tasks yet.</p>
    <% end %>
  </div>

  <%# Recent jobs %>
  <div>
    <h2 class="font-semibold text-lg mb-3">Recent jobs</h2>
    <% if @jobs.any? %>
      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50 text-xs uppercase text-gray-500">
            <tr>
              <th class="px-4 py-2 text-left">Job</th>
              <th class="px-4 py-2 text-left">Issue</th>
              <th class="px-4 py-2 text-left">Status</th>
              <th class="px-4 py-2 text-left">Last activity</th>
              <th class="px-4 py-2 text-left">PR</th>
              <th class="px-4 py-2"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 text-sm">
            <% @jobs.each do |job| %>
              <tr>
                <td class="px-4 py-3 text-gray-500">#<%= job.id %></td>
                <td class="px-4 py-3">
                  <% if job.cron? %>
                    <span class="text-gray-500 text-xs">scheduled:
                      <%= link_to (job.scheduled_task&.name || "##{job.scheduled_task_id}"),
                            scheduled_task_path(job.scheduled_task_id),
                            class: "text-blue-600 underline hover:no-underline" if job.scheduled_task %>
                    </span>
                  <% else %>
                    <%= link_to "##{job.issue_number}",
                          "https://github.com/#{@repository.slug}/issues/#{job.issue_number}",
                          target: "_blank", rel: "noopener",
                          class: "text-blue-600 underline hover:no-underline" %>
                  <% end %>
                </td>
                <td class="px-4 py-3"><%= state_pill(job_summary_state(job)) %></td>
                <td class="px-4 py-3 text-gray-500"><%= time_ago_in_words(job.updated_at) %> ago</td>
                <td class="px-4 py-3">
                  <% if job.pr_number %>
                    <%= link_to "##{job.pr_number}",
                          "https://github.com/#{@repository.slug}/pull/#{job.pr_number}",
                          target: "_blank", rel: "noopener",
                          class: "text-blue-600 underline hover:no-underline" %>
                  <% else %>
                    <span class="text-gray-400">—</span>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-right">
                  <%= link_to "View", job_path(job), class: "text-blue-600 underline hover:no-underline" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @total_pages > 1 %>
        <% first_item = (@page - 1) * RepositoriesController::PER_PAGE + 1 %>
        <% last_item = [@page * RepositoriesController::PER_PAGE, @total_jobs].min %>
        <div class="flex items-center justify-between mt-4 text-sm text-gray-600">
          <span>Showing <%= first_item %>–<%= last_item %> of <%= @total_jobs %></span>
          <div class="flex gap-2">
            <% if @page > 1 %>
              <%= link_to "← Previous", repository_path(@repository, page: @page - 1),
                    class: "px-3 py-1 border border-gray-300 rounded hover:bg-gray-50" %>
            <% else %>
              <span class="px-3 py-1 border border-gray-200 rounded text-gray-300">← Previous</span>
            <% end %>
            <% if @page < @total_pages %>
              <%= link_to "Next →", repository_path(@repository, page: @page + 1),
                    class: "px-3 py-1 border border-gray-300 rounded hover:bg-gray-50" %>
            <% else %>
              <span class="px-3 py-1 border border-gray-200 rounded text-gray-300">Next →</span>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="bg-white border border-gray-200 rounded-lg p-6 text-sm text-gray-600">
        No jobs yet. Enable polling or label an issue
        <code class="bg-gray-100 px-1 rounded"><%= @repository.trigger_label %></code>
        in this repo.
      </div>
    <% end %>
  </div>

  <div class="text-sm">
    <%= link_to "← Back to repositories", repositories_path,
          class: "text-gray-700 underline hover:no-underline" %>
  </div>
</div>
