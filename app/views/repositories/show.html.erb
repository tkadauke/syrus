<div class="space-y-6" data-controller="issue-comment">
  <%# Subscribe to two streams: the repository itself (so config
      changes morph the header) and its per-repo "jobs" stream (so
      newly-polled Jobs appear in the table and existing rows update
      their state pills without a full reload). %>
  <%= turbo_stream_from @repository %>
  <%= turbo_stream_from @repository, "jobs" %>

  <%# Header: title block on top (full width), action row below.
      Same treatment we just gave the jobs#show header — the long
      slug + flexible action row was clipping on mobile and crowding
      on desktop. Stacking is uniformly cleaner; flex-wrap on the
      action row handles long button lists naturally. %>
  <div class="space-y-3">
    <div>
      <h1 class="font-bold text-3xl">
        <%= link_to @repository.slug,
              "https://github.com/#{@repository.slug}",
              target: "_blank", rel: "noopener",
              class: "font-mono hover:underline" %>
      </h1>
      <div class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-sm text-gray-600">
        <span>Branch: <span class="font-mono"><%= @repository.default_branch %></span></span>
        <span>
          <% if @repository.polling_enabled? %>
            <span class="inline-block px-2 py-0.5 rounded text-xs bg-green-100 text-green-700">polling enabled</span>
          <% else %>
            <span class="inline-block px-2 py-0.5 rounded text-xs bg-gray-100 text-gray-600">polling paused</span>
          <% end %>
          · label: <code class="bg-gray-100 px-1 rounded"><%= @repository.trigger_label %></code>
        </span>
        <span>
          Owner: <%= @repository.user.email_address %>
          <% if @repository.user.admin? %>
            <span class="inline-block px-1.5 py-0.5 rounded text-xs bg-purple-100 text-purple-700">admin</span>
          <% end %>
        </span>
        <span>
          Agent:
          <% if @repository.agent_provider.present? %>
            <%= @repository.agent_provider.titleize %>
          <% else %>
            user default (<%= @repository.effective_agent_provider.titleize %>)
          <% end %>
        </span>
        <span>
          Operator chat: <%= @repository.allow_operator_chat.to_s.tr("_", " ").titleize %>
        </span>
        <% repo_user = @repository.user %>
        <% if repo_user.gh_rate_limit_observed_at %>
          <span>
            GitHub quota:
            <strong><%= number_with_delimiter(repo_user.gh_rate_limit_remaining) %></strong> /
            <%= number_with_delimiter(repo_user.gh_rate_limit_limit) %>
            (<%= repo_user.gh_rate_limit_resource || "core" %>)
          </span>
        <% end %>
        <span>Added: <%= @repository.created_at.to_fs(:long) %></span>
        <span>
          <% if @repository.app_credential_active? %>
            <span class="text-emerald-700 font-medium">✓ Syrus App installed (via <%= @repository.installation.account_login %>)</span>
          <% else %>
            <span class="text-amber-800 font-medium">PAT fallback</span>
          <% end %>
        </span>
      </div>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <%= link_to "New job",
            new_job_path(repository_id: @repository.id),
            class: "rounded-md px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium" %>
      <%= button_to "Poll now", poll_repository_path(@repository), method: :post,
            class: "rounded-md px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium cursor-pointer",
            form: { class: "inline" } %>
      <% retryable = @repository.jobs.where(state: "open").select { |j| !j.any_active_run? && j.current_run&.failed? } %>
      <% if retryable.any? %>
        <% preferred_agent = @repository.effective_agent_provider.titleize %>
        <%= button_to "Retry #{retryable.size} failed with #{preferred_agent}", retry_failed_jobs_repository_path(@repository), method: :post,
              class: "rounded-md px-3 py-1.5 bg-amber-600 hover:bg-amber-500 text-white text-sm font-medium cursor-pointer",
              form: { class: "inline", data: { turbo_confirm: "Retry #{retryable.size} failed job(s) with #{preferred_agent}?" } } %>
      <% end %>
      <%= link_to "Edit", edit_repository_path(@repository),
            class: "rounded-md px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium" %>
      <%= button_to "Review ROADMAP + plans",
            repository_chats_path(@repository),
            params: { chat_template: "docs_maintenance" },
            class: "rounded-md px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium cursor-pointer",
            form: { class: "inline" } %>
      <%# Archive is the soft-stop action — flips polling off and
          surfaces the repo under "Archived" on the index. Reversible.
          Hard delete still lives on the index page next to the
          archive controls there for the rare "actually wipe this"
          case. %>
      <%= button_to "Archive", archive_repository_path(@repository), method: :post,
            class: "rounded-md px-3 py-1.5 bg-amber-50 hover:bg-amber-100 text-amber-800 text-sm font-medium cursor-pointer",
            form: { class: "inline", data: { turbo_confirm: "Archive #{@repository.slug}? Polling stops; jobs and history are kept." } } %>
    </div>
  </div>

  <% unless @repository.app_credential_active? %>
    <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
      <% if AppSetting.github_app_registered? %>
        <div class="font-semibold">This repository is using personal-token fallback.</div>
        <p class="mt-1">
          Syrus can read and write through the operator PAT, but App mode gives this repo bot attribution,
          independent rate limits, and normal PR approval behavior.
          <% if @repository.installation&.removed_at.present? %>
            Its previous installation was removed.
          <% end %>
        </p>
        <% if (install_url = github_app_install_url_for(@repository)) %>
          <%= link_to "Install Syrus App on this repository", install_url,
                target: "_blank", rel: "noopener",
                class: "inline-block mt-3 rounded-md px-3 py-1.5 bg-amber-600 hover:bg-amber-500 text-white text-sm font-medium" %>
        <% else %>
          <p class="mt-2 text-xs">GitHub numeric IDs are missing; edit this repository and select it from the GitHub-backed picker to generate a one-click install link.</p>
        <% end %>
      <% else %>
        <div class="font-semibold">Syrus App is not registered.</div>
        <p class="mt-1">This repository is using personal-token fallback until an admin registers the GitHub App and installs it here.</p>
        <% if Current.user.admin? %>
          <%= link_to "Register Syrus App", admin_github_app_register_path,
                class: "inline-block mt-3 rounded-md px-3 py-1.5 bg-amber-600 hover:bg-amber-500 text-white text-sm font-medium" %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%# Tabs %>
  <div class="flex border-b border-gray-200">
    <%= link_to "Overview",
          repository_path(@repository),
          class: "px-4 py-2 text-sm font-medium border-b-2 -mb-px #{@tab == 'overview' ? 'border-blue-600 text-blue-600' : 'border-transparent text-gray-600 hover:text-gray-900 hover:border-gray-300'}" %>
    <%= link_to "GitHub Issues",
          repository_path(@repository, tab: "github_issues"),
          class: "px-4 py-2 text-sm font-medium border-b-2 -mb-px #{@tab == 'github_issues' ? 'border-blue-600 text-blue-600' : 'border-transparent text-gray-600 hover:text-gray-900 hover:border-gray-300'}" %>
    <%= link_to "Chats",
          repository_chats_path(@repository),
          class: "px-4 py-2 text-sm font-medium border-b-2 -mb-px border-transparent text-gray-600 hover:text-gray-900 hover:border-gray-300" %>
    <%= link_to "Proposals",
          repository_proposals_path(@repository),
          class: "px-4 py-2 text-sm font-medium border-b-2 -mb-px border-transparent text-gray-600 hover:text-gray-900 hover:border-gray-300" %>
  </div>

  <% if @tab == "overview" %>
    <%# Quick counts %>
    <div class="grid grid-cols-3 gap-4">
      <div class="bg-white border border-gray-200 rounded-lg p-4 text-center">
        <div class="text-2xl font-bold text-blue-600"><%= @running_count %></div>
        <div class="text-xs uppercase text-gray-500 mt-1">Running</div>
      </div>
      <div class="bg-white border border-gray-200 rounded-lg p-4 text-center">
        <div class="text-2xl font-bold text-gray-600"><%= @queued_count %></div>
        <div class="text-xs uppercase text-gray-500 mt-1">Queued</div>
      </div>
      <div class="bg-white border border-gray-200 rounded-lg p-4 text-center">
        <div class="text-2xl font-bold text-red-600"><%= @failed_7d_count %></div>
        <div class="text-xs uppercase text-gray-500 mt-1">Failed (7d)</div>
      </div>
    </div>

    <%# Scheduled tasks %>
    <div>
      <div class="flex items-center justify-between mb-3">
        <h2 class="font-semibold text-lg">Scheduled tasks</h2>
        <%= link_to "New scheduled task",
              new_repository_scheduled_task_path(@repository),
              class: "rounded-md px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium" %>
      </div>
      <% repo_tasks = @repository.scheduled_tasks.where(archived_at: nil).order(:created_at) %>
      <% if repo_tasks.any? %>
        <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50 text-xs uppercase text-gray-500">
              <tr>
                <th class="px-4 py-2 text-left">Name</th>
                <th class="px-4 py-2 text-left">Kind</th>
                <th class="px-4 py-2 text-left">Schedule</th>
                <th class="px-4 py-2 text-left">State</th>
                <th class="px-4 py-2 text-left">Last fired</th>
                <th class="px-4 py-2"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 text-sm">
              <% repo_tasks.each do |task| %>
                <tr>
                  <td class="px-4 py-3"><%= link_to task.name, scheduled_task_path(task), class: "text-blue-600 underline hover:no-underline" %></td>
                  <td class="px-4 py-3"><%= task.kind %></td>
                  <td class="px-4 py-3 font-mono text-xs">
                    <% if task.cron? %>
                      <%= task.smeared_cron_expression %>
                    <% else %>
                      <%= task.fire_at&.utc&.strftime("%Y-%m-%d %H:%M UTC") || "—" %>
                    <% end %>
                  </td>
                  <td class="px-4 py-3"><%= scheduled_task_state_pill(task) %></td>
                  <td class="px-4 py-3 text-xs text-gray-600">
                    <%= task.last_fired_at ? "#{time_ago_in_words(task.last_fired_at)} ago" : "never" %>
                  </td>
                  <td class="px-4 py-3 text-right">
                    <%= link_to "Open", scheduled_task_path(task), class: "text-blue-600 underline hover:no-underline" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-sm text-gray-600">No scheduled tasks yet.</p>
      <% end %>
    </div>

    <%# Recent jobs %>
    <div>
      <h2 class="font-semibold text-lg mb-3">Recent jobs</h2>
      <% if @jobs.any? %>
        <%# Layout mirrors the main dashboard's Recent jobs table:
            state pill (+ priority) on the left; the issue/source
            cell carries the title, PR link, and step caption; runs
            count + last activity collapse into a small mobile-only
            summary line below. The Repository column is dropped
            entirely (we're already on the repo's page) and the
            "Last activity" header reads `Last` instead of the
            dashboard's `Started` since this view orders by
            updated_at. %>
        <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50 text-xs uppercase text-gray-500">
              <tr>
                <th class="px-4 py-2 text-left">State</th>
                <th class="px-4 py-2 text-left">Issue</th>
                <th class="hidden sm:table-cell px-4 py-2 text-left">Runs</th>
                <th class="hidden sm:table-cell px-4 py-2 text-left">Last</th>
                <th class="hidden sm:table-cell px-4 py-2"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 text-sm">
              <% @jobs.each do |job| %>
                <tr>
                  <td class="px-4 py-3 align-top">
                    <%= state_pill(job_summary_state(job)) %>
                    <% if job.priority != "medium" %>
                      <%= priority_pill(job.priority) %>
                    <% end %>
                  </td>
                  <td class="px-4 py-3">
                    <%= job_source_label_html(job) %>
                    <% if job.issue_title.present? %>
                      <%= link_to job.issue_title, job_path(job), class: "ml-1 text-gray-700 hover:underline" %>
                    <% end %>
                    <% if job.pr_number %>
                      <span class="ml-1 text-xs text-indigo-700">
                        →
                        <%= link_to "PR ##{job.pr_number}", job_pr_url(job), target: "_blank", rel: "noopener", class: "underline hover:no-underline" %>
                      </span>
                    <% end %>
                    <% if job.external_pr_number %>
                      <span class="ml-1 text-xs text-violet-700">
                        ↪
                        <%= link_to "PR ##{job.external_pr_number}", external_pr_url(job), target: "_blank", rel: "noopener", class: "underline hover:no-underline" %>
                      </span>
                    <% end %>
                    <% caption = current_step_caption(job) %>
                    <% if caption %>
                      <div class="text-xs text-gray-500 italic mt-0.5"><%= caption %></div>
                    <% end %>
                    <div class="sm:hidden text-xs text-gray-400 mt-1 flex items-center gap-1.5">
                      <span><%= pluralize(job.runs.size, "run") %></span>
                      <span>·</span>
                      <span><%= time_ago_in_words(job.updated_at) %> ago</span>
                    </div>
                  </td>
                  <td class="hidden sm:table-cell px-4 py-3 text-gray-600"><%= job.runs.size %></td>
                  <td class="hidden sm:table-cell px-4 py-3 text-gray-500"><%= time_ago_in_words(job.updated_at) %> ago</td>
                  <td class="hidden sm:table-cell px-4 py-3 text-right">
                    <%= link_to "View", job_path(job), class: "text-blue-600 underline hover:no-underline" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <% if @total_pages > 1 %>
          <% first_item = (@page - 1) * RepositoriesController::PER_PAGE + 1 %>
          <% last_item = [@page * RepositoriesController::PER_PAGE, @total_jobs].min %>
          <div class="flex items-center justify-between mt-4 text-sm text-gray-600">
            <span>Showing <%= first_item %>–<%= last_item %> of <%= @total_jobs %></span>
            <div class="flex gap-2">
              <% if @page > 1 %>
                <%= link_to "← Previous", repository_path(@repository, page: @page - 1),
                      class: "px-3 py-1 border border-gray-300 rounded hover:bg-gray-50" %>
              <% else %>
                <span class="px-3 py-1 border border-gray-200 rounded text-gray-300">← Previous</span>
              <% end %>
              <% if @page < @total_pages %>
                <%= link_to "Next →", repository_path(@repository, page: @page + 1),
                      class: "px-3 py-1 border border-gray-300 rounded hover:bg-gray-50" %>
              <% else %>
                <span class="px-3 py-1 border border-gray-200 rounded text-gray-300">Next →</span>
              <% end %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="bg-white border border-gray-200 rounded-lg p-6 text-sm text-gray-600">
          No jobs yet. Enable polling or label an issue
          <code class="bg-gray-100 px-1 rounded"><%= @repository.trigger_label %></code>
          in this repo.
        </div>
      <% end %>
    </div>
  <% else %>
    <%# GitHub Issues tab %>
    <div>
      <div class="flex items-center justify-between mb-3">
        <div class="flex gap-1">
          <%= link_to "Open",
                repository_path(@repository, tab: "github_issues", state: "open"),
                class: "px-3 py-1.5 rounded-md text-sm font-medium border #{@state == 'open' ? 'bg-blue-600 text-white border-blue-600' : 'bg-white text-gray-700 border-gray-300 hover:bg-gray-50'}" %>
          <%= link_to "Closed",
                repository_path(@repository, tab: "github_issues", state: "closed"),
                class: "px-3 py-1.5 rounded-md text-sm font-medium border #{@state == 'closed' ? 'bg-blue-600 text-white border-blue-600' : 'bg-white text-gray-700 border-gray-300 hover:bg-gray-50'}" %>
        </div>
      </div>

      <% if @issues&.any? %>
        <%= form_with url: bulk_issues_repository_path(@repository),
              method: :post,
              id: "repository_bulk_issues",
              class: "mb-3 flex items-center justify-end gap-2" do %>
          <input type="hidden" name="state" value="<%= @state %>">
          <% if @state == "open" %>
            <button type="submit"
                    name="bulk_action"
                    value="close"
                    class="rounded px-3 py-1.5 text-sm font-medium bg-amber-50 text-amber-700 border border-amber-200 hover:bg-amber-100 cursor-pointer"
                    data-turbo-confirm="Close the selected issues?">
              Close selected
            </button>
          <% end %>
          <button type="submit"
                  name="bulk_action"
                  value="delegate"
                  class="rounded px-3 py-1.5 text-sm font-medium bg-blue-50 text-blue-700 border border-blue-200 hover:bg-blue-100 cursor-pointer"
                  data-turbo-confirm="Add the '<%= @repository.trigger_label %>' label to the selected issues?">
            Delegate selected
          </button>
        <% end %>
        <%# Two-column layout: identity block (number + title + labels +
            author + age + body excerpt) on the left, vertical action
            stack on the right. Was five columns (# · Title · Labels ·
            Opened · Actions) which collapsed to a tall mess on
            mobile — too many narrow columns to render nicely. %>
        <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50 text-xs uppercase text-gray-500">
              <tr>
                <th class="px-4 py-2 text-left w-10">
                  <span class="sr-only">Select</span>
                </th>
                <th class="px-4 py-2 text-left">Issue</th>
                <th class="px-4 py-2 text-right w-32">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 text-sm">
              <% @issues.each do |issue| %>
                <% has_trigger_label = issue.labels.any? { |l| l.name == @repository.trigger_label } %>
                <tr>
                  <td class="px-4 py-3 align-top">
                    <input type="checkbox"
                           form="repository_bulk_issues"
                           name="issue_numbers[]"
                           value="<%= issue.number %>"
                           class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
                  </td>
                  <td class="px-4 py-3 align-top">
                    <%# Single inline group: issue number, label chips, then
                        title. flex-wrap lets the line break onto multiple
                        lines on narrow viewports without forcing each
                        chunk onto its own row. %>
                    <div class="flex items-baseline gap-2 flex-wrap">
                      <%= link_to "##{issue.number}", issue.html_url, target: "_blank", rel: "noopener",
                            class: "font-mono text-gray-500 hover:underline" %>
                      <% issue.labels.each do |label| %>
                        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium"
                              style="background-color: #<%= label.color %>22; color: #<%= label.color %>; border: 1px solid #<%= label.color %>44">
                          <%= label.name %>
                        </span>
                      <% end %>
                      <%= link_to issue.title, issue.html_url, target: "_blank", rel: "noopener",
                            class: "font-medium text-gray-900 hover:underline" %>
                    </div>
                    <div class="mt-1 text-xs text-gray-500">
                      <% if issue.user %><%= issue.user.login %> · <% end %>
                      <%= time_ago_in_words(issue.created_at) %> ago
                    </div>
                    <% if issue.body.present? %>
                      <p class="text-xs text-gray-400 mt-1 line-clamp-2">
                        <%= issue.body.to_s.gsub(/\r?\n/, " ").truncate(180) %>
                      </p>
                    <% end %>
                  </td>
                  <td class="px-4 py-3 align-top">
                    <div class="flex flex-col items-stretch gap-1.5">
                      <%# Comment — opens the shared dialog %>
                      <button type="button"
                              data-action="issue-comment#open"
                              data-issue-comment-issue-param="<%= issue.number %>"
                              data-issue-comment-title-param="<%= j(issue.title) %>"
                              class="rounded px-2 py-1 text-xs font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 cursor-pointer">
                        Comment
                      </button>

                      <%# Close — only shown for open issues %>
                      <% if issue.state == "open" %>
                        <%= button_to "Close",
                              close_issue_repository_path(@repository),
                              method: :post,
                              params: { issue_number: issue.number, state: @state },
                              class: "rounded px-2 py-1 text-xs font-medium bg-amber-50 text-amber-700 hover:bg-amber-100 cursor-pointer w-full",
                              form: { class: "block", data: { turbo_confirm: "Close issue ##{issue.number}?" } } %>
                      <% end %>

                      <%# Delegate — add the trigger label to hand it to Syrus %>
                      <% if has_trigger_label %>
                        <span class="rounded px-2 py-1 text-xs font-medium bg-green-50 text-green-700 border border-green-200 text-center">
                          Delegated
                        </span>
                      <% else %>
                        <%= button_to "Delegate",
                              delegate_issue_repository_path(@repository),
                              method: :post,
                              params: { issue_number: issue.number, state: @state },
                              class: "rounded px-2 py-1 text-xs font-medium bg-blue-50 text-blue-700 hover:bg-blue-100 cursor-pointer w-full",
                              form: { class: "block", data: { turbo_confirm: "Add the '#{@repository.trigger_label}' label to ##{issue.number} and let Syrus handle it?" } } %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="bg-white border border-gray-200 rounded-lg p-6 text-sm text-gray-600">
          No <%= @state %> issues found.
        </div>
      <% end %>
    </div>

    <%# Shared comment dialog — populated by issue-comment controller %>
    <dialog data-issue-comment-target="dialog"
            class="rounded-lg shadow-xl p-0 w-full max-w-lg backdrop:bg-black/50">
      <%= form_with url: comment_issue_repository_path(@repository), method: :post, class: "p-6 space-y-4" do |f| %>
        <h2 class="text-base font-semibold text-gray-900">Comment on
          <span data-issue-comment-target="issueLabel" class="font-mono text-sm font-normal text-gray-600"></span>
        </h2>
        <input type="hidden" name="issue_number" data-issue-comment-target="issueNumber">
        <input type="hidden" name="state" value="<%= @state %>">
        <textarea name="comment_body"
                  data-issue-comment-target="body"
                  rows="5"
                  placeholder="Leave a comment…"
                  class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
        <div class="flex justify-end gap-2">
          <button type="button"
                  data-action="issue-comment#close"
                  class="px-3 py-1.5 text-sm text-gray-700 border border-gray-300 rounded-md hover:bg-gray-50 cursor-pointer">
            Cancel
          </button>
          <%= f.submit "Post comment",
                class: "px-3 py-1.5 text-sm font-medium text-white bg-blue-600 hover:bg-blue-500 rounded-md cursor-pointer" %>
        </div>
      <% end %>
    </dialog>
  <% end %>

  <div class="text-sm">
    <%= link_to "← Back to repositories", repositories_path,
          class: "text-gray-700 underline hover:no-underline" %>
  </div>
</div>
