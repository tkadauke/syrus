<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="font-bold text-3xl">Repositories</h1>
    <%= link_to "Add repository", new_repository_path,
          class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
  </div>

  <% if @repositories.any? %>
    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50 text-xs uppercase text-gray-500">
          <tr>
            <th class="px-4 py-2 text-left">Repository</th>
            <th class="px-4 py-2 text-left">Default branch</th>
            <th class="px-4 py-2 text-left">Trigger label</th>
            <th class="px-4 py-2 text-left">Polling</th>
            <th class="px-4 py-2"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 text-sm">
          <% @repositories.each do |repo| %>
            <tr>
              <td class="px-4 py-3 font-mono"><%= link_to repo.slug, "https://github.com/#{repo.slug}", target: "_blank", rel: "noopener", class: "text-blue-600 underline hover:no-underline" %></td>
              <td class="px-4 py-3"><%= repo.default_branch %></td>
              <td class="px-4 py-3"><%= repo.trigger_label %></td>
              <td class="px-4 py-3">
                <% if repo.polling_enabled? %>
                  <span class="inline-block px-2 py-0.5 rounded text-xs bg-green-100 text-green-700">enabled</span>
                <% else %>
                  <span class="inline-block px-2 py-0.5 rounded text-xs bg-gray-100 text-gray-600">paused</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-right space-x-3">
                <%= button_to "Poll now", poll_repository_path(repo), method: :post,
                      class: "text-blue-600 underline hover:no-underline cursor-pointer",
                      form: { class: "inline" } %>
                <%= link_to "Edit", edit_repository_path(repo), class: "text-blue-600 underline hover:no-underline" %>
                <%= button_to "Remove", repository_path(repo), method: :delete,
                      class: "text-red-600 underline hover:no-underline cursor-pointer",
                      form: { class: "inline", data: { turbo_confirm: "Remove #{repo.slug}?" } } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="bg-white border border-gray-200 rounded-lg p-6 text-sm text-gray-600">
      No repositories registered yet. Add one to start polling for issues labelled <code class="bg-gray-100 px-1 rounded">syrus</code>.
    </div>
  <% end %>
</div>
