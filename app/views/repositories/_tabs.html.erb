<%#
  Repository-scoped tab nav. Drop in at the top of any repo-scoped
  view so the operator's "where am I in this repo?" experience stays
  uniform — every view shows the same tabs in the same order,
  with the current one highlighted.

  Locals:
    repository: the Repository instance
    active:     symbol identifying the current tab — one of
                :overview, :github_issues, :scheduled_tasks

  Optional block: anything yielded renders inside an action slot on
  the right side of the tab row (e.g. the Triage buttons on
  repositories#show). Omit the block when the view has no
  contextual actions; the action slot collapses.
%>
<%
  tabs = [
    [ :overview,        "Overview",       repository_path(repository) ],
    [ :github_issues,   "GitHub Issues",  repository_path(repository, tab: "github_issues") ],
    [ :scheduled_tasks, "Scheduled Tasks", repository_scheduled_tasks_path(repository) ]
  ]
  base = "px-4 py-2 text-sm font-medium border-b-2 -mb-px"
  inactive_cls = "border-transparent text-gray-600 hover:text-gray-900 hover:border-gray-300"
  active_cls   = "border-blue-600 text-blue-600"
%>
<%# Pin the row to a constant height so the tab strip doesn't shift
    when navigating between tabs with an action slot (Scheduled Tasks)
    and tabs without one (Overview, GitHub Issues).
    items-end keeps the active tab's border-b-2 (with -mb-px) flush
    against the row's border-b regardless of right-slot content. %>
<div class="flex flex-wrap items-end justify-between gap-3 border-b border-gray-200 min-h-10">
  <div class="flex flex-wrap">
    <% tabs.each do |key, label, path| %>
      <%= link_to label, path,
            class: "#{base} #{active == key ? active_cls : inactive_cls}" %>
    <% end %>
  </div>
  <% if block_given? %>
    <div class="flex flex-wrap gap-2 pb-2">
      <%= yield %>
    </div>
  <% end %>
</div>
