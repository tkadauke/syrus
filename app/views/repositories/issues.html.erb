<% content_for :title, "Issues — #{@repository.slug}" %>

<div class="space-y-6" data-controller="issue-comment">
  <%# Header %>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="font-bold text-3xl">Issues</h1>
      <p class="mt-1 text-sm text-gray-600">
        <%= link_to @repository.slug,
              "https://github.com/#{@repository.slug}",
              target: "_blank", rel: "noopener",
              class: "font-mono hover:underline" %>
      </p>
    </div>

    <%# Open / Closed state tabs %>
    <div class="flex gap-1 self-start mt-1">
      <%= link_to issues_repository_path(@repository, state: "open"),
            class: "px-3 py-1.5 rounded-md text-sm font-medium border #{@state == 'open' ? 'bg-blue-600 text-white border-blue-600' : 'bg-white text-gray-700 border-gray-300 hover:bg-gray-50'}" do %>
        Open
      <% end %>
      <%= link_to issues_repository_path(@repository, state: "closed"),
            class: "px-3 py-1.5 rounded-md text-sm font-medium border #{@state == 'closed' ? 'bg-blue-600 text-white border-blue-600' : 'bg-white text-gray-700 border-gray-300 hover:bg-gray-50'}" do %>
        Closed
      <% end %>
    </div>
  </div>

  <%# Issue list %>
  <% if @issues.any? %>
    <%= form_with url: bulk_issues_repository_path(@repository),
          method: :post,
          id: "issues_bulk_issues",
          class: "flex items-center justify-end gap-2" do %>
      <input type="hidden" name="state" value="<%= @state %>">
      <% if @state == "open" %>
        <button type="submit"
                name="bulk_action"
                value="close"
                class="rounded px-3 py-1.5 text-sm font-medium bg-amber-50 text-amber-700 border border-amber-200 hover:bg-amber-100 cursor-pointer"
                data-turbo-confirm="Close the selected issues?">
          Close selected
        </button>
      <% end %>
      <button type="submit"
              name="bulk_action"
              value="delegate"
              class="rounded px-3 py-1.5 text-sm font-medium bg-blue-50 text-blue-700 border border-blue-200 hover:bg-blue-100 cursor-pointer"
              data-turbo-confirm="Add the '<%= @repository.trigger_label %>' label to the selected issues?">
        Delegate selected
      </button>
    <% end %>
    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50 text-xs uppercase text-gray-500">
          <tr>
            <th class="px-4 py-2 text-left w-10">
              <span class="sr-only">Select</span>
            </th>
            <th class="px-4 py-2 text-left w-14">#</th>
            <th class="px-4 py-2 text-left">Title</th>
            <th class="px-4 py-2 text-left">Labels</th>
            <th class="px-4 py-2 text-left">Opened</th>
            <th class="px-4 py-2 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 text-sm">
          <% @issues.each do |issue| %>
            <% has_trigger_label = issue.labels.any? { |l| l.name == @repository.trigger_label } %>
            <tr>
              <td class="px-4 py-3 align-top">
                <input type="checkbox"
                       form="issues_bulk_issues"
                       name="issue_numbers[]"
                       value="<%= issue.number %>"
                       class="rounded border-gray-300 text-blue-600 focus:ring-blue-500">
              </td>
              <td class="px-4 py-3 text-gray-500 font-mono">
                <%= link_to "##{issue.number}",
                      issue.html_url,
                      target: "_blank", rel: "noopener",
                      class: "hover:underline" %>
              </td>
              <td class="px-4 py-3 font-medium">
                <%= link_to issue.title,
                      issue.html_url,
                      target: "_blank", rel: "noopener",
                      class: "hover:underline text-gray-900" %>
                <% if issue.body.present? %>
                  <p class="text-xs text-gray-400 mt-0.5 line-clamp-1 max-w-sm">
                    <%= issue.body.to_s.gsub(/\r?\n/, " ").truncate(120) %>
                  </p>
                <% end %>
              </td>
              <td class="px-4 py-3">
                <% if issue.labels.any? %>
                  <div class="flex flex-wrap gap-1">
                    <% issue.labels.each do |label| %>
                      <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium"
                            style="background-color: #<%= label.color %>22; color: #<%= label.color %>; border: 1px solid #<%= label.color %>44">
                        <%= label.name %>
                      </span>
                    <% end %>
                  </div>
                <% else %>
                  <span class="text-gray-400">—</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-xs text-gray-500 whitespace-nowrap">
                <% if issue.user %>
                  <span><%= issue.user.login %></span>
                  <br>
                <% end %>
                <%= time_ago_in_words(issue.created_at) %> ago
              </td>
              <td class="px-4 py-3">
                <div class="flex items-center justify-end gap-1.5 flex-nowrap">
                  <%# Comment — opens the shared dialog %>
                  <button type="button"
                          data-action="issue-comment#open"
                          data-issue-comment-issue-param="<%= issue.number %>"
                          data-issue-comment-title-param="<%= j(issue.title) %>"
                          class="rounded px-2 py-1 text-xs font-medium bg-gray-100 text-gray-700 hover:bg-gray-200 cursor-pointer">
                    Comment
                  </button>

                  <%# Close — only shown for open issues %>
                  <% if issue.state == "open" %>
                    <%= button_to "Close",
                          close_issue_repository_path(@repository),
                          method: :post,
                          params: { issue_number: issue.number, state: @state },
                          class: "rounded px-2 py-1 text-xs font-medium bg-amber-50 text-amber-700 hover:bg-amber-100 cursor-pointer",
                          form: { class: "inline", data: { turbo_confirm: "Close issue ##{issue.number}?" } } %>
                  <% end %>

                  <%# Delegate — add the trigger label to hand it to Syrus %>
                  <% if has_trigger_label %>
                    <span class="rounded px-2 py-1 text-xs font-medium bg-green-50 text-green-700 border border-green-200">
                      Delegated
                    </span>
                  <% else %>
                    <%= button_to "Delegate",
                          delegate_issue_repository_path(@repository),
                          method: :post,
                          params: { issue_number: issue.number, state: @state },
                          class: "rounded px-2 py-1 text-xs font-medium bg-blue-50 text-blue-700 hover:bg-blue-100 cursor-pointer",
                          form: { class: "inline", data: { turbo_confirm: "Add the '#{@repository.trigger_label}' label to ##{issue.number} and let Syrus handle it?" } } %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="bg-white border border-gray-200 rounded-lg p-6 text-sm text-gray-600">
      No <%= @state %> issues found.
    </div>
  <% end %>

  <%# Shared comment dialog — populated by issue-comment controller %>
  <dialog data-issue-comment-target="dialog"
          class="rounded-lg shadow-xl p-0 w-full max-w-lg backdrop:bg-black/50">
    <%= form_with url: comment_issue_repository_path(@repository), method: :post, class: "p-6 space-y-4" do |f| %>
      <h2 class="text-base font-semibold text-gray-900">Comment on
        <span data-issue-comment-target="issueLabel" class="font-mono text-sm font-normal text-gray-600"></span>
      </h2>
      <input type="hidden" name="issue_number" data-issue-comment-target="issueNumber">
      <input type="hidden" name="state" value="<%= @state %>">
      <textarea name="comment_body"
                data-issue-comment-target="body"
                rows="5"
                placeholder="Leave a comment…"
                class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
      <div class="flex justify-end gap-2">
        <button type="button"
                data-action="issue-comment#close"
                class="px-3 py-1.5 text-sm text-gray-700 border border-gray-300 rounded-md hover:bg-gray-50 cursor-pointer">
          Cancel
        </button>
        <%= f.submit "Post comment",
              class: "px-3 py-1.5 text-sm font-medium text-white bg-blue-600 hover:bg-blue-500 rounded-md cursor-pointer" %>
      </div>
    <% end %>
  </dialog>

  <div class="text-sm">
    <%= link_to "← Back to #{@repository.slug}",
          repository_path(@repository),
          class: "text-gray-700 underline hover:no-underline" %>
  </div>
</div>
