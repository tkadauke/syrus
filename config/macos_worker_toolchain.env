# Tools a native macOS worker release installs for itself under
# /opt/syrus/tools, each verified against the SHA-256 below. Read (not
# sourced) by bin/macos-runtime-env; one KEY=VALUE per line, no quoting.
#
# Nothing here comes from Homebrew: Homebrew is shared with every account on
# the host, and an upgrade there can break a library or binary under a running
# worker. Ruby and Node are pinned in .ruby-version and .node-version.

# mise installs the pinned Ruby and Node, and target repositories' toolchains.
MISE_VERSION=2026.11.12
MISE_URL=https://github.com/jdx/mise/releases/download/v2026.11.12/mise-v2026.11.12-macos-arm64
MISE_SHA256=87b2bd5a1b88a612ee8856df23499404b115870b5a8a8e008763c7cd51c8d412

# The MySQL client library mysql2 is built and run against: Oracle's official
# macOS build, which carries its own OpenSSL. The archive URL keeps working
# after newer releases move this one off the main download path.
MYSQL_CLIENT_VERSION=8.4.10
MYSQL_CLIENT_URL=https://downloads.mysql.com/archives/get/p/23/file/mysql-8.4.10-macos15-arm64.tar.gz
MYSQL_CLIENT_SHA256=282618afd5cb662b94ac837f210b0ccb87ef156dd4c03eb88e094702a5c9ea1f

# XcodeGen, for iOS projects that generate their .xcodeproj from project.yml:
# the universal release archive from GitHub, which links only system
# frameworks.
XCODEGEN_VERSION=2.49.0
XCODEGEN_URL=https://github.com/yonaskolb/XcodeGen/releases/download/2.49.0/xcodegen.zip
XCODEGEN_SHA256=ae5598b33a19ad1e23e775d6648f97375c3529c970905f489358a21055b65e53

# The browser tools (`playwright-mcp`, used by the browser MCP tools and visual
# review) and the Playwright whose Chromium they drive: the Linux image's
# versions (PLAYWRIGHT_VERSION and PLAYWRIGHT_MCP_VERSION in the Dockerfile),
# installed from npm with the pinned Node. Change both places together.
PLAYWRIGHT_VERSION=1.65.1
PLAYWRIGHT_MCP_VERSION=0.0.85
