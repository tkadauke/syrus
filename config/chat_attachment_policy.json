{
  "binary_extensions": {
    ".jpg": ["image/jpeg"],
    ".jpeg": ["image/jpeg"],
    ".png": ["image/png"],
    ".gif": ["image/gif"],
    ".webp": ["image/webp"],
    ".pdf": ["application/pdf"]
  },
  "text_extensions": [
    ".txt", ".md", ".markdown", ".rst", ".rtf", ".tex",
    ".html", ".htm", ".css", ".svg",
    ".json", ".jsonl", ".ndjson", ".yaml", ".yml", ".toml", ".xml",
    ".csv", ".tsv", ".ini", ".cfg", ".conf", ".log", ".diff", ".patch",
    ".rb", ".py", ".pyw", ".js", ".jsx", ".mjs", ".cjs", ".ts", ".tsx",
    ".go", ".rs", ".java", ".kt", ".kts", ".swift",
    ".c", ".h", ".cc", ".cpp", ".cxx", ".hpp", ".hxx", ".cs", ".php",
    ".sh", ".bash", ".zsh", ".fish", ".ps1", ".psm1",
    ".ex", ".exs", ".erl", ".hrl", ".scala", ".sc", ".lua", ".r",
    ".dart", ".vue", ".svelte"
  ],
  "text_filenames": [
    "Dockerfile", "Makefile", "Gemfile", "Rakefile", "Procfile", "Brewfile",
    "Vagrantfile", "Guardfile"
  ],
  "text_application_mime_types": [
    "application/json", "application/ld+json", "application/x-ndjson",
    "application/xml", "application/xhtml+xml", "application/yaml",
    "application/x-yaml", "application/toml", "application/rtf",
    "application/javascript", "application/x-javascript", "application/sql",
    "image/svg+xml"
  ],
  "fallback_mime_types": ["application/octet-stream", "binary/octet-stream"]
}
