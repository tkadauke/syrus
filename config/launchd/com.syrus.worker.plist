<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.syrus.worker</string>

  <key>UserName</key>
  <string>syrus-worker</string>
  <key>GroupName</key>
  <string>syrus-worker</string>

  <key>WorkingDirectory</key>
  <string>/opt/syrus/current</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/syrus/current/bin/macos-worker</string>
    <string>--env-file</string>
    <string>/etc/syrus/worker.env</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/var/log/syrus/worker.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/syrus/worker.err.log</string>

  <!-- Seconds launchd waits after SIGTERM before SIGKILL. The worker drains
       in-flight runs on SIGTERM (SOLID_QUEUE_SHUTDOWN_TIMEOUT, set by
       bin/macos-worker); launchd's default of 20 seconds would kill them. -->
  <key>ExitTimeOut</key>
  <integer>3600</integer>

  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
  <!-- Standard, not Background: launchd runs Background jobs at the lowest
       CPU priority with throttled disk I/O, so any other account's build on
       the host starves the worker -- heartbeats lapse and work crawls. -->
  <key>ProcessType</key>
  <string>Standard</string>
  <key>Umask</key>
  <integer>18</integer>
  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>65536</integer>
  </dict>
  <key>HardResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>65536</integer>
  </dict>
</dict>
</plist>
