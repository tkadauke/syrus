<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.syrus.updater</string>

  <key>UserName</key>
  <string>root</string>
  <key>GroupName</key>
  <string>wheel</string>

  <key>WorkingDirectory</key>
  <string>/opt/syrus</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/syrus/syrus-macos-updater</string>
    <string>--env-file</string>
    <string>/etc/syrus/worker.env</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/opt/ruby@3.4/bin:/opt/homebrew/lib/ruby/gems/3.4.0/bin:/opt/homebrew/opt/node@22/bin:/opt/homebrew/opt/mysql-client/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PKG_CONFIG_PATH</key>
    <string>/opt/homebrew/opt/mysql-client/lib/pkgconfig</string>
    <key>LDFLAGS</key>
    <string>-L/opt/homebrew/opt/mysql-client/lib</string>
    <key>CPPFLAGS</key>
    <string>-I/opt/homebrew/opt/mysql-client/include</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/var/log/syrus/updater.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/syrus/updater.err.log</string>

  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
