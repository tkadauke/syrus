go 1.26.0

// The standalone CLI. Plugin commands are discovered from the configured
// instance or delegated to syrus-<name> executables on PATH; plugin modules
// are deliberately not part of this workspace or the CLI module graph.
use ./cli

// Container sources a plugin owns. `plugins/*/container` is the service image
// behind a container-backed plugin -- the runtime manager being the first --
// and lives in the plugin for the same reason its CLI commands do: deleting
// the plugin deletes the container with it. Listed so the repo-wide
// `go test $(go list -m -f '{{.Dir}}/...')` covers them.
use ./plugins/plugin_runtime/container

use ./plugins/git_mirror/container

use ./plugins/browser/container

use ./plugins/tailscale/container

use ./plugins/whisper_stt/container
