go 1.26.0

// The CLI and the local executables that bundled plugins distribute beside it.
//
// Go has no usable dynamic plugin loading for a single static binary
// (`plugin.Open` demands an identical toolchain and identical versions of
// every shared dependency, and does not support Windows), so a plugin's
// local executable lives in its own module here. Server-safe commands are
// declared by plugin manifests and discovered from the configured instance.
// `plugins/*/cli` keeps genuinely local behavior deletable with its plugin.
//
// Local plugin modules may import cli/pkg helpers to talk to the instance.
use ./cli

use ./plugins/scheduled_tasks/cli

use ./plugins/credential_store/cli

use ./plugins/global_search/cli

use ./plugins/design_docs/cli

use ./plugins/spending_insights/cli

// Container sources a plugin owns. `plugins/*/container` is the service image
// behind a container-backed plugin -- the runtime manager being the first --
// and lives in the plugin for the same reason its CLI commands do: deleting
// the plugin deletes the container with it. Listed so the repo-wide
// `go test $(go list -m -f '{{.Dir}}/...')` covers them.
use ./plugins/plugin_runtime/container

use ./plugins/git_mirror/container

use ./plugins/browser/container

use ./plugins/tailscale/container

use ./plugins/whisper_stt/container
