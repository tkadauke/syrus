import { Button, Card, Form, Input, Page, PageHeading, PanelMessage, SectionHeading, Select } from "@app/components/ui"
import { useT } from "@app/hooks/useT"

export default function AdminExample() {
  const { t } = useT("<%= file_name %>")

  return (
    <Page.Root aria-label={t("admin.title")}>
      <Page.Header>
        <PageHeading>{t("admin.title")}</PageHeading>
        <Page.Description>{t("admin.description")}</Page.Description>
      </Page.Header>

      <PanelMessage tone="success">{t("admin.panel_message")}</PanelMessage>

      <Card>
        <SectionHeading>{t("admin.settings_heading")}</SectionHeading>
        <form className="mt-4 grid gap-4 sm:grid-cols-2">
          <Form.Field>
            <Form.Label htmlFor="<%= file_name %>-name">{t("admin.name_label")}</Form.Label>
            <Input id="<%= file_name %>-name" defaultValue={t("admin.default_name")} />
          </Form.Field>
          <Form.Field>
            <Form.Label htmlFor="<%= file_name %>-mode">{t("admin.mode_label")}</Form.Label>
            <Select id="<%= file_name %>-mode" defaultValue="observe">
              <option value="observe">{t("admin.mode_observe")}</option>
              <option value="act">{t("admin.mode_act")}</option>
            </Select>
          </Form.Field>
          <Form.Actions className="sm:col-span-2">
            <Button type="submit">{t("admin.save")}</Button>
          </Form.Actions>
        </form>
      </Card>
    </Page.Root>
  )
}
