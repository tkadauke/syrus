import { Button, Card, Form, Input, Page, PageHeading, PanelMessage, SectionHeading, Select } from "@app/components/ui"

export default function AdminExample() {
  return (
    <Page.Root aria-label="<%= display_name %>">
      <Page.Header>
        <PageHeading><%= display_name %></PageHeading>
        <Page.Description>A plugin-owned page using Syrus semantic UI primitives.</Page.Description>
      </Page.Header>

      <PanelMessage tone="success">The plugin owns this message copy and any domain-specific visuals.</PanelMessage>

      <Card>
        <SectionHeading>Example settings</SectionHeading>
        <form className="mt-4 grid gap-4 sm:grid-cols-2">
          <Form.Field>
            <Form.Label htmlFor="<%= file_name %>-name">Name</Form.Label>
            <Input id="<%= file_name %>-name" defaultValue="<%= display_name %>" />
          </Form.Field>
          <Form.Field>
            <Form.Label htmlFor="<%= file_name %>-mode">Mode</Form.Label>
            <Select id="<%= file_name %>-mode" defaultValue="observe">
              <option value="observe">Observe</option>
              <option value="act">Act</option>
            </Select>
          </Form.Field>
          <Form.Actions className="sm:col-span-2">
            <Button type="submit">Save</Button>
          </Form.Actions>
        </form>
      </Card>
    </Page.Root>
  )
}
