module <%= module_name %>
  extend Syrus::PluginApi

  syrus_plugin "<%= file_name %>" do
    display_name "<%= display_name %>"
    display_name_i18n_key "<%= file_name %>:plugin.display_name"
    category     "tooling"
    author       ""
    description  "Syrus plugin: <%= display_name %>."
    description_i18n_key "<%= file_name %>:plugin.description"
    long_description "<%= display_name %> extends Syrus with plugin-owned functionality."
    long_description_i18n_key "<%= file_name %>:plugin.long_description"
<% if frontend? -%>

    provides admin_page: "<%= module_name %>::AdminPages"

    frontend routes: { "<%= file_name %>/AdminExample" => "app/frontend/routes/AdminExample.tsx" },
             i18n: [ "app/frontend/i18n/locales/*/<%= file_name %>.json" ]
<% end -%>
  end
end
