# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git directory.
/.git/
/.gitignore

# Ignore bundler config.
/.bundle
/vendor/bundle/

# Ignore local Syrus runtime state.
/.syrus/

# Ignore all environment files.
/.env*

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
/coverage/

# ProcessRunner's named-pipe scratch directories. A hard kill leaves these
# behind with their FIFOs intact, and a FIFO in the build context stalls
# `docker build` forever while it transfers context: it opens the pipe, waits
# for a writer that will never come, and reports nothing. git does not list
# non-regular files at all, so the debris is invisible to `git status` and to
# anything that reasons about the context from git.
process-runner-capture*
process-runner-pipeline*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore assets.
/node_modules/
/desktop/node_modules/
/desktop/dist/
/desktop/dist-electron/
/desktop/out/
/website/node_modules/
/website/.next/
/website/out/
/website/dist/
/website/.turbo/
/dist/
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Ignore CI service files.
/.github

# Ignore Kamal files.
/config/deploy*.yml
/.kamal

# Ignore development files
/.devcontainer

# Ignore Docker-related files
/.dockerignore
/Dockerfile*
/public/excalidraw-assets
