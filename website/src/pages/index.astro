---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { Card, CardGrid, LinkButton } from "@astrojs/starlight/components";

const mergedPrCount = 2;
---

<StarlightPage
  frontmatter={{
    title: "Syrus",
    description:
      "Self-hosted, multi-tenant, BYOK alternative to Devin and Copilot Coding Agent.",
    template: "splash",
  }}
  hasSidebar={false}
>
  <main class="home">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="epigraph">Bis dat qui cito dat. <span>He gives twice who gives quickly.</span></p>
        <h1 id="hero-title">Syrus</h1>
        <p class="lede">
          Self-hosted, multi-tenant, BYOK alternative to Devin and Copilot Coding Agent.
          Owns the deterministic plumbing - clones, branches, PRs, cleanup - so the
          agent only writes code. Multi-user from day one. Runs on your hardware, your
          Anthropic key, your audit log.
        </p>
        <div class="actions">
          <LinkButton href="/evaluate">Try it locally -></LinkButton>
          <LinkButton href="https://github.com/tkadauke/syrus" variant="secondary">
            Star on GitHub
          </LinkButton>
        </div>
      </div>

      <!-- Hero visual sourced from the real Syrus PR https://github.com/tkadauke/syrus/pull/165 -->
      <div class="proof" aria-label="Example Syrus issue becoming a pull request diff">
        <article class="proof-card issue-card">
          <p class="proof-label">Issue</p>
          <h2>Competitive scan, May 2026</h2>
          <p>
            Compare Devin, Copilot Coding Agent, OpenHands, Trigger.dev, and Inngest.
            Extract the moat for a small-team self-hosted agent harness.
          </p>
          <span>syrus</span>
        </article>
        <div class="proof-arrow" aria-hidden="true">-></div>
        <article class="proof-card diff-card">
          <p class="proof-label">PR #165</p>
          <h2>docs: competitive landscape scan</h2>
          <pre><code>+ Self-hosted by default
+ BYOK agent credentials
+ Multi-user queue ownership
+ GitHub issue -> PR loop</code></pre>
        </article>
      </div>
    </section>

    <section class="section intro" aria-labelledby="what-title">
      <div>
        <p class="eyebrow">30-second version</p>
        <h2 id="what-title">What is Syrus?</h2>
        <p>
          Syrus polls GitHub, turns labeled issues and review feedback into isolated
          agent runs, captures the resulting diff, and opens or updates the pull request.
          The agent gets a clean coding task; Syrus keeps the queues, clones, branches,
          logs, retries, rebases, and cleanup boring.
        </p>
      </div>

      <svg class="flow" viewBox="0 0 880 260" role="img" aria-labelledby="flow-title flow-desc">
        <title id="flow-title">Syrus issue to pull request flow</title>
        <desc id="flow-desc">An issue moves through a poller and an agent run, then becomes a pull request.</desc>
        <defs>
          <marker id="arrowhead" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto">
            <path d="M0,0 L0,6 L8,3 z" fill="currentColor"></path>
          </marker>
        </defs>
        <path class="flow-line" d="M188 130 C242 92 286 92 340 130"></path>
        <path class="flow-line" d="M402 130 C456 168 500 168 554 130"></path>
        <path class="flow-line" d="M616 130 C670 92 714 92 768 130"></path>
        <g class="node" transform="translate(38 58)">
          <rect width="150" height="144" rx="18"></rect>
          <path d="M36 42h78M36 72h58M36 102h88"></path>
          <text x="75" y="128">issue</text>
        </g>
        <g class="node" transform="translate(340 58)">
          <rect width="150" height="144" rx="18"></rect>
          <circle cx="75" cy="64" r="28"></circle>
          <path d="M75 30v68M41 64h68"></path>
          <text x="75" y="128">poller</text>
        </g>
        <g class="node" transform="translate(554 58)">
          <rect width="150" height="144" rx="18"></rect>
          <path d="M45 70c8-28 52-28 60 0M45 70c-8 30 68 30 60 0M54 96h42"></path>
          <text x="75" y="128">agent</text>
        </g>
        <g class="node" transform="translate(768 58)">
          <rect width="74" height="144" rx="18"></rect>
          <path d="M24 48h26M24 76h18M24 104h28"></path>
          <text x="37" y="128">PR</text>
        </g>
      </svg>
    </section>

    <section class="section" aria-labelledby="why-title">
      <p class="eyebrow">Why Syrus</p>
      <h2 id="why-title">Built for teams that want control.</h2>
      <CardGrid>
        <Card title="You own the keys" icon="lock">
          Bring your GitHub and agent credentials. Syrus stores them encrypted and keeps
          the audit trail in your database.
        </Card>
        <Card title="Self-host on your cluster" icon="server">
          Run it beside the code and systems you already operate. No hosted agent queue
          becomes the new center of gravity.
        </Card>
        <Card title="Multi-user from day one" icon="user">
          Separate users, repositories, credentials, schedules, priorities, and admin
          views without turning the first real team into a migration project.
        </Card>
      </CardGrid>
    </section>

    <section class="section work" aria-labelledby="work-title">
      <div class="section-heading">
        <p class="eyebrow">Show the work</p>
        <h2 id="work-title">The transcript, diff, queue, and PR link stay visible.</h2>
      </div>
      <div class="screenshots">
        <figure>
          <img
            src="/screenshots/job-page.svg"
            width="1440"
            height="900"
            alt="Redacted Syrus Job page showing workflow steps, transcript, diff summary, and pull request link"
            loading="lazy"
          />
          <figcaption>Job page: workflow state, transcript, diff, and PR handoff.</figcaption>
        </figure>
        <figure>
          <img
            src="/screenshots/dashboard.svg"
            width="1440"
            height="900"
            alt="Redacted Syrus dashboard showing repositories, recent jobs, workflow states, and queue activity"
            loading="lazy"
          />
          <figcaption>Dashboard: repositories, queue health, recent jobs, and ownership.</figcaption>
        </figure>
      </div>
    </section>

    <section class="status" aria-labelledby="status-title">
      <p class="eyebrow">Honest status</p>
      <h2 id="status-title">Syrus has been working on itself since day 2.</h2>
      <p>
        {mergedPrCount} PRs merged via Syrus's own pipeline. One production tenant;
        permissive MIT license; early-adopter friendly.
      </p>
    </section>

    <section class="section get-started" aria-labelledby="start-title">
      <p class="eyebrow">Get started</p>
      <h2 id="start-title">Pick the smallest deployment path that answers your question.</h2>
      <div class="actions">
        <LinkButton href="/docs/deployment/try-it-locally">Try it locally</LinkButton>
        <LinkButton href="/docs/deployment/docker-compose" variant="secondary">
          Deploy with Docker Compose
        </LinkButton>
        <LinkButton href="/docs/deployment/kubernetes" variant="secondary">
          Run on Kubernetes
        </LinkButton>
      </div>
    </section>
  </main>

  <footer class="home-footer">
    <a href="https://github.com/tkadauke/syrus">GitHub</a>
    <a href="https://github.com/tkadauke/syrus/blob/main/LICENSE">MIT license</a>
    <a href="/about">About the name</a>
  </footer>
</StarlightPage>

<style>
  :global(.sl-container) {
    max-width: none;
  }

  :global(main) {
    padding-inline: 0;
  }

  .home {
    color: var(--sl-color-white);
  }

  .hero,
  .section,
  .status,
  .home-footer {
    width: min(1120px, calc(100% - 2rem));
    margin-inline: auto;
  }

  .hero {
    min-height: calc(100vh - 4rem);
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(18rem, 0.96fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    padding-block: clamp(4rem, 11vh, 7rem) 3rem;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
  }

  .epigraph,
  .eyebrow {
    margin: 0 0 1rem;
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-sm);
    font-weight: 650;
    text-transform: uppercase;
  }

  .epigraph span {
    display: block;
    margin-top: 0.35rem;
    color: var(--sl-color-gray-2);
    font-weight: 500;
    text-transform: none;
  }

  h1,
  h2 {
    margin: 0;
    line-height: 1.04;
    letter-spacing: 0;
  }

  h1 {
    font-size: clamp(4rem, 18vw, 8.5rem);
  }

  h2 {
    max-width: 820px;
    font-size: clamp(2rem, 7vw, 4rem);
  }

  .lede {
    max-width: 46rem;
    margin: 1.25rem 0 0;
    color: var(--sl-color-gray-2);
    font-size: clamp(1.125rem, 2vw, 1.35rem);
    line-height: 1.65;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .proof {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 0.8rem;
    opacity: 0.72;
    filter: saturate(0.72);
  }

  .proof::before {
    content: "";
    position: absolute;
    inset: -1rem;
    border-radius: 1.5rem;
    background: color-mix(in srgb, var(--sl-color-bg-nav) 72%, transparent);
    backdrop-filter: blur(8px);
    border: 1px solid var(--sl-color-gray-6);
  }

  .proof-card,
  .proof-arrow {
    position: relative;
  }

  .proof-card {
    min-height: 17rem;
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--sl-color-bg) 84%, var(--sl-color-gray-6));
    box-shadow: 0 1.5rem 5rem rgba(0, 0, 0, 0.22);
  }

  .proof-label {
    margin: 0 0 0.85rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    font-weight: 700;
    text-transform: uppercase;
  }

  .proof-card h2 {
    font-size: 1rem;
    line-height: 1.25;
  }

  .proof-card p:not(.proof-label) {
    margin: 0.75rem 0 0;
    color: var(--sl-color-gray-2);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .proof-card span {
    display: inline-flex;
    margin-top: 1rem;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--sl-color-orange);
    border-radius: 999px;
    color: var(--sl-color-orange-high);
    font-size: var(--sl-text-xs);
  }

  .proof-card pre {
    overflow: hidden;
    margin: 1rem 0 0;
    color: var(--sl-color-green-high);
    font-size: 0.75rem;
    line-height: 1.6;
    white-space: pre-wrap;
  }

  .proof-arrow {
    color: var(--sl-color-gray-3);
    font-weight: 800;
  }

  .section {
    padding-block: clamp(4rem, 10vw, 7rem);
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(20rem, 1.1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .section p,
  .status p {
    max-width: 46rem;
    color: var(--sl-color-gray-2);
    font-size: 1.075rem;
    line-height: 1.7;
  }

  .flow {
    width: 100%;
    color: var(--sl-color-text-accent);
  }

  .flow-line {
    fill: none;
    stroke: currentColor;
    stroke-width: 7;
    stroke-linecap: round;
    marker-end: url(#arrowhead);
    opacity: 0.8;
  }

  .node rect {
    fill: color-mix(in srgb, var(--sl-color-bg-nav) 88%, var(--sl-color-text-accent));
    stroke: var(--sl-color-gray-4);
    stroke-width: 3;
  }

  .node path,
  .node circle {
    fill: none;
    stroke: var(--sl-color-gray-2);
    stroke-width: 7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .node text {
    fill: var(--sl-color-white);
    font: 700 22px system-ui, sans-serif;
    text-anchor: middle;
    text-transform: uppercase;
  }

  .section :global(.card) {
    border-radius: 0.5rem;
  }

  .section-heading {
    margin-bottom: 2rem;
  }

  .screenshots {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  figure {
    margin: 0;
  }

  figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-bg-nav);
  }

  figcaption {
    margin-top: 0.75rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .status {
    padding: clamp(2rem, 6vw, 4rem);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background:
      linear-gradient(135deg, rgba(20, 184, 166, 0.14), transparent 38%),
      color-mix(in srgb, var(--sl-color-bg-nav) 92%, var(--sl-color-bg));
  }

  .get-started {
    text-align: center;
  }

  .get-started h2,
  .get-started .actions {
    justify-content: center;
    margin-inline: auto;
  }

  .home-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    padding-block: 2rem 4rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .home-footer a {
    color: inherit;
  }

  @media (max-width: 880px) {
    .hero,
    .intro,
    .screenshots {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: 0;
    }

    .proof {
      grid-template-columns: 1fr;
    }

    .proof-arrow {
      text-align: center;
      transform: rotate(90deg);
    }
  }

  @media (max-width: 520px) {
    .hero,
    .section,
    .status,
    .home-footer {
      width: min(100% - 1rem, 1120px);
    }

    .proof-card {
      min-height: auto;
    }

    .actions :global(.sl-link-button) {
      width: 100%;
      justify-content: center;
    }
  }
</style>
