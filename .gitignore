# OS / editor
.DS_Store
*.swp
.vscode/
.idea/

# Rails (placeholders so M0 doesn't fight them)
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
/storage/*
!/storage/.keep
/public/assets
/public/packs
/coverage/
.bundle/*
!.bundle/
!.bundle/config
vendor/bundle/
.syrus/*
!.syrus/skills/
node_modules/
desktop/dist/
desktop/dist-electron/
desktop/out/
desktop/resources/
desktop/node_modules/
.byebug_history

# Local release artifacts
/dist/releases/

# Go CLI build output
/cli/bin/

# Secrets
.env
.env.*
!.env.example
config/master.key
config/credentials/*.key

# DB
*.sqlite3
*.sqlite3-journal

# Worktrees managed by Syrus itself
/tmp/worktrees/

# Ignore key files for decrypting credentials and more.
/config/*.key


/app/assets/builds/*
!/app/assets/builds/.keep
.claude/scheduled_tasks.lock
tmp/mcp_repro/
.claude/worktrees/

# Local eval-harness run history (see evals/README.md) -- not meant to be
# merged across branches/operators.
/evals/results/*.jsonl

# Playwright MCP browser-verification scratch (screenshots, console logs)
# from manual preview testing -- not product artifacts.
.playwright-mcp/

# Playwright run artifacts from bin/test-e2e. `.last-run.json` records the ids
# of the previous run's failures (so --last-failed works) and so changes on
# every local run; keeping it tracked meant running the suite always dirtied
# the working tree.
/test-results/
