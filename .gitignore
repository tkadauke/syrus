# OS / editor
.DS_Store
*.swp
.vscode/
.idea/

# Rails (placeholders so M0 doesn't fight them)
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
/storage/*
!/storage/.keep
/public/assets
/public/packs
/coverage/
.bundle/*
!.bundle/
!.bundle/config
vendor/bundle/
node_modules/
desktop/dist/
desktop/dist-electron/
desktop/out/
desktop/node_modules/
.byebug_history

# Go CLI build output
/cli/bin/

# Secrets
.env
.env.*
!.env.example
config/master.key
config/credentials/*.key

# DB
*.sqlite3
*.sqlite3-journal

# Worktrees managed by Syrus itself
/tmp/worktrees/

# Ignore key files for decrypting credentials and more.
/config/*.key


/app/assets/builds/*
!/app/assets/builds/.keep
.claude/scheduled_tasks.lock
tmp/mcp_repro/
