{
  "name": "syrus",
  "private": true,
  "scripts": {
    "build": "vite build",
    "build:analyze": "VITE_BUNDLE_ANALYZE=true vite build",
    "check:bundle-size": "bin/check-frontend-bundle-size",
    "desktop:build": "npm --prefix desktop run build",
    "desktop:dev": "npm --prefix desktop run dev",
    "typecheck": "tsc --noEmit",
    "test:react": "vitest run && npm run typecheck",
    "lint": "eslint --no-error-on-unmatched-pattern app/frontend plugins/*/app/frontend",
    "format:frontend": "prettier --write app/frontend plugins/*/app/frontend eslint-rules package.json package-lock.json tsconfig.json vite.config.ts",
    "format:frontend:changed": "git diff --name-only origin/main...HEAD -- app/frontend 'plugins/*/app/frontend/**' eslint-rules package.json package-lock.json tsconfig.json vite.config.ts | xargs -r prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@floating-ui/react": "^0.27.20",
    "@github/webauthn-json": "^2.1.1",
    "@rails/actioncable": "^8.1.401",
    "@shikijs/core": "^4.6.0",
    "@shikijs/engine-oniguruma": "^4.6.0",
    "@shikijs/langs": "^4.6.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "3.14.15",
    "@xterm/addon-fit": "^0.11.0",
    "d3-scale": "^4.0.3",
    "d3-selection": "^3.0.1",
    "d3-zoom": "^3.0.1",
    "html2canvas-pro": "^1.5.13",
    "i18next": "^26.7.2",
    "katex": "^0.16.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.1.13",
    "react-joyride": "^3.2.0",
    "react-router-dom": "^7.18.5",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vitest": "^4.1.11"
  }
}
