# Syrus single-host (Docker Compose) configuration template.
#
# `bin/compose-up` copies this to `.env` on first run and fills in the four
# secrets below with fresh random values. To do it by hand instead:
#   cp compose.env.example .env   (then replace every `generate-me`)
#
# `.env` is gitignored — keep your secrets out of source control. The full
# reference for every supported variable lives in `.env.example`.

RAILS_ENV=production

# Prebuilt image to run (install.sh pulls this). Override to pin a version
# instead of tracking :latest. Ignored when building from source via bin/compose-up.
# SYRUS_IMAGE=ghcr.io/tkadauke/syrus-local:0.1.0

# --- Secrets (bin/compose-up generates these; never commit real values) ------
SECRET_KEY_BASE=generate-me
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=generate-me
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=generate-me
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=generate-me

# --- Local single-host mode --------------------------------------------------
# Run production against SQLite under SYRUS_DATA_ROOT (no MySQL).
SYRUS_SQLITE=1
SYRUS_DATA_ROOT=/home/rails/.syrus
# Dedicated SQLite FTS5 search DB. Defaults to $SYRUS_DATA_ROOT/search.sqlite3
# when unset; Compose mounts a separate persistent volume for it.
SEARCH_DATABASE_PATH=/home/rails/.syrus-search/search.sqlite3
SYRUS_APP_HOST=localhost:3000
# Interactive terminal relay address advertised by worker-side terminal sessions:
# blank means bare-metal/local fallback to 127.0.0.1; Docker Compose overrides
# the worker container to `worker`; Kubernetes should set this to the worker pod
# IP with the Downward API.
SYRUS_TERMINAL_HOST=
# Serve plain HTTP locally (no TLS termination in front of the container).
SYRUS_ASSUME_SSL=false
SYRUS_FORCE_SSL=false
# Host port mapped to the container (http://localhost:<port>).
SYRUS_PORT=3000
RAILS_LOG_LEVEL=info
# Log to the container's stdout so `docker compose logs` shows app output.
RAILS_LOG_TO_STDOUT=true
# Present-but-empty so the in-app bug-report button doesn't error if clicked.
SYRUS_BUG_REPORT_OWNER=
# GitHub owner/repo of this install's own source, for the build-revision link in
# the UI footer. Defaults to the upstream repo; change it if you run a fork.
SYRUS_GITHUB_REPO=tkadauke/syrus

# --- Worker extensibility ----------------------------------------------------
# Extra apt packages baked into the worker image so your repos' prepare/grader
# commands have what they need. The base already includes Ruby/Node/Go (via
# mise), Python + poetry/uv, build tools, and db clients. Space-separated; edit
# then rerun `bin/compose-up`.
# Example: EXTRA_APT_PACKAGES="imagemagick ffmpeg libmagic-dev"
EXTRA_APT_PACKAGES=
