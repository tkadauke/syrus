#!/usr/bin/env ruby
# frozen_string_literal: true

# Fails when core code reaches into a plugin, when a plugin reaches into
# another plugin it does not declare a dependency on, when a depends_on names
# a plugin that is not installed, or when the dependency graph has a cycle.
#
# It also decides, for every bundled plugin, whether deleting it leaves a
# closed system (Formal::PluginDeletion; formal/SyrusModel/PluginDeletion.lean
# proves that checking the edges leaving kept code is enough). That replaces
# booting a reduced copy of the tree per plugin (NY42). bin/plugin-boundary-audit
# remains for a manual physical check, and
# spec/architecture/plugin_deletion_plants_spec.rb pins which coupling kinds
# the scan recognizes.

ENV["RAILS_ENV"] ||= "test"

require_relative "../config/environment"

root = Pathname.new(ENV.fetch("PLUGIN_BOUNDARY_AUDIT_ROOT", Rails.root.to_s))
audit = Admin::PluginSourceBoundaryAudit.new(root: root)

failures = []

audit.missing_dependencies.each do |source, dependency|
  failures << "#{source} declares depends_on #{dependency.inspect}, which is not an installed plugin"
end

audit.graph.cycles.each do |cycle|
  failures << "dependency cycle: #{cycle.join(' -> ')}"
end

failures.concat(audit.core_violations.map(&:message))
failures.concat(audit.plugin_violations.map(&:message))

deletion = Formal::PluginDeletion.new(audit)
verdicts = audit.bundled_manifest_names.map { |plugin| deletion.call(plugin) }
verdicts.reject { |result| result.verdict == :safe }.each do |result|
  edges = result.crossing.map(&:from).uniq.first(3).join(", ")
  failures << "deleting #{result.plugin} (removes #{result.removed.join(', ')}) is #{result.verdict}: #{edges}"
end
failures.concat(Admin::PluginHostSurfaceAudit.new.findings)

enforce_ownership = ENV["PLUGIN_OWNERSHIP_ENFORCE"] == "1"
ownership_findings = []
begin
  ownership_findings = Admin::PluginOwnershipAudit.new(root: root).findings.map(&:message)
rescue StandardError, ScriptError => e
  ownership_findings = [ "ownership audit could not complete: #{e.class}: #{e.message}" ]
end

if ownership_findings.any?
  warn "Plugin ownership inventory findings (shadow mode):"
  ownership_findings.each { |message| warn "- WARNING (ownership): #{message}" }
  warn "These findings are informational and do not affect this command's exit status."
  warn "Set PLUGIN_OWNERSHIP_ENFORCE=1 only after an explicit operator decision to enforce them."
end

failures.concat(ownership_findings) if enforce_ownership

if failures.empty?
  puts "Every bundled plugin is deletable (#{verdicts.size} checked)."
  puts "Plugin source boundaries look good."
  exit 0
end

warn "Plugin source boundary check failed:"
failures.each { |failure| warn "- #{failure}" }
exit 1
