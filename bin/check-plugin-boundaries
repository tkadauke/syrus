#!/usr/bin/env ruby
# frozen_string_literal: true

# Fails when core code reaches into a plugin, when a plugin reaches into
# another plugin it does not declare a dependency on, when a depends_on names
# a plugin that is not installed, or when the dependency graph has a cycle.
#
# This is the static half of the plugin boundary rules. The stronger check --
# physically removing a plugin and booting without it -- is the opt-in
# bin/plugin-boundary-audit script, which is too slow for a grade loop.

ENV["RAILS_ENV"] ||= "test"

require_relative "../config/environment"

root = Pathname.new(ENV.fetch("PLUGIN_BOUNDARY_AUDIT_ROOT", Rails.root.to_s))
audit = Admin::PluginSourceBoundaryAudit.new(root: root)

failures = []

audit.missing_dependencies.each do |source, dependency|
  failures << "#{source} declares depends_on #{dependency.inspect}, which is not an installed plugin"
end

audit.graph.cycles.each do |cycle|
  failures << "dependency cycle: #{cycle.join(' -> ')}"
end

failures.concat(audit.core_violations.map(&:message))
failures.concat(audit.plugin_violations.map(&:message))

ownership_findings = Admin::PluginOwnershipAudit.new(root: root).findings
if ownership_findings.any?
  warn "Plugin ownership inventory findings (shadow mode):"
  ownership_findings.each { |finding| warn "- #{finding.message}" }
  warn "These findings are informational and do not affect this command's exit status."
  warn "Set PLUGIN_OWNERSHIP_ENFORCE=1 only after an explicit operator decision to enforce them."
end

if ENV["PLUGIN_OWNERSHIP_ENFORCE"] == "1"
  failures.concat(ownership_findings.map(&:message))
end

if failures.empty?
  puts "Plugin source boundaries look good."
  exit 0
end

warn "Plugin source boundary check failed:"
failures.each { |failure| warn "- #{failure}" }
exit 1
