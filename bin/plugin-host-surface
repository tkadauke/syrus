#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"

options = { json: false }
parser = OptionParser.new do |opts|
  opts.banner = "Usage: bin/plugin-host-surface inventory [--json]\n       bin/plugin-host-surface scan DIR [--json]"
  opts.on("--json", "Print machine-readable JSON") { options[:json] = true }
end
parser.parse!
command = ARGV.shift
abort parser.to_s unless command == "inventory" ? ARGV.empty? : command == "scan" && ARGV.one?

ENV["RAILS_ENV"] ||= "test"
require_relative "../config/environment"
require "json"

if command == "scan"
  result = Syrus::PluginHostSurface::Scanner.new(ARGV.first).call
  if options[:json]
    puts JSON.pretty_generate(result.to_h.merge(
      public: result.public.map(&:to_h), unlisted: result.unlisted.map(&:to_h),
      dynamic: result.dynamic.map(&:to_h)
    ))
  else
    puts "Minimum Syrus version: #{result.minimum_syrus_version || 'none'}"
    result.findings.each { |finding| puts "#{finding.tier.upcase.ljust(8)} #{finding.constant}  #{finding.path}:#{finding.line}" }
    puts "No core API references found." if result.findings.empty?
  end
  exit(result.violations? ? 1 : 0)
end

results = Admin::PluginHostSurfaceInventory.new.results
if options[:json]
  puts JSON.pretty_generate(results.map(&:to_h))
else
  rows = results.map { |result| [ result.constant, result.tier, result.plugins.map { |plugin, count| "#{plugin} (#{count})" }.join(", ") ] }
  widths = [ "CONSTANT", "TIER", "PLUGINS (REFERENCES)" ].each_with_index.map { |heading, index| [ heading.length, *rows.map { |row| row[index].length } ].max }
  format = widths.map { |width| "%-#{width}s" }.join("  ")
  puts format % [ "CONSTANT", "TIER", "PLUGINS (REFERENCES)" ]
  rows.each { |row| puts format % row }
  puts "\n#{results.size} core constants, #{results.sum(&:count)} references"
end
