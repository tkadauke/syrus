#!/usr/bin/env bash
# Build (and optionally publish) Syrus release artifacts from this checkout.
#
# NOTE: the canonical release path is the CI pipeline — Actions -> "Release"
# (.github/workflows/release.yml), which signs, notarizes, and publishes
# everything atomically. See docs/releasing.md. This script is kept for LOCAL
# artifact builds and verification (especially `--no-upload`); the CLI tarball
# release also still runs through here. Prefer the workflow for real releases.
#
# Usage:
#   bin/release [VERSION] [--next-patch|--next-minor] [--cli] [--desktop] [--image] [--all]
#                       [--no-upload] [--skip-tests] [--skip-install]
#                       [--multi-arch] [--launch-desktop]
#
# Defaults to --all. With upload enabled, this refuses existing versions,
# creates/pushes the git tag, generates Claude-written GitHub release notes,
# ensures the GitHub release exists, uploads CLI/Desktop artifacts, and publishes
# the Docker image. Use --no-upload for local artifact builds only; when no
# VERSION is provided, --no-upload defaults to v0.0.0-local.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$ROOT/bin/release-lib"

VERSION=""
UPLOAD=1
SKIP_TESTS=0
SKIP_INSTALL=0
MULTI_ARCH=0
LAUNCH_DESKTOP=0
NEXT_BUMP=""
SELECTED=()
UPLOAD_DIRS=()
IMAGE_SELECTED=0

usage() {
  awk 'NR>1 && /^#/{sub(/^# ?/,""); print; next} NR>1{exit}' "$0"
}

select_component() {
  local component="${1:?usage: select_component COMPONENT}"
  local existing

  for existing in "${SELECTED[@]:-}"; do
    if [ "$existing" = "$component" ]; then
      return 0
    fi
  done

  SELECTED+=("$component")
}

for arg in "$@"; do
  case "$arg" in
    --next-patch)
      if [ -n "$NEXT_BUMP" ]; then
        echo "Specify only one of --next-patch or --next-minor." >&2
        usage >&2
        exit 2
      fi
      NEXT_BUMP=patch
      ;;
    --next-minor)
      if [ -n "$NEXT_BUMP" ]; then
        echo "Specify only one of --next-patch or --next-minor." >&2
        usage >&2
        exit 2
      fi
      NEXT_BUMP=minor
      ;;
    --cli) select_component cli ;;
    --desktop) select_component desktop ;;
    --image) select_component image ;;
    --all) SELECTED=(cli desktop image) ;;
    --no-upload) UPLOAD=0 ;;
    --skip-tests) SKIP_TESTS=1 ;;
    --skip-install) SKIP_INSTALL=1 ;;
    --multi-arch) MULTI_ARCH=1 ;;
    --launch-desktop) LAUNCH_DESKTOP=1 ;;
    --help|-h) usage; exit 0 ;;
    -*) echo "Unknown flag: $arg" >&2; usage >&2; exit 2 ;;
    *)
      if [ -n "$VERSION" ]; then
        echo "Unexpected argument: $arg" >&2
        usage >&2
        exit 2
      fi
      VERSION="$arg"
      ;;
  esac
done

if [ -n "$NEXT_BUMP" ] && [ -n "$VERSION" ]; then
  echo "Specify either VERSION or --next-$NEXT_BUMP, not both." >&2
  usage >&2
  exit 2
fi

if [ "${#SELECTED[@]}" -eq 0 ]; then
  SELECTED=(cli desktop image)
fi

if [ -n "$NEXT_BUMP" ]; then
  if [ "$UPLOAD" = 1 ]; then
    syrus_release_fetch_tags
  fi
  VERSION="$(syrus_release_next_version "$NEXT_BUMP")"
  echo "== Using next $NEXT_BUMP release: $VERSION =="
fi

if [ -z "$VERSION" ] && [ "$UPLOAD" = 0 ]; then
  VERSION="$(syrus_release_local_version)"
fi

syrus_release_validate_version "$VERSION"

if [ "$UPLOAD" = 1 ]; then
  syrus_release_require_clean_tree
  syrus_release_fetch_tags
  syrus_release_assert_new_version "$VERSION"
else
  echo "== Local release build only (--no-upload) =="
fi

for component in "${SELECTED[@]}"; do
  case "$component" in
    cli)
      args=("$VERSION")
      [ "$SKIP_TESTS" = 1 ] && args+=(--skip-tests)
      "$ROOT/bin/release-cli" "${args[@]}"
      UPLOAD_DIRS+=("$(syrus_release_output_dir "$VERSION" cli)")
      ;;
    desktop)
      args=("$VERSION")
      [ "$SKIP_TESTS" = 1 ] && args+=(--skip-tests)
      [ "$SKIP_INSTALL" = 1 ] && args+=(--skip-install)
      [ "$LAUNCH_DESKTOP" = 1 ] && args+=(--launch)
      "$ROOT/bin/release-desktop" "${args[@]}"
      UPLOAD_DIRS+=("$(syrus_release_output_dir "$VERSION" desktop)")
      ;;
    image)
      IMAGE_SELECTED=1
      ;;
    *)
      echo "Unknown component: $component" >&2
      exit 2
      ;;
  esac
done

if [ "$UPLOAD" = 1 ]; then
  RELEASE_NOTES_FILE="$(syrus_release_notes_file "$VERSION")"
  "$ROOT/bin/release-notes" "$VERSION"

  syrus_release_ensure_tag "$VERSION"
  syrus_release_push_tag "$VERSION"
  syrus_release_ensure_github_release "$VERSION" "$RELEASE_NOTES_FILE"

  for output_dir in "${UPLOAD_DIRS[@]:-}"; do
    echo
    echo "== Uploading artifacts from $output_dir to GitHub release $VERSION =="
    syrus_release_upload_dir "$VERSION" "$output_dir"
  done
fi

if [ "$IMAGE_SELECTED" = 1 ]; then
  if [ "$UPLOAD" = 1 ]; then
    args=("$VERSION")
    [ "$SKIP_TESTS" = 1 ] && args+=(--skip-tests)
    [ "$MULTI_ARCH" = 1 ] && args+=(--multi-arch)
    "$ROOT/bin/release-image" "${args[@]}"
  else
    echo "== Skipping Docker image publish because --no-upload was provided =="
  fi
fi

echo
echo "Release complete: $VERSION"
