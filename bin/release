#!/usr/bin/env bash
# Build Syrus release artifacts LOCALLY, for inspection and verification.
#
# This does NOT publish. The canonical release path is the CI pipeline —
# Actions -> "Release" (.github/workflows/release.yml), which computes the
# version, signs, generates notes, moves the image :latest, and publishes
# everything atomically. See docs/releasing.md. Use this script to build the
# CLI and/or desktop artifacts on your own machine (e.g. to verify a signing
# or packaging change) before cutting a real release through the workflow.
#
# Usage:
#   bin/release [VERSION] [--cli] [--desktop] [--all]
#               [--skip-tests] [--skip-install] [--launch-desktop]
#
#   VERSION            version string for artifact naming; defaults to
#                      v0.0.0-local. (The real version is chosen by the
#                      Release workflow, not here.)
#   --cli / --desktop  build only that component; --all (default) builds both.
#   --skip-tests       skip the component test gates.
#   --skip-install     desktop: skip the dependency install step.
#   --launch-desktop   desktop: open the packaged app when the build finishes.
#
# Artifacts land under dist/releases/<version>/{cli,desktop}/. Nothing is
# tagged, uploaded, or pushed. To publish an image locally use
# bin/publish-image; to preview release notes use bin/release-notes.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$ROOT/bin/release-lib"

VERSION=""
SKIP_TESTS=0
SKIP_INSTALL=0
LAUNCH_DESKTOP=0
SELECTED=()

usage() {
  awk 'NR>1 && /^#/{sub(/^# ?/,""); print; next} NR>1{exit}' "$0"
}

select_component() {
  local component="${1:?usage: select_component COMPONENT}"
  local existing

  for existing in "${SELECTED[@]:-}"; do
    if [ "$existing" = "$component" ]; then
      return 0
    fi
  done

  SELECTED+=("$component")
}

# Flags that used to publish a real release. That job moved to CI; point the
# operator at the workflow (or the direct local tools) instead of silently
# doing something different.
retired_publish_flag() {
  cat >&2 <<MSG
bin/release no longer publishes releases — that is the Release workflow's job
(Actions -> "Release", .github/workflows/release.yml; see docs/releasing.md).

  $1

This script builds local CLI/desktop artifacts only. For a local image push
use bin/publish-image; to preview notes use bin/release-notes.
MSG
  exit 2
}

for arg in "$@"; do
  case "$arg" in
    --cli) select_component cli ;;
    --desktop) select_component desktop ;;
    --all) SELECTED=(cli desktop) ;;
    --skip-tests) SKIP_TESTS=1 ;;
    --skip-install) SKIP_INSTALL=1 ;;
    --launch-desktop) LAUNCH_DESKTOP=1 ;;
    # Accepted as a no-op: local-only is now the only mode.
    --no-upload) ;;
    --next-patch|--next-minor)
      retired_publish_flag "Versioning is chosen by the workflow; pass an explicit VERSION for local artifact naming, or omit it for v0.0.0-local." ;;
    --image|--multi-arch)
      retired_publish_flag "Image publishing moved to CI. Use bin/publish-image directly for a local push." ;;
    --help|-h) usage; exit 0 ;;
    -*) echo "Unknown flag: $arg" >&2; usage >&2; exit 2 ;;
    *)
      if [ -n "$VERSION" ]; then
        echo "Unexpected argument: $arg" >&2
        usage >&2
        exit 2
      fi
      VERSION="$arg"
      ;;
  esac
done

if [ "${#SELECTED[@]}" -eq 0 ]; then
  SELECTED=(cli desktop)
fi

if [ -z "$VERSION" ]; then
  VERSION="$(syrus_release_local_version)"
fi

syrus_release_validate_version "$VERSION"

echo "== Local artifact build only — nothing is published (release path: Actions -> Release) =="

for component in "${SELECTED[@]}"; do
  case "$component" in
    cli)
      args=("$VERSION")
      [ "$SKIP_TESTS" = 1 ] && args+=(--skip-tests)
      "$ROOT/bin/release-cli" "${args[@]}"
      echo "   built: $(syrus_release_output_dir "$VERSION" cli)"
      ;;
    desktop)
      args=("$VERSION")
      [ "$SKIP_TESTS" = 1 ] && args+=(--skip-tests)
      [ "$SKIP_INSTALL" = 1 ] && args+=(--skip-install)
      [ "$LAUNCH_DESKTOP" = 1 ] && args+=(--launch)
      "$ROOT/bin/release-desktop" "${args[@]}"
      echo "   built: $(syrus_release_output_dir "$VERSION" desktop)"
      ;;
    *)
      echo "Unknown component: $component" >&2
      exit 2
      ;;
  esac
done

echo
echo "Local build complete: $VERSION"
echo "Artifacts under dist/releases/$VERSION/. To publish, run the Release workflow."
