#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/simulator_test_database_identity"
require_relative "../lib/simulator_schema_reconciler"

ENV["RAILS_ENV"] ||= "test"
SimulatorTestDatabaseIdentity.ensure_env_number! if ENV["RAILS_ENV"] == "test"

# The engine reads and writes $SYRUS_DATA_ROOT (clones, workspaces), which
# falls back to the operator's real ~/.syrus. Simulated repositories reuse
# small ids, so a scenario resolved the operator's own bare clones and shelled
# out to git against them on every landing decision. Keep the simulator in a
# data root of its own, outside the checkout for the reason
# spec/support/data_root.rb gives.
if ENV["RAILS_ENV"] == "test"
  require "tmpdir"
  ENV["SYRUS_DATA_ROOT"] ||= File.join(Dir.tmpdir, "syrus-simulator-data-root#{ENV['TEST_ENV_NUMBER']}")
end

require_relative "../config/environment"

if Rails.env.test?
  # Every simulated tick writes hundreds of SQL lines to log/test.log, about a
  # tenth of the run time and gigabytes over a fuzz campaign. SIMULATOR_LOG=1
  # keeps them for debugging.
  Rails.logger.level = :warn unless ENV["SIMULATOR_LOG"].present?
  SimulatorSchemaReconciler.call!
  ActiveRecord::Migration.maintain_test_schema!
  %w[claude_agent codex_agent agy_agent].each do |plugin_name|
    record = PluginRecord.find_or_create_by!(name: plugin_name)
    record.update!(enabled: true) unless record.enabled?
  end
  Syrus::PluginRegistry.clear_plugin_record_cache!
  WorkEngine::Simulation::SolidQueueBootstrap.clear!
  # Scenarios assert the row-lock order like the test suite does; the
  # runner records inversions and fails the scenario on them.
  require_relative "../lib/syrus/lock_order"
  ENV["SYRUS_LOCK_ORDER_WRITES"] ||= "1"
  Syrus::LockOrder::Checker.install!
  Syrus::LockOrder::Checker.mode ||= :record
end

# Unbuffered, so a long fuzz campaign redirected to a file reports as it goes.
$stdout.sync = true
exit WorkEngine::Simulation::Cli.call(argv: ARGV)
