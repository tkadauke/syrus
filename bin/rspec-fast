#!/usr/bin/env bash
set -euo pipefail

export RAILS_ENV="${RAILS_ENV:-test}"
export COVERAGE="${COVERAGE:-false}"
export PARALLEL_TEST_PROCESSORS="${RSPEC_PROCESSES:-8}"
export RSPEC_JSON_DIR="${RSPEC_JSON_DIR:-.syrus/rspec-json}"
export RSPEC_JUNIT_DIR="${RSPEC_JUNIT_DIR:-.syrus/rspec-junit}"
# Merged destination. Must match the `junit_output:` key of the rspec grader
# in .syrus.yml, which is what Steps::Grader ingests for test insights.
export RSPEC_JUNIT_OUTPUT="${RSPEC_JUNIT_OUTPUT:-.syrus/grade-output/rspec-junit.xml}"

# Always exclude :ci_only specs from the parallel run, regardless of an
# ambient CI=true (GitHub Actions sets this on every job). :ci_only specs
# that mutate schema in-process (e.g. migration reversibility specs) are
# not safe to interleave with unrelated specs inside a shared parallel
# worker; bin/rspec-ci runs them afterward in their own isolated,
# serial pass instead. See spec/spec_helper.rb.
export RUN_CI_ONLY_SPECS=false

mkdir -p .syrus
exec 9>.syrus/rspec-fast.lock
if ! ruby -e 'exit(File.for_fd(9).flock(File::LOCK_EX | File::LOCK_NB) ? 0 : 1)'; then
  echo "Another bin/rspec-fast run is already active in this checkout; refusing to share SQLite test databases." >&2
  exit 1
fi

mkdir -p "$RSPEC_JSON_DIR" "$RSPEC_JUNIT_DIR" "$(dirname "$RSPEC_JUNIT_OUTPUT")"
rm -f "$RSPEC_JSON_DIR"/rspec-*.json "$RSPEC_JUNIT_DIR"/rspec-junit-*.xml "$RSPEC_JUNIT_OUTPUT"
if [ "$COVERAGE" = "true" ]; then
  rm -f coverage/.resultset.json coverage/.resultset.json.lock coverage/lcov.info
fi

bin/rails db:test:prepare
bundle exec rake parallel:prepare
spec_file_count=""
if [ "$#" -eq 0 ]; then
  spec_file_count="$(
    {
      find spec -type f -name '*_spec.rb'
      find plugins -path '*/spec/*_spec.rb' -type f
      find plugins -path '*/spec/**/*_spec.rb' -type f
    } | sort -u | wc -l | tr -d ' '
  )"
else
  selected_spec_file_count=0
  for arg in "$@"; do
    case "$arg" in
      -*) continue ;;
    esac

    if [ -f "$arg" ]; then
      case "$arg" in
        *_spec.rb) selected_spec_file_count=$((selected_spec_file_count + 1)) ;;
      esac
    elif [ -d "$arg" ]; then
      count="$(find "$arg" -type f -name '*_spec.rb' | wc -l | tr -d ' ')"
      selected_spec_file_count=$((selected_spec_file_count + count))
    fi
  done
  if [ "$selected_spec_file_count" -gt 0 ]; then
    spec_file_count="$selected_spec_file_count"
  fi
fi

if [ -n "$spec_file_count" ]; then
  if [ "$spec_file_count" -eq 1 ]; then
    echo "$PARALLEL_TEST_PROCESSORS processes for 1 spec file"
  else
    echo "$PARALLEL_TEST_PROCESSORS processes for $spec_file_count spec files"
  fi
else
  echo "$PARALLEL_TEST_PROCESSORS processes for selected spec files"
fi

start_time="$SECONDS"
set +e
if [ "$#" -eq 0 ]; then
  bundle exec parallel_rspec \
    -n "$PARALLEL_TEST_PROCESSORS" \
    --quiet \
    --exec-args bin/rspec-worker \
    spec plugins
else
  bundle exec parallel_rspec \
    -n "$PARALLEL_TEST_PROCESSORS" \
    --quiet \
    --exec-args bin/rspec-worker \
    "$@"
fi
status="$?"
set -e

ruby -rjson -e '
  files = Dir[File.join(ARGV.fetch(0), "rspec-*.json")]
  exit if files.empty?

  totals = files.each_with_object(Hash.new(0)) do |path, memo|
    summary = JSON.parse(File.read(path)).fetch("summary", {})
    memo[:examples] += summary.fetch("example_count", 0).to_i
    memo[:failures] += summary.fetch("failure_count", 0).to_i
    memo[:pending] += summary.fetch("pending_count", 0).to_i
  end

  parts = ["#{totals[:examples]} examples", "#{totals[:failures]} failures"]
  parts << "#{totals[:pending]} pending" if totals[:pending].positive?
  puts
  puts parts.join(", ")
' "$RSPEC_JSON_DIR"
# Merge the per-worker JUnit documents into one. Each worker only ran its own
# slice of the suite, so ingesting a single worker's file would silently record
# a fraction of the run. JunitXmlParser accepts a <testsuites> wrapper, so the
# merge is a concatenation of each document's <testsuite> elements.
ruby -rrexml/document -e '
  dir, out = ARGV
  files = Dir[File.join(dir, "rspec-junit-*.xml")].sort
  exit if files.empty?

  merged = REXML::Document.new("<testsuites/>")
  totals = Hash.new(0)
  files.each do |path|
    doc = begin
      REXML::Document.new(File.read(path))
    rescue StandardError
      next
    end
    next unless doc.root

    suites = doc.root.name == "testsuites" ? doc.root.elements.to_a("testsuite") : [ doc.root ]
    suites.each do |suite|
      %w[tests failures errors skipped].each { |k| totals[k] += suite.attributes[k].to_i }
      totals["time"] += suite.attributes["time"].to_f
      merged.root.add_element(suite.deep_clone)
    end
  end
  exit if merged.root.elements.empty?

  %w[tests failures errors skipped].each { |k| merged.root.add_attribute(k, totals[k].to_s) }
  merged.root.add_attribute("time", format("%.6f", totals["time"]))
  File.write(out, merged.to_s)
' "$RSPEC_JUNIT_DIR" "$RSPEC_JUNIT_OUTPUT"

echo
echo "Took $((SECONDS - start_time)) seconds"
exit "$status"
