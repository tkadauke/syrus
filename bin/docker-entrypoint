#!/bin/bash -e

# Seed /opt/mise from /opt/mise-seed when the volume is empty. cp -rn
# (no-clobber) is safe for partially-populated volumes; reshim rebuilds
# shims so seeded installs are immediately on PATH.
if [ -d /opt/mise-seed ] && [ -z "$(ls -A /opt/mise/installs 2>/dev/null)" ]; then
  cp -rn /opt/mise-seed/. /opt/mise/
  /usr/local/bin/mise reshim
fi

# Older persisted /opt/mise volumes may have the Go runtime installed but no
# global mise version, which leaves the go shim unusable.
if [ -n "${SYRUS_MISE_GO_VERSION:-}" ] && [ -d "/opt/mise/installs/go/${SYRUS_MISE_GO_VERSION}" ]; then
  /usr/local/bin/mise use --global "go@${SYRUS_MISE_GO_VERSION}" >/dev/null
  /usr/local/bin/mise reshim go >/dev/null
fi

prepare_search_database() {
  if [ "${SYRUS_SKIP_SEARCH_PREPARE:-}" != "1" ]; then
    ./bin/rails syrus:prepare_search
  fi
}

check_pending_migrations() {
  ./bin/rails db:abort_if_pending_migrations
}

# If running the rails server then create or migrate existing databases.
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
  prepare_search_database
elif [ "${@: -1:1}" == "./bin/jobs" ] || [ "${@: -1:1}" == "bin/jobs" ]; then
  check_pending_migrations
  prepare_search_database
fi

exec "${@}"
