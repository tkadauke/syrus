#!/usr/bin/env bash
# Runs React/TypeScript unit tests for the SPA migration.
set -euo pipefail

# Install node_modules if missing or stale. npm writes node_modules/.package-lock.json,
# which gives us a cheap freshness check without running npm on every grader pass.
if [ ! -d node_modules/.bin ] || [ ! -f node_modules/.package-lock.json ] || [ package-lock.json -nt node_modules/.package-lock.json ] || [ package.json -nt node_modules/.package-lock.json ]; then
  npm ci
fi

vitest_max_workers="${VITEST_MAX_WORKERS:-2}"
vitest_junit_output="${VITEST_JUNIT_OUTPUT:-.syrus/grade-output/react-tests-junit.xml}"
mkdir -p "$(dirname "$vitest_junit_output")"

# TypeScript is cheap compared with coverage, so fail before spending the long
# Vitest pass when the typed frontend model is already broken. Keep Vitest by
# itself: coverage plus jsdom already saturates shared grader hosts, and running
# other type-aware tooling beside it has produced resource-pressure failures.
npm run typecheck

exec npx vitest run --coverage --maxWorkers "$vitest_max_workers" --reporter=default --reporter=junit --outputFile.junit="$vitest_junit_output"
