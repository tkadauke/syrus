#!/usr/bin/env bash
# Runs React/TypeScript unit tests for the SPA migration.
set -euo pipefail

# Install node_modules if missing or stale. npm writes node_modules/.package-lock.json,
# which gives us a cheap freshness check without running npm on every grader pass.
if [ ! -d node_modules/.bin ] || [ ! -f node_modules/.package-lock.json ] || [ package-lock.json -nt node_modules/.package-lock.json ] || [ package.json -nt node_modules/.package-lock.json ]; then
  npm ci
fi

vitest_max_workers="${VITEST_MAX_WORKERS:-4}"

# Vitest is the dominant cost here; run `tsc --noEmit` concurrently instead
# of after it so the two don't serialize inside the grader's wall-clock
# budget (see the react-tests grader in .syrus.yml).
npx vitest run --coverage --maxWorkers "$vitest_max_workers" &
vitest_pid=$!

npm run typecheck &
typecheck_pid=$!

vitest_status=0
typecheck_status=0
wait "$vitest_pid" || vitest_status=$?
wait "$typecheck_pid" || typecheck_status=$?

if [ "$vitest_status" -ne 0 ]; then
  exit "$vitest_status"
fi
exit "$typecheck_status"
