#!/usr/bin/env bash
# Runs React/TypeScript unit tests for the SPA migration.
set -euo pipefail

# Install node_modules if missing — mirrors the `bundle check || bundle install`
# pattern used by Ruby graders so this script is self-sufficient when the prepare
# step does not complete npm ci before graders run.
[ -d "node_modules" ] || npm ci

vitest_max_workers="${VITEST_MAX_WORKERS:-4}"

# Run typecheck and vitest in parallel so total wall time is the max of the
# two rather than their sum. Both must pass; errors from either are surfaced.
npm run typecheck &
typecheck_pid=$!

set +e
npx vitest run --coverage --maxWorkers "$vitest_max_workers"
vitest_exit=$?
set -e

wait "$typecheck_pid"
typecheck_exit=$?

if [ "$vitest_exit" -ne 0 ]; then exit "$vitest_exit"; fi
exit "$typecheck_exit"
