#!/usr/bin/env bash
set -euo pipefail

export RAILS_ENV="${RAILS_ENV:-test}"
export RSPEC_JSON_DIR="${RSPEC_JSON_DIR:-.syrus/rspec-json}"
# Per-worker JUnit XML. The typed RSpec grader command merges these into the
# configured `junit_output:` path after parallel_rspec finishes.
export RSPEC_JUNIT_DIR="${RSPEC_JUNIT_DIR:-.syrus/rspec-junit}"

mkdir -p "$RSPEC_JSON_DIR" "$RSPEC_JUNIT_DIR"
worker_id="${TEST_ENV_NUMBER:-1}"
json_prefix="${RSPEC_OUTPUT_PREFIX:-rspec}"
junit_prefix="${RSPEC_JUNIT_PREFIX:-rspec-junit}"
tag_args=()
if [ -n "${RSPEC_TAG_ARGS:-}" ]; then
  # shellcheck disable=SC2206
  tag_args=(${RSPEC_TAG_ARGS})
else
  tag_args=(--tag ~ci_only)
fi

exec bin/rspec \
  "${tag_args[@]}" \
  --require rspec_junit_formatter \
  --format progress \
  --format json \
  --out "$RSPEC_JSON_DIR/${json_prefix}-${worker_id}.json" \
  --format RspecJunitFormatter \
  --out "$RSPEC_JUNIT_DIR/${junit_prefix}-${worker_id}.xml" \
  "$@"
