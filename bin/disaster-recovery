#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require_relative "../plugins/local_backups/lib/local_backups/recovery"

options = {
  root: ENV["SYRUS_BACKUP_ROOT"], max_bytes: Integer(ENV.fetch("SYRUS_RECOVERY_MAX_BYTES", LocalBackups::Recovery::DEFAULT_MAX_BYTES)),
  max_files: Integer(ENV.fetch("SYRUS_RECOVERY_MAX_FILES", LocalBackups::Recovery::DEFAULT_MAX_FILES))
}
parser = OptionParser.new do |opts|
  opts.banner = "usage: bin/disaster-recovery COMMAND [BUNDLE] [options]"
  opts.on("--root PATH") { |value| options[:root] = value }
  opts.on("--destination PATH") { |value| options[:destination] = value }
  opts.on("--installation-id ID") { |value| options[:installation_id] = value }
  opts.on("--database-adapter NAME") { |value| options[:database_adapter] = value }
  opts.on("--database-version VERSION") { |value| options[:database_version] = value }
  opts.on("--application-version VERSION") { |value| options[:application_version] = value }
  opts.on("--plugin NAME") { |value| (options[:plugins] ||= []) << value }
  opts.on("--encryption-fingerprints JSON") { |value| options[:encryption_fingerprints] = JSON.parse(value) }
  opts.on("--in-flight COUNT", Integer) { |value| options[:in_flight] = value }
  opts.on("--max-bytes BYTES", Integer) { |value| options[:max_bytes] = value }
  opts.on("--max-files COUNT", Integer) { |value| options[:max_files] = value }
  opts.on("--stdin") { options[:stdin] = true }
end

command = ARGV.shift
parser.parse!(ARGV)
bundle_argument = ARGV.shift

def open_bundle(argument, options)
  return LocalBackups::Recovery::Bundle.materialize($stdin.binmode, max_bytes: options[:max_bytes], max_files: options[:max_files]) if options[:stdin]
  raise LocalBackups::Recovery::Error, "a bundle path is required" if argument.to_s.empty?
  path = Pathname.new(argument)
  return LocalBackups::Recovery::Bundle.new(path, max_bytes: options[:max_bytes], max_files: options[:max_files]) if path.directory?
  path.open("rb") { |input| LocalBackups::Recovery::Bundle.materialize(input, max_bytes: options[:max_bytes], max_files: options[:max_files]) }
end

begin
case command
when "list"
  raise LocalBackups::Recovery::Error, "--root is required" if options[:root].to_s.empty?
  Pathname.new(options[:root]).children.select(&:directory?).sort.each do |path|
    begin
      bundle = LocalBackups::Recovery::Bundle.new(path, max_bytes: options[:max_bytes], max_files: options[:max_files])
      puts [bundle.manifest["backup_id"], bundle.manifest["completed_at"], path].join("\t")
    rescue LocalBackups::Recovery::Error
      next
    end
  end
when "inspect"
  puts JSON.pretty_generate(open_bundle(bundle_argument, options).manifest)
when "validate"
  bundle = open_bundle(bundle_argument, options).validate!
  puts JSON.generate(status: "valid", artifact_checksum: bundle.checksum)
when "copy"
  bundle = open_bundle(bundle_argument, options).validate!
  raise LocalBackups::Recovery::Error, "--destination is required" if options[:destination].to_s.empty?
  destination = Pathname.new(options[:destination])
  raise LocalBackups::Recovery::Error, "destination already exists" if destination.exist?
  FileUtils.copy_entry(bundle.path, destination, false, false, true)
  puts destination
when "import"
  raise LocalBackups::Recovery::Error, "--root is required" if options[:root].to_s.empty?
  puts LocalBackups::Recovery::Importer.new(root: options[:root], max_bytes: options[:max_bytes], max_files: options[:max_files]).import(open_bundle(bundle_argument, options))
when "preflight"
  bundle = open_bundle(bundle_argument, options)
  destination = options[:destination] || ENV["SYRUS_DATA_ROOT"]
  raise LocalBackups::Recovery::Error, "--destination or SYRUS_DATA_ROOT is required" if destination.to_s.empty?
  report = LocalBackups::Recovery::Preflight.new(
    bundle:, destination:, installation_id: options[:installation_id] || ENV["SYRUS_INSTALLATION_ID"],
    token_secret: ENV["SYRUS_RECOVERY_TOKEN_SECRET"], current: options.slice(:database_adapter, :database_version, :application_version, :plugins, :encryption_fingerprints, :in_flight)
  ).call
  puts JSON.pretty_generate(report)
  exit 2 if report[:status] == "blocked"
when "verify-token"
  token = ARGV.shift
  raise LocalBackups::Recovery::Error, "a token is required" if token.to_s.empty?
  bundle = open_bundle(bundle_argument, options).validate!
  installation_id = options[:installation_id] || ENV["SYRUS_INSTALLATION_ID"]
  valid = LocalBackups::Recovery::Token.valid?(
    token, secret: ENV["SYRUS_RECOVERY_TOKEN_SECRET"], artifact_checksum: bundle.identity_checksum, installation_id:
  )
  raise LocalBackups::Recovery::Error, "preflight token is stale or belongs to another artifact or installation" unless valid
  puts JSON.generate(status: "valid", artifact_checksum: bundle.identity_checksum, installation_id:)
else
  warn parser
  exit 64
end
rescue LocalBackups::Recovery::Error, Errno::EACCES, Gem::Package::TarInvalidError => error
  warn "recovery error: #{error.message}"
  exit 1
end
