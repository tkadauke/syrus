#!/usr/bin/env ruby
# Syrus migration-collision grader.
#
# Fails the workflow's grade step if a migration on this branch
# shares its YYYYMMDDHHMMSS timestamp with any migration that
# already exists in the same migration namespace on the default
# branch, OR if two new migrations on this branch share a timestamp
# within the same namespace. With `--all`, scans the whole tree.
#
# Hand-rolled migration timestamps collide across branches and
# `rails db:migrate` silently skips colliding versions (because
# `schema_migrations` already records the version). Result:
# missing tables in production, silent-skip dev DBs. The fix is
# always `bin/rails generate migration <Name>` so the timestamp
# is fresh at file-creation time — but as long as agents can
# hand-write filenames, the grader is the enforcement point.
#
# See CLAUDE.md ("Migration timestamps come from the generator").

# frozen_string_literal: true

require "open3"
require "pathname"

ROOT = Pathname.new(Dir.pwd)

Migration = Struct.new(:path, :version, :namespace, keyword_init: true)

def capture(*args)
  stdout, _stderr, status = Open3.capture3(*args)
  return nil unless status.success?

  stdout
end

def resolve_default_branch
  origin_head = capture("git", "symbolic-ref", "refs/remotes/origin/HEAD")
  if origin_head
    branch = origin_head.strip.sub(%r{\Arefs/remotes/origin/}, "")
    return "origin/#{branch}" if branch != "" && system("git", "rev-parse", "--verify", "origin/#{branch}", out: File::NULL, err: File::NULL)
  end

  %w[origin/main origin/master main master].find do |candidate|
    system("git", "rev-parse", "--verify", candidate, out: File::NULL, err: File::NULL)
  end
end

def migration_path?(path)
  path.match?(%r{\Adb/(?:migrate|[^/]+_migrate)/\d{14}_[^/]*\.rb\z}) ||
    path.match?(%r{\Aplugins/[^/]+/db/migrate/\d{14}_[^/]*\.rb\z})
end

def namespace_for(path)
  case path
  when %r{\Adb/migrate/}, %r{\Aplugins/[^/]+/db/migrate/}
    "primary"
  when %r{\Adb/([^/]+_migrate)/}
    Regexp.last_match(1)
  end
end

def migration_for(path)
  basename = File.basename(path)
  match = basename.match(/\A(\d{14})_/)
  return nil unless match && migration_path?(path)

  Migration.new(path: path, version: match[1], namespace: namespace_for(path))
end

def all_migrations
  patterns = [
    "db/migrate/*.rb",
    "db/*_migrate/*.rb",
    "plugins/*/db/migrate/*.rb"
  ]
  patterns.flat_map { |pattern| Dir.glob(pattern, base: ROOT.to_s) }
          .filter_map { |path| migration_for(path) }
          .sort_by { |migration| [ migration.namespace, migration.version, migration.path ] }
end

def added_migrations(default_branch)
  diff = capture("git", "diff", "--name-only", "--diff-filter=A", "#{default_branch}...HEAD") || ""
  diff.lines.map(&:strip).filter_map { |path| migration_for(path) }
end

def default_branch_migrations(default_branch)
  tree = capture("git", "ls-tree", "-r", "--name-only", default_branch) || ""
  tree.lines.map(&:strip).filter_map { |path| migration_for(path) }
end

def duplicate_groups(migrations)
  migrations.group_by { |migration| [ migration.namespace, migration.version ] }
            .select { |_key, group| group.size > 1 }
            .sort_by { |(namespace, version), _group| [ namespace, version ] }
end

def print_duplicate_groups(header, groups)
  puts header
  groups.each do |(namespace, version), migrations|
    puts "  #{namespace}/#{version}:"
    migrations.map(&:path).sort.each { |path| puts "    #{path}" }
  end
  puts
  puts "Each database migration namespace needs unique versions. The primary namespace includes db/migrate and plugin db/migrate paths; db/*_migrate paths are separate namespaces."
  puts "Regenerate one colliding file with bin/rails generate migration <Name> so its timestamp is unique."
end

if ARGV.include?("--all")
  duplicates = duplicate_groups(all_migrations)
  if duplicates.any?
    print_duplicate_groups("[migration-collisions] duplicate migration timestamp(s) found in the migration tree:", duplicates)
    exit 1
  end

  puts "[migration-collisions] all migration timestamps are unique within their namespaces"
  exit 0
end

default_branch = resolve_default_branch
unless default_branch
  puts "[migration-collisions] could not locate the default branch ref - skipping check"
  exit 0
end

new_migrations = added_migrations(default_branch)
if new_migrations.empty?
  puts "[migration-collisions] no new migrations on this branch - nothing to check"
  exit 0
end

intra = duplicate_groups(new_migrations)
if intra.any?
  print_duplicate_groups("[migration-collisions] two new migrations on this branch share a timestamp:", intra)
  exit 1
end

existing_by_key = default_branch_migrations(default_branch).group_by { |migration| [ migration.namespace, migration.version ] }
collisions = new_migrations.group_by { |migration| [ migration.namespace, migration.version ] }
                           .filter_map do |key, migrations|
  existing = existing_by_key.fetch(key, [])
  [ key, migrations + existing ] if existing.any?
end

if collisions.any?
  puts "[migration-collisions] migration timestamp(s) already exist on #{default_branch}:"
  collisions.sort_by { |(namespace, version), _migrations| [ namespace, version ] }.each do |(namespace, version), migrations|
    puts "  #{namespace}/#{version}:"
    migrations.map(&:path).sort.each { |path| puts "    #{path}" }
  end
  puts
  puts "rails db:migrate silently SKIPS migrations whose version is already in"
  puts "schema_migrations for that database, so a collision leaves corrupted"
  puts "dev DBs and missing-table production deploys. Delete the colliding"
  puts "file and regenerate via 'bin/rails generate migration <Name>' so it"
  puts "gets a fresh timestamp; then port your migration body onto the new file."
  exit 1
end

puts "[migration-collisions] all new migration timestamps are unique within their namespaces against #{default_branch}"
exit 0
