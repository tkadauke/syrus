#!/usr/bin/env bash
# Build and publish the single-host distribution image to GHCR.
#
# This is the image `install.sh --docker` pulls (ghcr.io/tkadauke/syrus-local).
# It bakes whatever is in your working tree right now. The heavy runtime layers
# (mise: ruby/node/python/go) are cached, so a re-publish only re-copies app code
# and rebuilds assets — a few minutes.
#
# Builds the image, runs the integration suite (bin/test-docker) against it, and
# pushes ONLY if those pass — nothing reaches GHCR from a broken image.
#
# Usage:
#   bin/publish-image [VERSION] [--multi-arch] [--skip-tests] [--skip-latest] [--no-push]
#     VERSION       extra tag to push alongside :latest (e.g. 0.2.0)
#     --multi-arch  build + push linux/amd64 AND linux/arm64 (slower, under QEMU;
#                   needed only for Intel/Linux recipients). Default: this host's
#                   architecture only (arm64 on Apple Silicon).
#     --skip-tests  push without running the integration gate (not recommended)
#     --skip-latest push ONLY :VERSION, never move :latest (requires VERSION).
#                   The atomic release pipeline uses this so :latest moves only
#                   after every app has built and signed. (release.yml)
#     --no-push     build the image and run the integration gate, then STOP —
#                   nothing is pushed. For dry-run pipeline rehearsals.
#
# Reads the GHCR token from $GHCR_TOKEN or ~/.config/syrus/ghcr-token (chmod 600),
# the same place bin/deploy looks. Needs write:packages.
#
# Fork iteration: override the target repository and login user to publish
# test images from a fork instead of the upstream package, e.g.
#   SYRUS_IMAGE_REPO=ghcr.io/skadauke/syrus-local GHCR_USER=skadauke \
#     bin/publish-image stack
# Consumers then point at it with install.sh --image / SYRUS_IMAGE /
# the desktop build's SYRUS_BACKEND_IMAGE.
set -euo pipefail
cd "$(dirname "$0")/.."
. ./bin/docker-image-lib

IMAGE="${SYRUS_IMAGE_REPO:-ghcr.io/tkadauke/syrus-local}"
GHCR_USER="${GHCR_USER:-tkadauke}"
VERSION=""
MULTI=0
SKIP_TESTS=0
SKIP_LATEST=0
NO_PUSH=0

for arg in "$@"; do
  case "$arg" in
    --multi-arch) MULTI=1 ;;
    --skip-tests) SKIP_TESTS=1 ;;
    --skip-latest) SKIP_LATEST=1 ;;
    --no-push) NO_PUSH=1 ;;
    --help|-h) awk 'NR>1 && /^#/{sub(/^# ?/,""); print; next} NR>1{exit}' "$0"; exit 0 ;;
    -*) echo "Unknown flag: $arg (try --help)" >&2; exit 2 ;;
    *)  VERSION="$arg" ;;
  esac
done

if [ "$SKIP_LATEST" = 1 ] && [ -z "$VERSION" ]; then
  echo "--skip-latest requires a VERSION (there would be no tag to push)." >&2
  exit 2
fi

syrus_require_docker_daemon
syrus_disable_buildx_attestations
# --no-push never contacts the registry, so it needs no token (dry runs on a
# machine without GHCR creds still work).
TOKEN=""
if [ "$NO_PUSH" = 0 ]; then
  TOKEN="$(syrus_read_ghcr_token "$HOME/.config/syrus/ghcr-token")"
fi
GIT_SHA="$(git rev-parse --short HEAD 2>/dev/null || echo dev)"

tags=()
if [ "$SKIP_LATEST" = 0 ]; then tags+=(-t "$IMAGE:latest"); fi
if [ -n "$VERSION" ]; then tags+=(-t "$IMAGE:$VERSION"); fi
cache_args=()
if syrus_registry_cache_enabled; then
  CACHE_REF="$(syrus_docker_cache_ref)"
  cache_args=(--cache-from "type=registry,ref=${CACHE_REF}" --cache-to "type=registry,ref=${CACHE_REF},mode=max")
fi

echo "== Tags =="
if [ "$SKIP_LATEST" = 0 ]; then echo "   $IMAGE:latest"; fi
if [ -n "$VERSION" ]; then echo "   $IMAGE:$VERSION"; fi
echo "   (GIT_SHA=$GIT_SHA)"
if [ "${#cache_args[@]}" -gt 0 ]; then
  echo "   build cache: $CACHE_REF"
fi

# The tag the local build lands under and the integration suite runs against.
# Under --skip-latest there is no :latest tag, so use :VERSION.
if [ "$SKIP_LATEST" = 0 ]; then
  TEST_TAG="$IMAGE:latest"
else
  TEST_TAG="$IMAGE:$VERSION"
fi

if [ "$NO_PUSH" = 0 ]; then
  echo "== Logging in to ghcr.io as $GHCR_USER =="
  syrus_ghcr_login "$GHCR_USER" "$TOKEN"
fi

# Always build a local single-arch image first — this is what the integration
# suite runs against, and what the default path pushes. Nothing leaves this host
# until the tests below pass.
echo "== Building (single-arch, this host) =="
if [ "${#cache_args[@]}" -gt 0 ]; then
  syrus_docker_buildx_image worker-dev "$GIT_SHA" \
    --load \
    "${cache_args[@]}" \
    --provenance=false \
    "${tags[@]}" \
    .
else
  syrus_docker_build_image worker-dev "$GIT_SHA" \
    --provenance=false "${tags[@]}" .
fi

# Gate: integration tests against the freshly built image. set -e aborts the
# whole script (before any push) if bin/test-docker exits non-zero.
if [ "$SKIP_TESTS" = 1 ]; then
  echo "== Skipping integration tests (--skip-tests) =="
else
  echo "== Running integration tests against the built image =="
  SYRUS_IMAGE="$TEST_TAG" ./bin/test-docker
fi

if [ "$NO_PUSH" = 1 ]; then
  echo
  echo "== --no-push: image built and tested, nothing pushed =="
  exit 0
fi

# Tests passed — push.
if [ "$MULTI" = 1 ]; then
  echo "== Building + pushing multi-arch (amd64 + arm64) — the amd64 half is slow under QEMU =="
  # arm64 reuses the build cache from above; amd64 is built fresh. The tested
  # image is the arm64 variant (amd64 is the same source, not run here).
  syrus_docker_buildx_image worker-dev "$GIT_SHA" \
    --platform linux/amd64,linux/arm64 \
    "${cache_args[@]}" \
    --provenance=false \
    "${tags[@]}" \
    --push \
    .
else
  echo "== Pushing the tested image =="
  if [ "$SKIP_LATEST" = 0 ]; then docker push "$IMAGE:latest"; fi
  if [ -n "$VERSION" ]; then docker push "$IMAGE:$VERSION"; fi
fi

if [ "$SKIP_LATEST" = 0 ]; then syrus_verify_pushed "$IMAGE" "latest" "$TOKEN"; fi
if [ -n "$VERSION" ]; then syrus_verify_pushed "$IMAGE" "$VERSION" "$TOKEN"; fi

echo
echo "Published:"
if [ "$SKIP_LATEST" = 0 ]; then echo "   $IMAGE:latest"; fi
if [ -n "$VERSION" ]; then echo "   $IMAGE:$VERSION"; fi
echo "Verify:  docker manifest inspect $IMAGE:${VERSION:-latest} >/dev/null && echo OK"
