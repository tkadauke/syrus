#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
temporary_root="$(mktemp -d "${TMPDIR:-/tmp}/syrus-plugin-relocation.XXXXXX")"
trap 'rm -rf -- "$temporary_root"' EXIT

external_root="$temporary_root/external"
plugin_root="$external_root/relocatable_plugin"
mkdir -p "$external_root"
cp -R "$repo_root/spec/fixtures/relocatable_plugin" "$plugin_root"

cp -R "$plugin_root" "$external_root/future_plugin"
mv "$external_root/future_plugin/relocatable_plugin.gemspec" "$external_root/future_plugin/future_plugin.gemspec"
ruby -pi -e 'gsub("relocatable_plugin", "future_plugin"); gsub(">= 0.1.0", ">= 999.0")' \
  "$external_root/future_plugin/future_plugin.gemspec" "$external_root/future_plugin/lib/relocatable_plugin.rb"
mv "$external_root/future_plugin/lib/relocatable_plugin.rb" "$external_root/future_plugin/lib/future_plugin.rb"
rm -rf "$external_root/future_plugin/db/migrate"

mkdir -p "$external_root/exploding_plugin/lib"
cp "$plugin_root/relocatable_plugin.gemspec" "$external_root/exploding_plugin/exploding_plugin.gemspec"
ruby -pi -e 'gsub("relocatable_plugin", "exploding_plugin")' "$external_root/exploding_plugin/exploding_plugin.gemspec"
cat > "$external_root/exploding_plugin/lib/exploding_plugin.rb" <<'RUBY'
module ExplodingPlugin
  extend Syrus::PluginApi
  syrus_plugin "exploding_plugin" do
  end
end
raise "fixture load failure"
RUBY

"$repo_root/bin/build-plugin-frontend" "$plugin_root"

database_url="sqlite3:$temporary_root/plugin-relocation.sqlite3"
SYRUS_PLUGIN_PATH="$external_root" SYRUS_VERSION=0.1.0 DATABASE_URL="$database_url" RAILS_ENV=test \
  "$repo_root/bin/rails" db:schema:load >/dev/null

SYRUS_PLUGIN_PATH="$external_root" RELOCATABLE_PLUGIN_ROOT="$plugin_root" SYRUS_HOST_ROOT="$repo_root" SYRUS_VERSION=0.1.0 DATABASE_URL="$database_url" RAILS_ENV=test \
  "$repo_root/bin/rspec" "$plugin_root/spec/relocatable_plugin_spec.rb"
echo "plugin relocation acceptance passed"

empty_root="$temporary_root/empty"
mkdir -p "$empty_root"
SYRUS_PLUGIN_PATH="$empty_root" SYRUS_VERSION=0.1.0 DATABASE_URL="$database_url" RAILS_ENV=test \
  "$repo_root/bin/rails" runner "$repo_root/spec/fixtures/plugin_relocation_absence.rb"
