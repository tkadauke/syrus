#!/usr/bin/env node

import fs from "node:fs"
import path from "node:path"

const buildDir = path.resolve(process.env.VITE_BUILD_DIR || "app/assets/builds")
const manifestPath = path.join(buildDir, ".vite", "manifest.json")
const maximumBytes = Number(process.env.VITE_ENTRY_MAX_BYTES || 3_200_000)

if (!fs.existsSync(manifestPath)) {
  console.error(`Vite manifest not found at ${manifestPath}; run npm run build first`)
  process.exit(1)
}

const manifest = JSON.parse(fs.readFileSync(manifestPath, "utf8"))
const entry = Object.values(manifest).find((asset) => asset.isEntry)

if (!entry?.file) {
  console.error(`No entry asset found in ${manifestPath}`)
  process.exit(1)
}

const entryPath = path.join(buildDir, entry.file)
const size = fs.statSync(entryPath).size
const formattedSize = (size / 1024 / 1024).toFixed(2)
const formattedMaximum = (maximumBytes / 1024 / 1024).toFixed(2)

if (size > maximumBytes) {
  console.error(`Frontend entry ${entry.file} is ${formattedSize} MiB; budget is ${formattedMaximum} MiB`)
  process.exit(1)
}

console.log(`Frontend entry ${entry.file}: ${formattedSize} MiB (budget ${formattedMaximum} MiB)`)
