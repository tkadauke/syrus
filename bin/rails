#!/usr/bin/env ruby
app_root = File.expand_path("..", __dir__)
deps_root = File.join(app_root, ".syrus", "deps")
prepared_bundle = [
  File.join(deps_root, "bundle"),
  File.join(app_root, "vendor", "bundle")
].find { |path| Dir.exist?(path) }
if ENV["BUNDLE_PATH"].to_s.empty? && prepared_bundle
  ENV["BUNDLE_PATH"] = prepared_bundle
end
if Dir.exist?(deps_root)
  ENV["BUNDLE_APP_CONFIG"] ||= File.join(deps_root, "bundle-config")
  ENV["BUNDLE_USER_HOME"] ||= File.join(deps_root, "bundle-home")
  ENV["BUNDLE_USER_CACHE"] ||= File.join(deps_root, "bundle-cache")
end

APP_PATH = File.expand_path("../config/application", __dir__)
require_relative "../config/boot"
require "rails/commands"
