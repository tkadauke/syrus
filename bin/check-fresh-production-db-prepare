#!/usr/bin/env bash
# Verify that a fresh production-style database can be prepared from scratch.
#
# This runs production with SYRUS_SQLITE=1 so it exercises the deploy-time
# database layout (primary/cache/queue/cable/search plus plugin migrations)
# without requiring a local MySQL server. It catches historical migrations that
# accidentally reference current app models/tables instead of migration-local
# classes, which only fail on fresh installs or staging rebuilds.
set -euo pipefail

if [ ! -x bin/rails ]; then
  echo "[check-fresh-production-db-prepare] no bin/rails - skipping"
  exit 0
fi

root="$(pwd)"
tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/syrus-fresh-db-prepare.XXXXXX")"
cleanup() {
  rm -rf "$tmpdir"
}
trap cleanup EXIT

mkdir -p "$tmpdir/db" "$tmpdir/search"

# This check only needs bootable Active Record encryption configuration; it
# must never depend on or embed the application's Rails credentials key.
encryption_primary_key="fresh_db_prepare_primary_key_32b"
encryption_deterministic_key="fresh_db_prepare_deterministic_key"
encryption_key_derivation_salt="fresh_db_prepare_derivation_salt"

# Kubernetes creates the MySQL databases before Rails starts. That means
# `db:prepare` sees existing-but-empty secondary databases and takes the
# migration path, not the schema-load path. Empty SQLite files reproduce that
# shape locally.
touch \
  "$tmpdir/db/production.sqlite3" \
  "$tmpdir/db/production_cache.sqlite3" \
  "$tmpdir/db/production_queue.sqlite3" \
  "$tmpdir/db/production_cable.sqlite3" \
  "$tmpdir/search/search.sqlite3"

env \
  SYRUS_SQLITE=1 \
  RAILS_ENV=production \
  ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY="$encryption_primary_key" \
  ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY="$encryption_deterministic_key" \
  ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT="$encryption_key_derivation_salt" \
  SECRET_KEY_BASE="${SECRET_KEY_BASE:-fresh-db-prepare-local-secret}" \
  DB_HOST="${DB_HOST:-127.0.0.1}" \
  SYRUS_DATABASE_PASSWORD="${SYRUS_DATABASE_PASSWORD:-fresh-db-prepare}" \
  SYRUS_DATA_ROOT="$tmpdir" \
  SEARCH_DATABASE_PATH="$tmpdir/search/search.sqlite3" \
  SYRUS_APP_HOST="${SYRUS_APP_HOST:-localhost}" \
  SYRUS_PREVIEW_BASE_DOMAIN="${SYRUS_PREVIEW_BASE_DOMAIN:-localhost}" \
  "$root/bin/rails" db:prepare

env \
  SYRUS_SQLITE=1 \
  RAILS_ENV=production \
  ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY="$encryption_primary_key" \
  ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY="$encryption_deterministic_key" \
  ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT="$encryption_key_derivation_salt" \
  SECRET_KEY_BASE="${SECRET_KEY_BASE:-fresh-db-prepare-local-secret}" \
  DB_HOST="${DB_HOST:-127.0.0.1}" \
  SYRUS_DATABASE_PASSWORD="${SYRUS_DATABASE_PASSWORD:-fresh-db-prepare}" \
  SYRUS_DATA_ROOT="$tmpdir" \
  SEARCH_DATABASE_PATH="$tmpdir/search/search.sqlite3" \
  SYRUS_APP_HOST="${SYRUS_APP_HOST:-localhost}" \
  SYRUS_PREVIEW_BASE_DOMAIN="${SYRUS_PREVIEW_BASE_DOMAIN:-localhost}" \
  "$root/bin/rails" runner '
    checks = {
      "cache" => [ ActiveRecord::Base.configurations.configs_for(env_name: Rails.env, name: "cache").configuration_hash, %w[solid_cache_entries] ],
      "queue" => [ ActiveRecord::Base.configurations.configs_for(env_name: Rails.env, name: "queue").configuration_hash, %w[solid_queue_jobs solid_queue_processes solid_queue_recurring_tasks] ],
      "cable" => [ ActiveRecord::Base.configurations.configs_for(env_name: Rails.env, name: "cable").configuration_hash, %w[solid_cable_messages] ]
    }

    checks.each do |name, (config, tables)|
      ActiveRecord::Base.establish_connection(config)
      connection = ActiveRecord::Base.connection
      missing = tables.reject { |table| connection.table_exists?(table) }
      raise "#{name} database missing table(s): #{missing.join(", ")}" if missing.any?
    ensure
      ActiveRecord::Base.connection_handler.clear_active_connections!
    end
  '

echo "[check-fresh-production-db-prepare] ok"
