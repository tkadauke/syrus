#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEFAULT_ENV_FILE="/Library/Application Support/Syrus/worker.env"
ENV_FILE="${SYRUS_WORKER_ENV_FILE:-$DEFAULT_ENV_FILE}"
DRY_RUN=0
RUN_CHECK=0

usage() {
  cat <<'USAGE'
Usage: bin/macos-worker [--env-file PATH] [--check] [--dry-run] [--] [solid_queue_args...]

Starts a native macOS Syrus compute worker with the supported worker role,
queue, recurrence, storage, version, and capability environment.
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --env-file)
      ENV_FILE="${2:?--env-file requires a path}"
      shift 2
      ;;
    --check)
      RUN_CHECK=1
      shift
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

if [[ -f "$ENV_FILE" ]]; then
  set -a
  # shellcheck source=/dev/null
  source "$ENV_FILE"
  set +a
elif [[ "${SYRUS_WORKER_ENV_FILE:-}" || "$ENV_FILE" != "$DEFAULT_ENV_FILE" ]]; then
  echo "macos-worker: env file not found: $ENV_FILE" >&2
  exit 2
fi

export RAILS_ENV="${RAILS_ENV:-production}"
export SYRUS_ROLE="worker"
export SOLID_QUEUE_CONFIG="config/queue.compute.yml"
export SOLID_QUEUE_SKIP_RECURRING="1"

if [[ -z "${GIT_SHA:-}" ]]; then
  GIT_SHA="$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || true)"
  export GIT_SHA="${GIT_SHA:-dev}"
fi

require_env() {
  local name="$1"
  if [[ -z "${!name:-}" ]]; then
    echo "macos-worker: missing required env var $name" >&2
    exit 2
  fi
}

require_env "SYRUS_DATA_ROOT"
require_env "SYRUS_APP_HOST"
require_env "SYRUS_WORKER_POOL_NAME"
require_env "SYRUS_WORKER_CAPABILITIES"

if [[ "$RUN_CHECK" == "1" ]]; then
  exec "$ROOT/bin/macos-worker-check" --env-file "$ENV_FILE"
fi

cd "$ROOT"

if [[ "$DRY_RUN" == "1" ]]; then
  printf 'RAILS_ENV=%s\n' "$RAILS_ENV"
  printf 'SYRUS_ROLE=%s\n' "$SYRUS_ROLE"
  printf 'GIT_SHA=%s\n' "$GIT_SHA"
  printf 'SYRUS_DATA_ROOT=%s\n' "$SYRUS_DATA_ROOT"
  printf 'SYRUS_APP_HOST=%s\n' "$SYRUS_APP_HOST"
  printf 'SYRUS_WORKER_POOL_NAME=%s\n' "$SYRUS_WORKER_POOL_NAME"
  printf 'SYRUS_WORKER_CAPABILITIES=%s\n' "$SYRUS_WORKER_CAPABILITIES"
  printf 'SOLID_QUEUE_CONFIG=%s\n' "$SOLID_QUEUE_CONFIG"
  printf 'SOLID_QUEUE_SKIP_RECURRING=%s\n' "$SOLID_QUEUE_SKIP_RECURRING"
  printf 'command=%q' "$ROOT/bin/jobs"
  for arg in "$@"; do
    printf ' %q' "$arg"
  done
  printf '\n'
  exit 0
fi

if [[ "${SYRUS_SKIP_SEARCH_PREPARE:-}" != "1" ]]; then
  "$ROOT/bin/rails" syrus:prepare_search
fi

exec "$ROOT/bin/jobs" "$@"
