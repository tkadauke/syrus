#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEFAULT_ENV_FILE="/etc/syrus/worker.env"
ENV_FILE="${SYRUS_WORKER_ENV_FILE:-$DEFAULT_ENV_FILE}"
DRY_RUN=0
RUN_CHECK=0

usage() {
  cat <<'USAGE'
Usage: bin/macos-worker [--env-file PATH] [--check] [--dry-run] [--] [solid_queue_args...]

Starts a native macOS Syrus compute worker with the supported worker role,
queue, recurrence, storage, version, and capability environment.
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --env-file)
      ENV_FILE="${2:?--env-file requires a path}"
      shift 2
      ;;
    --check)
      RUN_CHECK=1
      shift
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

if [[ -f "$ENV_FILE" ]]; then
  set -a
  # shellcheck source=/dev/null
  source "$ENV_FILE"
  set +a
elif [[ "${SYRUS_WORKER_ENV_FILE:-}" || "$ENV_FILE" != "$DEFAULT_ENV_FILE" ]]; then
  echo "macos-worker: env file not found: $ENV_FILE" >&2
  exit 2
fi

# shellcheck source=bin/macos-ruby-env
source "$ROOT/bin/macos-ruby-env"
SHARED_DIR="${SYRUS_MACOS_SHARED_DIR:-/opt/syrus/shared}"
RUBY_VERSION_PIN="$(syrus_macos_ruby_version "$ROOT")"

export RAILS_ENV="${RAILS_ENV:-production}"
export SYRUS_ROLE="worker"
export SOLID_QUEUE_CONFIG="config/queue.compute.yml"
export SOLID_QUEUE_SKIP_RECURRING="1"

# This worker reaches MySQL through a `kubectl port-forward` tunnel. When a
# forwarded stream dies the local socket is never reset, so a query on that
# connection would wait forever: an MCP tool call blocked that way timed out
# in the agent while the daemon still waited on the database. Bound every
# socket operation so a dead connection fails, and Rails reconnects, instead.
# Well above the 10s lock-wait ceiling (config/database.yml).
export DB_CONNECT_TIMEOUT="${DB_CONNECT_TIMEOUT:-10}"
export DB_READ_TIMEOUT="${DB_READ_TIMEOUT:-30}"
export DB_WRITE_TIMEOUT="${DB_WRITE_TIMEOUT:-30}"

# The installed release knows its own revision. A GIT_SHA left in the env
# file from an earlier install would otherwise outlive every update and make
# the worker report the wrong app revision, so the release file wins.
if [[ -f "$ROOT/GIT_SHA" ]]; then
  RELEASE_SHA="$(head -n 1 "$ROOT/GIT_SHA")"
  if [[ -n "${GIT_SHA:-}" && "$GIT_SHA" != "$RELEASE_SHA" ]]; then
    echo "macos-worker: ignoring GIT_SHA=$GIT_SHA from the environment; the installed release is $RELEASE_SHA" >&2
  fi
  GIT_SHA="$RELEASE_SHA"
elif [[ -z "${GIT_SHA:-}" ]]; then
  GIT_SHA="$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || true)"
fi
export GIT_SHA="${GIT_SHA:-dev}"

require_env() {
  local name="$1"
  if [[ -z "${!name:-}" ]]; then
    echo "macos-worker: missing required env var $name" >&2
    exit 2
  fi
}

require_env "SYRUS_DATA_ROOT"
require_env "SYRUS_APP_HOST"
require_env "SYRUS_WORKER_POOL_NAME"
require_env "SYRUS_WORKER_CAPABILITIES"

# Everything below, including the jobs Solid Queue runs and every agent or
# grader they spawn, inherits the release's pinned Ruby from PATH.
if [[ "$DRY_RUN" != "1" ]]; then
  syrus_macos_ruby_activate "$ROOT" "$SHARED_DIR"
fi

if [[ "$RUN_CHECK" == "1" ]]; then
  exec "$ROOT/bin/macos-worker-check" --env-file "$ENV_FILE"
fi

cd "$ROOT"

if [[ "$DRY_RUN" == "1" ]]; then
  printf 'RUBY=%s\n' "$(syrus_macos_ruby_prefix "$RUBY_VERSION_PIN")/bin/ruby"
  printf 'BUNDLE_PATH=%s\n' "$(syrus_macos_bundle_path "$SHARED_DIR" "$RUBY_VERSION_PIN")"
  printf 'RAILS_ENV=%s\n' "$RAILS_ENV"
  printf 'SYRUS_ROLE=%s\n' "$SYRUS_ROLE"
  printf 'GIT_SHA=%s\n' "$GIT_SHA"
  printf 'SYRUS_DATA_ROOT=%s\n' "$SYRUS_DATA_ROOT"
  printf 'SYRUS_APP_HOST=%s\n' "$SYRUS_APP_HOST"
  printf 'SYRUS_WORKER_POOL_NAME=%s\n' "$SYRUS_WORKER_POOL_NAME"
  printf 'SYRUS_WORKER_CAPABILITIES=%s\n' "$SYRUS_WORKER_CAPABILITIES"
  printf 'SOLID_QUEUE_CONFIG=%s\n' "$SOLID_QUEUE_CONFIG"
  printf 'SOLID_QUEUE_SKIP_RECURRING=%s\n' "$SOLID_QUEUE_SKIP_RECURRING"
  printf 'DB_CONNECT_TIMEOUT=%s\n' "$DB_CONNECT_TIMEOUT"
  printf 'DB_READ_TIMEOUT=%s\n' "$DB_READ_TIMEOUT"
  printf 'DB_WRITE_TIMEOUT=%s\n' "$DB_WRITE_TIMEOUT"
  printf 'command=%q' "$ROOT/bin/jobs"
  for arg in "$@"; do
    printf ' %q' "$arg"
  done
  printf '\n'
  exit 0
fi

if [[ "${SYRUS_SKIP_SEARCH_PREPARE:-}" != "1" ]]; then
  "$ROOT/bin/rails" syrus:prepare_search
fi

exec "$ROOT/bin/jobs" "$@"
