#!/usr/bin/env bash
# Runs Playwright E2E specs: core (e2e/) plus every plugin's own (plugins/*/e2e/).
# Each tree is its own named Playwright project (see playwright.config.ts), so
# use --project to scope down instead of a path (path args are ambiguous here
# since every plugin's directory also contains "e2e/"):
#   bin/test-e2e                        # core + every plugin
#   bin/test-e2e --project=browser      # just the browser plugin
#   bin/test-e2e --project=core         # just core
#
# Works both in the worker image, which already ships a Chromium under
# /opt/ms-playwright, and on a developer's machine, where it does not: the
# browser, the npm install, and the demo seed rows the specs sign in as are all
# provisioned here when missing.
set -euo pipefail

# Only adopt the image's shared browser directory when it actually exists.
# Exporting it unconditionally pointed Playwright at an empty path on macOS and
# every local run failed to launch Chromium.
if [ -z "${PLAYWRIGHT_BROWSERS_PATH:-}" ] && [ -d /opt/ms-playwright ]; then
  export PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
fi

if [ ! -d node_modules/.bin ] || [ ! -f node_modules/.package-lock.json ] || [ package-lock.json -nt node_modules/.package-lock.json ] || [ package.json -nt node_modules/.package-lock.json ]; then
  npm ci
fi

# The image bakes its browser in; anywhere else Playwright manages its own copy
# and the first run has to download it. `install` is idempotent and quick once
# the browser is present, so just ask for it rather than trying to probe a
# platform-specific cache layout.
#
# Both binaries are required: `headless: true` launches the separate
# chromium-headless-shell build, not the full chromium, and installing only
# "chromium" leaves the shell missing -- which fails at browser launch, well
# after the server has booted.
if [ ! -d /opt/ms-playwright ]; then
  npx playwright install chromium chromium-headless-shell
fi

# The specs sign in as deterministic local users and assert on seeded preview
# rows. `e2e:seed` wraps db:seed, adds the auth/onboarding fixtures, and resets
# the invitation-token account so repeated local runs stay deterministic.
if [ -z "${E2E_BASE_URL:-}" ] && [ "${E2E_SKIP_SEED:-0}" != "1" ]; then
  echo "[test-e2e] Preparing local database and E2E fixtures."
  bin/rails db:prepare e2e:seed
fi

exec npx playwright test "$@"
