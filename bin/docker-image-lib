#!/usr/bin/env bash
# Shared Docker image helpers for Syrus build/publish/deploy scripts.
# Source this file from repo-root scripts; do not execute it directly.

syrus_disable_buildx_attestations() {
  # Plain single-arch local images are easier for Docker Desktop/OrbStack to
  # export and reuse as FROM bases. Callers that need attestations can opt out
  # by overriding this after sourcing.
  export BUILDX_NO_DEFAULT_ATTESTATIONS=1
}

syrus_docker_cache_ref() {
  local default_ref="${1:-ghcr.io/tkadauke/syrus:cache}"
  printf '%s' "${SYRUS_DOCKER_CACHE_REF:-$default_ref}"
}

syrus_registry_cache_enabled() {
  case "${SYRUS_DOCKER_REGISTRY_CACHE:-}" in
    1|true|TRUE|yes|YES|on|ON) return 0 ;;
  esac

  [ -n "${SYRUS_DOCKER_CACHE_REF:-}" ]
}

syrus_require_docker_daemon() {
  if ! command -v docker >/dev/null 2>&1; then
    echo "docker not found. Install a container runtime first." >&2
    return 1
  fi

  if ! docker info >/dev/null 2>&1; then
    echo "Docker daemon not reachable — start your runtime." >&2
    return 1
  fi
}

syrus_read_ghcr_token() {
  local token_file="${1:-$HOME/.config/syrus/ghcr-token}"
  local token="${GHCR_TOKEN:-}"

  if [ -z "$token" ] && [ -r "$token_file" ]; then
    token="$(cat "$token_file")"
  fi

  if [ -z "$token" ]; then
    cat >&2 <<MSG
No GHCR token found.

  set the env var:
    export GHCR_TOKEN=ghp_xxx

  or save it to a file (and chmod 600):
    mkdir -p $(dirname "$token_file")
    echo ghp_xxx > $token_file
    chmod 600 $token_file

  the token needs write:packages scope.
MSG
    return 1
  fi

  printf '%s' "$token"
}

syrus_ghcr_login() {
  local user="${1:?usage: syrus_ghcr_login USER TOKEN}"
  local token="${2:?usage: syrus_ghcr_login USER TOKEN}"

  printf '%s' "$token" | docker login ghcr.io -u "$user" --password-stdin >/dev/null
}

syrus_verify_pushed() {
  local repo="${1:?usage: syrus_verify_pushed REPO TAG}"
  local tag="${2:?usage: syrus_verify_pushed REPO TAG}"

  # Confirm buildx --push actually landed the manifest. Use imagetools, which
  # authenticates through the docker credential store we just logged into and
  # pushed with — no hand-rolled bearer token.
  #
  # The old approach base64-encoded the token into an `Authorization: Bearer`
  # header for a raw curl. GNU `base64` (the CI runner) wraps output at 76
  # columns, so a token longer than 57 bytes — e.g. the Actions GITHUB_TOKEN —
  # gained an embedded newline that broke the request at the transport layer
  # (curl exit 43/18). It was invisible locally because macOS `base64` does not
  # wrap, and never ran in the `--no-push` dry run. imagetools sidesteps the
  # whole class of bug: same creds that just pushed, no manual token handling.
  if ! docker buildx imagetools inspect "${repo}:${tag}" >/dev/null 2>&1; then
    echo "✗ ${repo}:${tag} not in registry — buildx --push didn't actually push" >&2
    return 1
  fi
}

syrus_docker_arg_tags() {
  local arg

  while [ $# -gt 0 ]; do
    arg="$1"
    case "$arg" in
      -t|--tag)
        shift
        [ $# -gt 0 ] && printf '%s\n' "$1"
        ;;
      --tag=*)
        printf '%s\n' "${arg#--tag=}"
        ;;
    esac
    shift || true
  done
}

syrus_docker_tags_match_label() {
  local label_key="${1:?usage: syrus_docker_tags_match_label LABEL_KEY LABEL_VALUE TAG...}"
  local label_value="${2:?usage: syrus_docker_tags_match_label LABEL_KEY LABEL_VALUE TAG...}"
  shift 2
  local tag tag_value

  for tag in "$@"; do
    tag_value="$(docker image inspect --format "{{ index .Config.Labels \"$label_key\" }}" "$tag" 2>/dev/null)" || return 1
    [ "$tag_value" = "$label_value" ] || return 1
  done
}

# Optional metadata flags immediately after GIT_SHA, in any order:
#   --version=X.Y.Z   feeds the SYRUS_VERSION build-arg (release version)
#   --built-at=TS     feeds the SYRUS_BUILT_AT build-arg (UTC ISO-8601)
# Both are baked as ENV by the Dockerfile so images know their release
# version and build time (the BuildBadge and its tooltips read them via the
# bootstrap payload). Callers that don't pass them — bin/deploy,
# bin/compose-up — get empty values, and the UI degrades to the git SHA
# with no tooltip. Flags (not positionals) so those call sites stay valid.
# The parse loop is inlined in both build functions: a shared helper would
# run in a $(...) subshell and could not set the caller's variables.

syrus_docker_build_image() {
  local target="${1:?usage: syrus_docker_build_image TARGET GIT_SHA [--version=X.Y.Z] [--built-at=TS] [docker build args...]}"
  local git_sha="${2:?usage: syrus_docker_build_image TARGET GIT_SHA [--version=X.Y.Z] [--built-at=TS] [docker build args...]}"
  shift 2
  local syrus_version="" syrus_built_at=""
  while :; do
    case "${1:-}" in
      --version=*) syrus_version="${1#--version=}"; shift ;;
      --built-at=*) syrus_built_at="${1#--built-at=}"; shift ;;
      *) break ;;
    esac
  done

  local -a build_args tags
  build_args=("$@")
  tags=()
  while IFS= read -r tag; do
    tags+=("$tag")
  done < <(syrus_docker_arg_tags "${build_args[@]}")

  if [ "${#tags[@]}" -eq 0 ] || [ "${SYRUS_DOCKER_BUILD_STALE_CLIENT_GUARD:-1}" = "0" ]; then
    docker build -f Dockerfile --target "$target" --build-arg "GIT_SHA=$git_sha" --build-arg "SYRUS_VERSION=$syrus_version" --build-arg "SYRUS_BUILT_AT=$syrus_built_at" "${build_args[@]}"
    return
  fi

  local build_pid state status exported_at now grace interval guard_label guard_value
  guard_label="com.syrus.build.guard"
  guard_value="${target}-${git_sha}-$$-$(date +%s)"
  grace="${SYRUS_DOCKER_BUILD_POST_EXPORT_GRACE:-20}"
  interval="${SYRUS_DOCKER_BUILD_POLL_INTERVAL:-2}"
  exported_at=""

  docker build -f Dockerfile --target "$target" --build-arg "GIT_SHA=$git_sha" --build-arg "SYRUS_VERSION=$syrus_version" --build-arg "SYRUS_BUILT_AT=$syrus_built_at" --label "$guard_label=$guard_value" "${build_args[@]}" &
  build_pid=$!

  while true; do
    state="$(ps -p "$build_pid" -o stat= 2>/dev/null || true)"
    if [ -z "$state" ] || [[ "$state" == *Z* ]]; then
      if wait "$build_pid"; then
        status=0
      else
        status=$?
      fi
      return "$status"
    fi

    if [ -z "$exported_at" ] && syrus_docker_tags_match_label "$guard_label" "$guard_value" "${tags[@]}"; then
      exported_at="$(date +%s)"
    fi

    if [ -n "$exported_at" ]; then
      now="$(date +%s)"
      if [ $((now - exported_at)) -ge "$grace" ]; then
        echo "→ docker build exported ${tags[*]} but the Docker client did not exit after ${grace}s; terminating stale client and continuing" >&2
        kill "$build_pid" 2>/dev/null || true
        sleep 2
        state="$(ps -p "$build_pid" -o stat= 2>/dev/null || true)"
        if [ -n "$state" ] && [[ "$state" != *Z* ]]; then
          kill -9 "$build_pid" 2>/dev/null || true
        fi
        wait "$build_pid" 2>/dev/null || true
        echo "→ stale Docker client terminated after verified image export" >&2
        return 0
      fi
    fi

    sleep "$interval"
  done
}

syrus_docker_buildx_image() {
  local target="${1:?usage: syrus_docker_buildx_image TARGET GIT_SHA [--version=X.Y.Z] [--built-at=TS] [docker buildx build args...]}"
  local git_sha="${2:?usage: syrus_docker_buildx_image TARGET GIT_SHA [--version=X.Y.Z] [--built-at=TS] [docker buildx build args...]}"
  shift 2
  local syrus_version="" syrus_built_at=""
  while :; do
    case "${1:-}" in
      --version=*) syrus_version="${1#--version=}"; shift ;;
      --built-at=*) syrus_built_at="${1#--built-at=}"; shift ;;
      *) break ;;
    esac
  done

  docker buildx build -f Dockerfile --target "$target" --build-arg "GIT_SHA=$git_sha" --build-arg "SYRUS_VERSION=$syrus_version" --build-arg "SYRUS_BUILT_AT=$syrus_built_at" "$@"
}

# Whether the whisper.cpp build+model download should be skipped for the
# LOCAL dev loop (bin/build-local-image, bin/compose-up — the only two
# callers of syrus_build_local_base_image). Defaults to skipping: compiling
# whisper.cpp and pulling its ~148MB model on every local rebuild would slow
# down the fast-iteration loop these scripts exist for, and most local dev
# doesn't touch chat_speech_to_text. Set SYRUS_SKIP_WHISPER_BUILD=0 to build
# the real thing locally (e.g. testing dictation itself). bin/publish-image
# and bin/deploy build the `app`/`worker-dev` targets directly, bypassing
# this helper entirely, so published images always get the real build.
syrus_whisper_skip_build_args() {
  case "${SYRUS_SKIP_WHISPER_BUILD:-1}" in
    0|false|FALSE|no|NO|off|OFF) ;;
    *) printf '%s\n' "--build-arg" "SYRUS_SKIP_WHISPER_BUILD=1" ;;
  esac
}

# Builds syrus-backend-base:latest (Dockerfile target worker-dev — the fat
# agent toolchain) from the current working tree. Honors the registry
# BuildKit cache like bin/compose-up: SYRUS_DOCKER_REGISTRY_CACHE=1 pulls
# from the cache ref, and SYRUS_DOCKER_CACHE_PUSH=1 additionally writes back
# to it (needs a token with write:packages).
# Trailing args are forwarded to the build helpers as metadata flags
# (e.g. --built-at=TS from bin/build-local-image); compose-up passes none.
syrus_build_local_base_image() {
  local git_sha="${1:?usage: syrus_build_local_base_image GIT_SHA [--version=X.Y.Z] [--built-at=TS]}"
  shift

  local -a whisper_args
  whisper_args=()
  while IFS= read -r arg; do
    whisper_args+=("$arg")
  done < <(syrus_whisper_skip_build_args)

  if syrus_registry_cache_enabled; then
    local ghcr_user cache_ref cache_token
    ghcr_user="${GHCR_USER:-tkadauke}"
    cache_ref="$(syrus_docker_cache_ref)"
    cache_token="$(syrus_read_ghcr_token "$HOME/.config/syrus/ghcr-token")"

    echo "== Using registry Docker build cache: ${cache_ref} =="
    syrus_ghcr_login "$ghcr_user" "$cache_token"

    local -a cache_args
    cache_args=(--cache-from "type=registry,ref=${cache_ref}")
    case "${SYRUS_DOCKER_CACHE_PUSH:-}" in
      1|true|TRUE|yes|YES|on|ON)
        # ignore-error: a cache EXPORT failure is fatal to the build in BuildKit
        # (unlike cache-from); keep caching best-effort so a 403 or disk-pressure
        # write can't kill an otherwise-good build.
        cache_args+=(--cache-to "type=registry,ref=${cache_ref},mode=max,ignore-error=true")
        ;;
    esac

    syrus_docker_buildx_image worker-dev "$git_sha" "$@" \
      --load \
      "${cache_args[@]}" \
      "${whisper_args[@]}" \
      --provenance=false \
      -t syrus-backend-base:latest \
      .
  else
    syrus_docker_build_image worker-dev "$git_sha" "$@" \
      "${whisper_args[@]}" \
      --provenance=false -t syrus-backend-base:latest .
  fi
}

# Builds the full local backend image: the worker-dev base plus the
# Dockerfile.local overlay (EXTRA_APT_PACKAGES), tagged FINAL_TAG. This is
# the image the desktop installer runs, so a locally built tag here plus
# SYRUS_BACKEND_IMAGE at DMG stage time gives a fully local end-to-end build.
syrus_build_local_backend_image() {
  local final_tag="${1:?usage: syrus_build_local_backend_image FINAL_TAG GIT_SHA [--version=X.Y.Z] [--built-at=TS]}"
  local git_sha="${2:?usage: syrus_build_local_backend_image FINAL_TAG GIT_SHA [--version=X.Y.Z] [--built-at=TS]}"
  shift 2

  # Metadata flags only need to reach the base build — the Dockerfile.local
  # overlay inherits the base image's baked ENV (GIT_SHA/SYRUS_*) via FROM.
  syrus_build_local_base_image "$git_sha" "$@"
  docker build -f Dockerfile.local \
    --build-arg BASE_IMAGE=syrus-backend-base:latest \
    -t "$final_tag" .
}
