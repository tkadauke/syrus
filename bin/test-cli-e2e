#!/usr/bin/env bash
# Runs the Go CLI E2E suite against the same preview dev server used by
# Playwright E2E specs. Scope to this suite directly:
#
#   bin/test-cli-e2e
#
# This intentionally stays outside playwright.config.ts's project mechanism:
# Playwright owns browser projects, while this wrapper boots the shared dev
# server fixture and then runs the CLI module's Go tests.
set -euo pipefail

port="${E2E_PORT:-3101}"
base_url="${E2E_BASE_URL:-http://127.0.0.1:${port}}"
server_pid=""

cleanup() {
  if [ -n "$server_pid" ] && kill -0 "$server_pid" 2>/dev/null; then
    kill "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
  fi
}

trap cleanup EXIT INT TERM

if [ -z "${E2E_BASE_URL:-}" ] && [ "${E2E_SKIP_SEED:-0}" != "1" ]; then
  echo "[test-cli-e2e] Preparing local database and E2E fixtures."
  bin/rails db:prepare e2e:seed
fi

if [ -z "${E2E_BASE_URL:-}" ]; then
  PORT="$port" bin/syrus-preview-dev &
  server_pid="$!"

  deadline=$((SECONDS + 420))
  until curl -fsS "${base_url}/up" >/dev/null 2>&1; do
    if ! kill -0 "$server_pid" 2>/dev/null; then
      echo "[test-cli-e2e] preview dev server exited before becoming ready" >&2
      exit 1
    fi
    if [ "$SECONDS" -ge "$deadline" ]; then
      echo "[test-cli-e2e] timed out waiting for ${base_url}/up" >&2
      exit 1
    fi
    sleep 1
  done
fi

SYRUS_CLI_E2E=1 \
  E2E_BASE_URL="$base_url" \
  go test ./cli/e2e "$@"
