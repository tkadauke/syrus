#!/usr/bin/env ruby
# frozen_string_literal: true

ENV["RAILS_ENV"] ||= "test"

require_relative "../config/environment"
require "syrus/plugin_model_namespace_checker"

result = Syrus::PluginModelNamespaceChecker.new.call

if result.success?
  puts "Plugin model namespaces and table prefixes look good."
  exit 0
end

warn "Plugin model namespace check failed:"
result.errors.each { |error| warn "- #{error}" }
exit 1
