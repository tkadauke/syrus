#!/usr/bin/env bash
# Build and optionally upload Syrus Desktop release artifacts.
#
# Usage:
#   bin/release-desktop [VERSION] [--upload] [--skip-tests] [--skip-install] [--launch]
#
# Examples:
#   bin/release-desktop v0.4.0
#   bin/release-desktop --launch
#   bin/release-desktop v0.4.0 --launch
#   bin/release-desktop v0.4.0 --upload
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$ROOT/bin/release-lib"
. "$ROOT/bin/signing-env"

VERSION=""
UPLOAD=0
SKIP_TESTS=0
SKIP_INSTALL=0
LAUNCH=0

usage() {
  awk 'NR>1 && /^#/{sub(/^# ?/,""); print; next} NR>1{exit}' "$0"
}

for arg in "$@"; do
  case "$arg" in
    --upload) UPLOAD=1 ;;
    --skip-tests) SKIP_TESTS=1 ;;
    --skip-install) SKIP_INSTALL=1 ;;
    --launch) LAUNCH=1 ;;
    --help|-h) usage; exit 0 ;;
    -*) echo "Unknown flag: $arg" >&2; usage >&2; exit 2 ;;
    *)
      if [ -n "$VERSION" ]; then
        echo "Unexpected argument: $arg" >&2
        usage >&2
        exit 2
      fi
      VERSION="$arg"
      ;;
  esac
done

if [ -z "$VERSION" ] && [ "$UPLOAD" = 0 ]; then
  VERSION="$(syrus_release_local_version)"
fi

syrus_release_validate_version "$VERSION"
syrus_release_require_command npm
syrus_release_require_command shasum

OUT_DIR="$(syrus_release_output_dir "$VERSION" desktop)"
BUILD_VERSION="$(syrus_release_semver "$VERSION")"

syrus_release_prepare_output_dir "$OUT_DIR"

clean_desktop_package_output() {
  rm -rf "$ROOT/desktop/out"
}

assert_packaged_renderer_assets() {
  local index_html="$ROOT/desktop/dist/index.html"

  if [ ! -f "$index_html" ]; then
    echo "Desktop renderer did not produce dist/index.html." >&2
    exit 1
  fi

  if grep -Eq '(src|href)="/' "$index_html"; then
    cat >&2 <<MSG
Desktop renderer emitted root-absolute asset URLs in dist/index.html.
Packaged Electron loads this file through file://, so /assets/... would
resolve to file:///assets/... and the released app would show a blank window.
MSG
    exit 1
  fi
}

launch_packaged_desktop() {
  local platform
  platform="$(uname -s)"

  case "$platform" in
    Darwin)
      local app_path
      app_path="$(find "$ROOT/desktop/out" -maxdepth 3 -type d -name "Syrus Desktop.app" -print -quit)"
      if [ -z "$app_path" ]; then
        echo "Could not find packaged Syrus Desktop.app under desktop/out." >&2
        exit 1
      fi

      echo "== Launching packaged desktop app =="
      open "$app_path"
      ;;
    Linux)
      local app_image
      app_image="$(find "$OUT_DIR" -maxdepth 1 -type f -name '*.AppImage' -print -quit)"
      if [ -z "$app_image" ]; then
        echo "Could not find packaged AppImage under $OUT_DIR." >&2
        exit 1
      fi

      echo "== Launching packaged desktop app =="
      chmod +x "$app_image"
      "$app_image" &
      ;;
    *)
      echo "--launch is only supported on macOS and Linux." >&2
      exit 1
      ;;
  esac
}

if [ "$SKIP_INSTALL" = 1 ]; then
  echo "== Skipping desktop npm ci =="
else
  echo "== Installing desktop dependencies =="
  npm --prefix "$ROOT/desktop" ci
fi

if [ "$SKIP_TESTS" = 1 ]; then
  echo "== Skipping desktop typecheck =="
else
  echo "== Typechecking desktop =="
  npm --prefix "$ROOT/desktop" run typecheck
fi

echo "== Building desktop renderer =="
npm --prefix "$ROOT/desktop" run build:renderer
assert_packaged_renderer_assets

echo "== Building desktop main process =="
npm --prefix "$ROOT/desktop" run build:main

clean_desktop_package_output

# Loads ~/.config/syrus/mac-signing.env — see bin/signing-env. Absent that
# file, this produces the same unsigned local build as before.
syrus_load_mac_signing_env

echo "== Packaging desktop app =="
(
  cd "$ROOT/desktop"
  npx electron-builder --config.extraMetadata.version="$BUILD_VERSION"
)

while IFS= read -r -d '' artifact; do
  cp "$artifact" "$OUT_DIR/"
done < <(
  find "$ROOT/desktop/out" -maxdepth 1 -type f \
    \( -name '*.dmg' -o -name '*.zip' -o -name '*.AppImage' \) \
    -name "*$BUILD_VERSION*" \
    -print0
)

if ! find "$OUT_DIR" -maxdepth 1 -type f | grep -q .; then
  echo "No desktop artifacts for version $BUILD_VERSION were produced in desktop/out." >&2
  exit 1
fi

syrus_release_checksums "$OUT_DIR" SHA256SUMS-desktop.txt

echo
echo "Desktop release artifacts:"
find "$OUT_DIR" -maxdepth 1 -type f -print | sort

if [ "$LAUNCH" = 1 ]; then
  launch_packaged_desktop
fi

if [ "$UPLOAD" = 1 ]; then
  echo
  echo "== Uploading desktop artifacts to GitHub release $VERSION =="
  syrus_release_upload_dir "$VERSION" "$OUT_DIR"
fi
