#!/usr/bin/env bash
set -euo pipefail

export RAILS_ENV="${RAILS_ENV:-test}"
export COVERAGE="${COVERAGE:-false}"
export RSPEC_JSON_DIR="${RSPEC_JSON_DIR:-.syrus/rspec-json}"
export RSPEC_JUNIT_DIR="${RSPEC_JUNIT_DIR:-.syrus/rspec-junit}"
export RSPEC_JUNIT_OUTPUT="${RSPEC_JUNIT_OUTPUT:-.syrus/grade-output/rspec-junit.xml}"

mkdir -p .syrus
exec 9>.syrus/rspec-fast.lock
if ! ruby -e 'exit(File.for_fd(9).flock(File::LOCK_EX | File::LOCK_NB) ? 0 : 1)'; then
  echo "Another bin/rspec-fast run is already active in this checkout; refusing to share SQLite test databases." >&2
  exit 1
fi
export RSPEC_FAST_LOCK_HELD=1

bin/rails db:test:prepare
bin/rspec-fast "$@"
mkdir -p "$RSPEC_JSON_DIR" "$RSPEC_JUNIT_DIR" "$(dirname "$RSPEC_JUNIT_OUTPUT")"
# The first parallel worker uses the default test database, and schema-mutating
# specs may leave it unlike db/schema.rb, so rebuild it before ci_only specs.
bin/rails db:test:purge db:test:prepare

run_ci_only_specs() {
  local suffix="$1"
  shift

  RUN_CI_ONLY_SPECS=true bin/rspec \
    --tag ci_only \
    --require rspec_junit_formatter \
    --format progress \
    --format json \
    --out "$RSPEC_JSON_DIR/rspec-ci-only${suffix}.json" \
    --format RspecJunitFormatter \
    --out "$RSPEC_JUNIT_DIR/rspec-junit-ci-only${suffix}.xml" \
    "$@"
}

status=0
set +e
if [ "$#" -eq 0 ]; then
  mapfile -t ci_only_spec_files < <(
    {
      find spec -type f -name '*_spec.rb'
      find plugins -path '*/spec/*_spec.rb' -type f
      find plugins -path '*/spec/**/*_spec.rb' -type f
    } 2>/dev/null | sort -u
  )

  non_migration_specs=()
  migration_specs=()
  for spec_file in "${ci_only_spec_files[@]}"; do
    case "$spec_file" in
      spec/migrations/*) migration_specs+=("$spec_file") ;;
      *) non_migration_specs+=("$spec_file") ;;
    esac
  done

  if [ "${#non_migration_specs[@]}" -gt 0 ]; then
    run_ci_only_specs "" "${non_migration_specs[@]}"
    status="$?"
  fi

  if [ "$status" -eq 0 ] && [ "${#migration_specs[@]}" -gt 0 ]; then
    bin/rails db:test:purge db:test:prepare
    run_ci_only_specs "-migrations" "${migration_specs[@]}"
    status="$?"
  fi
else
  run_ci_only_specs "" "$@"
  status="$?"
fi
set -e

ruby -rrexml/document -e '
  dir, out = ARGV
  files = Dir[File.join(dir, "rspec-junit-*.xml")].sort
  exit if files.empty?

  merged = REXML::Document.new("<testsuites/>")
  totals = Hash.new(0)
  files.each do |path|
    doc = begin
      REXML::Document.new(File.read(path))
    rescue StandardError
      next
    end
    next unless doc.root

    suites = doc.root.name == "testsuites" ? doc.root.elements.to_a("testsuite") : [ doc.root ]
    suites.each do |suite|
      %w[tests failures errors skipped].each { |k| totals[k] += suite.attributes[k].to_i }
      totals["time"] += suite.attributes["time"].to_f
      merged.root.add_element(suite.deep_clone)
    end
  end
  exit if merged.root.elements.empty?

  %w[tests failures errors skipped].each { |k| merged.root.add_attribute(k, totals[k].to_s) }
  merged.root.add_attribute("time", format("%.6f", totals["time"]))
  File.write(out, merged.to_s)
' "$RSPEC_JUNIT_DIR" "$RSPEC_JUNIT_OUTPUT"

exit "$status"
