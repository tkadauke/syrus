#!/usr/bin/env ruby
# frozen_string_literal: true

# Build this revision's images and roll them out to the K3s clusters.
# `bin/deploy --help` for flags and environment; lib/deploy/cluster_rollout.rb
# for what a rollout does, in order.
#
# The previous bash implementation is kept as bin/deploy-legacy, takes the same
# flags, and is the fallback if this one is ever in doubt. `--dry-run` on both
# prints the command stream each would run, so they can be compared rather than
# trusted.

Dir.chdir(File.expand_path("..", __dir__))

require_relative "../lib/deploy/errors"
require_relative "../lib/deploy/duration"
require_relative "../lib/deploy/clock"
require_relative "../lib/deploy/reporter"
require_relative "../lib/deploy/shell"
require_relative "../lib/deploy/kubectl"
require_relative "../lib/deploy/waiter"
require_relative "../lib/deploy/workload_status"
require_relative "../lib/deploy/control_stack"
require_relative "../lib/deploy/config"
require_relative "../lib/deploy/cli"
require_relative "../lib/deploy/repo"
require_relative "../lib/deploy/images"
require_relative "../lib/deploy/diagnostics"
require_relative "../lib/deploy/cluster_context"
require_relative "../lib/deploy/flux"
require_relative "../lib/deploy/mysql_backup"
require_relative "../lib/deploy/mise_cache"
require_relative "../lib/deploy/prepull"
require_relative "../lib/deploy/migrations"
require_relative "../lib/deploy/image_pins"
require_relative "../lib/deploy/rollout_wait"
require_relative "../lib/deploy/verifications"
require_relative "../lib/deploy/cluster_rollout"
require_relative "../lib/deploy/runner"

reporter = Deploy::Reporter.new

begin
  config = Deploy::CLI.parse(ARGV)
  if config == :help
    puts Deploy::CLI::USAGE
    exit 0
  end
rescue Deploy::Failure => e
  reporter.error(e.message)
  reporter.detail(e.detail)
  exit e.exit_status
end

# SIGTERM becomes an ordinary interruption so the control stack unwinds, which
# is how Flux gets resumed when a terminal is closed on a running deploy. SIGINT
# arrives as Ruby's own Interrupt and is translated the same way.
Signal.trap("TERM") { raise Deploy::Interrupted }

begin
  exit Deploy::Runner.new(config: config, reporter: reporter).call
rescue Interrupt
  reporter.error("deploy interrupted")
  exit 130
end
