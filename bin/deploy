#!/usr/bin/env bash
# Build the current HEAD as two linux/amd64 images — `syrus` (web pod,
# Dockerfile target=app) and `syrus-worker-dev` (worker pod, target=
# worker-dev with mise + multi-language tooling) — push both to GHCR
# with :<sha> and :latest tags, and rollout-restart staging +
# production K3s deployments. Uses plain `docker build` + `docker push`
# instead of buildx registry exporters because buildx has hung after
# image export on this deploy path. Reads the GHCR token from $GHCR_TOKEN or
# ~/.config/syrus/ghcr-token (chmod 600). Never prints it.
#
# Usage:
#   bin/deploy                      # both clusters (default)
#   bin/deploy --staging             # staging only
#   bin/deploy --production          # production only
#   bin/deploy --build-only          # build + push images, skip rollout
#   bin/deploy --skip-build           # assume both :<sha> already pushed
#                                       (just rollout restart)
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${SCRIPT_DIR}/docker-image-lib"

REGISTRY="ghcr.io/tkadauke/syrus"
WORKER_DEV_REGISTRY="ghcr.io/tkadauke/syrus-worker-dev"
GHCR_USER="${GHCR_USER:-tkadauke}"
TOKEN_FILE="${HOME}/.config/syrus/ghcr-token"

# Where each cluster's kubeconfig lives. Staging uses the default
# context (whatever kubectl points at out of the box); production
# uses an explicit file. Keeps the two clusters from racing each
# other through context switches.
STAGING_KUBECONFIG="${KUBECONFIG:-$HOME/.kube/config}"
PRODUCTION_KUBECONFIG="$HOME/.kube/config-production"

NAMESPACE_STAGING="syrus-staging"
NAMESPACE_PRODUCTION="syrus-production"
# Rollout targets across the multi-worker split: web + the single home worker
# (Deployment) + the per-node compute workers (DaemonSet). Each entry carries
# its resource type so `kubectl rollout restart/status` works for Deployments
# and the DaemonSet alike.
DEPLOYMENTS=(deployment/syrus-web deployment/syrus-worker-home daemonset/syrus-worker-compute deployment/syrus-preview)

# --- argv parsing ----------------------------------------------------
DEPLOY_STAGING=true
DEPLOY_PRODUCTION=true
SKIP_BUILD=false
BUILD_ONLY=false
while [ $# -gt 0 ]; do
  case "$1" in
    --staging)        DEPLOY_PRODUCTION=false ;;
    --production)     DEPLOY_STAGING=false ;;
    --build-only)     BUILD_ONLY=true ;;
    --skip-build)     SKIP_BUILD=true ;;
    -h|--help)
      sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
  shift
done

cd "$(git rev-parse --show-toplevel)"

# --- preflight: clean tree, sane HEAD --------------------------------
if ! git diff-index --quiet HEAD --; then
  echo "✗ uncommitted changes — commit or stash first" >&2
  exit 1
fi
SHA="$(git rev-parse --short HEAD)"
BRANCH="$(git rev-parse --abbrev-ref HEAD)"
echo "→ deploying ${SHA} (branch ${BRANCH})"

# --- preflight: eager-load probe -------------------------------------
# Catches Zeitwerk superclass-mismatch crashes that lazy autoload in
# dev/test hides. Shared with the agent's grade step (.syrus.yml
# `eager-load` grader) so the same logic runs in both contexts.
# Skipped under --skip-build because by then the image is already
# tagged and pushed.
if [ "$SKIP_BUILD" = false ] && [ -x bin/check-eager-load ]; then
  echo "→ eager_load probe"
  bin/check-eager-load --quiet
fi

# --- auth ------------------------------------------------------------
GHCR_TOKEN="$(syrus_read_ghcr_token "$TOKEN_FILE")"
syrus_disable_buildx_attestations

# --- build + push ----------------------------------------------------
# Two images, one Dockerfile: `app` (web pod) and `worker-dev` (worker
# pod, with mise + multi-language tooling so the in-pod claude-code
# agent can verify its changes — Dockerfile target).
#
# `verify_pushed` confirms a `<repo>:<tag>` manifest is actually
# present in GHCR after a push. Registry exporters have been seen
# to hang or return without producing a manifest at the tag
# (transient registry hiccup, buildx driver edge case, etc.); the
# only reliable signal is asking the registry directly. Without
# this, the deploy script reports success and the next rollout
# either reuses the old :latest digest (silent regression — what
# bit us today) or kubelet ImagePullBackOffs on the SHA tag.
verify_pushed() {
  syrus_verify_pushed "$1" "$2"
}

if [ "$SKIP_BUILD" = false ]; then
  echo "→ ${REGISTRY} login"
  syrus_ghcr_login "$GHCR_USER" "$GHCR_TOKEN"

  echo "→ ${REGISTRY}:${SHA} build (linux/amd64, target=app)"
  syrus_docker_build_image app "$SHA" \
    --platform linux/amd64 \
    --provenance=false \
    --sbom=false \
    -t "${REGISTRY}:${SHA}" \
    -t "${REGISTRY}:latest" \
    .
  echo "→ ${REGISTRY}:${SHA} push"
  docker push "${REGISTRY}:${SHA}"
  docker push "${REGISTRY}:latest"
  verify_pushed "${REGISTRY}" "${SHA}"
  verify_pushed "${REGISTRY}" "latest"

  echo "→ ${WORKER_DEV_REGISTRY}:${SHA} build (linux/amd64, target=worker-dev)"
  syrus_docker_build_image worker-dev "$SHA" \
    --platform linux/amd64 \
    --provenance=false \
    --sbom=false \
    -t "${WORKER_DEV_REGISTRY}:${SHA}" \
    -t "${WORKER_DEV_REGISTRY}:latest" \
    .
  echo "→ ${WORKER_DEV_REGISTRY}:${SHA} push"
  docker push "${WORKER_DEV_REGISTRY}:${SHA}"
  docker push "${WORKER_DEV_REGISTRY}:latest"
  verify_pushed "${WORKER_DEV_REGISTRY}" "${SHA}"
  verify_pushed "${WORKER_DEV_REGISTRY}" "latest"
else
  echo "→ skipping build/push (--skip-build); verifying existing tags in registry"
  verify_pushed "${REGISTRY}"            "${SHA}"
  verify_pushed "${WORKER_DEV_REGISTRY}" "${SHA}"
fi

if [ "$BUILD_ONLY" = true ]; then
  echo "✓ images built and pushed for ${SHA}; skipping rollout (--build-only)"
  exit 0
fi

# --- rollout helpers -------------------------------------------------
# Must exceed the worker's terminationGracePeriodSeconds (600s in
# the K8s manifests) plus headroom for the new pod's startup. With
# a long RunJob in flight, the old worker can drain for the full
# grace period before the new pod becomes ready. 15m gives us ~5m
# of headroom.
ROLLOUT_TIMEOUT="${ROLLOUT_TIMEOUT:-15m}"
MISE_CACHE_HOST_PATH="${MISE_CACHE_HOST_PATH:-/data/syrus-mise-cache}"

rollout() {
  local label="$1" kubeconfig="$2" namespace="$3"
  local targets=()
  local dep

  for dep in "${DEPLOYMENTS[@]}"; do
    if KUBECONFIG="$kubeconfig" kubectl get -n "$namespace" "$dep" >/dev/null 2>&1; then
      targets+=("$dep")
    else
      echo "→ ${label}: rollout target ${dep} not found in ${namespace} — skipping"
    fi
  done

  if [ "${#targets[@]}" -eq 0 ]; then
    echo "✗ ${label}: no rollout targets found in ${namespace}" >&2
    exit 1
  fi

  flux_suspend_with_watchdog "$kubeconfig" "$label"
  ensure_mise_cache "$label" "$kubeconfig" "$namespace"
  echo "→ ${label}: rollout restart in ${namespace}"
  KUBECONFIG="$kubeconfig" kubectl rollout restart -n "$namespace" "${targets[@]}"
  for dep in "${targets[@]}"; do
    KUBECONFIG="$kubeconfig" kubectl rollout status -n "$namespace" "$dep" --timeout="$ROLLOUT_TIMEOUT"
  done
  verify_sha "$label" "$kubeconfig" "$namespace"
  flux_resume_now "$kubeconfig" "$label"
  echo "✓ ${label} rolled to ${SHA}"
}

ensure_mise_cache() {
  local label="$1" kubeconfig="$2" namespace="$3"
  echo "→ ${label}: applying per-node mise cache worker mounts"
  patch_mise_mount "$kubeconfig" "$namespace" "deployment" "syrus-worker-home"
  patch_mise_mount "$kubeconfig" "$namespace" "daemonset" "syrus-worker-compute"
}

patch_mise_mount() {
  local kubeconfig="$1" namespace="$2" kind="$3" name="$4"
  if ! KUBECONFIG="$kubeconfig" kubectl get "$kind" "$name" -n "$namespace" >/dev/null 2>&1; then
    return 0
  fi

  KUBECONFIG="$kubeconfig" kubectl patch "$kind" "$name" -n "$namespace" --type strategic -p "$(cat <<EOF
{
  "spec": {
    "template": {
      "spec": {
        "securityContext": {
          "fsGroup": 1000,
          "fsGroupChangePolicy": "OnRootMismatch"
        },
        "containers": [
          {
            "name": "syrus-worker",
            "volumeMounts": [
              {
                "name": "syrus-mise-cache",
                "mountPath": "/opt/mise",
                "readOnly": false
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "syrus-mise-cache",
            "hostPath": {
              "path": "${MISE_CACHE_HOST_PATH}",
              "type": "DirectoryOrCreate"
            }
          }
        ]
      }
    }
  }
}
EOF
)" >/dev/null
}

# Flux's apps Kustomization reconciles every 10min and re-applies
# the manifest from Git. That re-apply strips annotations not in
# source — including the `kubectl.kubernetes.io/restartedAt` one
# `kubectl rollout restart` adds. If Flux fires mid-rollout, the
# new ReplicaSet's pod template hash collapses back to the old one
# and K8s stops replacing pods — which is exactly what bit us
# today: 2 web replicas, only 1 got rotated, the second stayed on
# the old image for hours.
#
# Strategy: suspend the Kustomization for the duration of the
# rollout, then resume on success. We DON'T rely on a bash trap
# alone — if the deploy script crashes, the laptop reboots, or the
# operator closes the terminal, the trap doesn't fire and Flux
# stays suspended forever. Instead, on suspend we also enqueue a
# server-side watchdog Job that re-enables Flux after a TTL. The
# script's own resume path normally fires earlier and makes the
# watchdog's resume a no-op; the watchdog is only load-bearing on
# the crash path.
FLUX_NAMESPACE="${FLUX_NAMESPACE:-flux-system}"
FLUX_KUSTOMIZATION="${FLUX_KUSTOMIZATION:-apps}"
FLUX_SUSPEND_TTL="${FLUX_SUSPEND_TTL:-1200}"  # seconds — generous deploy budget
FLUX_WATCHDOG_IMAGE="${FLUX_WATCHDOG_IMAGE:-alpine/k8s:1.31.13}"

flux_kustomization_exists() {
  local kubeconfig="$1"
  KUBECONFIG="$kubeconfig" kubectl -n "$FLUX_NAMESPACE" \
    get kustomization "$FLUX_KUSTOMIZATION" >/dev/null 2>&1
}

flux_suspend_with_watchdog() {
  local kubeconfig="$1" label="$2"
  if ! flux_kustomization_exists "$kubeconfig"; then
    echo "→ ${label}: flux kustomization '${FLUX_KUSTOMIZATION}' not found in '${FLUX_NAMESPACE}' — proceeding without suspend"
    return 0
  fi
  ensure_watchdog_rbac "$kubeconfig"
  echo "→ ${label}: suspending flux kustomization/${FLUX_KUSTOMIZATION} (auto-resume in ${FLUX_SUSPEND_TTL}s if I crash)"
  KUBECONFIG="$kubeconfig" kubectl -n "$FLUX_NAMESPACE" \
    patch kustomization "$FLUX_KUSTOMIZATION" \
    --type merge -p '{"spec":{"suspend":true}}' >/dev/null
  schedule_resume_watchdog "$kubeconfig"
}

flux_resume_now() {
  local kubeconfig="$1" label="$2"
  if ! flux_kustomization_exists "$kubeconfig"; then
    return 0
  fi
  echo "→ ${label}: resuming flux kustomization/${FLUX_KUSTOMIZATION}"
  KUBECONFIG="$kubeconfig" kubectl -n "$FLUX_NAMESPACE" \
    patch kustomization "$FLUX_KUSTOMIZATION" \
    --type merge -p '{"spec":{"suspend":false}}' >/dev/null
}

# RBAC for the watchdog Job: a ServiceAccount in flux-system with
# get/patch on kustomizations. Idempotent — re-applies are no-ops
# after the first run. Lives permanently (no cleanup); the only
# cost is one SA + Role + RoleBinding object per cluster.
ensure_watchdog_rbac() {
  local kubeconfig="$1"
  KUBECONFIG="$kubeconfig" kubectl apply -f - >/dev/null <<EOF
apiVersion: v1
kind: ServiceAccount
metadata:
  name: syrus-deploy-watchdog
  namespace: ${FLUX_NAMESPACE}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: syrus-deploy-watchdog
  namespace: ${FLUX_NAMESPACE}
rules:
  - apiGroups: ["kustomize.toolkit.fluxcd.io"]
    resources: ["kustomizations"]
    verbs: ["get", "patch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: syrus-deploy-watchdog
  namespace: ${FLUX_NAMESPACE}
subjects:
  - kind: ServiceAccount
    name: syrus-deploy-watchdog
    namespace: ${FLUX_NAMESPACE}
roleRef:
  kind: Role
  name: syrus-deploy-watchdog
  apiGroup: rbac.authorization.k8s.io
EOF
}

# Submit a one-shot Job that sleeps `FLUX_SUSPEND_TTL` seconds and
# then patches the Kustomization back to suspend=false. If the deploy
# script's normal resume path fires first, the patch is a no-op
# (already false). If the script crashes, the laptop reboots, or
# the terminal gets closed, the watchdog still runs in the cluster
# and Flux comes back online without operator intervention.
schedule_resume_watchdog() {
  local kubeconfig="$1"
  local job_name="syrus-flux-resume-$(date +%s)-$$"
  KUBECONFIG="$kubeconfig" kubectl apply -f - >/dev/null <<EOF
apiVersion: batch/v1
kind: Job
metadata:
  name: ${job_name}
  namespace: ${FLUX_NAMESPACE}
  labels:
    app: syrus-deploy-watchdog
spec:
  ttlSecondsAfterFinished: 60
  activeDeadlineSeconds: $((FLUX_SUSPEND_TTL + 120))
  backoffLimit: 0
  template:
    metadata:
      labels:
        app: syrus-deploy-watchdog
    spec:
      serviceAccountName: syrus-deploy-watchdog
      restartPolicy: Never
      securityContext:
        runAsNonRoot: true
        runAsUser: 1001
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: resume
          image: ${FLUX_WATCHDOG_IMAGE}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          command: ["/bin/sh", "-c"]
          args:
            - |
              sleep ${FLUX_SUSPEND_TTL}
              kubectl -n ${FLUX_NAMESPACE} patch kustomization ${FLUX_KUSTOMIZATION} --type merge -p '{"spec":{"suspend":false}}'
              echo "watchdog resumed kustomization/${FLUX_KUSTOMIZATION}"
EOF
}

# `kubectl rollout status` returning 0 does NOT mean the new pods
# actually run the SHA we pushed. Two ways it lies:
#
#  (a) The "rollout-restart" annotation never made it through to a
#      new ReplicaSet — Flux's periodic kustomize re-apply strips
#      annotations not present in source, undoing the restart if
#      the timing aligns. Status sees no progress to report and
#      returns immediately. Pods stay on whatever they were.
#
#  (b) The deployment uses `image: ghcr.io/.../syrus` (no tag, so
#      :latest), with `imagePullPolicy: Always`. After a restart,
#      kubelet pulls :latest — but the old pods may already be
#      running an older :latest digest. If the new ReplicaSet's
#      pods come up Ready before kubelet realizes :latest moved,
#      status is happy.  (Less common; the image-pull check usually
#      catches this in practice.)
#
# Cross-check by reading $GIT_SHA from a running container in each
# deployment. The Dockerfile bakes GIT_SHA into both `app` and
# `worker-dev` images, so this is a reliable witness of what's
# actually running.
verify_sha() {
  local label="$1" kubeconfig="$2" namespace="$3"
  local mismatch=0
  for dep in "${DEPLOYMENTS[@]}"; do
    local actual
    # Don't pass -c: the resource name is not the container name (both workers'
    # container is "syrus-worker", and the resource prefix varies deployment/
    # vs daemonset/), so let kubectl default to each pod's single app container.
    actual="$(KUBECONFIG="$kubeconfig" kubectl exec -n "$namespace" "$dep" -- printenv GIT_SHA 2>/dev/null || true)"
    actual="${actual//[$'\r\n']}"
    if [ "$actual" != "$SHA" ]; then
      echo "✗ ${label}/${dep}: pods running '${actual:-<empty>}' but expected ${SHA}" >&2
      mismatch=1
    fi
  done
  if [ "$mismatch" = 1 ]; then
    cat >&2 <<MSG

The ${label} rollout reported success but at least one deployment is
still serving an older image. Now that bin/deploy suspends Flux for
the rollout window and verifies images landed in the registry before
restart, the surviving causes are:

  - A new pod failed init (db migration crash, missing secret) and
    was kept un-Ready while old pods stayed alive. Check 'kubectl get
    pods -n ${namespace}' for Init:Error / CrashLoopBackOff.

  - The deployment manifest references the wrong image repo (e.g.
    'ghcr.io/tkadauke/syrus' for the worker pod when it should be
    'ghcr.io/tkadauke/syrus-worker-dev'). Both pods then pull
    :latest from the same repo, which won't match either build.
    Check the deployment yaml in greenacres.

  - kubelet is using a cached image digest from before the push.
    Delete the affected pod manually to force a fresh pull:
    'kubectl delete pod -n ${namespace} <pod-name>'.

MSG
    exit 1
  fi
}

# --- restart -----------------------------------------------------------
if [ "$DEPLOY_STAGING" = true ]; then
  rollout "staging" "$STAGING_KUBECONFIG" "$NAMESPACE_STAGING"
  git tag -f staging HEAD
  git push --force origin staging
  echo "→ staging tag → ${SHA}"
fi

if [ "$DEPLOY_PRODUCTION" = true ]; then
  rollout "production" "$PRODUCTION_KUBECONFIG" "$NAMESPACE_PRODUCTION"
  git tag -f production HEAD
  git push --force origin production
  echo "→ production tag → ${SHA}"
fi

echo ""
echo "✓ deployed ${SHA}$([ "$DEPLOY_STAGING" = true ] && echo " · staging")$([ "$DEPLOY_PRODUCTION" = true ] && echo " · production")"
