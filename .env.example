# Rails runtime
RAILS_ENV=development # Rails environment to boot.
RAILS_MASTER_KEY= # Secret key for decrypting Rails credentials.
SECRET_KEY_BASE= # Secret key base for signed cookies and sessions.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY= # Stable AR encryption key for encrypted credential columns; generate with `openssl rand -hex 32`.
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY= # Stable AR deterministic encryption key; generate with `openssl rand -hex 32`.
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT= # Stable AR encryption salt; generate with `openssl rand -hex 32`.
RAILS_LOG_LEVEL=info # Rails log verbosity in production.
RAILS_LOG_TO_STDOUT=true # Send Rails logs to stdout in containers.
RAILS_MAX_THREADS=10 # Active Record and Puma thread pool size.
PORT=3000 # HTTP port for Puma.
WEB_CONCURRENCY=1 # Puma worker process count; use auto or an integer.
PIDFILE= # Optional Puma pidfile path.
SOLID_QUEUE_IN_PUMA=false # Run Solid Queue inside Puma for single-server deploys.
CI=false # Enables test eager loading when running the test suite.
TEST_ENV_NUMBER= # Suffix used by parallel test workers to isolate SQLite test databases.

# Bundler runtime
BUNDLE_DEPLOYMENT=1 # Install gems in deployment mode for production images.
BUNDLE_PATH=/usr/local/bundle # Gem install path used by production images.
BUNDLE_WITHOUT=development:test # Bundler groups excluded from production images.

# Syrus application identity and paths
SYRUS_APP_HOST=syrus.internal.green-acres.estate # Canonical app hostname for links, redirects, and mail.
SYRUS_ALLOWED_HOSTS= # Comma-separated host allowlist; defaults to SYRUS_APP_HOST plus the internal host.
SYRUS_ASSUME_SSL=true # Treat requests as HTTPS behind a TLS-terminating proxy.
SYRUS_FORCE_SSL=true # Redirect production traffic to HTTPS.
SYRUS_MAILER_FROM= # Sender address for application mail; defaults to noreply at SYRUS_APP_HOST.
SYRUS_GITHUB_REPO=owner/syrus # GitHub owner/repo slug for this Syrus installation.
SYRUS_BUG_REPORT_OWNER=owner # GitHub owner or org where in-app bug reports are filed.
SYRUS_DATA_ROOT=~/.syrus # Root for cached clones and per-workflow workspaces.
SEARCH_DATABASE_PATH= # SQLite FTS5 search DB path; defaults to $SYRUS_DATA_ROOT/search.sqlite3.
SYRUS_TERMINAL_HOST= # Terminal relay host advertised by workers; blank falls back to 127.0.0.1, Compose uses worker, Kubernetes should use the pod IP.
SYRUS_ROLE=local # Instance role for version tracking, such as web or worker.
GIT_SHA=dev # Build revision reported by the UI and version endpoints.
SYRUS_AUTO_MERGE_DISABLED=false # Disable auto-merge globally when true.

# Agent and sidecar runtime
SYRUS_CODEX_MODEL= # Override the default Codex model used for Codex runs.
SYRUS_MCP_SIDECAR= # Internal flag set by bin/syrus-mcp-sidecar.
SYRUS_CHAT_MCP_SIDECAR= # Internal flag set by bin/syrus-chat-sidecar.
SYRUS_CHAT_SESSION_ID= # Chat session id passed to the chat MCP sidecar.
SYRUS_STT_PROVIDER= # Optional backend chat STT provider; supported value: whisper_cpp.
SYRUS_STT_WHISPER_CPP_EXECUTABLE= # whisper.cpp executable path for backend batch transcription.
SYRUS_STT_WHISPER_CPP_MODEL= # whisper.cpp model path for backend batch transcription.
SYRUS_STT_BACKEND_STREAMING=false # Whether the configured backend supports streaming transcription.

# Database and healthcheck
SYRUS_SQLITE= # Set (e.g. 1) to run production against SQLite under SYRUS_DATA_ROOT for single-host/Compose deploys; unset uses MySQL.
DB_HOST=127.0.0.1 # MySQL host for production and health checks.
SYRUS_DATABASE_USERNAME=syrus # MySQL username used by bin/healthcheck.
SYRUS_DATABASE_PASSWORD= # MySQL password for production databases.
SYRUS_QUEUE_DATABASE=syrus_production_queue # Queue database checked by bin/healthcheck.
HEALTHCHECK_FRESHNESS_SECONDS=180 # Maximum allowed Solid Queue heartbeat age.

# Solid Queue concurrency
JOB_CONCURRENCY=3 # Worker threads for long-running agent runs.
MERGE_CONCURRENCY=5 # Worker threads for deterministic merge and landing work.
CHAT_CONCURRENCY=2 # Worker threads for chat jobs.
DEV_RUN_CONCURRENCY=1 # Development worker threads for the runs queue.
DEV_MERGE_CONCURRENCY=1 # Development worker threads for the merges queue.
DEV_CHAT_CONCURRENCY=1 # Development worker threads for the chat queue.
DEV_DEFAULT_CONCURRENCY=1 # Development worker threads for the default queue.

# Active Storage S3-compatible service
S3_ACCESS_KEY_ID= # S3 or MinIO access key id.
S3_SECRET_ACCESS_KEY= # S3 or MinIO secret access key.
S3_REGION=us-east-1 # S3 region.
S3_BUCKET=syrus-attachments # S3 or MinIO bucket for uploaded files.
S3_ENDPOINT=http://minio.minio.svc.cluster.local:9000 # S3-compatible endpoint URL.

# SMTP
SMTP_ADDRESS= # SMTP server address; leave blank to use Rails default mail delivery.
SMTP_PORT=587 # SMTP server port.
SMTP_USERNAME= # SMTP username.
SMTP_PASSWORD= # SMTP password.
SMTP_AUTHENTICATION=plain # SMTP authentication mode.
SMTP_ENABLE_STARTTLS_AUTO=true # Enable SMTP STARTTLS when available.
SYRUS_MAILER_RAISE_DELIVERY_ERRORS= # Raise mail delivery errors; defaults to whether SMTP is configured.

# Deploy script
GHCR_TOKEN= # GitHub Container Registry token with write:packages scope.
KUBECONFIG=~/.kube/config # Kubeconfig for staging deploys; production uses config-production.
ROLLOUT_TIMEOUT=15m # kubectl rollout status timeout.
FLUX_NAMESPACE=flux-system # Namespace containing the Flux Kustomization.
FLUX_KUSTOMIZATION=apps # Flux Kustomization suspended during deploy.
FLUX_SUSPEND_TTL=1200 # Seconds before the deploy watchdog resumes Flux.
FLUX_WATCHDOG_IMAGE=alpine/k8s:1.31.13 # Container image for the Flux resume watchdog job.
