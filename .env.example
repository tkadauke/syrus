# Copy this file to .env before running `docker compose up`.

# Published full self-host image. Leave this alone unless you are testing a local build.
SYRUS_IMAGE=ghcr.io/tkadauke/syrus:full

# Rails secrets. Generate SECRET_KEY_BASE with `openssl rand -hex 64`.
# RAILS_MASTER_KEY must match the credentials bundled with the image/source checkout.
SECRET_KEY_BASE=
RAILS_MASTER_KEY=

# MySQL. Keep SYRUS_DATABASE_PASSWORD and MYSQL_ROOT_PASSWORD distinct.
SYRUS_DATABASE_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Web binding. Syrus listens on container port 80; Compose exposes it here.
SYRUS_WEB_PORT=3000

# Persistent workspace root mounted into web and worker containers.
SYRUS_DATA_ROOT=/home/rails/.syrus

# Worker concurrency for long-running agent jobs.
JOB_CONCURRENCY=3

# Optional timezone for logs and recurring schedules.
TZ=UTC

# GitHub and agent credentials are entered per user in the Syrus UI after
# sign-up: Settings -> Credentials. No GITHUB_APP_* env vars are required for
# this path. Add a GitHub PAT in the UI with repo access to repositories Syrus
# should poll and push to. Claude uses a Claude Code OAuth token rather than a
# global ANTHROPIC_API_KEY; Codex can use either an API key or ChatGPT auth.json.
