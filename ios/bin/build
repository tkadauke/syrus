#!/usr/bin/env bash
# Generate the Xcode project and build + test on an iOS Simulator.
set -euo pipefail
cd "$(dirname "$0")/.."
command -v xcodegen >/dev/null || { echo "xcodegen not found: brew install xcodegen" >&2; exit 1; }
xcodegen generate
exec xcodebuild test -project Syrus.xcodeproj -scheme Syrus \
  -destination "${SYRUS_IOS_DESTINATION:-platform=iOS Simulator,name=iPhone 17}" \
  -derivedDataPath build/DerivedData CODE_SIGNING_ALLOWED=NO "$@"
